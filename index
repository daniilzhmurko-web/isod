document.getElementById('btn-launch').addEventListener('click', () => {
  const regionCode = document.getElementById('region-select').value;
  if (!regionCode) { showToast('Пожалуйста, выберите регион из списка'); return; }
  const wp = document.querySelector('input[name="workplace"]:checked').value;
  State.region = REGIONS[regionCode];
  State.workplace = wp;
  loadProgress();
  buildMenu();
  showScreen('screen-menu');
});

// ════════════════════════════════════
// МЕНЮ СЦЕНАРИЕВ
// ════════════════════════════════════
function buildMenu() {
  const r = State.region;
  const wp = State.workplace;
  const user = r.users[wp];

  document.getElementById('menu-header-region').textContent = r.shortName;
  document.getElementById('menu-region-badge').textContent = '📍 ' + r.name;
  document.getElementById('menu-user-avatar').textContent = user.avatar;
  document.getElementById('menu-user-name').textContent = user.name;
  document.getElementById('menu-user-rank').textContent = user.rank;
  document.getElementById('menu-user-position').textContent = user.position;

  const done = State.completedScenarios.length;
  const pct = Math.round(done / SCENARIO_META.length * 100);
  document.getElementById('progress-pct').textContent = pct + '%';
  document.getElementById('progress-fill').style.width = pct + '%';
  document.getElementById('progress-time').textContent = `Пройдено: ${done} из ${SCENARIO_META.length} сценариев`;

  const list = document.getElementById('scenario-list');
  list.innerHTML = '';
  SCENARIO_META.forEach((sc, i) => {
    const done = State.completedScenarios.includes(sc.id);
    const isFirst = i === 0;
    const prevDone = i === 0 || State.completedScenarios.includes(SCENARIO_META[i-1].id);
    const locked = !isFirst && !prevDone;
    const current = !done && prevDone;
    const stars = State.progress['sc'+sc.id]?.stars || 0;
    const roleNames = { boss: 'Руководитель', clerk: 'Делопроизводитель', exec: 'Исполнитель', signer: 'Подписант' };

    const card = document.createElement('div');
    card.className = 'scenario-card' + (done ? ' completed' : current ? ' current' : locked ? ' locked' : '');
    card.innerHTML = `
      <div class="scenario-num">${done ? '✓' : locked ? '🔒' : sc.id}</div>
      <div class="scenario-info">
        <div class="scenario-title">${sc.title}</div>
        <div class="scenario-meta">${sc.time} · ${sc.steps} шагов</div>
        <div class="scenario-role">Роль: ${roleNames[sc.role]} — ${r.users[sc.role].name}</div>
        <div class="scenario-stars">
          ${[1,2,3].map(s => `<span class="star ${stars >= s ? 'filled' : 'empty'}">${stars >= s ? '★' : '☆'}</span>`).join('')}
        </div>
      </div>
      <div class="scenario-action">
        ${done ? `<button class="btn-repeat" onclick="startScenario(${sc.id})">↻ Повторить</button>` :
          locked ? `<span class="btn-locked">🔒 Закрыт</span>` :
          `<button class="btn-start" onclick="startScenario(${sc.id})">▶ Начать</button>`}
      </div>
    `;
    list.appendChild(card);
  });
}

function startScenario(id) {
  const sc = SCENARIO_META.find(s => s.id === id);
  const r = State.region;
  const user = r.users[sc.role];

  State.currentScenario = id;
  State.score = 100;
  State.errors = 0;
  State.hints = 0;
  State.startTime = Date.now();

  // Настройка шапки симулятора
  document.getElementById('sim-header-org').textContent = r.shortName;
  document.getElementById('sim-operator-name').textContent = user.name;
  document.getElementById('sim-scenario-badge').textContent = `Сценарий ${id}: ${sc.title}`;
  document.getElementById('sim-step-counter').textContent = `Шаг 1 из ${sc.steps}`;
  document.getElementById('statusbar-region').textContent = `Регион: ${r.name}`;
  document.getElementById('statusbar-scenario').textContent = sc.title;

  // Настройка интерфейса СЭД
  document.getElementById('sed-operator').textContent = user.name;
  document.getElementById('sed-username').textContent = user.name;
  document.getElementById('sed-userrole').textContent = user.rank;
  document.getElementById('sed-avatar').textContent = user.avatar;

  // Заполнить dropdown пользователей
  const dd = document.getElementById('sed-user-dropdown');
  dd.innerHTML = Object.entries(r.users).map(([k, u]) =>
    `<option value="${k}" ${k === sc.role ? 'selected' : ''}>${u.name}</option>`
  ).join('');

  // Загрузить документы региона
  renderDocuments(r.docs, 'approval');

  // Запустить таймер
  clearInterval(State.timerInterval);
  State.elapsedSeconds = 0;
  State.timerInterval = setInterval(() => {
    State.elapsedSeconds++;
    const m = Math.floor(State.elapsedSeconds / 60).toString().padStart(2,'0');
    const s = (State.elapsedSeconds % 60).toString().padStart(2,'0');
    document.getElementById('sim-timer-display').textContent = `${m}:${s}`;
  }, 1000);

  updateLiveScore();
  showScreen('screen-simulator');

  // Сообщаем движку сценария начать (Stage 2+)
  if (typeof loadScenarioEngine === 'function') loadScenarioEngine(id);
}

