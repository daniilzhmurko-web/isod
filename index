    1:['#l-btn','#l-role'],
    2:['#n-search'],
    3:['#s-type'],
    4:['#s-sur','#s-btn'],
    5:[''],
    6:['#cv-btn'],
    7:['#er-btn'],
    9:['#role-btn'],
    10:['#n-requests'],
  };
  const t=targets[S.step]||[];
  t.forEach(sel=>{const e=sel&&document.querySelector(sel);if(e)e.classList.add('qglow');});
}

/* =====================================================
   ЭКРАН: МИССИЯ ВЫПОЛНЕНА
   ===================================================== */
function showMC() {
  const ranks=[
    {min:0,  name:'🎓 Стажёр'},
    {min:80, name:'🥉 Специалист'},
    {min:140,name:'🥈 Старший специалист'},
    {min:190,name:'🥇 Эксперт ЦИАДИС-МВД'},
  ];
  const rank=ranks.filter(r=>S.xp>=r.min).pop();
  el('f-xp').textContent=S.xp;
  el('f-steps').textContent=S.done.length;
  el('f-hints').textContent=S.hints;
  el('f-rank').textContent=rank.name;
  el('mscreen').style.display='flex';
}

/* =====================================================
   TOASTS
   ===================================================== */
function toast(title,msg,type='success') {
  const icons={success:'✅',err:'❌',warn:'⚠️',info:'ℹ️'};
  const tc=document.getElementById('toasts');
  const d=document.createElement('div');
  d.className='toast '+(type==='err'?'err':type==='warn'?'warn':type==='info'?'info':'');
  d.innerHTML=`<span class="t-icon">${icons[type]||'ℹ️'}</span><div><div class="t-title">${title}</div><div class="t-msg">${msg}</div></div>`;
  tc.appendChild(d);
  setTimeout(()=>{d.style.transition='opacity .3s';d.style.opacity='0';setTimeout(()=>d.remove(),300);},3200);
}

