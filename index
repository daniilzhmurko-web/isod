function updateRiskUI(){
  const r=S.riskIndex;
  const color=r>75?'#e02424':r>50?'#d97706':r>25?'#f59e0b':'#057a55';
  ['sb-risk-fill','rp-risk-f'].forEach(id=>{const el=document.getElementById(id);if(el)el.style.width=r+'%';});
  const rv=document.getElementById('sb-risk-val');if(rv)rv.textContent=`${r} / 100`;
  const rn=document.getElementById('rp-risk-num');if(rn){rn.textContent=r;rn.style.color=color;}
  const th=document.getElementById('tb-risk-hdr');if(th)th.textContent=r;
  const ds=document.getElementById('ds-risk');if(ds)ds.textContent=r;
  renderRiskFactors();
}

function renderRiskFactors(){
  const factors=[
    {name:'Активные кейсы',val:CM.active.length,max:10},
    {name:'Объекты высокого риска',val:DB.objects.filter(o=>o.risk>70).length,max:5},
    {name:'Купюры без экспертизы',val:DB.cf.filter(c=>c.status==='Изъята').length,max:10},
    {name:'Просроченные запросы',val:DB.requests.filter(r=>r.status==='Просрочен').length,max:5},
    {name:'Adversarial угрозы',val:S.adversaryLevel,max:3},
