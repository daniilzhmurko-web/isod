    <div class="form-modal__footer">
      <button class="btn-form-cancel" onclick="closeFormModal()">Отмена</button>
      <button class="btn-form-submit" id="btn-form-submit" onclick="submitForm()" disabled style="opacity:.5;">Зарегистрировать</button>
