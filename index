function getContextualHint() {
  const m = MISSIONS[globalState.currentMission];
  if (!m) return 'Нет активной миссии.';
  const s = m.steps[globalState.currentStep];
  if (!s) return 'Все шаги завершены!';
  return s.hints?.[0] || 'Следуйте инструкции в правой панели.';
}

function getCurrentStepDesc() {
  const m = MISSIONS[globalState.currentMission];
  const s = m?.steps[globalState.currentStep];
  if (!s) return 'Миссия завершена!';
  return s.instruction.replace(/<[^>]+>/g, '');
}

function getClickTarget() {
  const m = MISSIONS[globalState.currentMission];
  const s = m?.steps[globalState.currentStep];
  if (!s) return 'Все выполнено!';
  const hints = s.hints || [];
  return hints[1] || hints[0] || 'Смотрите инструкцию в правой панели.';
}

function processAIMessage(msg) {
  const lower = msg.toLowerCase();

  // Проверка приветствий
  if (AI_KNOWLEDGE.greetings.some(g => lower.includes(g))) {
    return 'Здравствуйте! Я AI-помощник СЦУО. Введите "что делать" для подсказки по текущему шагу, или задайте вопрос по любой теме системы.';
  }

  // Поиск по базе знаний
  for (const [key, fn] of Object.entries(AI_KNOWLEDGE.helpTopics)) {
    if (lower.includes(key)) {
      return typeof fn === 'function' ? fn() : fn;
    }
  }

  // Fallback
  const idx = Math.floor(Math.random() * AI_KNOWLEDGE.fallbacks.length);
  return AI_KNOWLEDGE.fallbacks[idx];
}

function toggleAI() {
  const panel = document.getElementById('aiPanel');
  panel.classList.toggle('open');
}

function sendAIMessage() {
  const input = document.getElementById('aiInput');
  const msg = input.value.trim();
  if (!msg) return;
  input.value = '';

  addAIMessage(msg, 'user');

  // Имитация задержки ответа
  setTimeout(() => {
    const reply = processAIMessage(msg);
    addAIMessage(reply, 'bot');
  }, 400 + Math.random() * 300);
}

function addAIMessage(text, type) {
  const container = document.getElementById('aiMessages');
  const div = document.createElement('div');
  div.className = `ai-msg ${type}`;
  div.innerHTML = text;
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
}

function addAISystemMsg(text) {
  const container = document.getElementById('aiMessages');
  const div = document.createElement('div');
  div.className = 'ai-msg system';
  div.innerHTML = '🔔 ' + text;
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
}

