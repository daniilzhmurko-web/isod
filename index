function openModule(name){
  State.currentModule=name;
  // Уничтожаем все графики перед переключением модуля
  destroyAllCharts();
  document.querySelectorAll('.nav-item').forEach(function(el){el.classList.remove('active')});
  var navEl=document.getElementById('nav-'+name);
  if(navEl)navEl.classList.add('active');
  setQuestFlag(name);
  var mc=document.getElementById('main-content');
  var renders={
    dashboard:function(){mc.innerHTML=renderDashboard();setTimeout(initDashboardChart,50);},
    orgstructure:function(){mc.innerHTML=renderOrgStructure();},
    staffing:function(){mc.innerHTML=renderStaffing();},
    orders:function(){mc.innerHTML=renderOrders();},
    limits:function(){mc.innerHTML=renderLimits();},
    tariffs:function(){mc.innerHTML=renderTariffs();},
    classifiers:function(){mc.innerHTML=renderClassifiers();},
    reports:function(){mc.innerHTML=renderReports();},
    analytics:function(){mc.innerHTML=renderAnalytics();setTimeout(initAnalyticsCharts,50);},
    admin:function(){mc.innerHTML=renderAdmin();},
    audit:function(){mc.innerHTML=renderAudit();State.flags.viewedAudit=true;},
    signature:function(){mc.innerHTML=renderSignature();},
  };
  (renders[name]||function(){mc.innerHTML='<div class="card"><p>Раздел в разработке</p></div>';})();
