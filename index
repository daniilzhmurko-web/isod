  },30000);
}

function loadSavedProgress(){
  try{
    const data=localStorage.getItem('sodpp_progress');
    if(data){
      const saved=JSON.parse(data);
      if(saved&&saved.step>0){
        return saved;
      }
    }
  }catch(e){}
  return null;
}

