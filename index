  c.innerHTML=factors.map(f=>{const p=f.max>0?Math.min(100,f.val/f.max*100):0;return`<div style="margin-bottom:9px"><div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:2px"><span>${f.name}</span><span style="font-family:var(--mono);font-weight:700;color:${p>60?'var(--red)':p>30?'var(--orange)':'var(--green)'}">${f.val}/${f.max}</span></div><div class="pbar"><div class="pfill ${p>60?'pf-red':p>30?'pf-gold':'pf-green'}" style="width:${p}%"></div></div></div>`}).join('');
