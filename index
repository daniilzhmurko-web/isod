// ============================================================
// КВЕСТ-ДВИЖОК
// ============================================================
function updateQuestUI(){
  const step=questSteps[appState.currentQuestStep]||questSteps[questSteps.length-1];
  const progress=Math.round((appState.currentQuestStep/(questSteps.length-1))*100);
  const cnt=document.getElementById('questStepCounter');
  const num=document.getElementById('questStepNum');
  const title=document.getElementById('questStepTitle');
  const fill=document.getElementById('questProgressFill');
  const txt=document.getElementById('questProgressText');
  const obj=document.getElementById('questObjective');
  const hint=document.getElementById('questHintText');
  if(cnt) cnt.textContent=`Шаг ${appState.currentQuestStep+1}/${questSteps.length}`;
  if(num) num.textContent=step.mission;
  if(title) title.textContent=step.title;
  if(fill) fill.style.width=progress+'%';
  if(txt) txt.textContent=progress+'%';
  if(obj) obj.textContent=step.objective;
  if(hint) hint.innerHTML=step.hint;
  renderQuestLog();
  updateInstructions();
}

function renderQuestLog(){
  const log=document.getElementById('questLog');
  if(!log) return;
  log.innerHTML=questSteps.map((s,i)=>{
    const done=i<appState.currentQuestStep;
    const current=i===appState.currentQuestStep;
    return `<div class="quest-log-item"><div class="quest-log-dot ${done?'done':current?'current':'pending'}"></div><div class="quest-log-text ${done?'done':current?'current':''}">${s.title}</div></div>`;
  }).join('');
}

function advanceQuestStep(){
  if(appState.currentQuestStep<questSteps.length-1){
    appState.currentQuestStep++;
    appState.progress=Math.round((appState.currentQuestStep/(questSteps.length-1))*100);
    updateQuestUI();
    if(appState.currentQuestStep===questSteps.length-1) setTimeout(showCompletionModal,1000);
  }
}

function advanceIfStep(flag){
  const step=questSteps[appState.currentQuestStep];
  if(step&&step.id===flag&&!appState.flags[flag]){
    appState.flags[flag]=true;
    addXP(step.xp||100);
    advanceQuestStep();
  }
}

function nextQuestStep(){
  if(appState.currentQuestStep<questSteps.length-1){
    appState.currentQuestStep++;
    updateQuestUI();
    showToast('➡️ Переход','Следующий шаг квеста','info');
  }
}

function prevQuestStep(){
  if(appState.currentQuestStep>0){appState.currentQuestStep--;updateQuestUI();}
}

function checkCurrentStep(){
  const step=questSteps[appState.currentQuestStep];
  if(!step) return;
  if(appState.flags[step.flag]||step.id==='complete'){
    showToast('✅ Шаг выполнен!',step.title,'success');
    addXP(15,'Проверка пройдена!');
    if(step.id==='complete') showCompletionModal();
  } else {
    showToast('⚠️ Не выполнено','Выполните задание: '+step.objective.substring(0,60)+'...','warn');
  }
}

// ============================================================
// ИНСТРУКЦИИ (CISCO-СТИЛЬ)
// ============================================================
function updateInstructions(){
  const step=questSteps[appState.currentQuestStep]||questSteps[0];
  const t=document.getElementById('instrTitle');
  const txt=document.getElementById('instrText');
  const hint=document.getElementById('instrHintText');
  const lbl=document.getElementById('instrStepLabel');
  if(t) t.textContent=step.title;
  if(txt) txt.textContent=step.objective;
  if(hint) hint.innerHTML=step.hint;
  if(lbl) lbl.textContent='Шаг '+(appState.currentQuestStep+1)+'/'+questSteps.length;
  const dots=document.getElementById('instrDots');
  if(dots) dots.innerHTML=questSteps.map((_,i)=>`<div class="step-dot ${i<appState.currentQuestStep?'done':i===appState.currentQuestStep?'current':''}"></div>`).join('');
}

