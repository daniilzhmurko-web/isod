  genCall(){
    const n=new Date(),t=n.toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'});
    const subjects=['Драка у кафе','Подозрительный человек','Кража из автомобиля','Нарушение тишины','ДТП без пострадавших','Бытовой конфликт','Угроза насилием','Пропал ребёнок'];
    const names=['Иванов И.И.','Петрова С.В.','Сидоров А.Н.','Козлова М.Р.','Новиков Д.П.','Громова Е.К.','Морозов В.А.'];
    const prs=['low','medium','medium','high'];
    const call={caller:names[Math.floor(Math.random()*names.length)],phone:'7916'+Math.floor(1000000+Math.random()*9000000),subject:subjects[Math.floor(Math.random()*subjects.length)],priority:prs[Math.floor(Math.random()*prs.length)],addr:INC_ADDR[Math.floor(Math.random()*INC_ADDR.length)],time:t};
    this.s.callQueue.push(call);
    this.save();this.updBdg();
    this.addEv(`<strong>Входящий вызов</strong> от ${call.caller}: ${call.subject}.`,call.priority==='high'?'danger':'warning');
    this.toast(call.priority==='high'?'d':'w','Входящий вызов 02!',call.caller+': '+call.subject);
    if(this.s.mod==='disp')this.go('disp');
  },

  scheduleCall(){
    const schedNext=()=>{
      const delay=30000+Math.random()*60000;
      setTimeout(()=>{if(this.s.user.nm){this.genCall();schedNext();}},delay);
