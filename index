// PHASE 4 — SCENARIO ENGINE
// ═══════════════════════════════════════════════════════
function getScenario() {
  // self-evolving: higher levels get harder / shuffled scenarios
  const idx = S.scenarioIdx % BASE_SCENARIOS.length;
  const sc = JSON.parse(JSON.stringify(BASE_SCENARIOS[idx]));
  if (S.evoLevel > 2 && Math.random() > .6) {
    sc.tasks = sc.tasks.sort(() => Math.random() - .5);
    sc.badge += ' (адаптив)';
  }
  if (S.evoLevel > 3) { sc.tasks.forEach(t => { t.pts = Math.round(t.pts * 1.3); }); }
  return sc;
}

const taskState = {};
function renderScenario() {
  const sc = getScenario();
  document.getElementById('scBadge').textContent = sc.badge;
  document.getElementById('scTitle').textContent = sc.title;
  document.getElementById('scDesc').textContent = sc.desc;

  // role tabs
  const roles = ['Все роли','Сотрудник','Фин. подразделение','Филиал','ГЦСП','Администратор'];
  const tabsEl = document.getElementById('rTabs');
  const colors = ['#1B3E6F','#2357A8','#10B981','#8B5CF6','#EF4444','#F59E0B'];
  tabsEl.innerHTML = roles.map((r,i) => `<div class="rtab on" style="background:${colors[i]}" onclick="filterRole('${r}',this)">${r}</div>`).join('');

  const tl = document.getElementById('tList');
  tl.innerHTML = '';
  sc.tasks.forEach((t, i) => {
    taskState[t.id] = taskState[t.id] || 'pending';
    const locked = S.behavior.profile === 'Новичок' && i > S.taskIdx + 1;
    const cls = taskState[t.id] === 'done' ? 'done' : taskState[t.id] === 'active' ? 'active' : locked ? 'locked' : '';
    const check = taskState[t.id] === 'done' ? '✓' : i + 1;
    const modColors = {'Сотрудник':'#2357A8','ФинПодр':'#10B981','Филиал':'#8B5CF6','ГЦСП':'#1B3E6F','Отчёты':'#F59E0B','ТрансОрг':'#EF4444','Аудит':'#6366F1','Администратор':'#EC4899'};
    const mc = modColors[t.mod] || '#64748B';
    tl.innerHTML += `<div class="tc ${cls}" id="tc-${t.id}" onclick="doTask('${t.id}','${t.mod}',${t.pts},${locked})">
      <div class="tck">${check}</div>
      <div class="tbdy"><div class="ttl">${t.title}</div><div class="tdsc">${t.desc}</div></div>
      <div class="tmod" style="background:${mc}22;color:${mc}">${t.mod}</div>
    </div>`;
  });
  document.getElementById('tbadge').textContent = sc.tasks.filter(t => taskState[t.id] !== 'done').length;
  startTimer();
}

function doTask(id, mod, pts, locked) {
  if (locked) { notify('🔒 Завершите предыдущие задачи', 'warn'); return; }
  if (taskState[id] === 'done') return;

  const card = document.getElementById('tc-' + id);
  if (!card) return;
  card.classList.add('active');
  taskState[id] = 'active';

  // simulate processing
  const delay = (500 + Math.random() * 800) / S.speed;
  const startT = Date.now();
  setTimeout(() => {
    const elapsed = Date.now() - startT;
    const fast = elapsed < 600;
    taskState[id] = 'done';
    card.classList.remove('active'); card.classList.add('done');
    card.querySelector('.tck').textContent = '✓';
    S.score += pts;
    S.taskIdx++;
    document.getElementById('scoreV').textContent = S.score;
    addEvent('заявка', `Задача выполнена: "${card.querySelector('.ttl').textContent}" (+${pts} очков)`);
    updateBehavior(fast ? 'task_done_fast' : 'task_done_slow');
    updateBehavior('task_done');

    const rem = document.querySelectorAll('.tc:not(.done)').length;
    document.getElementById('tbadge').textContent = rem;
    if (rem === 0) { scenComplete(); }
  }, delay);
}

function scenComplete() {
  S.scensDone++;
  S.evoLevel = Math.min(10, Math.floor(S.scensDone / 2) + 1);
  document.getElementById('evoLvl').textContent = S.evoLevel;
  document.getElementById('scDone').textContent = S.scensDone;
  notify(`🎉 Сценарий завершён! +${50 * S.evoLevel} бонусных очков`, 'ok');
  S.score += 50 * S.evoLevel;
  document.getElementById('scoreV').textContent = S.score;
  doSave();
  addEvent('система', `Сценарий #${S.scenarioIdx + 1} завершён. Уровень эволюции: ${S.evoLevel}`);
  updateBehavior('task_done');
}

function nextScen() {
  S.scenarioIdx = (S.scenarioIdx + 1) % BASE_SCENARIOS.length;
  S.taskIdx = 0;
  const sc = getScenario();
  sc.tasks.forEach(t => delete taskState[t.id]);
  renderScenario();
  notify(`▶ Запущен: ${sc.title}`, 'info');
  stopTimer(); startTimer();
}

function resetScen() {
  S.taskIdx = 0;
  const sc = getScenario();
  sc.tasks.forEach(t => delete taskState[t.id]);
  renderScenario();
  stopTimer(); startTimer();
}

function filterRole(role, el) {
  document.querySelectorAll('.rtab').forEach(t => t.classList.remove('on'));
  el.classList.add('on');
}

// Timer
let timerInt = null;
function startTimer() {
  S.timer = 300 - S.evoLevel * 20;
  if (S.timer < 60) S.timer = 60;
  updateTimer();
  stopTimer();
  timerInt = setInterval(() => {
    if (!S.running) return;
    S.timer -= S.speed;
    const elapsed = Math.floor(S.simTime);
    document.getElementById('timeSys').textContent = `${Math.floor(elapsed/60)}м ${elapsed%60}с`;
    updateTimer();
    if (S.timer <= 0) { stopTimer(); notify('⏰ Время вышло!', 'err'); updateBehavior('task_error'); }
  }, 1000);
}
function stopTimer() { if (timerInt) clearInterval(timerInt); timerInt = null; }
function updateTimer() {
  const m = Math.floor(Math.max(0, S.timer) / 60);
  const s = Math.max(0, S.timer) % 60;
  document.getElementById('tmrD').textContent = `${String(m).padStart(2,'0')}:${String(Math.floor(s)).padStart(2,'0')}`;
  document.getElementById('tmrD').style.color = S.timer < 60 ? 'var(--red)' : 'var(--primary)';
}

// ═══════════════════════════════════════════════════════
// PHASE 5 — AI AGENTS
// ═══════════════════════════════════════════════════════
const AI_RESPONSES = {
  'что такое сопс': 'СОПС — Сервис оформления проезда сотрудников и военнослужащих внутренних войск МВД России. Предназначен для автоматизации выписки и использования воинских перевозочных документов (ВПД).',
  'э-впд': 'Э-ВПД — электронный воинский перевозочный документ. Заменяет бумажные документы и позволяет сотруднику купить билет у транспортной организации в пределах выделенного лимита.',
  'лимит': 'Лимит — сумма бюджетных ассигнований, выделенных подразделению на транспортные расходы. Распределяется сверху вниз: ФЭД МВД → ГЦСП → Филиал → Финансовое подразделение → Сотрудник.',
  'модул': 'Система СОПС включает 9 модулей: Сотрудник, Финансовое подразделение, Филиал, ГЦСП, Транспортная организация, Администратор, Отчёты, Аудит и НСИ.',
  'аудит': 'Модуль «Аудит» фиксирует все действия пользователей, обмен сообщениями с транспортными организациями и выполнение автоматических процедур. Обеспечивает полный контроль и прозрачность операций.',
  'гцсп': 'ГЦСП (Главный центр специальных перевозок) — центральный узел системы. Распределяет лимиты от ФЭД МВД по филиалам, консолидирует отчётность и обрабатывает реестры от транспортных организаций.',
  'default': null
};

const AI_PROACTIVE = [
  { agent:'instructor', text:'Изучите модуль «Финансовое подразделение» — именно там начинается цепочка оформления Э-ВПД.' },
  { agent:'inspector',  text:'Обратите внимание: лимит распределяется строго иерархически. Нельзя превысить лимит вышестоящего уровня.' },
  { agent:'adversary',  text:'Внимание! Обнаружен риск: несинхронизированные реестры от транспортных организаций могут вызвать ошибки сверки.' },
  { agent:'trainer',    text:'Ваш прогресс зафиксирован. На следующей сессии сложность сценариев будет адаптирована к вашему уровню.' },
  { agent:'instructor', text:'Роль «Сотрудник» — конечный потребитель системы. Все остальные роли обеспечивают его возможность купить билет.' },
  { agent:'inspector',  text:'Транспортные организации передают сводные реестры в ГЦСП. Это критически важный этап для сверки и акцепта.' },
];

let aiMsgIdx = 0;
function initChat() {
  const cm = document.getElementById('chatM');
  cm.innerHTML = '';
  addChatMsg('instructor', 'Добро пожаловать в систему СОПС! Я — AI Instructor. Задайте вопрос о системе или выполняйте сценарии для получения персонализированных рекомендаций.', false);
  setTimeout(() => addChatMsg('trainer', `Сессия #${S.session}. Уровень эволюции: ${S.evoLevel}. ${S.scensDone > 0 ? `Предыдущая сессия: завершено ${S.scensDone} сценариев.` : 'Начните с первого сценария.'}`, false), 1200);
}

function addChatMsg(agent, text, isUser) {
  const cm = document.getElementById('chatM');
  const ag = isUser ? null : AI_AGENTS[agent];
  const div = document.createElement('div');
  div.className = 'cmsg' + (isUser ? ' usr' : '');
  if (isUser) {
    div.innerHTML = `<div class="cav" style="background:var(--surface3)">👤</div><div class="cbub">${text}</div>`;
  } else {
    div.innerHTML = `<div class="cav" style="background:var(--surface3)">${ag.ico}</div>
      <div><div class="cag ${ag.cls}">${ag.name.toUpperCase()}</div><div class="cbub">${text}</div></div>`;
  }
  cm.appendChild(div);
  cm.scrollTop = cm.scrollHeight;
}

function sendChat() {
  const fld = document.getElementById('chatFld');
  const txt = fld.value.trim();
  if (!txt) return;
  fld.value = '';
  addChatMsg(null, txt, true);

  let reply = null, agent = 'instructor';
  const low = txt.toLowerCase();
  for (const [k, v] of Object.entries(AI_RESPONSES)) {
    if (k !== 'default' && low.includes(k)) { reply = v; break; }
  }

  if (!reply) {
    if (low.includes('совет') || low.includes('помог') || low.includes('подск')) {
      agent = 'trainer';
      reply = `Исходя из вашего профиля «${S.behavior.profile}», рекомендую: ${S.behavior.experience < 40 ? 'начать с Сценария 1 — базовая командировка.' : 'попробовать Сценарий 6 — комплексный кейс.'}`;
    } else if (low.includes('ошибк') || low.includes('провер')) {
      agent = 'inspector';
      reply = `Зафиксировано ошибок в сессии: ${S.errors}. Точность: ${S.behavior.accuracy}%. ${S.errors > 2 ? 'Рекомендую перечитать описание задач перед выполнением.' : 'Отличный результат!'}`;
    } else if (low.includes('сложн') || low.includes('труд')) {
      agent = 'adversary';
      reply = 'Уровень сложности адаптируется автоматически. На уровне ' + S.evoLevel + ' сценарии ' + (S.evoLevel > 3 ? 'уже усложнены — задачи перемешаны, очки увеличены.' : 'базовые. Завершайте сценарии для повышения уровня.');
    } else {
      const proact = AI_PROACTIVE[aiMsgIdx % AI_PROACTIVE.length];
      aiMsgIdx++;
      agent = proact.agent;
      reply = proact.text;
    }
  }

  setTimeout(() => addChatMsg(agent, reply, false), 600 + Math.random() * 400);
}

// AI Hints in Simulation panel
function renderAIHints(hints) {
  const el = document.getElementById('aiHints');
  if (!hints.length) {
    const p = AI_PROACTIVE[Math.floor(Math.random() * AI_PROACTIVE.length)];
    hints = [{t: AI_AGENTS[p.agent].ico + ' ' + p.text}];
  }
  el.innerHTML = hints.map(h => `<div class="aihint"><div class="hag">AI Совет</div>${h.t}</div>`).join('');
}

// Periodic AI proactive hints
setInterval(() => {
  if (!S.running) return;
  if (Math.random() > .3) return;
  const p = AI_PROACTIVE[aiMsgIdx % AI_PROACTIVE.length];
  aiMsgIdx++;
  if (S.activeTab === 'chat') addChatMsg(p.agent, p.text, false);
  addEvent('система', `[AI ${p.agent}] ${p.text}`);
}, 18000 / S.speed);

// ═══════════════════════════════════════════════════════
// PHASE 6 — SIMULATION LOOP
// ═══════════════════════════════════════════════════════
let simStartTime = Date.now();
let lastEvTime = 0;
const EV_INTERVAL = [2000, 5000];

function simLoop() {
  if (!S.running) { requestAnimationFrame(simLoop); return; }
  const now = Date.now();
  S.simTime = (now - simStartTime) / 1000;

  // sim clock
  const tm = Math.floor(S.simTime);
  document.getElementById('simTm').textContent =
    `${String(Math.floor(tm/60)).padStart(2,'0')}:${String(tm%60).padStart(2,'0')}`;

  // generate events
  const evInterval = (EV_INTERVAL[0] + Math.random()*(EV_INTERVAL[1]-EV_INTERVAL[0])) / S.speed;
  if (now - lastEvTime > evInterval) {
    genEvent();
    lastEvTime = now;
  }

  requestAnimationFrame(simLoop);
}

// ═══════════════════════════════════════════════════════
// PHASE 7 — DASHBOARD UPDATE
// ═══════════════════════════════════════════════════════
function updateKPIs() {
  document.getElementById('k-bud').textContent = (S.budget / 1e6).toFixed(1) + 'М ₽';
  document.getElementById('k-bud-d').textContent = S.budget < 20e6 ? '↓ Расходуется' : '↑ Бюджет выделен';
  document.getElementById('k-bud-d').className = 'kc-d ' + (S.budget < 20e6 ? 'dd' : 'du');

  // Limit bars
  const lb = document.getElementById('lBars');
  lb.innerHTML = BRANCHES.slice(1,6).map(b => {
    const pct = Math.min(100, Math.round(b.spent / b.limit * 100));
    const col = pct > 80 ? 'var(--red)' : pct > 50 ? 'var(--amber)' : 'var(--green)';
    return `<div class="lrow">
      <div class="lname">${b.name}</div>
      <div class="lbw"><div class="lb" style="width:${pct}%;background:${col}"></div></div>
      <div class="lpct">${pct}%</div>
    </div>`;
  }).join('');

  // Transport table
  const tt = document.getElementById('tTable');
  tt.innerHTML = `<div style="display:grid;grid-template-columns:1fr 60px 80px;gap:3px;font-size:10px;font-weight:700;color:var(--tx3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">
    <span>Организация</span><span style="text-align:right">Билетов</span><span style="text-align:right">Сумма</span></div>` +
    TRANSPORT.map(t => `<div style="display:grid;grid-template-columns:1fr 60px 80px;gap:3px;font-size:11.5px;padding:4px 0;border-bottom:1px solid var(--br);color:var(--tx2)">
      <span>🚂 ${t.name}</span>
      <span style="text-align:right;font-family:'PT Mono',monospace">${t.tickets}</span>
      <span style="text-align:right;font-family:'PT Mono',monospace">${(t.sum/1000).toFixed(0)}к ₽</span>
    </div>`).join('');

  // AI Recs
  const recs = document.getElementById('aiRecs');
  const msgs = [];
  BRANCHES.slice(1).forEach(b => {
    const p = b.spent/b.limit;
    if (p > .8) msgs.push({c:'var(--red)', t:`⚠ ${b.name}: лимит использован на ${Math.round(p*100)}%`});
  });
  if (S.queueLen > 5) msgs.push({c:'var(--amber)', t:`📋 В очереди ${S.queueLen} необработанных заявок`});
  if (msgs.length === 0) msgs.push({c:'var(--green)', t:'✓ Система работает в штатном режиме'});
  if (S.evoLevel > 2) msgs.push({c:'var(--purple)', t:`🧬 Уровень эволюции ${S.evoLevel}: сценарии усложняются`});
  recs.innerHTML = msgs.map(m => `<div style="font-size:11.5px;color:${m.c};padding:5px 0;border-bottom:1px solid var(--br)">${m.t}</div>`).join('');

  document.getElementById('errCnt').textContent = S.errors;
  document.getElementById('sessBadge').textContent = '#' + S.session;
  document.getElementById('evoLvl').textContent = S.evoLevel;
}
setInterval(updateKPIs, 2000);

