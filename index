  c('doc',DB.docs.length>8);c('cf',DB.cf.length>6);c('obj',DB.objects.length>12);
  c('graph',S.log.some(e=>e.type==='graph_analyze'));c('ai',S.log.some(e=>e.type==='ai_insights'));
