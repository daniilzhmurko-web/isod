        ${quizState.current < QUIZ_QUESTIONS.length - 1 ? 'Следующий вопрос <i class="fas fa-arrow-right"></i>' : 'Завершить тест <i class="fas fa-flag-checkered"></i>'}
      </button>
    </div>
  </div>`;
