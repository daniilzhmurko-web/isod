  dispatchP(id){
    const p=this.s.patrols.find(x=>x.id===id);if(!p)return;
    if(p.sta==='busy'){this.toast('w','Занят',p.cs+' уже обрабатывает происшествие.');return;}
    const freeKusp=this.s.kusp?this.s.kusp.filter(k=>k.status==='pending'):[];
    if(freeKusp.length){
      const k=freeKusp[0];p.sta='busy';p.inc=k.id;k.patrol=p.cs;k.status='inprogress';
      this.addEv(`<strong>Наряд ${p.cs}</strong> выслан на ${k.type} — ${k.addr}.`,'warning');
      this.toast('s','Наряд выслан',p.cs+' направлен на '+k.addr);
    }else{
      p.sta='busy';
      this.addEv(`<strong>Наряд ${p.cs}</strong> выслан по указанию ОД.`,'warning');
      this.toast('s','Наряд выслан',p.cs+' направлен.');
    }
    this.log('Наряд '+p.cs+' выслан');
    this.save();this.updBdg();
    setTimeout(()=>{p.sta='free';p.inc=null;this.addEv(`<strong>Наряд ${p.cs}</strong> завершил задачу, свободен.`,'success');this.save();this.updBdg();},120000);
    if(this.s.mod==='patr')this.go('patr');else if(this.s.mod==='dash')this.go('dash');
    this.valStep('patr');
  },

