function statusBadge(status,anomaly){
  if(anomaly==='dup_vin')return`<span class="badge b-orange">⚠️ Дубл. VIN</span>`;
  if(status==='В розыске')return`<span class="badge b-red">🚨 В розыске</span>`;
  if(status==='Угнан')return`<span class="badge b-red">🚨 Угнан</span>`;
  return`<span class="badge b-green">✅ Активен</span>`;
}

function searchVehicle(){
  const q=document.getElementById('v-srch').value.trim();
  const type=document.getElementById('v-stype').value;
  if(!q){notify('w','Введите данные для поиска','');return;}
  log(`Поиск ТС: ${q}`,'v_search');
  const c=document.getElementById('v-result');
  // Поиск
  let found=null;
  const qu=q.toUpperCase().replace(/\s/g,'');
  if(type==='plate')found=DB.vehicles.find(v=>v.plate.replace(/\s/g,'')=== qu);
  else if(type==='vin')found=DB.vehicles.find(v=>v.vin.includes(qu));
  else found=DB.vehicles.find(v=>v.owner.toUpperCase().includes(q.toUpperCase()));

  if(!found){
    c.innerHTML=`<div class="rcard"><div class="rhdr"><div style="font-family:var(--font);font-size:13px;font-weight:700">❌ Не найдено</div></div><div style="font-size:13px;color:var(--txt2)">ТС с указанными данными не найдено в базе.</div></div>`;
    advanceActiveQuest(false);
    return;
  }

  const isW=DB.wanted.find(w=>w.plate===found.plate&&w.active);
  const isDup=found.anomaly==='dup_vin';
  const cls=isW?'wanted':isDup?'fraud':'found';

  c.innerHTML=`<div class="rcard ${cls}">
    <div class="rhdr">
      <div style="font-family:var(--font);font-size:14px;font-weight:800">${found.plate}</div>
      ${statusBadge(found.status,found.anomaly)}
    </div>
    ${isW?`<div class="alrt ai-danger" style="margin-bottom:11px"><span>🚨</span><div><div class="alrt-title">ВНИМАНИЕ: ТС В РОЗЫСКЕ!</div><div class="alrt-text">Причина: ${isW.reason} | Дата: ${fmtDate(isW.date)}</div></div></div>`:''}
    ${isDup?`<div class="alrt ai-warn" style="margin-bottom:11px"><span>⚠️</span><div><div class="alrt-title">АНОМАЛИЯ: Дублирующийся VIN!</div><div class="alrt-text">VIN ${found.vin} уже числится за другим ТС в базе!</div></div></div>`:''}
    <div class="rgrid">
      <div class="rfield"><div class="rflbl">VIN</div><div class="rfval" style="font-size:11px">${found.vin}</div></div>
      <div class="rfield"><div class="rflbl">Марка / Модель</div><div class="rfval">${found.brand} ${found.model}</div></div>
      <div class="rfield"><div class="rflbl">Год / Цвет</div><div class="rfval">${found.year} / ${found.color}</div></div>
      <div class="rfield"><div class="rflbl">Владелец</div><div class="rfval">${found.owner}</div></div>
      <div class="rfield"><div class="rflbl">СТС</div><div class="rfval">${found.sts}</div></div>
      <div class="rfield"><div class="rflbl">Дата регистрации</div><div class="rfval">${fmtDate(found.regDate)}</div></div>
    </div>
    <div class="bgrp" style="margin-top:11px">
      ${isW?`<button class="btn btn-ok btn-sm" onclick="clearFromWanted('${found.plate}')">✅ Снять с розыска</button>`:''}
      ${isDup?`<button class="btn btn-d btn-sm" onclick="blockRecord(${found.id})">🚫 Заблокировать запись</button>`:''}
      <button class="btn btn-s btn-sm" onclick="addToWantedFromSearch('${found.plate}','${found.vin}')">🚨 Объявить розыск</button>
    </div>
  </div>`;

  if(isW||isDup)aMsg('sys',isW?`🚨 ВНИМАНИЕ! ТС ${found.plate} числится в розыске! Задержите транспортное средство!`:`⚠️ АНОМАЛИЯ! VIN ${found.vin} уже зарегистрирован на другое ТС. Подозрение на мошенничество!`,'sys');
  advanceActiveQuest(true);
  scorePopup('+10',true);S.score+=10;updateHeader();
}

function showVehicle(id){const v=DB.vehicles.find(x=>x.id===id);if(!v)return;document.getElementById('v-srch').value=v.plate;document.getElementById('v-stype').value='plate';searchVehicle();}

function clearFromWanted(plate){
  const w=DB.wanted.find(x=>x.plate===plate);
  if(w){w.active=false;notify('ok','Снято с розыска',plate);scorePopup('+50',true);S.score+=50;updateHeader();renderWantedTable();log(`Снят с розыска: ${plate}`,'v_dewant');}
}

function blockRecord(id){const v=DB.vehicles.find(x=>x.id===id);if(v){v.status='Заблокирован';v.anomaly=null;notify('ok','Запись заблокирована',v.plate);scorePopup('+80',true);S.score+=80;updateHeader();log(`Запись заблокирована: ${v.plate}`,'v_block');}}
function addToWantedFromSearch(plate,vin){document.getElementById('aw-plate').value=plate;document.getElementById('aw-vin').value=vin||'';openModal('m-wanted');}

function checkVIN(inp){
  const v=inp.value.toUpperCase();
  const err=document.getElementById('vin-err');
  const dup=DB.vehicles.find(x=>x.vin===v&&v.length===17);
  if(v.length<17){inp.className='finp';err.textContent=`VIN: ${v.length}/17 символов`;}
  else if(dup){inp.className='finp err';err.textContent=`⚠️ ДУБЛИКАТ VIN! Уже числится за ${dup.plate}`;aMsg('sys',`⚠️ Обнаружен дублирующийся VIN ${v}! Это может быть мошенничество.`,'sys');}
  else{inp.className='finp ok';err.textContent='✅ VIN уникален';}
}

function checkDocs(){
  const vin=document.getElementById('r-vin').value;
  const brand=document.getElementById('r-brand').value;
  const owner=document.getElementById('r-owner').value;
  const pass=document.getElementById('r-pass').value;
  const res=document.getElementById('reg-result');
  const errs=[];
  if(vin.length!==17)errs.push('VIN должен содержать 17 символов');
  if(!brand)errs.push('Укажите марку ТС');
  if(!owner)errs.push('Укажите владельца');
  if(!pass)errs.push('Укажите паспорт');
  if(errs.length){res.innerHTML=`<div class="alrt ai-danger"><span>❌</span><div><div class="alrt-title">Ошибки в документах</div><div class="alrt-text">${errs.join('<br>')}</div></div></div>`;advanceActiveQuest(false);}
  else{res.innerHTML=`<div class="alrt ai-ok"><span>✅</span><div><div class="alrt-title">Документы проверены</div><div class="alrt-text">Все данные корректны. Можно продолжить регистрацию.</div></div></div>`;advanceActiveQuest(true);scorePopup('+15',true);S.score+=15;updateHeader();}
  log('Проверка документов','check_docs');
}

function regVehicle(){
  const vin=document.getElementById('r-vin').value.trim();
  const brand=document.getElementById('r-brand').value;
  const model=document.getElementById('r-model').value.trim();
  const year=document.getElementById('r-year').value;
  const color=document.getElementById('r-color').value;
  const owner=document.getElementById('r-owner').value.trim();
  const pass=document.getElementById('r-pass').value.trim();
  const res=document.getElementById('reg-result');

  if(!vin||!brand||!model||!year||!owner||!pass){res.innerHTML=`<div class="alrt ai-danger"><span>❌</span><div><div class="alrt-title">Заполните все обязательные поля!</div></div></div>`;advanceActiveQuest(false);return;}
  if(vin.length!==17){res.innerHTML=`<div class="alrt ai-danger"><span>❌</span><div><div class="alrt-title">VIN должен содержать 17 символов!</div></div></div>`;return;}

  const dup=DB.vehicles.find(v=>v.vin===vin.toUpperCase());
  if(dup){res.innerHTML=`<div class="alrt ai-danger"><span>⚠️</span><div><div class="alrt-title">ОТКАЗ! Дублирующийся VIN!</div><div class="alrt-text">VIN уже числится за ТС ${dup.plate}. Регистрация запрещена.</div></div></div>`;aMsg('sys','🚨 Попытка регистрации с дублирующимся VIN! Запись заблокирована.','sys');advanceActiveQuest(false);return;}

  const newPlate=document.getElementById('r-plate').value.trim()||genPlate();
  const newV={id:DB.vehicles.length+1,plate:newPlate.toUpperCase(),vin:vin.toUpperCase(),brand,model,year:parseInt(year),color,type:document.getElementById('r-type').value,owner,passport:pass,sts:genSTS(),regDate:today(),status:'Активен',anomaly:null};
  DB.vehicles.push(newV);
  DB.vHistory.unshift({date:today(),plate:newPlate,action:'Первичная регистрация',op:S.user.name||'Оператор',result:'Выполнено'});

  res.innerHTML=`<div class="alrt ai-ok"><span>✅</span><div><div class="alrt-title">ТС успешно зарегистрировано!</div><div class="alrt-text">Гос. номер: <b>${newPlate}</b> | СТС: ${newV.sts}</div></div></div>`;
  scorePopup('+120',true);S.score+=120;S.acc.total++;S.acc.correct++;updateHeader();
  advanceActiveQuest(true);clearReg();renderVehiclesTable();
  log(`ТС зарегистрировано: ${newPlate}`,'v_reg',{plate:newPlate,vin});
  notify('ok','ТС зарегистрировано!',newPlate);
}

function clearReg(){['r-vin','r-plate','r-brand','r-model','r-year','r-color','r-type','r-owner','r-pass','r-docdate'].forEach(id=>{const el=document.getElementById(id);if(el)el.value='';});document.getElementById('reg-result').innerHTML='';document.getElementById('vin-err').textContent='';}

