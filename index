function performSign(docId){
  var hash='SHA256:'+Array.from({length:16},function(){return Math.floor(Math.random()*16).toString(16)}).join('')+'...';
  var order=State.orders.find(function(o){return o.number===docId||String(o.id)===String(docId)});
  if(order){order.signature=hash;order.status='signed';}
  var sched=State.staffingSchedules.find(function(s){return s.number===docId||String(s.id)===String(docId)});
  if(sched){sched.signature=hash;sched.status='signed';sched.signedDate=new Date().toISOString().slice(0,10);}
  State.flags.signedDoc=true;
  addAudit('Электронная подпись','Документ «'+docId+'» подписан ЭЦП. Хэш: '+hash);
  showNotif('🖊️ Документ успешно подписан электронной подписью!','success');
  openModule('signature');
}

