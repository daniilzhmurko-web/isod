function runAVScan() {
  document.getElementById('avScanProgress').style.display = 'block';
  document.getElementById('btnAVScan').disabled = true;
  let pct = 0;
  const files = ['C:\\Windows\\System32\\...','C:\\Users\\...','C:\\Program Files\\...','Реестр...','Память...'];
  let fi = 0;
  const iv = setInterval(() => {
    pct += Math.random() * 8 + 2;
    if (pct >= 100) { pct = 100; clearInterval(iv); finishScan(); }
    document.getElementById('avProgressBar').style.width = pct + '%';
    document.getElementById('avScanFile').textContent = 'Проверка: ' + files[fi % files.length];
    fi++;
  }, 200);
  
  function finishScan() {
    STATE.facts.avScanRun = true;
    document.getElementById('avScanResult').innerHTML = `
      <div class="badge badge-red" style="font-size:12px;padding:6px 10px">
        ⚠ Найдено 1 угроза. Требуется немедленная обработка.
      </div>`;
    document.getElementById('btnAVScan').disabled = false;
    addEvent('MALWARE', 'crit', 'Сканирование WS-07 завершено. Обнаружена 1 угроза.');
    showToast('Сканирование завершено', 'Обнаружена 1 угроза на WS-07', 'warning');
    checkStepValidation();
  }
}

