/* ============================================================
   ЭТАП 4/9 — VALIDATION ENGINE (Движок валидации)
   ============================================================ */

// Диспетчер действий пользователя
function dispatch(action, value) {
  const mission = MISSIONS[globalState.currentMission];
  if (!mission) return;
  const step = mission.steps[globalState.currentStep];
  if (!step) return;

  // Анти-чит: проверка времени
  const now = Date.now();
  const elapsed = now - globalState.lastActionTime;
  if (elapsed < 300 && action !== 'START' && action !== 'NEXT') {
    globalState.cheatScore++;
    if (globalState.cheatScore >= 3) {
      showCheatWarning();
      penalizeScore(5);
    }
  }
  globalState.lastActionTime = now;
  globalState.totalActions++;

  // Автозавершаемые шаги
  if (step.autoComplete) {
    completeCurrentStep();
    return;
  }

  // Сравнение действия с ожидаемым
  if (action === step.expectedAction) {
    // Дополнительная валидация для полей форм
    if (step.validate) {
      if (!step.validate(value)) {
        recordError(step.validateMsg || 'Проверьте введённые данные');
        return;
      }
    }
    globalState.correctActions++;
    completeCurrentStep(value);
  } else if (action !== 'HINT') {
    // Неверное действие
    recordError('Выполните текущий шаг инструкции');
    showCheatWarning();
  }
}

// Завершить текущий шаг
function completeCurrentStep(value) {
  const mission = MISSIONS[globalState.currentMission];
  const step = mission.steps[globalState.currentStep];
  const pts = step.points || 10;

  globalState.score += pts;
  globalState.stepCompleted = true;
  globalState.stepLocked = false;
  globalState.hintUsed = false;

  // Инициализировать completedSteps для текущей миссии
  if (!globalState.completedSteps[globalState.currentMission]) {
    globalState.completedSteps[globalState.currentMission] = new Set();
  }
  globalState.completedSteps[globalState.currentMission].add(globalState.currentStep);

  addLog('success', `Шаг выполнен: ${step.expectedAction}`);
  updateScoreDisplay();
  renderInstructions();
  showStepDone();
  showToast('Шаг выполнен! +' + pts + ' очков', 'success');
}

// Записать ошибку
function recordError(msg) {
  globalState.errorCount++;
  globalState.score = Math.max(0, globalState.score - 3);
  addLog('error', `Ошибка: ${msg}`);
  updateScoreDisplay();
  showToast(msg, 'error');
  renderInstructions();
  // Показать подсказку после 2 ошибок
  if (globalState.errorCount % 2 === 0) {
    showHint(true);
  }
}

// Подсветка целевого элемента
