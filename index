.action-flash.show{display:flex;animation:bannerDrop .35s ease forwards;}

/* ── Клавишная шпаргалка ── */
.kbd-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:5000;display:none;align-items:center;justify-content:center;}
.kbd-overlay.show{display:flex;}
.kbd-card{background:#fff;border-radius:14px;padding:28px 32px;max-width:480px;width:90%;}
.kbd-card h3{font-size:16px;font-weight:800;color:#0058A3;margin-bottom:18px;text-align:center;}
.kbd-list{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.kbd-item{display:flex;align-items:center;gap:10px;padding:8px 10px;background:#F8F9FA;border-radius:8px;font-size:12px;}
.kbd-key{background:#343A40;color:#fff;padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700;font-family:monospace;white-space:nowrap;}
.kbd-close{margin-top:18px;width:100%;background:#0058A3;color:#fff;padding:10px;border-radius:8px;font-size:13px;font-weight:700;border:none;cursor:pointer;}

/* ── Расширенная таблица результатов ── */
.score-breakdown{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px;}
.score-item{padding:14px 16px;background:#F8F9FA;border:1px solid #DEE2E6;border-radius:10px;}
.score-item__label{font-size:11px;color:#6C757D;text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px;}
.score-item__value{font-size:24px;font-weight:900;color:#0058A3;}
.score-item__sub{font-size:11px;color:#6C757D;margin-top:3px;}
.score-item.green .score-item__value{color:#1B7A3E;}
.score-item.red .score-item__value{color:#C0392B;}
.score-item.gold .score-item__value{color:#C8860A;}

/* ── Печатный отчёт ── */
@media print{
  body>*:not(#screen-result){display:none!important;}
  #screen-result{display:block!important;padding:0!important;}
  .result-card{box-shadow:none!important;border:1px solid #ccc!important;max-width:100%!important;}
  .result-footer,.sim-header,.sim-statusbar{display:none!important;}
  .result-body{padding:20px!important;}
  .print-header{display:block!important;}
}
.print-header{display:none;text-align:center;padding:16px 0 8px;border-bottom:2px solid #0058A3;margin-bottom:16px;}
.print-header h1{font-size:18px;font-weight:800;color:#0058A3;}
.print-header p{font-size:12px;color:#6C757D;margin-top:4px;}

/* ── Анимации ── */
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.fade-in{animation:fadeIn .35s ease forwards;}
@keyframes countUp{from{opacity:.4}to{opacity:1}}
.count-up{animation:countUp .6s ease;}

/* ── Мини-карта документа в карточке ── */
.doc-timeline{padding:10px 0;}
.doc-tl-item{display:flex;align-items:flex-start;gap:10px;padding:5px 0;}
.doc-tl-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;margin-top:3px;}
.doc-tl-dot.done{background:#1B7A3E;}
.doc-tl-dot.active{background:#0058A3;box-shadow:0 0 0 3px rgba(0,88,163,.2);}
.doc-tl-dot.wait{background:#CED4DA;}
.doc-tl-line{width:2px;background:#DEE2E6;margin-left:4px;height:16px;margin-top:-3px;margin-bottom:-3px;}
.doc-tl-text{font-size:12px;color:#343A40;font-weight:500;}
.doc-tl-date{font-size:11px;color:#6C757D;margin-top:2px;}
</style>

