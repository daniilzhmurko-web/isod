.sn-d{background:var(--success);color:#fff}.sn-c{background:var(--primary);color:#fff}.sn-p{background:var(--bdr);color:var(--tm)}
.mp-sl2{font-size:11.5px;color:var(--ts);line-height:1.35}.mp-si.cs .mp-sl2{color:var(--primary);font-weight:600}
.mp-ct{flex:1;padding:14px 16px;overflow-y:auto}
.mp-ct-t{font-size:13px;font-weight:700;color:var(--primary);margin-bottom:7px;display:flex;align-items:center;gap:7px}
.mp-ct-d{font-size:12.5px;color:var(--ts);line-height:1.6}
.mp-hn{margin-top:10px;padding:8px 11px;background:var(--info-bg);border-left:3px solid var(--info);border-radius:0 var(--r) var(--r) 0;font-size:11.5px;color:var(--info);display:flex;gap:7px;align-items:flex-start}
.mp-em{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:var(--tm);gap:8px}
.mp-em i{font-size:28px;opacity:.3}.mp-em span{font-size:12px}

/* ── КОМПОНЕНТЫ ── */
.card{background:var(--bg-card);border-radius:var(--rl);box-shadow:var(--sh-sm);border:1px solid var(--bdrl);overflow:hidden}
