// Nav dots scroll tracking
const sections = document.querySelectorAll('[data-sec]');
const dots = document.querySelectorAll('.nd[data-sec]');

function updateDots(){
  let current = 0;
  sections.forEach((s,i)=>{
    if(s.getBoundingClientRect().top < window.innerHeight*0.45) current = parseInt(s.dataset.sec)||0;
  });
  dots.forEach(d=>{
    d.classList.toggle('on', parseInt(d.dataset.sec)===current);
  });
}

window.addEventListener('scroll', updateDots, {passive:true});

function scrollToSec(n){
  const el = document.getElementById('sec'+n);
  if(el) el.scrollIntoView({behavior:'smooth', block:'start'});
}

// Animate sections on scroll
const obs = new IntersectionObserver((entries)=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.style.opacity='1';
      e.target.style.transform='translateY(0)';
    }
  });
},{threshold:0.08});

document.querySelectorAll('.sec').forEach(s=>{
  s.style.opacity='0';
  s.style.transform='translateY(18px)';
  s.style.transition='opacity .5s ease, transform .5s ease';
  obs.observe(s);
});
