        <p>${x.a.bd} г.р., урож. ${x.a.bc}</p>
        <p>${d.ic}</p>
        ${S.wo.si?`<div style="margin-top:12px;padding:8px;background:#dcfce7;border:1px solid #86efac;border-radius:4px;font-size:11px;color:#166534;font-weight:700">✍️ Электронная подпись верна. Сертификат: ${u?.tok}. Владелец: ${u?.nm}.</div>`:''}
