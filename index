  createFromCall(idx){
    const call=this.s.callQueue[idx];if(!call)return;
    const type=document.getElementById('cType')?document.getElementById('cType').value||call.subject:call.subject;
    const addr=document.getElementById('cAddr')?document.getElementById('cAddr').value:call.addr;
    const prio=document.getElementById('cPrio')?document.getElementById('cPrio').value:call.priority;
    const n=new Date(),t=n.toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'});
    const id='КУСП-'+n.getFullYear()+'-'+String(++this.s.kuspCnt).padStart(3,'0');
    const inc={id,type,addr,caller:call.caller,phone:call.phone,priority:prio,status:'pending',patrol:null,created:t,desc:call.subject};
    if(!this.s.kusp)this.s.kusp=[];
    this.s.kusp.push(inc);
    this.s.incs.push({t,type,addr,status:'pending'});
    this.s.callQueue.splice(idx,1);
