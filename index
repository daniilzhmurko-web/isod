/* ============================================================
   ЭТАП 7/9 (продолжение) — INSTRUCTIONS PANEL
   ============================================================ */

// Рендер инструкционной панели
function renderInstructions() {
  const mission = MISSIONS[globalState.currentMission];
  if (!mission) return;
  const totalSteps = mission.steps.length;
  const curStep = globalState.currentStep;
  const progress = totalSteps > 0 ? Math.round((curStep / totalSteps) * 100) : 0;

  document.getElementById('instMissionLabel').textContent = `МИССИЯ ${globalState.currentMission + 1} ИЗ ${MISSIONS.length}`;
  document.getElementById('instMissionTitle').textContent = mission.title;
  document.getElementById('instProgressFill').style.width = progress + '%';
  document.getElementById('instStepCounter').textContent = `Шаг ${Math.min(curStep + 1, totalSteps)} из ${totalSteps}`;
  document.getElementById('hdrMissionName').textContent = mission.title;

  // Рендер шагов
  const body = document.getElementById('instBody');
  let html = '';

  // Описание миссии
  html += `<div style="background:var(--bg-panel);border-radius:6px;padding:12px;margin-bottom:12px;font-size:12px;color:var(--text-muted);border-left:3px solid var(--primary)">
    <strong style="color:var(--primary);display:block;margin-bottom:4px"><i class="fas fa-flag"></i> ${mission.title}</strong>
    ${mission.desc}
  </div>`;

  mission.steps.forEach((step, idx) => {
    const isDone = globalState.completedSteps[globalState.currentMission]?.has(idx);
    const isActive = idx === curStep;
    const isPast = idx < curStep;

    let cls = 'step-block';
    if (isActive && !isDone) cls += ' active';
    if (isDone || isPast) cls += ' done';

    html += `<div class="${cls}" id="step-block-${idx}">
      <div class="step-number">ШАГ ${idx + 1}</div>
      <div class="step-instruction">${step.instruction}</div>
      <div class="step-status ${isDone||isPast?'done':isActive?'active':'pending'}">
        ${isDone||isPast ? '<i class="fas fa-check-circle"></i> Выполнено' : isActive ? '<i class="fas fa-circle-dot"></i> Текущий шаг' : '<i class="far fa-circle"></i> Ожидание'}
      </div>
      ${isActive ? `<div class="hint-box" id="hintBox-${idx}"><i class="fas fa-lightbulb"></i><span id="hintText-${idx}"></span></div>` : ''}
    </div>`;
  });

  // Кнопки миссии
  html += `<div style="margin-top:16px;text-align:center">
    <button class="btn btn-secondary btn-sm" onclick="replayMission(${globalState.currentMission})">
      <i class="fas fa-rotate-right"></i>Перепройти миссию
    </button>
  </div>`;

  body.innerHTML = html;

  // Обновить кнопки
  document.getElementById('btnPrev').disabled = globalState.currentMission === 0;
  const isMissionDone = curStep >= mission.steps.length;
  document.getElementById('btnNext').textContent = isMissionDone ? 'Следующая миссия' : 'Проверить';
  document.getElementById('btnNext').innerHTML = isMissionDone
    ? '<i class="fas fa-forward-step" style="margin-right:4px"></i>Следующая миссия'
    : 'Проверить <i class="fas fa-chevron-right" style="margin-left:4px"></i>';
}

// Показать подсказку
function showHint(auto = false) {
  const mission = MISSIONS[globalState.currentMission];
  const step = mission?.steps[globalState.currentStep];
  if (!step) return;

  const hints = step.hints || [];
  const hintIdx = Math.min(globalState.hintCount, hints.length - 1);
  const hint = hints[hintIdx] || 'Следуйте инструкциям в правой панели.';

  const box = document.getElementById(`hintBox-${globalState.currentStep}`);
  const txt = document.getElementById(`hintText-${globalState.currentStep}`);
  if (box && txt) {
    txt.textContent = hint;
    box.classList.add('visible');
  }

  if (!auto) {
    globalState.hintCount++;
    globalState.score = Math.max(0, globalState.score - 2);
    updateScoreDisplay();
  }
  addLog('warn', `Использована подсказка: ${hint}`);
}

// Показать анимацию выполненного шага
function showStepDone() {
  const badge = document.getElementById('stepDoneBadge');
  badge.style.display = 'inline-flex';
  setTimeout(() => { badge.style.display = 'none'; }, 2000);
}

// Следующий шаг / миссия
function nextMission() {
  const mission = MISSIONS[globalState.currentMission];
  const stepsDone = globalState.currentStep >= mission.steps.length;

  if (stepsDone) {
    // Завершить миссию и перейти к следующей
    if (!globalState.completedMissions.includes(globalState.currentMission)) {
      globalState.completedMissions.push(globalState.currentMission);
    }
    if (globalState.currentMission < MISSIONS.length - 1) {
      globalState.currentMission++;
      globalState.currentStep = 0;
      globalState.hintCount = 0;
      globalState.stepCompleted = false;
      renderMissionList();
      renderInstructions();
      navigate('dashboard');
      showToast(`Миссия завершена! Начинается миссия ${globalState.currentMission + 1}`, 'success');
      addAISystemMsg(`🎉 Миссия "${MISSIONS[globalState.currentMission - 1].title}" завершена! Следующая: "${MISSIONS[globalState.currentMission].title}"`);
    } else {
      // Все миссии завершены
      showFinalResults();
    }
    return;
  }

  // Перейти к следующему шагу если текущий выполнен
  if (globalState.stepCompleted) {
    globalState.currentStep++;
    globalState.stepCompleted = false;
    globalState.hintCount = 0;
    renderInstructions();
    scrollToStep(globalState.currentStep);
  } else {
    // Попытка пропустить шаг
    const step = mission.steps[globalState.currentStep];
    if (step.autoComplete) {
      completeCurrentStep();
      globalState.currentStep++;
      renderInstructions();
    } else {
      showToast('Выполните текущий шаг перед переходом', 'warning');
      // Подсветить нужный элемент
      const actionMap = {
        'navigate_persons': 'nav-persons', 'navigate_weapons': 'nav-weapons',
        'navigate_applications': 'nav-applications', 'navigate_licenses': 'nav-licenses',
        'navigate_inspections': 'nav-inspections', 'navigate_interdept': 'nav-interdept',
        'navigate_dashboard': 'nav-dashboard', 'navigate_logs': 'nav-logs',
        'click_add_person': 'btnAddPerson', 'click_add_weapon': 'btnAddWeapon',
        'click_add_application': 'btnAddApp', 'click_add_license': 'btnAddLicense',
        'click_add_inspection': 'btnAddInspection', 'click_add_interdept': 'btnAddInterdept',
        'save_person': 'btnSavePerson',
      };
      const targetId = actionMap[step.expectedAction];
      if (targetId) highlightElement(targetId);
    }
  }
}

function prevMission() {
  if (globalState.currentMission > 0) {
    globalState.currentMission--;
    globalState.currentStep = 0;
    globalState.stepCompleted = false;
    renderMissionList();
    renderInstructions();
    navigate('dashboard');
  }
}

function replayMission(idx) {
  globalState.currentMission = idx;
  globalState.currentStep = 0;
  globalState.stepCompleted = false;
  globalState.hintCount = 0;
  if (globalState.completedSteps[idx]) {
    delete globalState.completedSteps[idx];
  }
  renderMissionList();
  renderInstructions();
  showToast('Миссия сброшена. Начните заново.', 'info');
}

function scrollToStep(idx) {
  const el = document.getElementById(`step-block-${idx}`);
  if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

// Рендер списка миссий в сайдбаре
function renderMissionList() {
  const list = document.getElementById('missionList');
  list.innerHTML = MISSIONS.map((m, i) => {
    const done = globalState.completedMissions.includes(i);
    const active = i === globalState.currentMission;
    return `<div class="mission-item ${done?'done':active?'active':''}" onclick="if(${i}<=${globalState.currentMission}||${done}){globalState.currentMission=${i};globalState.currentStep=0;globalState.stepCompleted=false;renderMissionList();renderInstructions();navigate('dashboard');}">
      <div class="mission-num">${done ? '<i class="fas fa-check" style="font-size:8px"></i>' : i+1}</div>
      <div style="font-size:11px;line-height:1.3">${m.title}</div>
    </div>`;
  }).join('');
}

/* ============================================================
   ЭТАП 8/9 — ASSESSMENT & ANTI-CHEAT
   ============================================================ */

function getAccuracy() {
  if (globalState.totalActions === 0) return 100;
  return Math.round((globalState.correctActions / globalState.totalActions) * 100);
}

function updateScoreDisplay() {
  document.getElementById('scoreDisplay').textContent = globalState.score;
  document.getElementById('accuracyDisplay').textContent = getAccuracy() + '%';
  document.getElementById('errorsDisplay').textContent = globalState.errorCount;
}

function showCheatWarning() {
  const warn = document.getElementById('cheatWarn');
  warn.style.display = 'block';
  setTimeout(() => { warn.style.display = 'none'; }, 2500);
}

function penalizeScore(pts) {
  globalState.score = Math.max(0, globalState.score - pts);
  updateScoreDisplay();
}

function updateBadges() {
  document.getElementById('badge-persons').textContent = globalState.persons.length;
  document.getElementById('badge-weapons').textContent = globalState.weapons.length;
  document.getElementById('badge-applications').textContent = globalState.applications.length;
  document.getElementById('badge-licenses').textContent = globalState.licenses.length;
  document.getElementById('badge-inspections').textContent = globalState.inspections.length;
  document.getElementById('badge-orgs').textContent = globalState.orgs.length;
}

function showFinalResults() {
  const acc = getAccuracy();
  let grade, icon, color;
  if (acc >= 90) { grade = 'Отлично (5)'; icon = '🏆'; color = 'var(--gold)'; }
