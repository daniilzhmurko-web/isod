const AC={
  MIN:400,
  record(e){
    const now=e.ts,last=S.ac.lastT;
    if(last>0){const d=now-last;S.ac.times.push(d);if(d<this.MIN)this.flag('TOO_FAST',d+'мс');}
    S.ac.lastT=now;this.analyze();
  },
  flag(type,reason){
    S.ac.flags.push({type,reason,t:new Date().toLocaleTimeString()});
    S.ac.risk+=type==='TOO_FAST'?8:20;this.updateUI();
    if(S.ac.risk>60&&S.ac.flags.filter(f=>f.type==='BRUTEFORCE').length<2)
      aMsg('exam','🛡️ АНТИЧИТ: Обнаружено аномальное поведение. Риск: '+S.ac.risk,'sys');
  },
  analyze(){
    const ts=S.ac.times.slice(-8);
    if(ts.length>=5&&ts.every(t=>t<700)&&!S.ac.flags.find(f=>f.type==='BRUTEFORCE'))
      this.flag('BRUTEFORCE','Серия быстрых действий');
    this.updateUI();
  },
  updateUI(){
    const r=S.ac.risk;
    const dot=document.getElementById('acdot'),txt=document.getElementById('actxt');
    if(r>60){dot.className='acdot danger';txt.textContent=`🚨 Риск: ${r}`;}
    else if(r>25){dot.className='acdot warn';txt.textContent=`⚠️ Флаги: ${S.ac.flags.length}`;}
    else{dot.className='acdot';txt.textContent='Мониторинг активен';}
  }
};

