function agentReply(agent,q){
  const ql=q.toLowerCase();
  if(agent==='instr'){
    if(ql.includes('докладн')||ql.includes('запис'))return rnd(AI_R.instr.docs);
    if(ql.includes('объект')||ql.includes('заинтер'))return rnd(AI_R.instr.obj);
    if(ql.includes('купюр')||ql.includes('фальш'))return rnd(AI_R.instr.cf);
    if(ql.includes('фрод')||ql.includes('корпор')||ql.includes('офшор'))return rnd(AI_R.instr.fraud);
    return rnd(AI_R.instr.gen);
  }
  if(agent==='analyst'){
    const n=ri(3,14),r=S.riskIndex,p=ri(60,95),m=ri(5,200);
    if(ql.includes('аномал')||ql.includes('подозр'))return rnd(AI_R.analyst.anomaly).replace('${n}',n);
    if(ql.includes('риск'))return rnd(AI_R.analyst.risk).replace('${r}',r).replace('${n}',n);
    return rnd(AI_R.analyst.pred).replace('${p}',p).replace('${n}',n).replace('${m}',m);
  }
  return rnd(AI_R.adversary);
}

