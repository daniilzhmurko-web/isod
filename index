  --text:      #1A1A2E;
  --text2:     #5A6A7E;
  --muted:     #8A9AB0;
  --border:    #DDE3EE;
  --shadow:    0 2px 12px rgba(0,63,138,.10);
  --shadow-l:  0 8px 32px rgba(0,63,138,.15);
  /* квест-панель */
  --qbg:       #0D1117;
  --qbrd:      #30363D;
  --qtxt:      #C9D1D9;
  --qacc:      #58A6FF;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;
  background:var(--bg);color:var(--text);overflow:hidden}

/* =====================================================
   ЭТАП 2 — ЭКРАН ЗАГРУЗКИ
   ===================================================== */
#boot{position:fixed;inset:0;background:#003F8A;display:flex;flex-direction:column;
  align-items:center;justify-content:center;z-index:9999;color:#fff}
.boot-logo{margin-bottom:28px;text-align:center}
.boot-logo svg{display:block;margin:0 auto 14px;animation:pulse 2s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.75;transform:scale(.97)}}
.boot-h{font-size:21px;font-weight:700;letter-spacing:2px;text-transform:uppercase}
.boot-sub{font-size:12px;opacity:.65;margin-top:4px;letter-spacing:.5px;max-width:480px;text-align:center;line-height:1.5}
.boot-term{width:580px;max-width:92vw;background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.18);
  border-radius:8px;padding:16px;font-family:'Courier New',monospace;font-size:12px;
  height:168px;overflow:hidden;margin:28px 0 18px}
.boot-line{color:#7EE8A2;line-height:1.75;opacity:0;animation:la .3s ease forwards}
@keyframes la{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:none}}
.boot-bar{width:580px;max-width:92vw;height:4px;background:rgba(255,255,255,.18);border-radius:2px;overflow:hidden}
.boot-fill{height:100%;background:#7EE8A2;border-radius:2px;width:0%;transition:width .4s ease}

/* =====================================================
   ЭТАП 3 — ЭКРАН ВХОДА
   ===================================================== */
#login{position:fixed;inset:0;background:linear-gradient(135deg,#003F8A 0%,#1A56A0 55%,#2D7DD2 100%);
  display:none;align-items:center;justify-content:center;z-index:9000;flex-direction:column;gap:16px}
.login-card{background:#fff;border-radius:16px;padding:44px 38px;width:460px;max-width:92vw;
  box-shadow:0 24px 64px rgba(0,0,0,.22)}
.lc-logo{text-align:center;margin-bottom:28px}
.lc-icon{width:68px;height:68px;background:#003F8A;border-radius:50%;display:flex;
  align-items:center;justify-content:center;margin:0 auto 14px;font-size:28px;color:#fff}
.lc-title{font-size:19px;font-weight:700;color:#003F8A;line-height:1.3}
.lc-sys{font-size:12px;color:var(--text2);margin-top:3px}
.lc-div{height:1px;background:var(--border);margin:20px 0}
.fg{margin-bottom:14px}
.fl{display:block;font-size:11px;font-weight:700;color:var(--text2);
  margin-bottom:5px;text-transform:uppercase;letter-spacing:.5px}
.fi,.fs{width:100%;padding:11px 14px;border:2px solid var(--border);border-radius:8px;
  font-size:13px;font-family:inherit;color:var(--text);background:#F8FAFC;
  transition:border-color .2s,box-shadow .2s;outline:none}
.fi:focus,.fs:focus{border-color:#003F8A;box-shadow:0 0 0 3px rgba(0,63,138,.1);background:#fff}
.btn-primary{width:100%;padding:13px 22px;background:#003F8A;color:#fff;border:none;
  border-radius:8px;font-size:14px;font-weight:600;font-family:inherit;cursor:pointer;
  transition:all .2s;margin-top:6px;letter-spacing:.3px}
.btn-primary:hover{background:#1A56A0;transform:translateY(-1px);box-shadow:0 4px 16px rgba(0,63,138,.3)}
.lc-warn{text-align:center;margin-top:18px;font-size:11px;color:var(--muted)}
/* Подсказка на логин */
.login-quest{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);
  border-radius:10px;padding:14px 20px;width:460px;max-width:92vw;color:#fff;font-size:13px}
.lq-label{font-size:10px;font-weight:700;letter-spacing:1px;color:#7EE8A2;text-transform:uppercase;margin-bottom:6px}

/* =====================================================
   ЭТАП 4 — ВОРКСПЕЙС: ЛЕЙАУТ
   ===================================================== */
#ws{display:none;height:100vh;flex-direction:column}
/* Топ-бар */
#topbar{height:58px;background:#fff;border-bottom:1px solid var(--border);
  display:flex;align-items:center;padding:0 18px;gap:14px;
  box-shadow:var(--shadow);z-index:200;flex-shrink:0}
.tb-logo{display:flex;align-items:center;gap:9px}
.tb-logo-ic{width:34px;height:34px;background:#003F8A;border-radius:7px;
  display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px}
.tb-logo-t{font-size:13px;font-weight:700;color:#003F8A;line-height:1.2}
.tb-logo-s{font-size:10px;color:var(--muted)}
.tb-sp{flex:1}
.tb-clock{font-size:12px;color:var(--muted);font-family:'Courier New',monospace}
.tb-item{display:flex;align-items:center;gap:7px;padding:5px 11px;border-radius:7px;
  cursor:pointer;transition:background .2s;font-size:12px;color:var(--text2);position:relative}
.tb-item:hover{background:var(--bg)}
.rbadge{padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;
  letter-spacing:.3px;color:#fff;white-space:nowrap}
.rb-external{background:#2D7DD2}
.rb-operator{background:#1E8449}
.rb-territorial{background:#16A085}
.rb-foiv{background:#D35400}
.rb-sysadmin{background:#7D3C98}
.rb-security{background:#C0392B}
.notif-dot{position:absolute;top:2px;right:2px;width:15px;height:15px;background:#E74C3C;
  color:#fff;border-radius:50%;font-size:9px;display:flex;align-items:center;justify-content:center;font-weight:700}
.uavatar{width:30px;height:30px;background:#003F8A;border-radius:50%;display:flex;
  align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:700}
/* Main */
#main{display:flex;flex:1;overflow:hidden}
/* Sidebar */
#sidebar{width:234px;background:var(--sidebar);display:flex;flex-direction:column;
  flex-shrink:0;overflow-y:auto}
.sb-sec{padding:18px 14px 6px;font-size:10px;font-weight:700;
  color:rgba(255,255,255,.38);text-transform:uppercase;letter-spacing:1px}
.sb-item{display:flex;align-items:center;gap:9px;padding:10px 14px;
  color:rgba(255,255,255,.68);cursor:pointer;transition:all .2s;
  font-size:13px;border-left:3px solid transparent}
.sb-item:hover{background:rgba(255,255,255,.09);color:#fff}
.sb-item.active{background:rgba(255,255,255,.14);color:#fff;
  border-left-color:#7EE8A2;font-weight:600}
.sb-item i{width:16px;text-align:center;font-size:13px}
.sb-badge{margin-left:auto;background:#E74C3C;color:#fff;padding:2px 6px;
  border-radius:9px;font-size:9px;font-weight:700}
.sb-bot{margin-top:auto;padding:14px;border-top:1px solid rgba(255,255,255,.1)}
/* Content */
#content{flex:1;overflow-y:auto;padding:22px;padding-bottom:210px}
/* Scrollbars */
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:#b0b8c8}

/* =====================================================
   ЭТАП 5 — КОМПОНЕНТЫ ВОРКСПЕЙСА
   ===================================================== */
.breadcrumb{font-size:11px;color:var(--muted);margin-bottom:14px;
  display:flex;align-items:center;gap:5px}
.breadcrumb .sep{color:var(--border)}
.breadcrumb .cur{color:#003F8A;font-weight:600}
.sec-hdr{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:18px}
.sec-title{font-size:21px;font-weight:700;color:var(--text)}
.sec-sub{font-size:12px;color:var(--muted);margin-top:2px}
.card{background:#fff;border-radius:12px;box-shadow:var(--shadow);margin-bottom:18px;overflow:hidden}
.card-hdr{padding:14px 18px;border-bottom:1px solid #EEF3F9;display:flex;align-items:center;gap:9px}
.card-title{font-size:14px;font-weight:600;color:var(--text)}
.card-body{padding:18px}
/* Кнопки */
.btn{padding:8px 16px;border-radius:8px;border:none;cursor:pointer;font-size:12px;
  font-weight:600;font-family:inherit;transition:all .2s;
  display:inline-flex;align-items:center;gap:5px}
.btn-sm{padding:6px 11px;font-size:11px}
.btn-blue{background:#003F8A;color:#fff}
.btn-blue:hover{background:#1A56A0;transform:translateY(-1px)}
.btn-blue:disabled{background:#AAB4C5;cursor:not-allowed;transform:none}
.btn-out{background:transparent;border:2px solid var(--border);color:var(--text2)}
.btn-out:hover{border-color:#003F8A;color:#003F8A}
.btn-out:disabled{opacity:.5;cursor:not-allowed}
.btn-green{background:#1E8449;color:#fff}
.btn-green:hover{background:#1a7040}
.btn-orange{background:#D35400;color:#fff}
.btn-orange:hover{background:#b84a00}
.btn-red{background:#C0392B;color:#fff}
.btn-red:hover{background:#a93226}
/* Формы */
.form-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.fg2{margin-bottom:12px}
.fl2{display:block;font-size:11px;font-weight:700;color:var(--text2);
  margin-bottom:4px;text-transform:uppercase;letter-spacing:.4px}
.fi2,.fs2{width:100%;padding:9px 12px;border:2px solid var(--border);border-radius:7px;
  font-size:13px;font-family:inherit;color:var(--text);background:#F8FAFC;
  transition:border-color .2s,box-shadow .2s;outline:none}
.fi2:focus,.fs2:focus{border-color:#003F8A;box-shadow:0 0 0 3px rgba(0,63,138,.1);background:#fff}
/* Таблица */
.dtbl{width:100%;border-collapse:collapse}
.dtbl th{padding:9px 13px;text-align:left;font-size:10px;font-weight:700;color:var(--muted);
  text-transform:uppercase;letter-spacing:.4px;background:#F8FAFC;border-bottom:2px solid var(--border)}
.dtbl td{padding:11px 13px;font-size:12px;border-bottom:1px solid #F0F4F8;color:var(--text)}
.dtbl tr:hover td{background:#EEF3F9;cursor:pointer}
.dtbl tr.sel td{background:#E8F0FE}
/* Бейджи статусов */
.badge{padding:3px 9px;border-radius:11px;font-size:10px;font-weight:700;display:inline-block}
.b-active{background:var(--green-bg);color:var(--green)}
.b-pending{background:var(--orange-bg);color:var(--orange)}
.b-confirmed{background:var(--blue-bg);color:#1A5276}
.b-rejected{background:var(--red-bg);color:var(--red)}
.b-criminal{background:var(--red-bg);color:var(--red)}
.b-civil{background:var(--blue-bg);color:#1A5276}
.b-migration{background:var(--orange-bg);color:var(--orange)}
/* Поле карточки */
.dkf-row{margin-bottom:12px}
.dkf-lbl{font-size:10px;font-weight:700;color:var(--muted);
  text-transform:uppercase;letter-spacing:.4px;margin-bottom:3px}
.dkf-val{font-size:13px;color:var(--text);padding:7px 11px;
  background:#F8FAFC;border-radius:6px;border:1px solid var(--border)}
/* Отпечатки */
.fp-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-top:10px}
.fp-slot{aspect-ratio:3/4;background:#F8FAFC;border:2px solid var(--border);border-radius:7px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  font-size:9px;color:var(--muted);overflow:hidden;position:relative}
.fp-slot.ok{border-color:#003F8A;background:#EBF5FB}
.fp-slot.ok::after{content:'';position:absolute;width:55%;height:65%;
  background:repeating-linear-gradient(45deg,transparent,transparent 2px,rgba(0,63,138,.12) 2px,rgba(0,63,138,.12) 4px);
  border-radius:50% 50% 50% 50%/40% 40% 60% 60%}
/* Статы */
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}
.stat-card{background:#fff;border-radius:12px;padding:18px;box-shadow:var(--shadow);
  border-left:4px solid var(--accent)}
.stat-v{font-size:26px;font-weight:700;color:var(--accent);line-height:1}
.stat-l{font-size:11px;color:var(--muted);margin-top:3px;font-weight:700;text-transform:uppercase}
.stat-d{font-size:11px;color:var(--green);margin-top:7px}
/* Bar chart */
.bar-wrap{display:flex;gap:10px;align-items:flex-end;height:150px;padding:0 6px}
.bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;
  height:100%;justify-content:flex-end}
.bar-fill{width:100%;border-radius:5px 5px 0 0;min-height:4px;transition:height .5s ease}
.bar-lbl{font-size:10px;color:var(--muted);text-align:center}
.bar-val{font-size:10px;font-weight:700;color:var(--accent)}
/* Tabs */
.tabs{display:flex;gap:2px;background:#EEF3F9;border-radius:8px;
  padding:3px;margin-bottom:16px;width:fit-content}
.tab{padding:7px 14px;border-radius:6px;cursor:pointer;font-size:11px;
  font-weight:600;color:var(--muted);transition:all .2s}
.tab.on{background:#fff;color:#003F8A;box-shadow:0 1px 4px rgba(0,0,0,.1)}
/* Лог */
.log-row{display:flex;gap:10px;align-items:flex-start;padding:9px 16px;
  border-bottom:1px solid #F0F4F8;font-size:12px}
.log-t{color:var(--muted);font-family:'Courier New',monospace;flex-shrink:0;width:75px}
.log-type{padding:1px 6px;border-radius:4px;font-size:9px;font-weight:700;
  white-space:nowrap;flex-shrink:0;margin-top:1px}
.log-a{flex:1;color:var(--text)}
.log-u{font-weight:600;color:#003F8A}
/* Activity */
.act-item{display:flex;gap:10px;padding:11px 0;border-bottom:1px solid #F0F4F8;font-size:12px}
.act-dot{width:7px;height:7px;border-radius:50%;margin-top:4px;flex-shrink:0}
/* Spinner */
.spinner{width:28px;height:28px;border:3px solid var(--border);
  border-top-color:#003F8A;border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
/* Empty state */
.empty{text-align:center;padding:44px 20px;color:var(--muted)}
.empty i{font-size:44px;margin-bottom:14px;opacity:.25;display:block}
/* Dash grid */
.dash-grid{display:grid;grid-template-columns:2fr 1fr;gap:18px}
.sys-row{display:flex;justify-content:space-between;align-items:center;
  font-size:13px;padding:8px 0;border-bottom:1px solid #F0F4F8}
.online{color:var(--green);font-weight:700;font-size:12px}

/* =====================================================
   ЭТАП 6 — МОДАЛЬНЫЕ ОКНА
   ===================================================== */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;
  display:none;align-items:center;justify-content:center}
.overlay.on{display:flex}
.modal{background:#fff;border-radius:14px;padding:30px;width:540px;
  max-width:94vw;max-height:92vh;overflow-y:auto;box-shadow:0 24px 64px rgba(0,0,0,.22)}
.modal-title{font-size:19px;font-weight:700;margin-bottom:6px;color:var(--text)}
.modal-sub{font-size:12px;color:var(--muted);margin-bottom:20px}
/* Role switcher dropdown */
.rs-drop{position:fixed;top:68px;right:120px;background:#fff;border-radius:11px;
  box-shadow:0 8px 32px rgba(0,0,0,.16);border:1px solid var(--border);
  z-index:600;padding:7px;min-width:270px;display:none}
.rs-drop.on{display:block}
.rs-opt{padding:10px 12px;border-radius:7px;cursor:pointer;
  display:flex;align-items:center;gap:10px;transition:background .2s}
.rs-opt:hover{background:var(--bg)}
.rs-opt.cur{background:#EBF5FB}
.rs-icon{width:34px;height:34px;border-radius:7px;display:flex;
  align-items:center;justify-content:center;color:#fff;font-size:13px}
.rs-name{font-size:12px;font-weight:600;color:var(--text)}
.rs-desc{font-size:10px;color:var(--muted)}

/* =====================================================
   ЭТАП 7 — TOASTS И УВЕДОМЛЕНИЯ
   ===================================================== */
#toasts{position:fixed;top:74px;right:18px;z-index:8000;
  display:flex;flex-direction:column;gap:7px}
.toast{background:#fff;border-radius:9px;padding:12px 16px;
  box-shadow:0 4px 20px rgba(0,0,0,.14);min-width:290px;max-width:380px;
  display:flex;align-items:flex-start;gap:10px;animation:tsin .3s ease;border-left:4px solid #1E8449}
.toast.err{border-left-color:#C0392B}
.toast.warn{border-left-color:#D35400}
.toast.info{border-left-color:#003F8A}
@keyframes tsin{from{transform:translateX(110%);opacity:0}to{transform:none;opacity:1}}
.t-icon{font-size:16px;margin-top:1px}
.t-title{font-size:12px;font-weight:700;color:var(--text)}
.t-msg{font-size:11px;color:var(--text2);margin-top:2px}

/* =====================================================
   ЭТАП 8 — КВЕСТ-ПАНЕЛЬ (Cisco PT style)
   ===================================================== */
#qpanel{position:fixed;bottom:0;left:0;right:0;background:var(--qbg);
  border-top:2px solid var(--qbrd);z-index:700}
.qp-head{display:flex;align-items:center;gap:11px;padding:9px 18px;
  border-bottom:1px solid #21262D;cursor:pointer;user-select:none}
.qp-title{font-size:11px;font-weight:700;color:var(--qacc);
  text-transform:uppercase;letter-spacing:1px;white-space:nowrap}
.qp-prog{flex:1;height:5px;background:#21262D;border-radius:3px;overflow:hidden}
.qp-prog-fill{height:100%;background:linear-gradient(90deg,#58A6FF,#7EE8A2);
  border-radius:3px;transition:width .6s ease;width:0%}
.qp-stats{display:flex;gap:14px;align-items:center;flex-shrink:0}
.qp-stat{font-size:10px;color:#8B949E;display:flex;align-items:center;gap:3px}
.qp-stat .v{color:#F0F6FC;font-weight:700}
.qp-xp{background:#161B22;border:1px solid var(--qbrd);border-radius:20px;
  padding:2px 9px;font-size:10px;color:#E3B341;font-weight:700}
.qp-body{padding:13px 18px;display:flex;gap:22px}
.qp-info{flex:1}
.qp-step-title{font-size:14px;font-weight:700;color:#F0F6FC;margin-bottom:5px}
.qp-desc{font-size:12px;color:#8B949E;line-height:1.55}
.qp-obj{margin-top:9px;padding:9px 13px;background:#161B22;
  border:1px solid var(--qbrd);border-left:3px solid var(--qacc);
  border-radius:5px;font-size:11px;color:var(--qtxt)}
.qp-obj-lbl{font-size:9px;font-weight:700;color:var(--qacc);
  text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px}
.qp-hint{background:#161B22;border:1px solid #E3B341;border-radius:5px;
  padding:9px 13px;margin-top:7px;font-size:11px;color:#E3B341;display:none}
.qp-ctrl{display:flex;flex-direction:column;gap:7px;min-width:190px}
.qst{padding:7px 14px;border-radius:6px;font-size:11px;font-weight:700;text-align:center}
.qst-wait{background:rgba(88,166,255,.12);color:#58A6FF;border:1px solid rgba(88,166,255,.3)}
.qst-ok{background:rgba(126,232,162,.12);color:#7EE8A2;border:1px solid rgba(126,232,162,.3);
  animation:blink 1s ease infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.55}}
.qbtn{padding:7px 14px;border-radius:5px;border:none;cursor:pointer;
  font-size:11px;font-weight:600;font-family:inherit;transition:all .2s}
.qbtn-hint{background:#21262D;color:#E3B341;border:1px solid var(--qbrd)}
.qbtn-hint:hover{background:#2D333B}
.qbtn-tog{background:#21262D;color:#8B949E;border:1px solid var(--qbrd)}

/* =====================================================
   ЭТАП 9 — МИССИЯ ВЫПОЛНЕНА и АНИМАЦИИ
   ===================================================== */
#mscreen{position:fixed;inset:0;background:rgba(0,0,0,.82);z-index:9100;
  display:none;align-items:center;justify-content:center}
.mc-card{background:#fff;border-radius:18px;padding:44px;text-align:center;
  max-width:480px;width:92vw;animation:mpop .5s cubic-bezier(.34,1.56,.64,1)}
@keyframes mpop{from{transform:scale(.5);opacity:0}to{transform:scale(1);opacity:1}}
.mc-icon{font-size:76px;margin-bottom:18px}
.mc-title{font-size:26px;font-weight:700;color:#003F8A;margin-bottom:6px}
.mc-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:22px 0}
.mc-stat{background:#F8FAFC;border-radius:9px;padding:14px}
.mc-sv{font-size:22px;font-weight:700;color:#003F8A}
.mc-sl{font-size:10px;color:var(--muted);margin-top:3px}
.mc-rank-box{background:#F8FAFC;border-radius:9px;padding:14px;margin-bottom:22px}
.mc-rank{font-size:20px;font-weight:700;color:#003F8A}

/* Подсветка квест-цели */
.qglow{animation:qg 1.2s ease-in-out infinite !important;border-radius:8px}
@keyframes qg{
  0%,100%{box-shadow:0 0 0 2px rgba(0,63,138,.9),0 0 0 4px rgba(0,63,138,.3)}
  50%{box-shadow:0 0 0 4px rgba(0,63,138,.5),0 0 0 10px rgba(0,63,138,.08)}}
