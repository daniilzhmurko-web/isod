.notif{position:fixed;top:68px;right:18px;background:var(--surface);border:1px solid var(--br);border-radius:var(--r);padding:11px 15px;box-shadow:0 8px 30px rgba(15,30,48,.15);font-size:12.5px;z-index:1000;min-width:240px;animation:fuR .3s;border-left:4px solid var(--pm);max-width:320px}
