let crisisScenarioIdx=0;
function triggerCrisis(){
  if(S.crisisActive){notify('w','Кризис уже активен!','');return;}
  S.crisisActive=true;
  const sc=CRISIS_SCENARIOS[crisisScenarioIdx%CRISIS_SCENARIOS.length];
  crisisScenarioIdx++;
  S.crisisTasks=sc.tasks.map((t,i)=>({...t,id:i,done:false,sel:false}));
  S.crisisLeft=300;
  document.getElementById('crisispanel').style.display='block';
  document.getElementById('ctimer').style.display='block';
  renderCrisisTasks();
  S.crisisTimer=setInterval(()=>{
    S.crisisLeft--;
    const m=Math.floor(S.crisisLeft/60),ss=String(S.crisisLeft%60).padStart(2,'0');
    const ts=`${String(m).padStart(2,'0')}:${ss}`;
    document.getElementById('ccnt').textContent=ts;
    document.getElementById('ctime').textContent=ts;
    if(S.crisisLeft<=0)endCrisis();
    if(S.crisisLeft<=60)document.getElementById('ccnt').style.color='#ff6b6b';
  },1000);
  aMsg('sys',`🚨 КРИЗИСНЫЙ РЕЖИМ!\n${sc.title}\nВыполните все задания до истечения таймера!`,'sys');
  aMsg('instr',`⚡ Кризис! ${Math.floor(S.crisisLeft/60)} минуты. Приоритет: CRITICAL > HIGH > MEDIUM`,'warn');
  log('Кризис активирован','crisis_start',{sc:sc.title});
}

function renderCrisisTasks(){
  const c=document.getElementById('ctasks');
  c.innerHTML=S.crisisTasks.map((t,i)=>`
    <div class="ctask ${t.done?'done':''} ${t.sel?'sel':''}" onclick="selCTask(${i})">
      <div style="font-size:18px">${t.icon}</div>
      <div style="flex:1"><div style="font-family:var(--font);font-size:11px;font-weight:700">${t.done?'✅ ':''}${t.name}</div><div style="font-size:10px;color:var(--txt2)">${t.desc}</div></div>
