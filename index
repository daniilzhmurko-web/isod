// ═══════════════════════════════════════════════════
const AC = {
  MIN: 350,
  record(e){
    const now=e.ts,last=APP.ac.lastT;
    if(last>0){const d=now-last;APP.ac.times.push(d);if(d<this.MIN)this.flag('FAST',d+'мс');}
    APP.ac.lastT=now;this.analyze();
  },
  flag(type,reason){APP.ac.flags.push({type,reason,t:new Date().toLocaleTimeString()});APP.ac.risk+=type==='FAST'?7:20;this.updateUI();},
  analyze(){const ts=APP.ac.times.slice(-6);if(ts.length>=4&&ts.every(t=>t<600)&&!APP.ac.flags.find(f=>f.type==='BRUTE'))this.flag('BRUTE','Слишком быстрые действия');this.updateUI();},
  updateUI(){const r=APP.ac.risk;const dot=document.getElementById('acdot'),txt=document.getElementById('actxt');if(r>60){dot.className='ac-dot danger';txt.textContent=`⚠️ Риск: ${r}`;}else if(r>25){dot.className='ac-dot warn';txt.textContent=`Флаги: ${APP.ac.flags.length}`;}else{dot.className='ac-dot';txt.textContent='Мониторинг';}}
};

