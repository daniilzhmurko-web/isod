  else { grade = 'Неудовлетворительно (2)'; icon = '📉'; color = 'var(--error)'; }

  document.getElementById('examIcon').textContent = icon;
  document.getElementById('examScore').textContent = globalState.score + ' очков';
  document.getElementById('examScore').style.color = color;
  document.getElementById('examGrade').textContent = grade;
