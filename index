//  ЗВУКОВАЯ СИСТЕМА (Web Audio API)
// ═══════════════════════════════════════════════
const Sound = {
  ctx: null,
  init() { try { this.ctx = new (window.AudioContext||window.webkitAudioContext)(); } catch(e){} },
  play(type) {
    if (!document.getElementById('set-sound')?.checked) return;
    if (!this.ctx) this.init();
    if (!this.ctx) return;
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.connect(gain); gain.connect(this.ctx.destination);
    const presets = {
      ok:     {freq:880, dur:.15, type:'sine',   vol:.1},
      err:    {freq:220, dur:.3,  type:'sawtooth',vol:.08},
      click:  {freq:600, dur:.05, type:'square',  vol:.05},
      notify: {freq:660, dur:.2,  type:'sine',    vol:.1},
      level:  {freq:[523,659,784],dur:.5,type:'sine',vol:.12},
      send:   {freq:[440,550,660],dur:.3,type:'sine',vol:.1},
    };
    const p = presets[type] || presets.click;
    if (Array.isArray(p.freq)) {
      p.freq.forEach((f,i)=>{
        const o2=this.ctx.createOscillator(),g2=this.ctx.createGain();
        o2.connect(g2);g2.connect(this.ctx.destination);
        o2.frequency.value=f;o2.type=p.type;g2.gain.setValueAtTime(p.vol,this.ctx.currentTime+i*.1);
        g2.gain.exponentialRampToValueAtTime(.001,this.ctx.currentTime+i*.1+p.dur);
        o2.start(this.ctx.currentTime+i*.1);o2.stop(this.ctx.currentTime+i*.1+p.dur);
      });
    } else {
      osc.frequency.value=p.freq;osc.type=p.type;
      gain.gain.setValueAtTime(p.vol,this.ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(.001,this.ctx.currentTime+p.dur);
      osc.start();osc.stop(this.ctx.currentTime+p.dur);
    }
  }
};

