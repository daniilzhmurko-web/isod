  border-radius: 4px; padding: 2px 6px; font-weight: 700;
}
.zone-content-block {
  background: rgba(255,255,255,0.04); border-radius: 8px;
  padding: 14px; margin-bottom: 10px; border: 1px solid rgba(255,255,255,0.07);
}
.zcb-label { font-size: 9px; color: rgba(255,255,255,0.3); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
.zcb-row {
  display: flex; gap: 6px; height: 8px; margin-bottom: 5px;
}
.zcb-cell {
