  drawRiskMatrix();
}

function drawRiskMatrix(){
  const canvas=document.getElementById('risk-canvas');if(!canvas)return;
  const ctx=canvas.getContext('2d');const w=canvas.width,h=canvas.height;
  ctx.clearRect(0,0,w,h);
  const grad=ctx.createLinearGradient(0,h,w,0);
  grad.addColorStop(0,'rgba(5,122,85,.12)');grad.addColorStop(.5,'rgba(245,158,11,.12)');grad.addColorStop(1,'rgba(224,36,36,.12)');
  ctx.fillStyle=grad;ctx.fillRect(0,0,w,h);
  ctx.strokeStyle='rgba(0,0,0,.07)';ctx.lineWidth=1;
  for(let i=1;i<4;i++){ctx.beginPath();ctx.moveTo(w/4*i,0);ctx.lineTo(w/4*i,h);ctx.stroke();ctx.beginPath();ctx.moveTo(0,h/4*i);ctx.lineTo(w,h/4*i);ctx.stroke();}
  ctx.fillStyle='rgba(0,0,0,.45)';ctx.font='10px PT Sans';
  ctx.fillText('Вероятность →',8,h-5);
  ctx.save();ctx.translate(12,h/2);ctx.rotate(-Math.PI/2);ctx.fillText('Воздействие →',0,0);ctx.restore();
  DB.objects.slice(0,8).forEach(o=>{
    const x=ri(20,w-25),y=h-ri(20,h-25);
    ctx.beginPath();ctx.arc(x,y,o.risk/12+4,0,Math.PI*2);
    ctx.fillStyle=o.color+'cc';ctx.fill();
    ctx.fillStyle='#111';ctx.font='9px PT Sans';ctx.textAlign='center';
    ctx.fillText(o.name.substring(0,12),x,y+o.risk/12+14);
  });
}

