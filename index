function doLogin() {
  const user = document.getElementById('login-user').value.trim();
  const pass = document.getElementById('login-pass').value;
  const err = document.getElementById('auth-err');
  log(`Попытка входа: ${user}`, 'login_attempt');

  if (user.toLowerCase() !== 'ivanov.ap' || pass !== 'Mvd@2024') {
    err.style.display = 'block';
    document.getElementById('login-user').classList.add('err');
    document.getElementById('login-pass').classList.add('err');
    APP.examMistakes++;
    AC.flag('WRONG_LOGIN', 'Неверные учётные данные');
    log('Ошибка авторизации', 'login_fail');
    return;
  }
  err.style.display = 'none';
  
  APP.user.login = user;
  APP.user.name = 'Иванов А.П.';
  APP.user.role = 'Оператор';
  APP.user.mode = document.querySelector('input[name="smode"]:checked')?.value || 'training';
  APP.user.diff = parseInt(document.getElementById('login-diff').value);

  document.getElementById('screen-login').style.display = 'none';
  document.getElementById('screen-main').classList.add('on');
  
  initUI();
  log('Успешная авторизация', 'login_ok', {user});
  
  // Отметить шаг 4 уровня 0 выполненным
  if (CQ.level === 0) {
    QUESTS[0].steps[3].done = true;
    APP.doneSteps++;
    APP.score += 40;
    updateHeader();
    checkStepValidation();
    setTimeout(() => completeLevel(), 500);
  }

  notify('ok', `Добро пожаловать, ${APP.user.name}!`, 'Вход в СЭП выполнен успешно');
}

function doLoginEP() {
  notify('info', 'Вход по ЭП', 'Функция входа по электронной подписи доступна при наличии сертификата ключа подписи.');
