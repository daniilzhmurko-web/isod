    if(isDone){pts+=t.pts;done++;}
    const icon=document.getElementById('examCheckIcon'+i);
    const row=document.getElementById('examCheck'+i);
    if(isDone&&icon&&!icon.classList.contains('done')){
      icon.classList.add('done');icon.innerHTML='<i class="fas fa-check"></i>';
