  if (done < 6) recs.push(`📋 Пройдено только ${done} из 6 сценариев. Завершите оставшиеся для полной оценки компетенций.`);

  document.getElementById('result-recommendations').innerHTML =
    recs.map(r2 => `<div class="rec-item fade-in">${r2}</div>`).join('') ||
    '<div class="rec-item fade-in">💡 Продолжайте практику!</div>';

  // Шапка печатного отчёта
  const printH = document.querySelector('.print-header') || (() => {
    const ph = document.createElement('div');
    ph.className = 'print-header';
    document.querySelector('.result-card').prepend(ph);
