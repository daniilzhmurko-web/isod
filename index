<script>
// === Раскрытие/сворачивание шагов ===
function toggleStep(head){
  const card = head.parentElement;
  const body = card.querySelector('.step-body');
  head.classList.toggle('open');
  body.classList.toggle('open');
  if(body.classList.contains('open')){
    body.style.display = 'block';
  } else {
    body.style.display = 'none';
  }
}

// === FAQ ===
function toggleFaq(q){
  const item = q.parentElement;
  const a = item.querySelector('.faq-a');
  const ico = q.querySelector('.faq-ico');
  q.classList.toggle('open');
  a.classList.toggle('open');
  if(a.classList.contains('open')){
    a.style.display = 'block';
    ico.textContent = '−';
  } else {
    a.style.display = 'none';
    ico.textContent = '+';
  }
}

// === Плавная прокрутка к секции ===
function scrollToSec(id){
  const el = document.getElementById(id);
  if(el){
    el.scrollIntoView({behavior:'smooth',block:'start'});
  }
}

// === Sticky nav: подсветка активной секции ===
const sections = ['s0','s1','s2','s3','s4','s5','s6','s7','s8','s9','s10','s11','s12'];
const navDots = document.querySelectorAll('.sn-dot');

function updateActiveNav(){
  let current = 's0';
  const scrollY = window.scrollY + 100;
  for(const id of sections){
    const sec = document.getElementById(id);
    if(sec && sec.offsetTop <= scrollY){
      current = id;
    }
  }
  navDots.forEach(dot => {
    dot.classList.toggle('active', dot.dataset.sec === current);
  });
}

window.addEventListener('scroll', updateActiveNav);

// === Кнопка «Наверх» ===
const scrollTopBtn = document.getElementById('scrollTop');
window.addEventListener('scroll', () => {
  if(window.scrollY > 400){
    scrollTopBtn.classList.add('visible');
  } else {
    scrollTopBtn.classList.remove('visible');
  }
});

// === Горячие клавиши страницы инструкции ===
document.addEventListener('keydown', (e) => {
  if(e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

  switch(e.key){
    case 'Home':
      e.preventDefault();
      window.scrollTo({top:0,behavior:'smooth'});
      break;
    case 'End':
      e.preventDefault();
      window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'});
      break;
  }

  // Цифры 1-9 для перехода к разделам 1-9
  if(e.key >= '1' && e.key <= '9'){
    const idx = parseInt(e.key);
    scrollToSec('s' + idx);
  }
  // Shift+1..3 для разделов 10-12
  if(e.shiftKey && e.key === '!') scrollToSec('s10');
  if(e.shiftKey && e.key === '@') scrollToSec('s11');
  if(e.shiftKey && e.key === '#') scrollToSec('s12');
});

// === Инициализация ===
document.addEventListener('DOMContentLoaded', () => {
  updateActiveNav();

  // Открываем первый шаг каждой секции по умолчанию
  document.querySelectorAll('.step-head.open').forEach(head => {
    const body = head.parentElement.querySelector('.step-body');
    if(body) body.style.display = 'block';
  });

  // Плавное появление карточек при скролле
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.step-card, .level-card, .ach-card, .module-card, .agent-card').forEach(card => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(20px)';
    card.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
    observer.observe(card);
  });
});
</script>
