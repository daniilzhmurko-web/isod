  initMap(){
    const el=document.getElementById('ME');
    if(!el) {
      console.error('Контейнер карты #ME не найден!');
      return;
    }
    
    // Проверка загрузки библиотеки
    if(!window.L) {
      el.innerHTML = '<div style="padding:40px;text-align:center;color:var(--danger);font-weight:700;font-size:14px"><i class="fas fa-exclamation-triangle" style="font-size:32px;display:block;margin-bottom:12px"></i>Ошибка загрузки карты!<br><span style="font-size:12px;color:var(--ts);font-weight:400">Библиотека Leaflet не загружена. Проверьте, исправлены ли теги &lt;\\/script&gt; на &lt;/script&gt; в секции &lt;head&gt;.</span></div>';
      return;
    }
    
    if(this.map){try{this.map.remove();}catch(e){}this.map=null;}
    
    // Жестко задаем размеры контейнера
    el.style.height = '420px';
    el.style.minHeight = '420px';
    el.style.width = '100%';
    el.style.background = '#e8e8e8';

    const map = L.map(el, {zoomControl:true}).setView([55.755,37.617],12);
    this.map = map;

    // Используем тайлы CartoDB (они работают в РФ без VPN)
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>',
      maxZoom: 19,
      subdomains: 'abcd'
    }).addTo(map);

    const c={free:'#2e7d32',busy:'#e65100',patrol:'#1565c0',off:'#90a4ae'};
    this.s.patrols.forEach(p=>{
      L.marker([p.lat,p.lng],{icon:L.divIcon({html:`<div style="background:${c[p.sta]||c.off};color:#fff;padding:4px 9px;border-radius:6px;font-size:11px;font-weight:700;white-space:nowrap;box-shadow:0 2px 8px rgba(0,0,0,.3);border:2px solid rgba(255,255,255,.6)">${p.cs}</div>`,iconSize:null,className:''})}).addTo(map).bindPopup(`<b>${p.cs}</b><br>${p.st.join(', ')}<br>А/м: ${p.car}<br>Статус: ${this.ps(p.sta)}<br>Район: ${p.dst}<br>${p.inc?'<span style="color:#e65100">Задача: '+p.inc+'</span>':'Свободен'}`);
    });

    const leg=L.control({position:'bottomright'});
    leg.onAdd=()=>{const d=L.DomUtil.create('div');d.style.cssText='background:#fff;padding:10px 14px;border-radius:8px;font-size:12px;box-shadow:0 2px 8px rgba(0,0,0,.15)';d.innerHTML='<b style="display:block;margin-bottom:6px">Статус нарядов</b>'+Object.entries({free:'Свободен',busy:'На выезде',patrol:'Патрулирует'}).map(([k,v])=>`<div style="display:flex;align-items:center;gap:6px;margin-bottom:3px"><div style="width:12px;height:12px;border-radius:50%;background:${c[k]}"></div>${v}</div>`).join('');return d;};
    leg.addTo(map);
    // Зоны ответственности районов
    const districts = [
      {name:'Центральный',lat:55.758,lng:37.618,color:'#1565c0'},
      {name:'Северный',lat:55.770,lng:37.600,color:'#2e7d32'},
      {name:'Советский',lat:55.740,lng:37.650,color:'#ef6c00'}
    ];
    districts.forEach(d=>{
      L.circle([d.lat,d.lng],{color:d.color,fillColor:d.color,fillOpacity:0.08,radius:1200,weight:2,dashArray:'5,5'}).addTo(map).bindTooltip(d.name,{permanent:true,direction:'center',className:'district-label'});
    });
    // Критически важная задержка
    setTimeout(() => {
      map.invalidateSize();
    }, 500);
  },

