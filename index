    </div>
  </div>
</div>

<!-- ВИСП ПОРТАЛ -->
<div id="vispScreen" class="hidden">
  <div class="visp-header">
    <span style="font-size:28px">🦅</span>
    <div><div style="font-size:15px;font-weight:700">МВД России</div><div style="font-size:10px;opacity:.75">Информационно-справочный портал</div></div>
    <div style="margin-left:auto;display:flex;gap:8px;align-items:center"><span style="font-size:13px;color:rgba(255,255,255,.8)">Скороход П.П.</span><button class="header-btn" onclick="exitVisp()">Выход</button></div>
  </div>
  <div class="visp-nav">
    <div class="visp-nav-item">📞 Адресно-телефонный справочник</div>
    <div class="visp-nav-item">📰 Новости и НТИ</div>
    <div class="visp-nav-item">❓ Вопросы и ответы</div>
    <div class="visp-nav-item active" onclick="showVispServices()">⚙️ Сервисы ИСОД</div>
    <div style="margin-left:auto"><input class="search-input" style="width:200px;height:32px;font-size:12px" placeholder="Поиск..."></div>
  </div>
  <div class="visp-body" id="vispBody">
    <div style="font-size:18px;font-weight:800;color:var(--text);margin-bottom:16px;display:flex;align-items:center;gap:8px"><span>🖥️</span> Сервисы обеспечения оперативно-служебной деятельности</div>
