function updateBehavior(action) {
  if (action === 'task_done_fast') { S.behavior.speed = Math.min(100, S.behavior.speed + 5); S.behavior.accuracy = Math.min(100, S.behavior.accuracy + 3); }
  if (action === 'task_done_slow') { S.behavior.speed = Math.max(0, S.behavior.speed - 3); }
  if (action === 'task_error')     { S.behavior.accuracy = Math.max(0, S.behavior.accuracy - 8); S.errors++; }
  if (action === 'task_done')      { S.behavior.experience = Math.min(100, S.behavior.experience + 4); }

  const { speed, accuracy, experience } = S.behavior;
  const score = speed * .3 + accuracy * .4 + experience * .3;
  let profile = 'Новичок', bg = '#EEF4FF', col = 'var(--pm)';
  if (score > 80)      { profile = 'Эксперт';   bg = '#D1FAE5'; col = '#065F46'; }
  else if (score > 60) { profile = 'Аналитик';  bg = '#EDE9FE'; col = '#5B21B6'; }
  else if (score > 35) { profile = 'Практик';   bg = '#FEF3C7'; col = '#92400E'; }
  else if (score < 20 && Math.random() > .5) { profile = 'Хаотичный'; bg = '#FEE2E2'; col = '#991B1B'; }

  S.behavior.profile = profile;
  document.getElementById('bpSpd').style.width = S.behavior.speed + '%';
  document.getElementById('bpAcc').style.width = S.behavior.accuracy + '%';
  document.getElementById('bpExp').style.width = S.behavior.experience + '%';
  const badge = document.getElementById('profBadge');
  badge.textContent = profile.toUpperCase();
  badge.style.background = bg; badge.style.color = col;
  document.getElementById('lvlLbl').textContent = `Уровень ${S.evoLevel} / ${profile}`;

  adaptAI();
}

function adaptAI() {
  const hints = [];
  if (S.behavior.accuracy < 40) hints.push({t:'Advisor: Внимательно читайте условия задачи перед выполнением.'});
  if (S.behavior.speed < 30) hints.push({t:'Trainer: Используйте горячие клавиши и навигацию по разделам.'});
  if (S.behavior.experience > 60) hints.push({t:'Inspector: Попробуйте сценарий 6 — комплексный кейс.'});
  if (S.errors > 3) hints.push({t:'Instructor: Изучите модуль «Финансовое подразделение» подробнее.'});
  renderAIHints(hints);
}

