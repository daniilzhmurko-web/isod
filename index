let aiConversationHistory = [];
let aiIsLoading = false;

async function sendAIMessageEnhanced(msg) {
  if (!msg || aiIsLoading) return;
  aiIsLoading = true;

  addAIMessage(msg, 'user');
  aiConversationHistory.push({ role: 'user', content: msg });

  // Показать индикатор печати
  const typingDiv = document.createElement('div');
  typingDiv.className = 'ai-typing'; typingDiv.id = 'aiTyping';
  typingDiv.innerHTML = '<div class="ai-dot"></div><div class="ai-dot"></div><div class="ai-dot"></div>';
  document.getElementById('aiMessages').appendChild(typingDiv);
  document.getElementById('aiMessages').scrollTop = 9999;

  try {
    // Системный промпт с контекстом симулятора
    const currentMission = MISSIONS[globalState.currentMission];
    const currentStep = currentMission?.steps[globalState.currentStep];
    const systemPrompt = `Ты — встроенный AI-помощник симулятора СЦУО (Система централизованного учёта оружия). Отвечай СТРОГО на русском языке, кратко и по делу.

Контекст пользователя:
- Текущая миссия: "${currentMission?.title || '—'}" (${globalState.currentMission + 1} из ${MISSIONS.length})
- Текущий шаг: "${currentStep?.instruction?.replace(/<[^>]+>/g,'') || '—'}"
- Очков набрано: ${globalState.score}
- Ошибок допущено: ${globalState.errorCount}
- Точность: ${getAccuracy()}%

Ты помогаешь операторам МВД изучить работу с системой учёта оружия. Отвечай не длиннее 3-4 предложений. Если спрашивают о текущем шаге — объясни что нужно сделать.`;

    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 300,
        system: systemPrompt,
        messages: aiConversationHistory.slice(-6)
      })
    });

    const data = await response.json();
    const reply = data?.content?.[0]?.text || processAIMessage(msg);
    aiConversationHistory.push({ role: 'assistant', content: reply });

    document.getElementById('aiTyping')?.remove();
    addAIMessage(reply, 'bot');
  } catch (e) {
    // Фоллбэк на rule-based
    document.getElementById('aiTyping')?.remove();
    const fallback = processAIMessage(msg);
    addAIMessage(fallback, 'bot');
  }
  aiIsLoading = false;
}

