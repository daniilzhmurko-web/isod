  position: absolute;
  display: flex; flex-direction: column; align-items: center;
  gap: 4px; cursor: pointer;
  transition: transform 0.2s;
}
.topo-node:hover { transform: scale(1.1); z-index: 10; }
.topo-icon {
  width: 44px; height: 44px; border-radius: var(--radius-sm);
