function openSign(){const u=S.se.u;document.getElementById('sTok').textContent=u?.tok||'—';document.getElementById('sCrt').textContent=u?.ce||'—';document.getElementById('sOwn').textContent=u?.nm||'—';om('mSign');}
function doSign(){const b=document.getElementById('dsb');b.innerHTML='<span class="sgn">⚙️ Подписание...</span>';b.disabled=true;setTimeout(()=>{cm('mSign');S.wo.si=true;log('Справка подписана ЭЦП',S.wo.req?.a.fn,'success');notif('Подписано','Справка подписана ЭЦП. Нажмите «Передать в МФЦ».','success');b.innerHTML='<i class="fas fa-signature"></i> Подписать';b.disabled=false;updBadges();updQ();chkAchs();renderJTab('sign');},1800);}
function sendMFC(){S.wo.sn=true;if(S.wo.req)S.wo.req.rq.st='completed';log('Справка передана в МФЦ',S.wo.req?.a.fn,'success');notif('Готово!','Справка передана в МФЦ через СМЭВ 3.x. Статус — «Выполнено».','success',7000);updBadges();updQ();chkAchs();renderJTab('sign');}

