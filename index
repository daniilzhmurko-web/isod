      return`<div class="mc ${isDone?'mcd':isAct?'mca':''}"><div class="mch"><div class="mce" style="background:${isDone?'var(--success-bg)':isAct?'var(--primary-light)':'var(--bdrl)'}">${isDone?'✅':isAct?'▶️':m.ico}</div><div class="mci"><div class="mct">${m.title}</div><div class="mcs">${m.sub}</div></div><div class="mca2"><span class="bdg ${isDone?'bg':isAct?'bb':'bgy'}">${isDone?'✓ Завершена':isAct?'▶ Активна':'Доступна'}</span><span class="bdg bv"><i class="fas fa-star"></i> +${m.xp} XP</span></div></div><div class="mcb"><div class="mcd2">${m.desc}</div><div class="mctg">${m.tags.map(t=>`<span class="bdg bi">${t}</span>`).join('')}</div><div class="mcf"><div class="mcm"><span><i class="fas fa-list-check"></i> ${m.steps.length} шагов</span><span><i class="fas fa-clock"></i> ~${m.dur} мин</span></div>${isDone?`<button class="btn btn-sec btn-sm" onclick="SYS.replayM('${m.id}')"><i class="fas fa-rotate-left"></i> Повторить</button>`:`<button class="btn btn-p btn-sm" onclick="SYS.startM('${m.id}')"><i class="fas fa-play"></i> ${isAct?'Продолжить':'Начать'}</button>`}</div></div></div>`;
