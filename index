    setTimeout(()=>{
      S.step++;
      S.hIdx=0;
      el('q-hint').style.display='none';
      if(S.step>=QUEST.length){ showMC(); return; }
      updQ();
      glow();
    },1400);
  }
  updQProgress();
  updQUI();
}

function updQUI() {
  if(S.step>=QUEST.length) return;
