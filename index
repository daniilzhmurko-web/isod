  const opts = document.getElementById('quiz-options');
  opts.innerHTML = quizData.options.map((o, i) => `
    <div class="quiz-option" onclick="answerQuiz(${i},${o.correct},this,'${o.feedback.replace(/'/g,"\\'")}')">
      <div class="quiz-option__letter">${String.fromCharCode(65+i)}</div>
      <span>${o.text}</span>
    </div>
  `).join('');

  document.getElementById('quiz-overlay').classList.add('show');
}

function answerQuiz(idx, correct, el, feedback) {
  document.querySelectorAll('.quiz-option').forEach(o => o.classList.add('disabled'));
  el.classList.add(correct ? 'correct' : 'wrong');
  const fb = document.getElementById('quiz-feedback');
  fb.textContent = feedback;
  fb.className = 'quiz-feedback ' + (correct ? 'correct' : 'wrong');
  fb.style.display = 'block';
  if (correct) {
    addScoreEvent('Верный ответ на вопрос', +5);
    document.getElementById('btn-quiz-continue').classList.add('show');
  } else {
    addScoreEvent('Неверный ответ', -3);
    State.errors++;
    updateLiveScore();
    setTimeout(() => {
      document.querySelectorAll('.quiz-option').forEach(o => { o.classList.remove('disabled','wrong','correct'); });
      fb.style.display = 'none';
    }, 1800);
  }
}

function continueAfterQuiz() {
  document.getElementById('quiz-overlay').classList.remove('show');
  if (_quizCallback) { _quizCallback(); _quizCallback = null; }
}

function showHint() {
  document.getElementById('instr-hint').style.display = 'block';
  document.getElementById('btn-show-hint').style.display = 'none';
  State.hints++;
  addScoreEvent('Использована подсказка', -2);
}


