<script>
(function() {
    const HIDE_DELAY = 3500; // Время показа в мс (3.5 секунды)
    const TARGET_TEXT = 'Мониторинг активен';

    function hideMonitoringStatus() {
        // Поиск элемента по точному совпадению текста
        const allElements = document.querySelectorAll('*');
        let target = null;

        for (let el of allElements) {
            if (el.textContent.trim() === TARGET_TEXT) {
                target = el;
                break;
            }
        }

        if (!target) return; // Элемент ещё не отрисован

        // Подготовка к анимации
        target.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        target.style.opacity = '1';

        // Скрытие по таймеру
        setTimeout(() => {
            target.style.opacity = '0';
            target.style.transform = 'translateY(6px) scale(0.98)';
            target.style.pointerEvents = 'none';

            // Полное удаление из потока после анимации
            setTimeout(() => {
                target.style.display = 'none';
            }, 600);
        }, HIDE_DELAY);
    }

    // Запуск при готовности DOM
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', hideMonitoringStatus);
    } else {
        hideMonitoringStatus();
    }

    // Отслеживание динамического появления (если интерфейс рендерится через JS)
    const observer = new MutationObserver((mutations) => {
        for (let m of mutations) {
            if (m.addedNodes.length) hideMonitoringStatus();
        }
    });
    observer.observe(document.body, { childList: true, subtree: true });
})();
</script>
