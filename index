<!-- ═══════════════════════════════════════════════════════════
     HOTFIX 2: Исправление съезжающего выделения (динамический трекинг)
═══════════════════════════════════════════════════════════ -->
<script>
'use strict';

if (typeof Nav !== 'undefined') {
  const _origNavActivate = Nav.activate;
  const _origNavClear = Nav.clear;

  // Переопределяем метод активации подсветки
  Nav.activate = function(sel) {
    // Останавливаем предыдущий трекер, если он активен
    if (this._trackInterval) {
      cancelAnimationFrame(this._trackInterval);
      this._trackInterval = null;
    }
    
    // Вызываем оригинальный метод для первичной отрисовки
    _origNavActivate.call(this, sel);

    const el = sel ? document.querySelector(sel) : null;
    if (!el) return;

    let targetEl = el;
    // Корректировка для выпадающего списка
    if (el.offsetParent === null && el.id === 'sed-user-dropdown') {
      targetEl = document.querySelector('.sed-user-block') || el.parentElement || el;
    }

    this._lastRect = { left: -999, top: -999, width: -999, height: -999 };

    // Функция для покадрового слежения за элементом
    const updateSpotlight = () => {
      if (!this.svm || this.svm.style.display !== 'block' || !targetEl) {
        this._trackInterval = null;
        return;
      }

      const r = targetEl.getBoundingClientRect();
      const prev = this._lastRect;

      // Обновляем координаты только если элемент сдвинулся/изменил размер > 0.5px
      // Это решает проблему анимации выезда панелей и пульсации бейджей
      if (Math.abs(r.left - prev.left) > 0.5 || Math.abs(r.top - prev.top) > 0.5 || 
          Math.abs(r.width - prev.width) > 0.5 || Math.abs(r.height - prev.height) > 0.5) {
        
        this._lastRect = { left: r.left, top: r.top, width: r.width, height: r.height };
        const pad = 8;
        const W = window.innerWidth, H = window.innerHeight;

        // Обновляем SVG маску затемнения
        this.svm.innerHTML = `<defs><mask id="smask"><rect width="${W}" height="${H}" fill="white"/><rect x="${r.left-pad}" y="${r.top-pad}" width="${r.width+pad*2}" height="${r.height+pad*2}" rx="6" fill="black"/></mask></defs><rect width="${W}" height="${H}" fill="rgba(0,30,80,0.46)" mask="url(#smask)"/>`;
        
        // Обновляем желтую рамку
        this.sr.style.left = `${r.left-pad}px`;
        this.sr.style.top = `${r.top-pad}px`;
        this.sr.style.width = `${r.width+pad*2}px`;
        this.sr.style.height = `${r.height+pad*2}px`;
        
        // Обновляем стрелку
        const ax = r.left + r.width / 2;
        const ay = Math.max(r.top - 48, 60);
        this.ar.style.left = `${ax}px`;
        this.ar.style.top = `${ay}px`;
      }

      // Зацикливаем проверку до завершения шага
      this._trackInterval = requestAnimationFrame(updateSpotlight);
    };

    // Запускаем трекер
    this._trackInterval = requestAnimationFrame(updateSpotlight);
  };

  // Очистка при завершении шага
  Nav.clear = function() {
    if (this._trackInterval) {
      cancelAnimationFrame(this._trackInterval);
      this._trackInterval = null;
    }
    _origNavClear.call(this);
  };
}
</script>
