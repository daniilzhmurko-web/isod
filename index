<script>
'use strict';

// 1. ИСПРАВЛЕНИЕ БАГА ГОРЯЧИХ КЛАВИШ (и других модальных окон)
// Глобальный перехватчик Engine блокирует клики, не попадающие в цель текущего шага.
// Мы добавляем исключение на фазе захвата (capture) уровня окна.
window.addEventListener('click', function(e) {
  if (e.target.closest('.kbd-overlay, .quest-alert, .form-modal, .quiz-modal-overlay, .trap-modal-overlay, #scene-intro')) {
    if (typeof Engine !== 'undefined' && Engine.waiting && Engine._cur) {
      // Временно скрываем текущую цель от жесткого блокиратора документа, разрешая клик
      const savedCur = Engine._cur;
      Engine._cur = null; 
      setTimeout(() => {
        // Восстанавливаем состояние движка сразу после прохождения события
        if (!Engine._cur) Engine._cur = savedCur;
      }, 0);
    }
  }
}, true);

// 2. ИСПРАВЛЕНИЕ СОФТЛОКА В СЦЕНАРИИ 6 (Шаг "Добавьте резолюцию")
// Если целевая кнопка находится в другой (скрытой) вкладке, она не может быть нажата.
// Патчим метод активации шага, чтобы он принудительно открывал нужную вкладку перед поиском кнопки.
if (typeof Engine !== 'undefined' && typeof Engine._activate === 'function') {
  const _origActivateFinalPatch = Engine._activate;
  Engine._activate = function(step) {
    if (step && step.target) {
      const card = document.getElementById('doc-card');
      if (card && !card.classList.contains('hidden') && typeof switchCardTab === 'function') {
        const fakeEvent = { preventDefault: () => {} };
        // Принудительное переключение вкладок, если цель находится в них
        if (step.target === '#btn-add-resolution') {
          switchCardTab('res', fakeEvent);
        } else if (step.target === '#card-link-control') {
          switchCardTab('control', fakeEvent);
        } else if (step.target === '#btn-acknowledged') {
          switchCardTab('info', fakeEvent);
        }
      }
