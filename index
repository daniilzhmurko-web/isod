  const wasOpen = card.classList.contains('open');
  card.classList.toggle('open', !wasOpen);
}

/* ════════════════════════════════
   АКТИВНАЯ ССЫЛКА В САЙДБАРЕ
════════════════════════════════ */
function setActive(el) {
  document.querySelectorAll('.sb-item').forEach(i => i.classList.remove('active'));
  el.classList.add('active');
}

/* ════════════════════════════════
   ПРОГРЕСС ЧТЕНИЯ
════════════════════════════════ */
function updateReadProgress() {
  const el = document.getElementById('content');
  const scrollTop = el.scrollTop || document.documentElement.scrollTop || window.scrollY;
  const docH = document.documentElement.scrollHeight - window.innerHeight;
  const pct = Math.min(100, Math.round((scrollTop / docH) * 100));
  document.getElementById('readProgressFill').style.width = pct + '%';
  document.getElementById('sbProgress').style.width = pct + '%';
  document.getElementById('sbPct').textContent = pct + '%';
}

window.addEventListener('scroll', updateReadProgress, { passive: true });
document.getElementById('content').addEventListener('scroll', updateReadProgress, { passive: true });

/* ════════════════════════════════
   ПЛАВНОЕ ВЫДЕЛЕНИЕ АКТИВНОГО
   ПУНКТА ПРИ СКРОЛЛЕ
════════════════════════════════ */
const sections = ['intro','interface','start','missions','mission1','mission2','mission3',
  'mission4','mission5','mission6','mission7','scoring','shortcuts','roles','tips'];

function updateActiveSectionOnScroll() {
  const scrollY = window.scrollY || document.documentElement.scrollTop;
  let current = sections[0];
  sections.forEach(id => {
    const el = document.getElementById(id);
    if (el && el.getBoundingClientRect().top <= 120) current = id;
  });
  const link = document.querySelector(`.sb-item[href="#${current}"]`);
  if (link) {
    document.querySelectorAll('.sb-item').forEach(i => i.classList.remove('active'));
    link.classList.add('active');
  }
}
window.addEventListener('scroll', updateActiveSectionOnScroll, { passive: true });

/* ════════════════════════════════
   АНИМАЦИЯ ПОЯВЛЕНИЯ СЕКЦИЙ
════════════════════════════════ */
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.style.opacity = '1';
      e.target.style.transform = 'none';
    }
  });
}, { threshold: 0.08 });

document.querySelectorAll('.section, .hero').forEach(el => {
  el.style.opacity = '0';
  el.style.transform = 'translateY(20px)';
  el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
  observer.observe(el);
});

// Сразу показать hero
setTimeout(() => {
  const hero = document.querySelector('.hero');
  if (hero) { hero.style.opacity = '1'; hero.style.transform = 'none'; }
}, 100);
</script>
