  {id:'five_kusp',     ico:'📚', nm:'Опытный дежурный',  desc:'Зарегистрировали 5 записей КУСП',        xp:100, check:s=>(s.kusp||[]).length>=5},
  {id:'first_dispatch',ico:'🚔', nm:'Диспетчер',         desc:'Выслали первый наряд',                   xp:50,  check:s=>s.patrols.some(p=>p.sta==='busy')},
  {id:'all_free',      ico:'✅', nm:'Спокойная смена',   desc:'Все наряды свободны одновременно',       xp:75,  check:s=>s.patrols.every(p=>p.sta==='free'||p.sta==='patrol')},
  {id:'first_call',    ico:'📞', nm:'На связи',          desc:'Ответили на первый вызов 02',            xp:50,  check:s=>s.incs.length>=1},
  {id:'analytics',     ico:'📊', nm:'Аналитик',          desc:'Открыли модуль аналитики',               xp:30,  check:s=>s.mod==='anal'},
  {id:'mission1',      ico:'🏅', nm:'Новобранец',        desc:'Завершили первую миссию',                xp:0,   check:s=>s.prog.done.length>=1},
  {id:'mission2',      ico:'🏆', nm:'Опытный',           desc:'Завершили две миссии',                   xp:0,   check:s=>s.prog.done.length>=2},
  {id:'mission3',      ico:'🌟', nm:'Профессионал',      desc:'Завершили все три миссии',               xp:200, check:s=>s.prog.done.length>=3},
  {id:'first_bul',     ico:'🔍', nm:'Следователь',       desc:'Создали оперативную ориентировку',       xp:40,  check:s=>(s.bul||[]).some(b=>b.id.includes('2024-00')&&parseInt(b.id.split('-')[2])>3)},
  {id:'first_grl',     ico:'👮', nm:'Конвоир',           desc:'Оформили задержанного в ГРЛ',            xp:50,  check:s=>(s.grl||[]).length>=1},
  {id:'summary_sent',  ico:'📤', nm:'Отчётность',        desc:'Отправили сводку в ЦОР',                 xp:60,  check:s=>s.audit.some(a=>a.action.includes('Сводка'))},
  {id:'radio_used',    ico:'📡', nm:'Радист',            desc:'Использовали радиосвязь',                xp:30,  check:s=>s.audit.some(a=>a.action.includes('Радио'))},
  {id:'handover',      ico:'🔄', nm:'Сдача смены',       desc:'Оформили сдачу дежурной смены',          xp:75,  check:s=>s.audit.some(a=>a.action.includes('Сдача смены'))}
];

// ── Расширение объекта SYS ──
Object.assign(SYS,{
  notifs:[],
  emergActive:false,
  radioLog:[
    {tp:'sys',tx:'[08:00:00] СИСТЕМА: Дежурная смена №1 начата. Все наряды в строю.'},
    {tp:'in', tx:'[08:04:15] РОМБ-1 → ДЧ: Вышел на маршрут №3. Всё спокойно.'},
    {tp:'in', tx:'[08:11:32] СОКОЛ-1 → ДЧ: Принял вызов. Выдвигаюсь на место.'},
    {tp:'in', tx:'[08:28:47] КЕДР-1 → ДЧ: Маршрут №7, происшествий не выявлено.'},
    {tp:'sys',tx:'[08:35:10] СИСТЕМА: Получено обращение через ЕПГУ.'}
  ],

  // ── ДОСТИЖЕНИЯ ──
  checkAch(){
    const s=this.s;
    ACHIEVEMENTS.forEach(a=>{
      if(!s.prog.ach.includes(a.id)&&a.check(s)){
        s.prog.ach.push(a.id);
        if(a.xp>0)s.prog.xp+=a.xp;
        this.addNotif('achievement','🏆 Достижение разблокировано!',a.nm+' ('+a.ico+')',a.xp>0?'+'+a.xp+' XP':'','iv');
        this.toast('s','🏆 '+a.nm,a.desc+(a.xp>0?' | +'+a.xp+' XP':''));
        document.getElementById('hRk').textContent=this.rn(s.prog.xp);
        this.save();
      }
    });
  },

  pgAch(){
    const done=this.s.prog.ach;
    const cards=ACHIEVEMENTS.map(a=>{
      const ok=done.includes(a.id);
      return`<div class="ach-card ${ok?'unlocked':'locked'}">
        <span class="ach-ico">${a.ico}</span>
        <div class="ach-name">${a.nm}</div>
        <div class="ach-desc">${a.desc}</div>
        ${a.xp>0?`<div class="ach-xp">+${a.xp} XP</div>`:''}
        ${ok?'<div style="margin-top:6px;font-size:10px;color:var(--success);font-weight:700">✓ Получено</div>':'<div style="margin-top:6px;font-size:10px;color:var(--tm)">Заблокировано</div>'}
      </div>`;
    }).join('');
    return`<div class="ph"><div><div class="pt">Достижения</div><div class="ps">Разблокировано: ${done.length} / ${ACHIEVEMENTS.length}</div></div><div class="pha"><span class="bdg bv"><i class="fas fa-star"></i> ${this.s.prog.xp} XP</span></div></div>
<div class="al al-i mb16"><i class="fas fa-info-circle"></i><span>Выполняйте задания и миссии, чтобы разблокировать достижения и получать XP.</span></div>
<div class="ach-grid">${cards}</div>`;
  },

  // ── УВЕДОМЛЕНИЯ ──
  addNotif(type,title,text,meta='',cls='ib'){
    const ico={achievement:'fa-trophy',call:'fa-phone-volume',kusp:'fa-book-open',patrol:'fa-car-side',system:'fa-shield-halved'};
    const n=new Date(),t=n.toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'});
    this.notifs.unshift({type,title,text,meta,cls,t,ico:ico[type]||'fa-bell',read:false});
    if(this.notifs.length>30)this.notifs.pop();
    // Обновить точку
    const dot=document.getElementById('nDot');
    if(dot)dot.style.display='block';
    // Обновить панель если открыта
    if(document.getElementById('NP').classList.contains('open'))this.renderNotifPanel();
  },

  renderNotifPanel(){
    const list=document.getElementById('npList');
    if(!list)return;
    if(!this.notifs.length){list.innerHTML='<div class="np-empty"><i class="fas fa-bell-slash" style="font-size:28px;opacity:.3;display:block;margin-bottom:8px"></i>Уведомлений нет</div>';return;}
    list.innerHTML=this.notifs.map(n=>`
    <div class="np-item" onclick="SYS.markRead()">
      <div class="np-ic ${n.cls}" style="background:var(--primary-light)"><i class="fas ${n.ico}"></i></div>
      <div class="np-txt">
        <div class="np-nt">${n.title}</div>
        <div class="np-ns">${n.text}${n.meta?` | ${n.meta}`:''}</div>
        <div class="np-ns">${n.t}</div>
      </div>
      ${!n.read?'<div style="width:8px;height:8px;border-radius:50%;background:var(--primary);flex-shrink:0;margin-top:4px"></div>':''}
    </div>`).join('');
  },

  tgNotif(){
    const np=document.getElementById('NP');
    np.classList.toggle('open');
    if(np.classList.contains('open'))this.renderNotifPanel();
  },

  markRead(){this.notifs.forEach(n=>n.read=true);const dot=document.getElementById('nDot');if(dot)dot.style.display='none';},
  clearNotifs(){this.notifs=[];this.renderNotifPanel();const dot=document.getElementById('nDot');if(dot)dot.style.display='none';},
  showNotifs(){this.tgNotif();},

  // ── РАДИОСВЯЗЬ ──
  pgRadio(){
    const msgs=this.radioLog.map(m=>`<div class="radio-msg ${m.tp}">${m.tx}</div>`).join('');
    const patBtns=this.s.patrols.map(p=>`<button class="btn btn-xs btn-sec" onclick="SYS.radioQuick('${p.cs}')">${p.cs}</button>`).join('');
    return`<div class="ph"><div><div class="pt">Радиосвязь</div><div class="ps">Симулятор радиообмена с нарядами</div></div><div class="pha"><button class="btn btn-sec btn-sm" onclick="SYS.radioSysMsg()"><i class="fas fa-broadcast-tower"></i> Системное</button></div></div>
<div class="card">
  <div class="ch"><i class="fas fa-broadcast-tower" style="color:var(--warning)"></i><div class="ct">Канал связи ДЧ — Наряды</div><div class="ca"><span class="bdg bg">● Связь активна</span></div></div>
  <div class="radio-wrap">
    <div class="radio-feed" id="radioFeed">${msgs}</div>
    <div class="radio-footer">
      <input type="text" class="radio-inp" id="radioInp" placeholder="ДЧ → [позывной]: сообщение..." onkeydown="if(event.key==='Enter')SYS.radioSend()">
      <button class="btn btn-sm btn-p" onclick="SYS.radioSend()"><i class="fas fa-paper-plane"></i></button>
    </div>
  </div>
  <div class="ch" style="border-top:1px solid var(--bdrl);border-bottom:none;flex-wrap:wrap;gap:6px">
    <span style="font-size:11px;color:var(--tm)">Быстрый вызов:</span>
    ${patBtns}
    <button class="btn btn-xs btn-d" onclick="SYS.radioAlert()" style="margin-left:auto"><i class="fas fa-triangle-exclamation"></i> Тревога всем</button>
  </div>
</div>`;
  },

  radioSend(){
    const inp=document.getElementById('radioInp');if(!inp)return;
    const msg=inp.value.trim();if(!msg)return;
    const n=new Date(),t=n.toLocaleTimeString('ru-RU');
    const entry={tp:'out',tx:`[${t}] ДЧ: ${msg}`};
    this.radioLog.push(entry);
    inp.value='';
    this.log('Радио: '+msg);
    this.s.prog.xp+=2;this.save();
    this.renderRadio();this.checkAch();
    // Ответ через 2-4 сек
    const respTime=2000+Math.random()*2000;
    const resps=['Принято. Выполняем.','Вас понял. Подтверждаю.','Принято, докладываю обстановку.','Понял вас. Всё под контролем.'];
    const pat=this.s.patrols[Math.floor(Math.random()*this.s.patrols.length)];
    setTimeout(()=>{
      const n2=new Date(),t2=n2.toLocaleTimeString('ru-RU');
      this.radioLog.push({tp:'in',tx:`[${t2}] ${pat.cs} → ДЧ: ${resps[Math.floor(Math.random()*resps.length)]}`});
      this.renderRadio();
    },respTime);
  },

  radioQuick(cs){const inp=document.getElementById('radioInp');if(inp)inp.value='ДЧ → '+cs+': ';inp.focus();},

  radioAlert(){
    const n=new Date(),t=n.toLocaleTimeString('ru-RU');
