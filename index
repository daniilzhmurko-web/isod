function globalSearch(query){
  if(!query||query.length<2) return;
  logAction('Поиск','Глобальный поиск: '+query,'СИСТЕМА');
  appState.stats.searchesPerformed++;
  const modules=[
    {mod:'monitoring',name:'Мониторинг',match:'НПА, правоприменение, мониторинг'},
    {mod:'isk',name:'Иск',match:'иск, суд, дело, заявление'},
    {mod:'resources',name:'Правовые ресурсы',match:'НПА, закон, приказ, перечень'},
    {mod:'news',name:'Новости',match:'новость, событие, конференция'}
  ];
  const results=modules.filter(m=>m.match.toLowerCase().includes(query.toLowerCase())||m.name.toLowerCase().includes(query.toLowerCase()));
  if(results.length>0){
    showToast('🔍 Найдено','Результаты в модулях: '+results.map(r=>r.name).join(', '),'info');
    if(results[0]) showModule(results[0].mod);
  } else {
    showToast('🔍 Поиск','По запросу «'+query+'» ничего не найдено','warn');
  }
}

