  const loci=Object.keys(pA.loci);let matches=0;
  const rows=loci.map(l=>{const a=pA.loci[l],b=pB.loci[l],m=a===b;if(m)matches++;
    return `<div class="sll ${m?'mt':'ms'}"><div class="slln">${l}</div><div class="slla">${a}</div>
      <div style="font-size:14px;margin:2px 0;">${m?'✅':'❌'}</div><div class="slla">${b}</div></div>`;});
  const prob=(Math.pow(0.1,matches)*(loci.length/matches)).toExponential(2);
  document.getElementById('cmpRes').innerHTML=`
    <div style="padding:11px;background:${matches>=10?'#f0fdf4':'#fef3c7'};border-radius:var(--rr);margin-bottom:12px;border:1.5px solid ${matches>=10?'#86efac':'#fcd34d'};">
