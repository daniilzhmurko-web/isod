  0%,100% { transform: translateY(0); }
  50%      { transform: translateY(-6px); }
}

.hero-text { flex: 1; }
.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(200,150,12,.15); border: 1px solid rgba(200,150,12,.3);
  border-radius: 20px; padding: 4px 14px; font-size: 11px;
  font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase;
  color: var(--gold-light); margin-bottom: 16px;
}
.hero-eyebrow i { font-size: 10px; }

.hero h1 {
  font-family: var(--serif);
  font-size: clamp(26px, 4vw, 40px);
  font-weight: 900; line-height: 1.15;
  margin-bottom: 12px;
  letter-spacing: -0.5px;
}
.hero h1 span { color: var(--gold-light); }

.hero-sub {
  font-size: 15px; opacity: .8; max-width: 520px;
  line-height: 1.6; margin-bottom: 28px;
}

.hero-pills { display: flex; gap: 10px; flex-wrap: wrap; }
.hero-pill {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15);
  border-radius: 20px; padding: 5px 14px; font-size: 12px; font-weight: 500;
  color: rgba(255,255,255,.85);
}
.hero-pill i { font-size: 11px; color: var(--gold-light); }

/* ═══════════════ PROGRESS NAV ════════════════════════ */
.progress-nav {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  position: sticky; top: 0; z-index: 100;
  box-shadow: var(--shadow-sm);
}
.progress-nav-inner {
  max-width: 900px; margin: 0 auto;
  padding: 0 40px;
  display: flex; align-items: center; gap: 0;
  overflow-x: auto; scrollbar-width: none;
}
.progress-nav-inner::-webkit-scrollbar { display: none; }

.nav-step {
  flex-shrink: 0; display: flex; align-items: center; gap: 8px;
  padding: 14px 18px; cursor: pointer; transition: all .2s;
  border-bottom: 3px solid transparent; font-size: 13px;
  font-weight: 500; color: var(--ink-soft); white-space: nowrap;
  background: none; border-top: none; border-left: none; border-right: none;
}
.nav-step:hover { color: var(--navy-mid); background: rgba(26,58,107,.04); }
.nav-step.active { color: var(--navy-mid); border-bottom-color: var(--gold); font-weight: 600; }
.nav-step-num {
  width: 22px; height: 22px; border-radius: 50%;
  background: var(--border); color: var(--ink-soft);
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700; flex-shrink: 0;
  transition: all .2s;
}
.nav-step.active .nav-step-num { background: var(--gold); color: var(--white); }
.nav-step.done .nav-step-num  { background: var(--success); color: var(--white); }
.nav-step.done { color: var(--success); }

/* ═══════════════ LAYOUT ══════════════════════════════ */
.container { max-width: 900px; margin: 0 auto; padding: 0 40px; }

/* ═══════════════ SECTION WRAPPERS ════════════════════ */
.doc-section {
  padding: 60px 0 20px;
  border-bottom: 1px solid var(--border);
}
.doc-section:last-child { border-bottom: none; }

.section-label {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 11px; font-weight: 700; text-transform: uppercase;
  letter-spacing: 1.8px; color: var(--gold);
  margin-bottom: 10px;
}
.section-label::after {
  content: ''; flex: 1; height: 1px; background: var(--border-gold);
  min-width: 40px;
}

.section-title {
  font-family: var(--serif);
  font-size: clamp(22px, 3vw, 32px);
  font-weight: 700; color: var(--navy);
  line-height: 1.2; margin-bottom: 10px;
  letter-spacing: -0.3px;
}

.section-lead {
  font-size: 16px; color: var(--ink-mid);
  max-width: 680px; line-height: 1.7;
  margin-bottom: 36px;
}

/* ═══════════════ CALLOUT BOXES ═══════════════════════ */
.callout {
  border-radius: var(--radius); padding: 16px 20px;
  display: flex; gap: 14px; margin: 20px 0;
  font-size: 14px; line-height: 1.6;
}
.callout-icon { font-size: 18px; flex-shrink: 0; margin-top: 1px; }
.callout.info    { background: #eff6ff; border-left: 4px solid #3b82f6; color: #1e40af; }
.callout.warning { background: var(--gold-pale); border-left: 4px solid var(--gold); color: #7c5800; }
.callout.success { background: #f0fdf4; border-left: 4px solid var(--success); color: #14532d; }
.callout.danger  { background: #fef2f2; border-left: 4px solid var(--danger); color: #7f1d1d; }
.callout strong  { display: block; margin-bottom: 4px; font-size: 13px; letter-spacing: .3px; }

/* ═══════════════ CREDENTIAL BOX ═════════════════════ */
.cred-box {
  background: var(--navy);
  border-radius: var(--radius-lg);
  padding: 28px 32px;
  margin: 24px 0;
  position: relative; overflow: hidden;
}
.cred-box::before {
  content: '';
  position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(circle at 90% 50%, rgba(200,150,12,.12), transparent 60%);
}
.cred-box-title {
  font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
  color: rgba(255,255,255,.5); margin-bottom: 18px;
  display: flex; align-items: center; gap: 8px;
}
.cred-box-title i { color: var(--gold-light); }
.cred-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; position: relative; z-index: 1; }
.cred-item {}
.cred-label {
  font-size: 11px; color: rgba(255,255,255,.45);
  text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px;
}
.cred-value {
  font-family: var(--mono); font-size: 18px; font-weight: 500;
  color: var(--gold-light);
  background: rgba(255,255,255,.07);
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 8px; padding: 10px 16px;
  display: flex; align-items: center; justify-content: space-between;
  cursor: pointer; transition: all .2s;
}
.cred-value:hover { background: rgba(255,255,255,.12); }
.cred-value i { font-size: 13px; opacity: .5; }
.cred-note {
  font-size: 12px; color: rgba(255,255,255,.4);
  margin-top: 14px; position: relative; z-index: 1;
}

/* ═══════════════ STEP CARDS ══════════════════════════ */
.steps { display: flex; flex-direction: column; gap: 0; margin: 28px 0; }

.step-item {
  display: flex; gap: 0; position: relative;
}
.step-item:not(:last-child) .step-line {
  position: absolute; left: 19px; top: 44px; bottom: 0;
  width: 2px; background: linear-gradient(to bottom, var(--border-gold), var(--border));
}

.step-left { display: flex; flex-direction: column; align-items: center; margin-right: 24px; }
.step-num {
  width: 40px; height: 40px; border-radius: 50%;
  background: linear-gradient(135deg, var(--navy-mid), var(--navy-light));
  color: var(--white); font-family: var(--serif);
  font-size: 16px; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; box-shadow: 0 2px 8px rgba(26,58,107,.25);
  position: relative; z-index: 1;
}

.step-body { flex: 1; padding-bottom: 32px; }
.step-title {
  font-family: var(--serif); font-size: 18px; font-weight: 700;
  color: var(--navy); margin-bottom: 8px; margin-top: 8px;
}
.step-desc { font-size: 14px; color: var(--ink-mid); line-height: 1.7; margin-bottom: 12px; }

/* ═══════════════ MISSION CARDS ═══════════════════════ */
.missions-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 14px; margin: 28px 0;
}

.mission-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px;
  transition: all .25s;
  cursor: default;
  position: relative; overflow: hidden;
}
.mission-card::before {
  content: ''; position: absolute;
  top: 0; left: 0; right: 0; height: 3px;
  background: linear-gradient(90deg, var(--navy-mid), var(--navy-light));
  opacity: 0; transition: opacity .25s;
}
.mission-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: #b8c8e0; }
.mission-card:hover::before { opacity: 1; }

.mc-top { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
.mc-num {
  width: 32px; height: 32px; border-radius: 8px;
  background: linear-gradient(135deg, var(--navy-mid), var(--navy-light));
  color: var(--white); font-size: 13px; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.mc-title { font-weight: 700; font-size: 14px; color: var(--navy); line-height: 1.3; }
.mc-desc { font-size: 13px; color: var(--ink-mid); line-height: 1.55; margin-bottom: 12px; }
.mc-footer { display: flex; align-items: center; justify-content: space-between; }
.mc-points {
  display: inline-flex; align-items: center; gap: 5px;
  background: var(--gold-pale); border: 1px solid var(--border-gold);
  border-radius: 20px; padding: 3px 10px;
  font-size: 12px; font-weight: 700; color: var(--gold);
}
.mc-points i { font-size: 10px; }
.mc-tag {
  font-size: 11px; color: var(--ink-soft);
  background: #f0f4f8; border-radius: 20px;
  padding: 3px 9px; font-weight: 500;
}

/* MISSION SPECIAL COLORS */
.mission-card.m-gold::before { background: linear-gradient(90deg, var(--gold), var(--gold-light)); opacity: 1; }
.mission-card.m-red::before  { background: linear-gradient(90deg, var(--danger), #ef4444); opacity: 1; }
.mission-card.m-teal::before { background: linear-gradient(90deg, var(--accent-teal), #0891b2); opacity: 1; }

/* ═══════════════ INTERFACE ANATOMY ══════════════════ */
.ui-anatomy {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin: 28px 0;
  box-shadow: var(--shadow-sm);
}
.ua-header {
  background: linear-gradient(135deg, var(--navy) 0%, #1e4080 100%);
  padding: 14px 20px;
  display: flex; align-items: center; gap: 12px; color: white;
}
.ua-header i { color: var(--gold-light); font-size: 16px; }
.ua-header span { font-size: 14px; font-weight: 600; }
.ua-body { padding: 0; }

.ua-row {
  display: flex; align-items: flex-start; gap: 0;
  border-bottom: 1px solid var(--border);
}
.ua-row:last-child { border-bottom: none; }
.ua-zone {
  padding: 16px 20px; flex: 1;
  border-right: 1px solid var(--border);
  font-size: 13px;
}
.ua-zone:last-child { border-right: none; }
.ua-zone-label {
  font-size: 10px; font-weight: 700; text-transform: uppercase;
  letter-spacing: 1.2px; color: var(--ink-soft); margin-bottom: 6px;
}
.ua-zone-name { font-weight: 700; color: var(--navy); margin-bottom: 4px; font-size: 14px; }
.ua-zone-desc { color: var(--ink-mid); line-height: 1.5; font-size: 13px; }

.zone-tag {
  display: inline-flex; align-items: center; gap: 4px;
  background: #f0f4ff; border: 1px solid #c5d5f5;
  border-radius: 6px; padding: 2px 8px;
  font-size: 11px; color: var(--navy-mid); font-weight: 600;
  margin-top: 6px;
}

/* ═══════════════ TIPS ════════════════════════════════ */
.tips-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 28px 0; }
.tip-card {
  background: var(--white); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 18px 18px 16px;
  display: flex; gap: 14px; transition: box-shadow .2s;
}
.tip-card:hover { box-shadow: var(--shadow-sm); }
.tip-icon {
  width: 38px; height: 38px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; flex-shrink: 0;
}
.tip-icon.blue  { background: #eff6ff; color: #1d4ed8; }
.tip-icon.gold  { background: var(--gold-pale); color: var(--gold); }
.tip-icon.green { background: #f0fdf4; color: var(--success); }
.tip-icon.red   { background: #fef2f2; color: var(--danger); }
.tip-icon.teal  { background: #f0fdfa; color: var(--accent-teal); }
.tip-icon.purple{ background: #faf5ff; color: #7c3aed; }
.tip-title  { font-weight: 700; font-size: 14px; color: var(--navy); margin-bottom: 5px; }
.tip-desc   { font-size: 13px; color: var(--ink-mid); line-height: 1.55; }

/* ═══════════════ MODULE TABLE ════════════════════════ */
.module-table {
  width: 100%; border-collapse: collapse;
  margin: 20px 0; font-size: 13px;
  border-radius: var(--radius-lg); overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.module-table th {
  background: var(--navy); color: var(--white);
  padding: 12px 16px; text-align: left;
  font-size: 11px; font-weight: 600;
  text-transform: uppercase; letter-spacing: 1px;
}
.module-table td {
  padding: 11px 16px; border-bottom: 1px solid var(--border);
  vertical-align: top; background: var(--white);
}
.module-table tr:last-child td { border-bottom: none; }
.module-table tr:hover td { background: #f8fafd; }
.module-table td:first-child { font-weight: 700; color: var(--navy); white-space: nowrap; }
.mod-icon {
  width: 28px; height: 28px; border-radius: 7px;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 12px; margin-right: 8px; vertical-align: middle;
}

/* ═══════════════ SCORING TABLE ═══════════════════════ */
.score-table {
  width: 100%; border-collapse: collapse;
  margin: 20px 0; font-size: 14px;
}
.score-table th {
  background: #f8fafd; padding: 10px 16px;
  border-bottom: 2px solid var(--border);
  font-size: 12px; font-weight: 700; text-transform: uppercase;
  letter-spacing: .5px; color: var(--ink-soft); text-align: left;
}
.score-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); }
.score-table tr:last-child td { border-bottom: none; }
.grade-bar {
  height: 8px; border-radius: 4px;
  display: inline-block; margin-right: 8px; vertical-align: middle;
}

/* ═══════════════ FAQ ═════════════════════════════════ */
.faq { margin: 20px 0; }
.faq-item {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 10px;
  overflow: hidden;
  background: var(--white);
}
.faq-q {
  padding: 16px 20px;
  font-weight: 600; font-size: 14px; color: var(--navy);
  cursor: pointer; display: flex; align-items: center; justify-content: space-between;
  transition: background .2s; user-select: none;
}
.faq-q:hover { background: #f8fafd; }
.faq-q .faq-arrow { transition: transform .3s; color: var(--ink-soft); font-size: 12px; }
.faq-q.open .faq-arrow { transform: rotate(180deg); }
.faq-a {
  padding: 0 20px; max-height: 0; overflow: hidden;
  transition: max-height .35s ease, padding .35s ease;
  font-size: 14px; color: var(--ink-mid); line-height: 1.7;
  border-top: 0 solid var(--border);
}
.faq-a.open {
  max-height: 400px; padding: 14px 20px 18px;
  border-top-width: 1px;
}

/* ═══════════════ CODE BLOCKS ═════════════════════════ */
.kbd {
  display: inline-flex; align-items: center;
  background: var(--navy); color: var(--gold-light);
  font-family: var(--mono); font-size: 13px;
  padding: 3px 10px; border-radius: 6px;
  border: 1px solid rgba(200,150,12,.25);
  letter-spacing: .5px;
}

/* ═══════════════ FLOWCHART ═══════════════════════════ */
.flow {
  display: flex; align-items: center; gap: 0;
  flex-wrap: wrap; margin: 20px 0; padding: 20px;
  background: #f8fafd; border-radius: var(--radius-lg);
  border: 1px solid var(--border);
}
.flow-step {
  display: flex; align-items: center; gap: 8px;
  background: var(--white); border: 1px solid var(--border);
  border-radius: 8px; padding: 9px 14px;
  font-size: 13px; font-weight: 600; color: var(--navy);
  white-space: nowrap;
  box-shadow: var(--shadow-sm);
}
.flow-step i { color: var(--gold); font-size: 13px; }
.flow-arrow { color: var(--ink-soft); font-size: 14px; margin: 0 6px; flex-shrink: 0; }

/* ═══════════════ ROLES CARDS ═════════════════════════ */
.roles-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 14px; margin: 24px 0; }
.role-card {
  background: var(--white); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 18px;
}
.role-card-top {
  display: flex; align-items: center; gap: 12px; margin-bottom: 12px;
}
.role-icon {
  width: 40px; height: 40px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center; font-size: 16px;
}
.role-name { font-weight: 700; font-size: 14px; color: var(--navy); }
.role-badge { font-size: 11px; color: var(--ink-soft); }
.role-perms { list-style: none; }
.role-perms li {
  font-size: 13px; color: var(--ink-mid);
  padding: 4px 0; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: 8px;
}
.role-perms li:last-child { border-bottom: none; }
.role-perms li i { color: var(--success); font-size: 11px; flex-shrink: 0; }

/* ═══════════════ FOOTER ══════════════════════════════ */
.doc-footer {
  background: var(--navy);
  color: rgba(255,255,255,.6);
  padding: 40px;
  text-align: center;
  font-size: 13px;
  margin-top: 60px;
}
.doc-footer strong { color: var(--gold-light); }
.doc-footer .footer-logo {
  font-family: var(--serif); font-size: 22px;
  color: var(--white); margin-bottom: 8px;
}

/* ═══════════════ BACK-TO-TOP ═════════════════════════ */
.btt {
  position: fixed; bottom: 28px; right: 28px;
  width: 44px; height: 44px; border-radius: 50%;
  background: var(--navy-mid); color: var(--white);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; box-shadow: var(--shadow-lg);
  font-size: 16px; border: none;
  opacity: 0; pointer-events: none;
  transition: all .3s;
  z-index: 200;
}
.btt.visible { opacity: 1; pointer-events: auto; }
.btt:hover { background: var(--navy-light); transform: translateY(-2px); }

/* ═══════════════ READING PROGRESS ════════════════════ */
.reading-bar {
  position: fixed; top: 0; left: 0; height: 3px;
  background: linear-gradient(90deg, var(--gold), var(--gold-light));
  z-index: 9999; transition: width .1s;
  width: 0%;
}

/* ═══════════════ HIGHLIGHT TAGS ═════════════════════ */
.tag {
  display: inline-flex; align-items: center; gap: 4px;
  border-radius: 6px; padding: 2px 8px;
  font-size: 12px; font-weight: 600;
}
.tag-navy   { background: #e8eef8; color: var(--navy-mid); }
.tag-gold   { background: var(--gold-pale); color: #8a6400; }
.tag-green  { background: #f0fdf4; color: var(--success); }
.tag-red    { background: #fef2f2; color: var(--danger); }

/* ═══════════════ ORDERED INSTRUCTIONS ═══════════════ */
.inst-list { list-style: none; margin: 16px 0; }
.inst-list li {
  display: flex; gap: 14px; padding: 10px 0;
  border-bottom: 1px solid var(--border);
  font-size: 14px; color: var(--ink-mid); line-height: 1.6;
  align-items: flex-start;
}
.inst-list li:last-child { border-bottom: none; }
.inst-list .il-num {
  width: 24px; height: 24px; border-radius: 50%;
  background: linear-gradient(135deg, var(--navy-mid), var(--navy-light));
  color: var(--white); font-size: 11px; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  margin-top: 1px;
}

/* ═══════════════ DIVIDERS ════════════════════════════ */
.ornament {
  text-align: center; padding: 20px 0; color: var(--border-gold);
  font-size: 18px; letter-spacing: 12px;
}

/* ═══════════════ RESPONSIVE ══════════════════════════ */
@media (max-width: 680px) {
  .hero-inner { flex-direction: column; gap: 24px; padding: 40px 24px; }
  .container  { padding: 0 24px; }
  .missions-grid, .tips-grid, .roles-grid, .cred-grid { grid-template-columns: 1fr; }
  .flow { flex-direction: column; align-items: flex-start; }
}

/* ═══════════════ ANIMATIONS ══════════════════════════ */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}
.animate-up { animation: fadeUp .6s ease both; }
.delay-1 { animation-delay: .1s; }
.delay-2 { animation-delay: .2s; }
.delay-3 { animation-delay: .3s; }
</style>
</head>
<body>

<!-- Reading Progress Bar -->
<div class="reading-bar" id="readingBar"></div>

<!-- ═══════════════════════ HERO ════════════════════════════ -->
<section class="hero">
  <div class="hero-pattern"></div>
  <div class="hero-inner">
    <div class="hero-emblem animate-up">
      <i class="fas fa-shield-alt"></i>
    </div>
    <div class="hero-text">
      <div class="hero-eyebrow animate-up delay-1">
        <i class="fas fa-book-open"></i>
        Руководство пользователя
      </div>
      <h1 class="animate-up delay-2">
        Симулятор <span>СОКД</span><br>МВД России
      </h1>
      <p class="hero-sub animate-up delay-3">
