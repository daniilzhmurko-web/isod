function goTab(tab) {
  S.activeTab = tab;
  ['dash','graph','sim','chat'].forEach(t => {
    document.getElementById(t+'P').classList.toggle('on', t === tab);
    document.getElementById('nv-'+t).classList.toggle('on', t === tab);
