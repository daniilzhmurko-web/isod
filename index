/* ── STICKY NAV ── */
.sticky-nav{position:fixed;top:0;left:0;right:0;background:rgba(246,248,251,.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--br);padding:10px 24px;display:flex;align-items:center;justify-content:space-between;z-index:100;transform:translateY(-100%);transition:transform .3s}
