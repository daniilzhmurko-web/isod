  try{if(s.validate()){s.done=true;S.score+=s.pts;S.correctAct++;S.totalAct++;showInstStatus('ok',`✅ Шаг выполнен! +${s.pts} очков`);addLog(`Шаг: ${s.title}`,'ok');spop(`+${s.pts}`,true);updateHeader();renderInstSteps();setTimeout(()=>{const b=document.getElementById('inst-next');if(b)b.disabled=false;},400);}}catch(e){}
}
function instNext(){
  const s=getCurStep();
  if(s&&!s.done){S.totalAct++;CQ.hintCnt++;showInstStatus('err','❌ Шаг не выполнен');showHint(s,CQ.hintCnt);S.behaviors.errors++;return;}
  const lv=QUESTS[CQ.level];
  if(CQ.step<lv.steps.length-1){CQ.step++;CQ.hintCnt=0;renderInst();}
  else completeLevel();
}
function instPrev(){if(CQ.step>0){CQ.step--;renderInst();}else if(CQ.level>0){CQ.level--;CQ.step=QUESTS[CQ.level].steps.length-1;renderInst();}}
function instSkip(){const s=getCurStep();if(s)s.done=true;instNext();}
function completeLevel(){
  QUESTS[CQ.level].done=true;LEVELS[CQ.level].done=true;
  notify('ok',`Уровень ${CQ.level+1} пройден!`,LEVELS[CQ.level].desc);
  showAch(LEVELS[CQ.level].icon,`Уровень: ${LEVELS[CQ.level].name}`);
  addLog(`Уровень завершён: ${LEVELS[CQ.level].name}`,'ok');
  if(CQ.level<QUESTS.length-1){CQ.level++;CQ.step=0;CQ.hintCnt=0;renderInst();renderTBProg();}
  else showInstStatus('ok','🏆 Все уровни пройдены! Симулятор завершён.');
  updateHeader();checkAch();
}
function showHint(s,cnt){
  const hints=[s.hint,`Подсказка 2: ${s.desc}`,`Решение: ${s.hint} — выполните действие.`];
  const h=hints[Math.min(cnt-1,hints.length-1)];
  const ha=document.getElementById('inst-hint-area');
  if(ha)ha.innerHTML=`<div class="inst-hint"><div class="inst-hint-t">💡 Подсказка ${cnt}</div>${h}</div>`;
}
function showInstStatus(type,msg){
  const el=document.getElementById('inst-stat');if(!el)return;
  el.style.display='flex';el.className=`inst-stat ${type}`;
  el.innerHTML=`<span>${type==='ok'?'✅':type==='err'?'❌':'⏳'}</span> ${msg}`;
}
function renderInst(){
  const lv=QUESTS[CQ.level];if(!lv)return;
  const s=lv.steps[CQ.step];if(!s)return;
  const badge=document.getElementById('inst-lvbadge');if(badge)badge.textContent=`Уровень ${CQ.level+1}: ${LEVELS[CQ.level].name}`;
  const tt=document.getElementById('inst-tt');if(tt)tt.textContent=`${LEVELS[CQ.level].icon} Шаг ${CQ.step+1}: ${s.title}`;
  const td=document.getElementById('inst-td');if(td)td.textContent=s.desc;
  const ha=document.getElementById('inst-hint-area');
  if(ha)ha.innerHTML=S.user.mode==='training'?`<div class="inst-hint"><div class="inst-hint-t">💡 Подсказка</div>${s.hint}</div>`:'';
  const stat=document.getElementById('inst-stat');if(stat)stat.style.display='none';
  const pf=document.getElementById('inst-progf');if(pf)pf.style.width=(CQ.step/lv.steps.length*100)+'%';
  const pt=document.getElementById('inst-prt');if(pt)pt.textContent=`${CQ.step}/${lv.steps.length}`;
  const nb=document.getElementById('inst-next');if(nb)nb.disabled=!s.done&&S.user.mode!=='teacher';
  const sk=document.getElementById('inst-skip');if(sk)sk.style.display=S.teacherMode?'':'none';
  renderInstSteps();checkStep();
}
function renderInstSteps(){
  const lv=QUESTS[CQ.level];if(!lv)return;
  const c=document.getElementById('inst-slist');if(!c)return;
  c.innerHTML=lv.steps.map((s,i)=>`<div class="istep ${s.done?'done':i===CQ.step?'cur':''}" onclick="CQ.step=${i};renderInst()"><div class="isn">${s.done?'✓':i+1}</div><div class="ist">${s.title}</div></div>`).join('');
}
function toggleInst(){S.instCollapsed=!S.instCollapsed;document.getElementById('inst').classList.toggle('collapsed',S.instCollapsed);const ico=document.getElementById('inst-col-ico');if(ico)ico.textContent=S.instCollapsed?'▲':'▼';}
function renderTBProg(){
  const c=document.getElementById('tb-prog');if(!c)return;
  c.innerHTML=LEVELS.map((lv,i)=>`<div class="tb-lv ${lv.done?'done':i===CQ.level?'cur':i>CQ.level&&!S.teacherMode?'lock':''}" onclick="${S.teacherMode?`jmpLevel(${i})`:''}"><span>${lv.icon}</span><div class="tb-lv-tip">${lv.name}: ${lv.desc}</div></div>`).join('');
}
function jmpLevel(i){if(!S.teacherMode)return;CQ.level=i;CQ.step=0;renderInst();renderTBProg();notify('info',`Уровень ${i+1}`,LEVELS[i].name);}

