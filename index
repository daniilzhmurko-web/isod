    this.showM('Профиль пользователя',`<div style="text-align:center;padding:8px 0 16px"><div style="width:60px;height:60px;background:linear-gradient(135deg,var(--primary),var(--mvd-mid));border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:24px;font-weight:800;color:#fff;margin-bottom:12px">${u.av||'?'}</div><div style="font-size:17px;font-weight:800">${u.nm||'—'}</div><div style="color:var(--tm);font-size:12.5px">${R[u.role]||'—'}</div><div style="margin:16px 0;background:var(--bg-hv);border-radius:var(--r);padding:14px"><div style="font-size:26px;font-weight:800;color:var(--primary)">${p.xp} XP</div><div style="font-size:13px;color:var(--ts);margin-top:2px">${this.rn(p.xp)}</div><div class="xb mt8"><div class="xf" style="width:${this.xpP(p.xp)}%"></div></div></div><div style="font-size:13px;color:var(--ts)">Завершено миссий: <strong>${p.done.length}</strong> / 3 | Действий в журнале: <strong>${this.s.audit.length}</strong></div></div>`,'fas fa-user-shield',[{l:'Сбросить прогресс',a:'SYS.reset()',cl:'btn-d'}]);
  },
  tgSB(){this.sbCol=!this.sbCol;document.getElementById('SB').classList.toggle('col',this.sbCol);}
};


