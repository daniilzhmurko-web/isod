.badge-blue  { background: rgba(30,95,168,.25); border: 1px solid rgba(30,95,168,.5); color: #7ec8ff; }
.badge-gold  { background: rgba(200,164,21,.2);  border: 1px solid rgba(200,164,21,.4); color: var(--gold-light); }
.badge-red   { background: rgba(192,57,43,.2);   border: 1px solid rgba(192,57,43,.4); color: #ff9090; }
.hero-wave {
  position: absolute;
  bottom: -1px; left: 0; right: 0;
  height: 60px;
  background: var(--cream);
  clip-path: ellipse(55% 100% at 50% 100%);
