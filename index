const DB={vehicles:[],licenses:[],violations:[],special:[],specMoves:[],wanted:[],vHistory:[]};

function initDB(){
  // Vehicles
  const wantedPlates=['К777АВ77','Х001РОС77','М555НА50'];
  const usedVINs=[];
  for(let i=0;i<50;i++){
    const brand=rnd(BRANDS);
