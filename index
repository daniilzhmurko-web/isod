      if(mod==='mobile'){document.getElementById('CT').innerHTML=this.pgMobile();document.querySelectorAll('.sb-it').forEach(el=>el.classList.remove('act'));document.getElementById('hBc').textContent='Мобильный АРМ';this.s.mod=mod;this.save();this.valStep(mod);return;}
