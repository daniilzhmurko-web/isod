}

function setSpd(v) {
  S.speed = v;
  ['05','1','2','5'].forEach(x => document.getElementById('s'+x).classList.remove('on'));
  document.getElementById('s'+String(v).replace('.','0')).classList.add('on');
}

function notify(msg, type = 'info') {
  const n = document.createElement('div');
  n.className = 'notif ' + (type === 'ok' ? 'ok' : type === 'err' ? 'err' : type === 'warn' ? 'warn' : '');
  n.innerHTML = `<div class="notif-t">${msg}</div>`;
  document.body.appendChild(n);
  setTimeout(() => n.remove(), 3200);
}

