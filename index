function filterRegistry(){
  const q=(document.getElementById('registrySearch')?.value||'').toLowerCase();
  const dept=document.getElementById('regFilterDept')?.value||'';
  const status=document.getElementById('regFilterStatus')?.value||'';
  const tabel=(document.getElementById('adv_tabel')?.value||'').trim();
  const rank=document.getElementById('adv_rank')?.value||'';
  STATE.regFiltered=STATE.employees.filter(e=>{
    const fio=`${e.surname} ${e.name} ${e.patronymic} ${e.tabel} ${e.post}`.toLowerCase();
    if(q&&!fio.includes(q))return false;
    if(dept&&e.dept!==dept)return false;
    if(status&&e.status!==status)return false;
    if(tabel&&!e.tabel.includes(tabel))return false;
    if(rank&&e.rank!==rank)return false;
    return true;
  });
  STATE.regPage=1;
  renderRegistry();
}

function regPage(dir){
  const perPage=parseInt(document.getElementById('regPerPage')?.value||20);
  const total=Math.ceil(STATE.regFiltered.length/perPage)||1;
  STATE.regPage=Math.max(1,Math.min(total,STATE.regPage+dir));
  renderRegistry();
}

