function answerQuiz(idx) {
  if (quizState.finished) return;
  const q = QUIZ_QUESTIONS[quizState.current];
  if (!q) return;
  const opts = document.querySelectorAll('.quiz-option');
  opts.forEach(o => o.classList.add('disabled'));

  if (idx === q.correct) {
    opts[idx].classList.add('correct');
    quizState.score++;
    quizState.answers.push({ correct: true });
    showToast('Верно! +1 очко', 'success');
  } else {
    opts[idx].classList.add('wrong');
    opts[q.correct].classList.add('correct');
    quizState.answers.push({ correct: false });
    showToast('Неверно. Смотрите пояснение.', 'error');
  }

  // Показать пояснение
  document.getElementById('quizExplanation').style.display = 'block';
  document.getElementById('explanationText').textContent = q.explanation;
  document.getElementById('quizNext').style.display = 'block';
}

let _quizNavigating = false;
function nextQuizQuestion() {
  if (_quizNavigating) return;
  _quizNavigating = true;
  quizState.current++;
  if (quizState.current >= QUIZ_QUESTIONS.length) {
    quizState.finished = true;
  }
  renderWorkspace('knowledge');
  setTimeout(() => { _quizNavigating = false; }, 400);
}

function renderQuizResults() {
  const pct = Math.round((quizState.score / QUIZ_QUESTIONS.length) * 100);
  let grade, color, icon;
  if (pct >= 90) { grade='Отлично'; color='var(--success)'; icon='🏆'; }
  else if (pct >= 75) { grade='Хорошо'; color='var(--primary)'; icon='🎖️'; }
  else if (pct >= 60) { grade='Удовлетворительно'; color='var(--warning)'; icon='📋'; }
  else { grade='Неудовлетворительно'; color='var(--error)'; icon='📉'; }

  return `
  <div class="workspace-header"><div class="ws-title">Результаты теста</div></div>
  <div class="card" style="max-width:480px;text-align:center;padding:40px">
    <div style="font-size:64px;margin-bottom:16px">${icon}</div>
    <div style="font-size:48px;font-weight:900;font-family:var(--font-mono);color:${color};margin-bottom:8px">${pct}%</div>
    <div style="font-size:20px;font-weight:700;color:var(--primary);margin-bottom:8px">${grade}</div>
    <div style="font-size:14px;color:var(--text-muted);margin-bottom:24px">
      Правильных ответов: <strong>${quizState.score}</strong> из <strong>${QUIZ_QUESTIONS.length}</strong>
    </div>
    <div style="display:flex;gap:10px;justify-content:center">
