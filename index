<script>
// ══════════════════════════════════════════════════════
// STAGE 5-PRE: Буфер pending change + надёжный change listener
// ══════════════════════════════════════════════════════
'use strict';

// Глобальный буфер: если пользователь выбрал пользователя до готовности Engine
window._pendingUserChange = null;

// Перехват change на dropdown с буферизацией
document.getElementById('sed-user-dropdown').addEventListener('change', function(e) {
  const val = e.target.value;
  if (!val) return;
  
  // Применить UI смену сразу
  if (State.region && State.region.users[val]) {
    const u = State.region.users[val];
    document.getElementById('sed-username').textContent = u.name;
    document.getElementById('sed-userrole').textContent = u.rank;
    document.getElementById('sed-avatar').textContent = u.avatar;
    document.getElementById('sed-operator').textContent = u.name;
    document.getElementById('sim-operator-name').textContent = u.name;
    document.getElementById('sed-user-dropdown').style.display = 'none';
  }
  
  // Попробовать передать в Engine
  function tryHit() {
    if (Engine.waiting && Engine._cur && Engine._cur.action === 'change') {
      Engine.hit('change', e.target, val);
      window._pendingUserChange = null;
    } else {
      // Engine ещё не готов — сохранить в буфер
      window._pendingUserChange = val;
    }
  }
  
  tryHit();
  // Повторить попытку через 200, 500, 1000, 1500ms
  [200, 500, 1000, 1500].forEach(delay => {
    setTimeout(() => {
      if (window._pendingUserChange === val) tryHit();
    }, delay);
  });
}, true); // capturing = до inline onchange
</script>

