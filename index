.istep-num{width:20px;height:20px;border-radius:50%;background:var(--border);font-family:var(--font);font-size:10px;font-weight:700;color:var(--txt2);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.2s}
.istep.done .istep-num{background:var(--green);color:#fff}
.istep.cur .istep-num{background:var(--blue);color:#fff}
.istep.err .istep-num{background:var(--red);color:#fff}
.istep-txt{font-size:11px;color:var(--txt2);line-height:1.4}
.istep.cur .istep-txt{color:var(--txt);font-weight:700}
.istep.done .istep-txt{color:var(--green);text-decoration:line-through;opacity:.7}
.inst-detail{flex:1;overflow-y:auto}
.inst-task-title{font-family:var(--font);font-size:13px;font-weight:800;color:var(--txt);margin-bottom:6px}
.inst-task-desc{font-size:12px;color:var(--txt2);line-height:1.6;margin-bottom:10px}
.inst-hint-box{background:var(--blue-xl);border-radius:var(--r);padding:9px 12px;border-left:3px solid var(--blue);font-size:12px;color:var(--txt2);margin-bottom:9px}
.inst-hint-title{font-family:var(--font);font-size:10px;font-weight:700;color:var(--blue);text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px}
.inst-status{display:flex;align-items:center;gap:7px;font-size:12px;padding:7px 11px;border-radius:var(--r);margin-bottom:9px}
.inst-status.ok{background:var(--green-l);color:var(--green)}
.inst-status.err{background:var(--red-l);color:var(--red)}
.inst-status.wait{background:var(--orange-l);color:var(--orange)}
.inst-nav{display:flex;gap:7px;margin-top:auto;flex-shrink:0}
.inst-btn{padding:6px 14px;border-radius:var(--r);font-family:var(--font);font-size:11px;font-weight:700;cursor:pointer;transition:.2s;display:flex;align-items:center;gap:5px}
.inst-btn-prev{background:var(--bg3);color:var(--txt2);border:1.5px solid var(--border)}
.inst-btn-prev:hover{border-color:var(--blue);color:var(--blue)}
.inst-btn-next{background:var(--blue);color:#fff}
.inst-btn-next:hover{background:var(--blue2)}
.inst-btn-next:disabled{opacity:.4;cursor:not-allowed}
.inst-btn-finish{background:var(--green);color:#fff}
.inst-btn-finish:hover{background:var(--green)}
.inst-btn-skip{background:var(--orange-l);color:var(--orange);border:1.5px solid var(--orange)}

/* ════════════════════════════════════════════
   МОДАЛЬНЫЕ ОКНА
════════════════════════════════════════════ */
.overlay{position:fixed;inset:0;background:rgba(10,20,50,.5);z-index:500;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(3px)}
.overlay.hide{display:none}
.modal{background:#fff;border-radius:var(--r3);width:680px;max-width:95vw;max-height:88vh;overflow:hidden;box-shadow:var(--shadow3);animation:popIn .25s ease}
.modal-lg{width:920px}
.mhdr{padding:18px 22px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.mtitle{font-family:var(--font);font-size:15px;font-weight:800;color:var(--txt);display:flex;align-items:center;gap:9px}
.mbdy{padding:20px 22px;overflow-y:auto;max-height:60vh}
.mftr{padding:14px 22px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:9px}
.closex{width:28px;height:28px;border-radius:50%;background:var(--bg3);color:var(--txt2);font-size:14px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.2s}
.closex:hover{background:var(--red-l);color:var(--red)}

/* ФОРМА ПИСЬМА */
.compose-wrap{height:100%;display:flex;flex-direction:column}
.compose-field{display:flex;align-items:center;padding:8px 14px;border-bottom:1px solid var(--border);gap:9px}
.compose-lbl{font-family:var(--font);font-size:11px;font-weight:700;color:var(--txt2);width:40px;flex-shrink:0;text-transform:uppercase;letter-spacing:.5px}
.compose-input{flex:1;border:none;font-size:13px;color:var(--txt);background:transparent;padding:2px 0}
.compose-input:focus{outline:none}
.compose-body-wrap{flex:1;padding:14px;overflow:hidden;display:flex;flex-direction:column}
.compose-body{flex:1;resize:none;border:none;font-size:13px;color:var(--txt);line-height:1.6;font-family:var(--body)}
.compose-body:focus{outline:none}
.compose-toolbar{display:flex;align-items:center;gap:6px;padding:9px 14px;border-top:1px solid var(--border);background:var(--bg3)}
.compose-tb-btn{padding:5px 12px;border:1.5px solid var(--border);border-radius:var(--r);font-size:11px;color:var(--txt2);background:#fff;cursor:pointer;transition:.2s;font-family:var(--font);font-weight:600;display:flex;align-items:center;gap:5px}
.compose-tb-btn:hover{border-color:var(--blue);color:var(--blue);background:var(--blue-xl)}
.compose-tb-btn.send{background:var(--blue);color:#fff;border-color:var(--blue)}
.compose-tb-btn.send:hover{background:var(--blue2)}
.attach-list{display:flex;flex-wrap:wrap;gap:6px;padding:9px 14px;border-top:1px solid var(--border)}
.attach-chip{display:inline-flex;align-items:center;gap:6px;padding:4px 9px;background:var(--blue-xl);border:1px solid rgba(21,101,192,.2);border-radius:20px;font-size:11px;color:var(--blue)}
.attach-chip-del{cursor:pointer;opacity:.6;font-size:12px}
.attach-chip-del:hover{opacity:1}

/* АДРЕСНАЯ КНИГА */
.contact-item{display:flex;align-items:center;gap:11px;padding:9px 12px;border-radius:var(--r);cursor:pointer;transition:.2s}
.contact-item:hover{background:var(--bg3)}
.contact-av{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font);font-size:13px;font-weight:700;color:#fff;flex-shrink:0}
.contact-name{font-family:var(--font);font-size:12px;font-weight:700;color:var(--txt)}
.contact-email{font-size:11px;color:var(--txt3)}
.contact-dept{font-size:10px;color:var(--txt3)}

/* ПРАВИЛА */
.rule-card{padding:12px 14px;border-radius:var(--r);border:1.5px solid var(--border);margin-bottom:9px;cursor:pointer;transition:.2s}
.rule-card:hover{border-color:var(--blue);background:var(--blue-xl)}
.rule-card.active{border-color:var(--green);background:var(--green-l)}
.rule-title{font-family:var(--font);font-size:12px;font-weight:700;color:var(--txt)}
.rule-desc{font-size:11px;color:var(--txt2);margin-top:2px}
.rule-status{font-size:10px;margin-top:4px}

/* КАЛЕНДАРЬ */
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-top:9px}
.cal-head{font-family:var(--font);font-size:10px;font-weight:700;color:var(--txt3);text-align:center;padding:4px}
.cal-day{padding:6px;text-align:center;border-radius:var(--r);cursor:pointer;font-size:12px;color:var(--txt2);transition:.2s}
.cal-day:hover{background:var(--bg3)}
.cal-day.today{background:var(--blue);color:#fff;font-weight:700}
.cal-day.has-event{background:var(--blue-xl);color:var(--blue);font-weight:700}
.cal-event{padding:6px 9px;background:var(--blue-xl);border-left:3px solid var(--blue);border-radius:var(--r);font-size:11px;margin-bottom:6px;color:var(--txt)}

/* ЗАДАЧИ */
.task-item{display:flex;align-items:center;gap:9px;padding:8px 0;border-bottom:1px solid var(--border)}
.task-check{width:18px;height:18px;border-radius:50%;border:2px solid var(--border);cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.2s}
.task-check.done{background:var(--green);border-color:var(--green);color:#fff}
.task-txt{font-size:12px;color:var(--txt);flex:1}
.task-txt.done{text-decoration:line-through;color:var(--txt3)}
.task-priority{font-size:9px;font-family:var(--font);font-weight:700;padding:2px 6px;border-radius:3px}
.tp-high{background:var(--red-l);color:var(--red)}
.tp-med{background:var(--orange-l);color:var(--orange)}
.tp-low{background:var(--green-l);color:var(--green)}

/* НАСТРОЙКИ/ФИЛЬТРЫ */
.filter-rule{padding:11px 14px;border:1.5px solid var(--border);border-radius:var(--r);margin-bottom:9px;background:var(--bg3)}
.filter-cond{display:flex;gap:7px;align-items:center;margin-bottom:7px}
.filter-sel{padding:5px 9px;border:1.5px solid var(--border);border-radius:var(--r);font-size:12px;background:#fff;color:var(--txt);cursor:pointer}
.filter-inp{flex:1;padding:5px 9px;border:1.5px solid var(--border);border-radius:var(--r);font-size:12px;color:var(--txt);background:#fff}
.filter-inp:focus{outline:none;border-color:var(--blue)}

/* УВЕДОМЛЕНИЯ */
#notifs{position:fixed;top:60px;right:14px;z-index:2000;display:flex;flex-direction:column;gap:8px;max-width:300px}
.notif{background:#fff;border-radius:var(--r);padding:11px 14px;box-shadow:var(--shadow2);animation:notif 4s ease forwards;font-size:12px;display:flex;gap:9px;border-left:4px solid var(--blue)}
.notif.ok{border-color:var(--green)}
.notif.err{border-color:var(--red)}
.notif.warn{border-color:var(--orange)}

/* ЭКЗАМЕН */
.exam-overlay{position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:3000;display:none;align-items:center;justify-content:center;backdrop-filter:blur(5px)}
.exam-overlay.on{display:flex}
.exam-card{background:#fff;border-radius:20px;width:760px;max-width:95vw;padding:40px;box-shadow:0 20px 60px rgba(0,0,0,.5);animation:popIn .3s ease}
.exam-title{font-family:var(--font);font-size:24px;font-weight:800;text-align:center;margin-bottom:8px}
.exam-sub{font-size:13px;color:var(--txt2);text-align:center;margin-bottom:30px}
.exam-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:24px}
.exam-stat{padding:18px;background:var(--bg3);border-radius:var(--r2);text-align:center;border:2px solid var(--border)}
.exam-stat-val{font-family:var(--font);font-size:30px;font-weight:800}
.exam-stat-lbl{font-size:11px;color:var(--txt2);margin-top:3px}
.exam-grade{font-family:var(--font);font-size:60px;font-weight:800;text-align:center;margin:20px 0}

/* АНТИЧИТ */
#ac-ind{position:fixed;bottom:12px;right:12px;z-index:700;background:#fff;border:1.5px solid var(--border);border-radius:var(--r);padding:6px 11px;display:flex;align-items:center;gap:7px;font-size:11px;color:var(--txt2);box-shadow:var(--shadow)}
.ac-dot{width:7px;height:7px;border-radius:50%;background:var(--green);flex-shrink:0}
.ac-dot.warn{background:var(--gold);animation:pulse 1s infinite}
.ac-dot.danger{background:var(--red);animation:pulse .5s infinite}

/* КНОПКИ ОБЩИЕ */
.btn{padding:7px 16px;border-radius:var(--r);font-family:var(--font);font-size:12px;font-weight:700;transition:.2s;cursor:pointer;display:inline-flex;align-items:center;gap:5px}
.btn-p{background:var(--blue);color:#fff;box-shadow:0 2px 8px rgba(21,101,192,.3)}
.btn-p:hover{background:var(--blue2);transform:translateY(-1px)}
.btn-s{background:var(--bg3);color:var(--txt);border:1.5px solid var(--border)}
.btn-s:hover{border-color:var(--blue);color:var(--blue)}
.btn-d{background:var(--red);color:#fff}
.btn-ok{background:var(--green);color:#fff}
.btn-sm{padding:4px 10px;font-size:11px}

/* БЕЙДЖИ */
.badge{display:inline-flex;align-items:center;padding:2px 7px;border-radius:20px;font-size:10px;font-weight:700;font-family:var(--font)}
.b-blue{background:var(--blue-xl);color:var(--blue)}
.b-green{background:var(--green-l);color:var(--green)}
.b-red{background:var(--red-l);color:var(--red)}
.b-orange{background:var(--orange-l);color:var(--orange)}
.b-gray{background:var(--bg3);color:var(--txt2);border:1px solid var(--border)}

/* ФОРМА */
.fg{margin-bottom:14px}
.fl{font-family:var(--font);font-size:10px;font-weight:700;color:var(--txt2);text-transform:uppercase;letter-spacing:.7px;display:block;margin-bottom:5px}
.fi{width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:var(--r);font-size:13px;color:var(--txt);background:var(--bg3);transition:.2s}
.fi:focus{border-color:var(--blue);background:#fff;box-shadow:0 0 0 3px rgba(21,101,192,.08)}
.fi.err{border-color:var(--red);background:var(--red-l)}
.fi.ok{border-color:var(--green);background:var(--green-l)}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:11px}

/* SCORE POPUP */
.spop{position:fixed;z-index:3000;pointer-events:none;font-family:var(--font);font-size:22px;font-weight:800;animation:spopAnim 1.5s ease forwards}
.spop.pos{color:var(--green)}.spop.neg{color:var(--red)}.spop.bonus{color:var(--gold)}
@keyframes spopAnim{0%{opacity:1;transform:translateY(0)scale(1)}100%{opacity:0;transform:translateY(-50px)scale(1.3)}}

/* STAT MINI CARDS */
.ministat{background:var(--bg3);border:1px solid var(--border);border-radius:var(--r);padding:9px 12px;display:flex;flex-direction:column;gap:2px}
.ministat-val{font-family:var(--font);font-size:20px;font-weight:800}
.ministat-lbl{font-size:10px;color:var(--txt3)}

/* HIGHLIGHT PULSE (для обучения) */
.highlight-pulse{animation:hpulse 2s ease infinite}
@keyframes hpulse{0%,100%{box-shadow:0 0 0 0 rgba(21,101,192,.4)}50%{box-shadow:0 0 0 8px rgba(21,101,192,.1)}}

/* PROGRESS RING */
.prog-ring{position:relative;width:64px;height:64px}
.prog-ring-svg{transform:rotate(-90deg)}
.prog-ring-bg{fill:none;stroke:var(--border);stroke-width:5}
.prog-ring-fill{fill:none;stroke:var(--blue);stroke-width:5;stroke-linecap:round;transition:stroke-dashoffset .5s ease}
.prog-ring-text{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--font);font-size:13px;font-weight:800;color:var(--txt)}

/* QUIZ */
.quiz-q{font-family:var(--font);font-size:14px;font-weight:700;margin-bottom:14px;line-height:1.5}
.quiz-opt{padding:10px 14px;border:2px solid var(--border);border-radius:var(--r);margin-bottom:8px;cursor:pointer;transition:.2s;font-size:13px}
.quiz-opt:hover{border-color:var(--blue);background:var(--blue-xl)}
.quiz-opt.correct{border-color:var(--green);background:var(--green-l);color:var(--green)}
.quiz-opt.wrong{border-color:var(--red);background:var(--red-l);color:var(--red)}

/* ACHIEVEMENT */
.ach-popup{position:fixed;bottom:60px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,#1a3365,#1565c0);color:#fff;border-radius:var(--r2);padding:14px 20px;display:flex;align-items:center;gap:12px;box-shadow:0 8px 32px rgba(21,44,87,.4);z-index:2500;animation:achAnim 4s ease forwards}
@keyframes achAnim{0%{opacity:0;transform:translateX(-50%)translateY(20px)}10%{opacity:1;transform:translateX(-50%)translateY(0)}85%{opacity:1}100%{opacity:0;transform:translateX(-50%)translateY(-10px)}}
.ach-icon{font-size:32px}
.ach-title{font-family:var(--font);font-size:11px;font-weight:700;opacity:.7;text-transform:uppercase;letter-spacing:.5px}
.ach-name{font-family:var(--font);font-size:15px;font-weight:800}

/* MISC */
.empty{text-align:center;padding:32px;color:var(--txt3)}
.eico{font-size:44px;margin-bottom:11px;opacity:.4}
.divider{height:1px;background:var(--border);margin:12px 0}
.chip{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;background:var(--blue-xl);border-radius:20px;font-size:11px;color:var(--blue);font-family:var(--font);font-weight:600}
</style>
</head>
