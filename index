  _origGo:null,

  // ── РАСШИРЯЕМ ФУНКЦИОНАЛ ──
  extendRouting(){
    const origGo=this.go.bind(this);
    this.go=function(mod){
      if(mod==='ach'){document.getElementById('CT').innerHTML=this.pgAch();document.querySelectorAll('.sb-it').forEach(el=>el.classList.toggle('act',false));document.getElementById('hBc').textContent='Достижения';this.s.mod=mod;this.save();this.valStep(mod);this.checkAch();return;}
      if(mod==='radio'){document.getElementById('CT').innerHTML=this.pgRadio();document.querySelectorAll('.sb-it').forEach(el=>el.classList.toggle('act',false));document.getElementById('hBc').textContent='Радиосвязь';this.s.mod=mod;this.save();setTimeout(()=>this.renderRadio(),50);return;}
      if(mod==='handover'){document.getElementById('CT').innerHTML=this.pgHandover();document.querySelectorAll('.sb-it').forEach(el=>el.classList.toggle('act',false));document.getElementById('hBc').textContent='Сдача-приём дежурства';this.s.mod=mod;this.save();return;}
      if(mod==='asgo'){document.getElementById('CT').innerHTML=this.pgAsgoFull();document.querySelectorAll('.sb-it').forEach(el=>el.classList.toggle('act',el.dataset.m===mod));document.getElementById('hBc').textContent='АСГО — Оповещение';this.s.mod=mod;this.save();this.valStep(mod);return;}
      if(mod==='usis'){origGo.call(this,mod);return;}
      origGo.call(this,mod);
      this.checkAch();
    }.bind(this);
  }
});

