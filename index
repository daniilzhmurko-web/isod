function openFolder(folder) {
  APP.curFolder = folder;
  document.querySelectorAll('.mn-item').forEach(el => el.classList.toggle('on', el.dataset.folder===folder));
  log(`Открыта папка: ${folder}`, 'nav');
  checkStepValidation();

  const specialFolders = ['contacts','calendar','tasks','files','rules','settings'];
  if (specialFolders.includes(folder)) {
    renderSpecialFolder(folder);
    return;
  }
  renderMailList(folder);
  document.getElementById('mail-view').innerHTML = `<div class="mv-empty"><div class="mv-empty-icon">📧</div><div style="font-family:var(--font);font-size:14px;font-weight:700;color:var(--txt2)">Выберите письмо</div></div>`;
  setToolbar(false);
  checkStepValidation();
}

function go(folder) { openFolder(folder); }

function renderMailList(folder) {
  const list = document.getElementById('mail-list');
  let mails = DB.emails.filter(m => m.folder === folder);
  
  const f = APP.filterType;
  if (f === 'unread') mails = mails.filter(m => m.unread);
  if (f === 'attach') mails = mails.filter(m => m.attachments?.length > 0);
  
  const q = document.getElementById('mail-search')?.value?.toLowerCase() || '';
  if (q) mails = mails.filter(m =>
    m.subj.toLowerCase().includes(q) || m.fromName.toLowerCase().includes(q) || m.body.toLowerCase().includes(q)
  );

  if (mails.length === 0) {
    list.innerHTML = `<div class="empty"><div class="eico">📭</div><div style="font-family:var(--font);font-size:13px;font-weight:700;color:var(--txt2)">Папка пуста</div></div>`;
    return;
  }

  list.innerHTML = mails.map(m => `
    <div class="mail-item ${m.unread?'unread':''} ${m.isSpam?'spam':''} ${APP.selectedMail?.id===m.id?'on':''}" onclick="openMail(${m.id})">
      <div class="mi-row1">
        <span class="mi-from">${m.fromName}</span>
        <span class="mi-date">${m.date.split(' ')[0]}</span>
      </div>
      <div class="mi-subj">${m.isSpam?'🚫 ':m.important?'⭐ ':''}${m.subj}</div>
      <div class="mi-preview">${m.body.substring(0,60).replace(/\n/g,' ')}...</div>
      <div class="mi-icons">
        ${m.attachments?.length?`<span class="mi-tag attach">📎 ${m.attachments.length}</span>`:''}
        ${m.isSpam?`<span class="mi-tag spam">СПАМ</span>`:''}
        ${m.important?`<span class="mi-tag important">⭐</span>`:''}
      </div>
    </div>`).join('');
}

function openMail(id) {
  const m = DB.emails.find(x => x.id === id);
  if (!m) return;
  APP.selectedMail = m;
  m.unread = false;
  setToolbar(true);
  renderMailList(APP.curFolder);
  checkStepValidation();
  log(`Открыто письмо: ${m.subj}`, 'open_mail', {id});

  const view = document.getElementById('mail-view');
  view.innerHTML = `
    <div style="animation:fadeIn .2s ease">
      ${m.isPhishing?`<div class="spam-warning"><span style="font-size:20px">⚠️</span><div><div style="font-family:var(--font);font-size:12px;font-weight:700;color:#e65100">ВНИМАНИЕ: ВОЗМОЖНЫЙ ФИШИНГ!</div><div style="font-size:12px;color:var(--txt2)">Это письмо было автоматически идентифицировано как фишинговое. Не переходите по ссылкам и не вводите данные!</div></div></div>`:''}
      ${m.isSpam&&!m.isPhishing?`<div class="spam-warning"><span style="font-size:20px">⚠️</span><div><div style="font-family:var(--font);font-size:12px;font-weight:700;color:#e65100">НЕЖЕЛАТЕЛЬНОЕ СООБЩЕНИЕ (СПАМ)</div><div style="font-size:12px;color:var(--txt2)">Это письмо помечено как спам. Будьте осторожны.</div></div></div>`:''}
      <div class="mv-header">
        <div class="mv-subject">${m.subj}</div>
        <div class="mv-meta">
          <div class="mv-meta-item"><span class="mv-meta-lbl">От:</span><span>${m.fromName} &lt;${m.from}&gt;</span></div>
          <div class="mv-meta-item"><span class="mv-meta-lbl">Дата:</span><span>${m.date}</span></div>
          <div class="mv-meta-item"><span class="mv-meta-lbl">Кому:</span><span>${APP.user.name} &lt;${APP.user.login}@mvd.ru&gt;</span></div>
        </div>
        ${m.attachments?.length?`<div class="mv-attach">
          <div class="mv-attach-title">📎 Вложения (${m.attachments.length})</div>
          ${m.attachments.map(a=>`<div class="attach-file" onclick="downloadAttach('${a}')"><span class="attach-icon">${a.endsWith('.pdf')?'📄':a.endsWith('.docx')?'📝':a.endsWith('.xlsx')?'📊':a.endsWith('.exe')?'⚠️':'📎'}</span>${a}</div>`).join('')}
        </div>`:''}
      </div>
      <div class="divider"></div>
      <div class="mv-body">${m.body}</div>
    </div>`;
}

function setToolbar(active) {
  ['mtb-reply','mtb-forward','mtb-delete','mtb-spam','mtb-mark'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.disabled = !active;
  });
}

function replyEmail() {
  if (!APP.selectedMail) return;
  openCompose();
  setTimeout(() => {
    document.getElementById('c-to').value = APP.selectedMail.from;
    document.getElementById('c-subj').value = 'RE: ' + APP.selectedMail.subj;
    document.getElementById('c-body').value = `\n\n> ${APP.selectedMail.body.substring(0,200).replace(/\n/g,'\n> ')}`;
  }, 100);
  log('Ответ на письмо', 'reply', {to:APP.selectedMail.from});
}

function forwardEmail() {
  if (!APP.selectedMail) return;
  openCompose();
  setTimeout(() => {
    document.getElementById('c-subj').value = 'FWD: ' + APP.selectedMail.subj;
    document.getElementById('c-body').value = `--- Пересланное письмо ---\nОт: ${APP.selectedMail.fromName}\nДата: ${APP.selectedMail.date}\n\n${APP.selectedMail.body}`;
  }, 100);
  log('Пересылка письма', 'forward', {from:APP.selectedMail.from});
}

function deleteEmail() {
  if (!APP.selectedMail) return;
  const isPhishing = APP.selectedMail.isPhishing;
  const m = APP.selectedMail;
  m.folder = 'trash';
  APP.selectedMail = null;
  renderMailList(APP.curFolder);
  document.getElementById('mail-view').innerHTML = `<div class="mv-empty"><div class="mv-empty-icon">🗑️</div><div style="font-family:var(--font);font-size:14px;font-weight:700;color:var(--txt2)">Письмо перемещено в корзину</div></div>`;
  setToolbar(false);
  log('Удаление письма', isPhishing ? 'delete_phishing' : 'delete_mail', {subj:m.subj});
  checkStepValidation();
  notify('ok', 'Письмо удалено', 'Перемещено в корзину');
  APP.score += 10; updateHeader();
}

function markSpam() {
  if (!APP.selectedMail) return;
  APP.selectedMail.isSpam = true;
  APP.selectedMail.folder = 'spam';
  const m = APP.selectedMail;
  APP.selectedMail = null;
  renderMailList(APP.curFolder);
  setToolbar(false);
  log('Отметить как спам', 'mark_spam', {subj:m.subj});
  checkStepValidation();
  notify('ok', 'Помечено как спам', 'Письмо перемещено');
  APP.score += 15; updateHeader();
}

function markImportant() {
  if (!APP.selectedMail) return;
  APP.selectedMail.important = !APP.selectedMail.important;
  renderMailList(APP.curFolder);
  log('Важное', 'mark_important', {subj:APP.selectedMail.subj});
  checkStepValidation();
  notify(APP.selectedMail.important?'ok':'info', APP.selectedMail.important?'Помечено как важное':'Отметка удалена', '');
  APP.score += 5; updateHeader();
}

function searchMails() { renderMailList(APP.curFolder); }
function sortMails() { renderMailList(APP.curFolder); }
function filterMails(type, el) {
  APP.filterType = type;
  document.querySelectorAll('.ml-ftab').forEach(t => t.classList.remove('on'));
  el.classList.add('on');
  renderMailList(APP.curFolder);
}

function downloadAttach(fname) {
  notify('info', 'Вложение', `Загрузка файла: ${fname}`);
