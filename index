      </div>
      <div class="form-row">
        <label>Краткое содержание (заголовок) <span>*</span></label>
        <input class="form-control" id="ff-subject" type="text" placeholder="О чём документ..." oninput="checkFormFill()"/>
      </div>
      <div class="form-row-2">
        <div class="form-row">
          <label>Степень срочности</label>
          <select class="form-control" id="ff-urgency">
            <option>Обычный</option>
            <option selected>Срочно</option>
            <option>Очень срочно</option>
          </select>
        </div>
        <div class="form-row">
          <label>Гриф доступа</label>
          <select class="form-control" id="ff-grift">
            <option>Несекретно</option>
            <option>Для служебного пользования</option>
            <option>Секретно</option>
          </select>
        </div>
      </div>
      <div class="form-row">
