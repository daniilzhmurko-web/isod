function updateLiveScore() {
  document.getElementById('live-score').textContent = Math.max(0, State.score);
  document.getElementById('stat-correct').textContent = Math.max(0, State.score < 100 ? 0 : 0);
  document.getElementById('stat-errors').textContent = State.errors;
  document.getElementById('stat-hints').textContent = State.hints;
  document.getElementById('stat-traps').textContent = State.trapsFail;
  document.getElementById('stat-traps-ok').textContent = State.trapsOk;
}

function addScoreEvent(text, points) {
  const el = document.getElementById('score-events');
  const item = document.createElement('div');
  item.style.cssText = `display:flex;justify-content:space-between;align-items:center;padding:6px 10px;background:${points > 0 ? 'var(--mvd-green-light)' : 'var(--mvd-red-light)'};border-radius:6px;font-size:12px;`;
  item.innerHTML = `<span style="color:#343A40;">${text}</span><span style="font-weight:700;color:${points > 0 ? 'var(--mvd-green)' : 'var(--mvd-red)'};">${points > 0 ? '+' : ''}${points}</span>`;
  el.insertBefore(item, el.firstChild);
  if (el.children.length > 10) el.removeChild(el.lastChild);
  State.score += points;
  updateLiveScore();
}

