  canvas.querySelectorAll('.topo-node').forEach(n => n.remove());
  const svg = document.getElementById(svgId);
  svg.innerHTML = '';
  
  const W = canvas.offsetWidth || 800;
  const H = small ? 200 : 460;
  const scale = small ? 0.55 : 1;
  
  const nodes = [
    { id:'ws07',    icon:'💻', label:'WS-07\nСидоров П.А.',     x:0.08, y:0.70, status:'crit' },
    { id:'ws03',    icon:'💻', label:'WS-03\nПетров И.В.',      x:0.08, y:0.30, status:'warn' },
    { id:'sw-int',  icon:'🔀', label:'Коммутатор\nвнутренний',  x:0.28, y:0.50, status:'ok'   },
    { id:'auth',    icon:'🔐', label:'Сервер\nаутентификации',  x:0.50, y:0.20, status:'crit' },
    { id:'siem',    icon:'⚡', label:'ArcSight\nSIEM',          x:0.50, y:0.50, status:'warn' },
    { id:'ids',     icon:'🚨', label:'ViPNet\nIDS',             x:0.50, y:0.78, status:'alert'},
    { id:'fw',      icon:'🔥', label:'МЭ\nFW-EDGE',            x:0.72, y:0.50, status:'warn' },
    { id:'dmz',     icon:'🌐', label:'WEB-DMZ',                 x:0.86, y:0.30, status:'ok'   },
    { id:'inet',    icon:'🌍', label:'Интернет\n185.220.101.45',x:0.93, y:0.70, status:'crit' },
    { id:'ca',      icon:'🏛️', label:'УЦ МВД\n(PKI)',          x:0.28, y:0.20, status:'ok'   },
    { id:'vipnet',  icon:'🔑', label:'ViPNet\nCustom',          x:0.28, y:0.80, status:'warn' },
  ];
  
  const edges = [
    { from:'ws07', to:'sw-int', color:'#DC2626', animated:true },
    { from:'ws03', to:'sw-int', color:'#94A3B8' },
    { from:'sw-int', to:'auth', color:'#94A3B8' },
    { from:'sw-int', to:'siem', color:'#94A3B8' },
    { from:'sw-int', to:'ids',  color:'#94A3B8' },
    { from:'sw-int', to:'vipnet', color:'#94A3B8' },
    { from:'ca',   to:'auth',  color:'#7C3AED' },
    { from:'auth', to:'fw',    color:'#94A3B8' },
    { from:'siem', to:'fw',    color:'#94A3B8' },
    { from:'fw',   to:'dmz',   color:'#94A3B8' },
    { from:'fw',   to:'inet',  color:'#DC2626', animated:true },
  ];
  
  // Рисуем рёбра
  edges.forEach(e => {
    const fn = nodes.find(n => n.id === e.from);
    const tn = nodes.find(n => n.id === e.to);
    if (!fn || !tn) return;
    const x1 = fn.x * W, y1 = fn.y * H;
    const x2 = tn.x * W, y2 = tn.y * H;
    const line = document.createElementNS('http://www.w3.org/2000/svg','line');
    line.setAttribute('x1', x1); line.setAttribute('y1', y1);
    line.setAttribute('x2', x2); line.setAttribute('y2', y2);
    line.setAttribute('stroke', e.color || '#CBD5E1');
    line.setAttribute('stroke-width', '2');
    if (e.animated) {
      line.classList.add('traffic-line','attack');
    }
    svg.appendChild(line);
  });
  
  // Рисуем узлы
  nodes.forEach(n => {
    const div = document.createElement('div');
    div.className = 'topo-node';
    div.style.left = (n.x * W - 22) + 'px';
    div.style.top  = (n.y * H - 22) + 'px';
    div.innerHTML = `
      <div class="topo-icon status-${n.status}">${n.icon}</div>
      <div class="topo-label" style="font-size:${small?9:10}px">${n.label.replace(/\n/g,'<br>')}</div>`;
    div.onclick = () => showNodeDetails(n);
    canvas.appendChild(div);
  });
}

