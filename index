        ${x.pros?`<div class="rf"><span class="rfl">Блок №2 Привлечение ............</span><span style="color:#16a34a">✓ Данные заполнены</span></div>`:''}
        ${x.wnt?`<div class="rf"><span class="rfl">Блок №3 Розыск ............</span><span style="color:#e53e3e;font-weight:700">⚠️ Данные заполнены</span></div>`:''}
