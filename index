    if(!type||!addr){this.toast('w','Ошибка','Укажите тип события и адрес.');return;}
    const n=new Date(),t=n.toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'});
    const id='КУСП-'+n.getFullYear()+'-'+String(++this.s.kuspCnt).padStart(3,'0');
    const patrol=document.getElementById('kPatrol').value;
    const entry={id,type,addr,caller:document.getElementById('kCaller').value||'Аноним',phone:document.getElementById('kPhone').value||'—',priority:document.getElementById('kPrio').value,status:patrol?'inprogress':'pending',patrol:patrol||null,created:t,desc:document.getElementById('kDesc').value};
    if(!this.s.kusp)this.s.kusp=[];
    this.s.kusp.push(entry);
    if(patrol){const p=this.s.patrols.find(x=>x.cs===patrol);if(p){p.sta='busy';p.inc=id;}}
    this.addEv(`<strong>${id}</strong> зарегистрирован: ${type} — ${addr}.`,'info');
    this.log('Создана запись КУСП: '+id);
    this.save();this.updBdg();this.cM();
