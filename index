<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>СОЭБ МВД России | Интеллектуальный симулятор v9.0</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=PT+Sans:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ═══ ПЕРЕМЕННЫЕ ═══ */
:root{
  --bg:#f0f4fa;--bg2:#ffffff;--bg3:#f7f9fc;--bg4:#eef2fa;
  --nav:#1b2d5e;--nav2:#142348;
  --blue:#1a56db;--blue2:#1e429f;--blue3:#3f83f8;--blue-l:#ebf5ff;--blue-xl:#f0f7ff;
  --teal:#0694a2;--teal-l:#e0f7fa;
  --red:#e02424;--red-l:#fef2f2;--red-d:#9b1c1c;
  --green:#057a55;--green-l:#f3faf7;
  --orange:#d97706;--orange-l:#fffbeb;
  --gold:#f59e0b;--purple:#7e3af2;--purple-l:#f5f3ff;
  --txt:#111928;--txt2:#4b5563;--txt3:#9ca3af;
  --border:#e5e7eb;--border2:#d1d5db;
  --shadow:0 1px 3px rgba(0,0,0,.1);--shadow2:0 4px 6px -1px rgba(0,0,0,.1);
  --shadow3:0 10px 15px -3px rgba(0,0,0,.1);--shadow4:0 20px 25px -5px rgba(0,0,0,.1);
  --r:6px;--r2:10px;--r3:16px;--r4:24px;
  --font:'Montserrat',sans-serif;--body:'PT Sans',sans-serif;--mono:'JetBrains Mono',monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%;overflow:hidden}
body{font-family:var(--body);background:var(--bg);color:var(--txt);font-size:14px;line-height:1.5}
button{cursor:pointer;border:none;outline:none;font-family:var(--body)}
input,select,textarea{font-family:var(--body);outline:none}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}

/* ═══ АНИМАЦИИ ═══ */
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes slideR{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:translateX(0)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes popIn{0%{transform:scale(.85);opacity:0}100%{transform:scale(1);opacity:1}}
@keyframes glow{0%,100%{box-shadow:0 0 5px rgba(26,86,219,.3)}50%{box-shadow:0 0 20px rgba(26,86,219,.6)}}
@keyframes scoreUp{0%{opacity:1;transform:translateY(0)}100%{opacity:0;transform:translateY(-44px)}}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-4px)}75%{transform:translateX(4px)}}
@keyframes riskPulse{0%,100%{background:var(--red-l)}50%{background:rgba(224,36,36,.18)}}
@keyframes borderAnim{0%,100%{border-color:var(--blue)}50%{border-color:var(--blue3)}}
@keyframes achSlide{0%{opacity:0;transform:translateX(-50%)translateY(20px)}10%{opacity:1;transform:translateX(-50%)translateY(0)}85%{opacity:1}100%{opacity:0;transform:translateX(-50%)translateY(-12px)}}
@keyframes typeWriter{from{width:0}to{width:100%}}

/* ═══ SPLASH ═══ */
#splash{position:fixed;inset:0;background:linear-gradient(135deg,#0f1f4b,#1b2d5e,#1a56db);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9999;transition:opacity .8s}
#splash.out{opacity:0;pointer-events:none}
.sp-ico{font-size:80px;animation:popIn .7s ease}
.sp-title{font-family:var(--font);font-size:28px;font-weight:900;color:#fff;margin:16px 0 5px;text-align:center}
.sp-sub{font-size:12px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:2px;margin-bottom:38px;text-align:center}
.sp-bar{width:320px;height:3px;background:rgba(255,255,255,.15);border-radius:2px;overflow:hidden;margin-bottom:12px}
.sp-fill{height:100%;background:linear-gradient(90deg,#3f83f8,#7e3af2);border-radius:2px;transition:width .12s}
.sp-status{font-family:var(--mono);font-size:11px;color:rgba(255,255,255,.4);min-height:16px}

/* ═══ LOGIN ═══ */
#login{position:fixed;inset:0;background:linear-gradient(135deg,#0f1f4b,#1b2d5e,#1a56db);display:none;align-items:center;justify-content:center}
#login.on{display:flex}
.lc{display:flex;width:980px;max-width:96vw;border-radius:var(--r4);overflow:hidden;box-shadow:var(--shadow4);animation:fadeIn .5s ease}
.ll{width:400px;background:rgba(255,255,255,.07);backdrop-filter:blur(10px);padding:44px 38px;border-right:1px solid rgba(255,255,255,.1);flex-shrink:0}
.lr{flex:1;background:#fff;padding:44px 40px}
.ll-brand{display:flex;align-items:center;gap:13px;margin-bottom:28px}
.ll-ico{width:54px;height:54px;background:linear-gradient(135deg,#3f83f8,#1a56db);border-radius:var(--r2);display:flex;align-items:center;justify-content:center;font-size:26px}
.ll-name{font-family:var(--font);font-size:21px;font-weight:900;color:#fff}
.ll-sub{font-size:9px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:1.5px;margin-top:2px}
.lf{margin-bottom:10px;padding:10px 12px;background:rgba(255,255,255,.06);border-radius:var(--r);border:1px solid rgba(255,255,255,.1);display:flex;gap:10px;align-items:flex-start}
.lf-ico{font-size:18px;flex-shrink:0;margin-top:1px}
.lf-name{font-family:var(--font);font-size:11px;font-weight:700;color:rgba(255,255,255,.85)}
.lf-desc{font-size:10px;color:rgba(255,255,255,.45);margin-top:1px}
.ls{display:flex;gap:9px;margin-top:22px}
.ls-i{flex:1;background:rgba(255,255,255,.06);border-radius:var(--r);padding:10px;text-align:center;border:1px solid rgba(255,255,255,.1)}
.ls-v{font-family:var(--font);font-size:18px;font-weight:800;color:#3f83f8}
.ls-l{font-size:9px;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.8px;margin-top:2px}
.lr-t{font-family:var(--font);font-size:21px;font-weight:800;color:var(--txt);margin-bottom:5px}
.lr-s{font-size:13px;color:var(--txt2);margin-bottom:24px}
.lbl{font-family:var(--font);font-size:10px;font-weight:700;color:var(--txt2);text-transform:uppercase;letter-spacing:.8px;display:block;margin-bottom:5px}
.inp{width:100%;padding:10px 13px;border:2px solid var(--border);border-radius:var(--r);font-size:14px;color:var(--txt);background:var(--bg3);transition:.2s}
.inp:focus{border-color:var(--blue);background:#fff;box-shadow:0 0 0 3px rgba(26,86,219,.1)}
.inp.err{border-color:var(--red);animation:shake .3s ease}
.roles{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:16px}
.rb{padding:10px 8px;border:2px solid var(--border);border-radius:var(--r);cursor:pointer;text-align:center;transition:.2s;background:var(--bg3)}
.rb:hover,.rb.sel{border-color:var(--blue);background:var(--blue-xl)}
.rb-ico{font-size:19px;margin-bottom:2px}
.rb-n{font-family:var(--font);font-size:10px;font-weight:700;color:var(--txt)}
.rb-d{font-size:9px;color:var(--txt3);margin-top:1px}
.modes{display:flex;gap:7px;margin-bottom:18px}
.mc{flex:1;padding:7px 5px;border:2px solid var(--border);border-radius:var(--r);cursor:pointer;text-align:center;transition:.2s;background:var(--bg3);font-family:var(--font);font-size:10px;font-weight:700;color:var(--txt2)}
.mc:hover,.mc.sel{border-color:var(--blue);color:var(--blue);background:var(--blue-xl)}
.btn-enter{width:100%;padding:13px;background:linear-gradient(135deg,var(--blue),var(--blue2));color:#fff;border-radius:var(--r);font-family:var(--font);font-size:14px;font-weight:700;transition:.2s;box-shadow:0 4px 12px rgba(26,86,219,.4)}
.btn-enter:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(26,86,219,.5)}
.l-note{margin-top:13px;padding:11px 13px;background:var(--blue-xl);border-radius:var(--r);border-left:3px solid var(--blue);font-size:12px;color:var(--txt2)}
.l-err{color:var(--red);font-size:12px;margin-top:6px;display:none;font-weight:600}

/* ═══ MAIN APP ═══ */
#app{position:fixed;inset:0;display:none;flex-direction:column}
#app.on{display:flex}

/* ═══ TOPBAR ═══ */
.tb{height:50px;background:var(--nav);display:flex;align-items:center;padding:0 15px;gap:11px;flex-shrink:0;box-shadow:0 2px 8px rgba(0,0,0,.25);z-index:200}
.tb-logo{display:flex;align-items:center;gap:9px;padding-right:13px;border-right:1px solid rgba(255,255,255,.15)}
.tb-logo-ico{width:30px;height:30px;background:linear-gradient(135deg,#3f83f8,#7e3af2);border-radius:var(--r);display:flex;align-items:center;justify-content:center;font-size:15px}
.tb-logo-txt{font-family:var(--font);font-size:12px;font-weight:800;color:#fff;line-height:1.2}
.tb-logo-s{font-size:8px;color:rgba(255,255,255,.45);text-transform:uppercase;letter-spacing:1px}
.tb-prog{display:flex;align-items:center;gap:3px}
.tb-lv{width:24px;height:24px;border-radius:50%;border:2px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-family:var(--font);font-size:9px;font-weight:700;color:rgba(255,255,255,.35);cursor:pointer;transition:.2s;position:relative}
.tb-lv:hover{border-color:rgba(255,255,255,.5)}
.tb-lv.done{background:#057a55;border-color:#057a55;color:#fff}
.tb-lv.cur{background:var(--blue);border-color:#3f83f8;color:#fff;animation:glow 2s infinite}
.tb-lv.lock{cursor:not-allowed}
.tb-lv-tip{position:absolute;bottom:calc(100%+6px);left:50%;transform:translateX(-50%);background:var(--txt);color:#fff;font-size:9px;padding:4px 7px;border-radius:4px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .2s;font-family:var(--body)}
.tb-lv:hover .tb-lv-tip{opacity:1}
.tb-sp{flex:1}
.tb-right{display:flex;align-items:center;gap:11px}
.tb-m{display:flex;align-items:center;gap:5px;color:rgba(255,255,255,.75)}
.tb-mv{font-family:var(--font);font-size:13px;font-weight:800;color:#fff}
.tb-ml{font-size:9px;color:rgba(255,255,255,.45)}
.tb-badge{padding:3px 9px;border-radius:20px;font-family:var(--font);font-size:10px;font-weight:700;letter-spacing:.5px}
.tb-badge.training{background:rgba(5,122,85,.3);color:#68d391}
.tb-badge.exam{background:rgba(224,36,36,.3);color:#fc8181}
.tb-badge.sandbox{background:rgba(126,58,242,.3);color:#b794f4}
.tb-badge.teacher{background:rgba(245,158,11,.3);color:#fcd34d}
.tb-btn{padding:5px 11px;background:rgba(255,255,255,.1);color:#fff;border-radius:var(--r);font-size:11px;font-family:var(--font);font-weight:600;border:1px solid rgba(255,255,255,.15);transition:.2s}
.tb-btn:hover{background:rgba(255,255,255,.2)}
.tb-user{display:flex;align-items:center;gap:7px;padding:4px 9px;background:rgba(255,255,255,.08);border-radius:var(--r);border:1px solid rgba(255,255,255,.12)}
.tb-av{width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,#3f83f8,#7e3af2);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;font-family:var(--font)}
.tb-un{font-family:var(--font);font-size:11px;font-weight:600;color:#fff}
.tb-ur{font-size:9px;color:rgba(255,255,255,.45)}

/* ═══ LAYOUT ═══ */
.layout{display:flex;flex:1;overflow:hidden}

/* ═══ SIDEBAR ═══ */
.sb{width:215px;background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;overflow-y:auto}
.sb-sec{padding:7px 0}
.sb-t{font-family:var(--font);font-size:9px;font-weight:700;color:var(--txt3);text-transform:uppercase;letter-spacing:1.5px;padding:0 13px;margin-bottom:2px}
.ni{display:flex;align-items:center;gap:8px;padding:7px 13px;cursor:pointer;transition:.15s;border-left:3px solid transparent}
.ni:hover{background:var(--bg3)}
.ni.on{background:var(--blue-xl);border-left-color:var(--blue)}
.ni-ico{font-size:14px;width:17px;text-align:center;flex-shrink:0}
.ni-lbl{font-family:var(--font);font-size:11px;font-weight:600;color:var(--txt2)}
.ni.on .ni-lbl{color:var(--blue)}
.nbadge{margin-left:auto;border-radius:10px;padding:2px 5px;font-size:9px;font-weight:700;font-family:var(--font)}
.nb-r{background:var(--red-l);color:var(--red)}
.nb-b{background:var(--blue-xl);color:var(--blue)}
.nb-o{background:var(--orange-l);color:var(--orange)}
.sb-risk{margin:9px 12px;padding:9px 11px;background:var(--red-l);border-radius:var(--r);border:1px solid rgba(224,36,36,.2);cursor:pointer}
.sb-risk-title{font-family:var(--font);font-size:10px;font-weight:700;color:var(--red);margin-bottom:4px}
.sb-risk-bar{height:4px;background:rgba(224,36,36,.2);border-radius:2px;overflow:hidden;margin-bottom:4px}
.sb-risk-fill{height:100%;background:linear-gradient(90deg,#f59e0b,#e02424);border-radius:2px;transition:width .5s}
.sb-risk-val{font-family:var(--mono);font-size:11px;font-weight:600;color:var(--red)}

/* ═══ CONTENT ═══ */
.cnt{flex:1;overflow-y:auto;padding:16px;background:var(--bg)}
.panel{display:none;animation:fadeIn .22s ease}
.panel.on{display:block}

/* ═══ RIGHT PANEL ═══ */
.rp{width:272px;background:var(--bg2);border-left:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;overflow:hidden}
.rp-hdr{height:36px;background:var(--bg3);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 11px;font-family:var(--font);font-size:9px;font-weight:700;color:var(--txt2);text-transform:uppercase;letter-spacing:.7px;flex-shrink:0}
.rp-tabs{display:flex;border-bottom:1px solid var(--border);flex-shrink:0}
.rp-tab{flex:1;padding:8px 2px;font-family:var(--font);font-size:9px;font-weight:700;color:var(--txt3);border-bottom:2px solid transparent;cursor:pointer;transition:.15s;text-align:center;background:transparent;text-transform:uppercase;letter-spacing:.4px}
.rp-tab.on{color:var(--blue);border-bottom-color:var(--blue);background:var(--blue-xl)}
.rp-body{flex:1;overflow:hidden}
.rp-pane{display:none;height:100%;overflow-y:auto;flex-direction:column}
.rp-pane.on{display:flex}

/* AI CHAT */
.achat{flex:1;overflow-y:auto;padding:9px;display:flex;flex-direction:column;gap:7px}
.amsg{padding:8px 10px;border-radius:var(--r2);max-width:93%;animation:fadeIn .2s ease;line-height:1.5;font-size:11px}
.amsg.inst{background:var(--bg3);border:1px solid var(--border);align-self:flex-start}
.amsg.user{background:var(--blue-xl);border:1px solid rgba(26,86,219,.2);align-self:flex-end}
.amsg.analyst{background:var(--purple-l);border:1px solid rgba(126,58,242,.2);align-self:flex-start}
.amsg.adversary{background:var(--red-l);border:1px solid rgba(224,36,36,.3);align-self:flex-start}
.amsg.system{background:var(--bg3);border:1px solid var(--border);align-self:center;font-style:italic;max-width:100%;text-align:center;font-size:10px}
.amsg-n{font-family:var(--font);font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px}
.amsg.inst .amsg-n{color:var(--blue)}
.amsg.analyst .amsg-n{color:var(--purple)}
.amsg.adversary .amsg-n{color:var(--red)}
.amsg-t{color:var(--txt)}
.amsg-ts{font-size:9px;color:var(--txt3);text-align:right;margin-top:2px}
.adots{display:flex;gap:4px;padding:8px 10px;background:var(--bg3);border-radius:var(--r2);width:46px;align-items:center}
.adot{width:5px;height:5px;border-radius:50%;background:var(--txt3);animation:pulse 1.2s infinite}
.adot:nth-child(2){animation-delay:.2s}.adot:nth-child(3){animation-delay:.4s}
.ainrow{padding:8px;border-top:1px solid var(--border);display:flex;gap:6px;flex-shrink:0}
.ainf{flex:1;padding:6px 10px;border:1.5px solid var(--border);border-radius:20px;font-size:11px;color:var(--txt);background:var(--bg3);transition:.2s;resize:none}
.ainf:focus{border-color:var(--blue);background:#fff}
.asend{width:28px;height:28px;background:var(--blue);color:#fff;border-radius:50%;font-size:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.2s}
.asend:hover{background:var(--blue2);transform:scale(1.07)}

/* LOG */
.lentry{padding:5px 9px;border-bottom:1px solid var(--border);display:flex;gap:6px;align-items:flex-start}
.ltime{font-family:var(--mono);font-size:9px;color:var(--txt3);flex-shrink:0;margin-top:1px}
.ltext{font-size:11px;line-height:1.4}
.l-ok{color:var(--green)}.l-warn{color:var(--orange)}.l-err{color:var(--red)}.l-info{color:var(--blue)}

/* RISK PANEL */
.rsk-big{text-align:center;padding:14px}
.rsk-num{font-family:var(--font);font-size:50px;font-weight:900;line-height:1}
.rsk-lbl{font-size:11px;color:var(--txt2);margin-top:3px}
.rsk-bw{padding:0 13px 9px}
.rsk-b{height:7px;background:var(--border);border-radius:4px;overflow:hidden}
.rsk-f{height:100%;border-radius:4px;transition:width .5s}
.rsk-scale{display:flex;justify-content:space-between;font-size:9px;color:var(--txt3);margin-top:2px;font-family:var(--font);font-weight:600}
.rsk-factors{padding:0 9px 9px}
.rfi{display:flex;align-items:center;justify-content:space-between;padding:5px 0;border-bottom:1px solid var(--border);font-size:11px}
.rfi-v{font-family:var(--mono);font-size:10px;font-weight:600}
.rv-h{color:var(--red)}.rv-m{color:var(--orange)}.rv-l{color:var(--green)}

/* ═══ INST PANEL ═══ */
#inst{height:205px;background:var(--bg2);border-top:2px solid var(--blue);display:flex;flex-direction:column;overflow:hidden;transition:height .3s;flex-shrink:0}
#inst.collapsed{height:36px}
.inst-hdr{height:36px;background:var(--blue);display:flex;align-items:center;padding:0 13px;gap:9px;cursor:pointer;flex-shrink:0;user-select:none}
.inst-hdr-t{font-family:var(--font);font-size:11px;font-weight:700;color:#fff;display:flex;align-items:center;gap:7px}
.inst-lvbadge{background:rgba(255,255,255,.2);border-radius:20px;padding:2px 9px;font-size:9px}
.inst-sp{flex:1}
.inst-prog{width:150px;height:5px;background:rgba(255,255,255,.2);border-radius:3px;overflow:hidden}
.inst-progf{height:100%;background:#fff;border-radius:3px;transition:width .4s}
.inst-prt{font-family:var(--font);font-size:10px;color:rgba(255,255,255,.8)}
.inst-col{width:19px;height:19px;background:rgba(255,255,255,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;color:#fff;transition:.2s}
.inst-col:hover{background:rgba(255,255,255,.3)}
.inst-body{flex:1;display:flex;overflow:hidden;padding:11px 13px;gap:13px}
.inst-slist{width:185px;overflow-y:auto;flex-shrink:0}
.istep{display:flex;gap:7px;align-items:flex-start;padding:4px 0;cursor:pointer}
.isn{width:19px;height:19px;border-radius:50%;font-family:var(--font);font-size:9px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.2s;background:var(--border);color:var(--txt3)}
.istep.done .isn{background:var(--green);color:#fff}
.istep.cur .isn{background:var(--blue);color:#fff}
.istep.err .isn{background:var(--red);color:#fff}
.ist{font-size:11px;color:var(--txt2);line-height:1.4}
.istep.cur .ist{color:var(--txt);font-weight:700}
.istep.done .ist{color:var(--green);text-decoration:line-through;opacity:.7}
.inst-detail{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:7px}
.inst-tt{font-family:var(--font);font-size:13px;font-weight:800;color:var(--txt)}
.inst-td{font-size:12px;color:var(--txt2);line-height:1.6}
.inst-hint{background:var(--blue-xl);border-radius:var(--r);padding:8px 11px;border-left:3px solid var(--blue);font-size:11px;color:var(--txt2)}
.inst-hint-t{font-family:var(--font);font-size:9px;font-weight:700;color:var(--blue);text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px}
.inst-stat{display:flex;align-items:center;gap:7px;font-size:11px;padding:6px 10px;border-radius:var(--r)}
.inst-stat.ok{background:var(--green-l);color:var(--green)}
.inst-stat.err{background:var(--red-l);color:var(--red)}
.inst-stat.wait{background:var(--orange-l);color:var(--orange)}
