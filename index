th{background:var(--blue);color:#fff;padding:11px 14px;text-align:left;font-weight:700;font-size:11px;letter-spacing:.5px;text-transform:uppercase;font-family:'JetBrains Mono',monospace}
td{padding:10px 14px;border-bottom:1px solid var(--br);color:var(--ink2);vertical-align:top}
