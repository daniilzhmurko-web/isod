<script>
'use strict';
// ══════════════════════════════════════════════════════
// НАРРАТИВНЫЕ ДАННЫЕ СЦЕНАРИЕВ (лор + цели)
// ══════════════════════════════════════════════════════
const SCENE_LORE = {
1:{
  lore:(r)=>`Сегодня ${new Date().toLocaleDateString('ru-RU')}. Входящий документ из ${r.docs[0].from} ожидает вашего решения уже несколько часов. Как ${r.users.boss.rank} ${r.users.boss.name}, вы несёте персональную ответственность за соблюдение сроков рассмотрения. Каждый непросмотренный документ — потенциальный дисциплинарный риск.`,
  objectives:['Ознакомиться с реквизитами входящего документа','Проверить маршрут согласования и все этапы','Изучить текст вложений','Утвердить исполнение документа','Убедиться в корректном статусе после утверждения']
},
2:{
  lore:(r)=>`Почта принесла пакет из ${r.docs[0].from}. Документы лежат на столе делопроизводителя ${r.users.clerk.name}. Каждый непрошедший регистрацию документ — «невидимка» в системе учёта. Без регистрации документ юридически не существует для организации.`,
  objectives:['Переключиться на роль делопроизводителя','Создать регистрационно-контрольную карточку (РКК)','Заполнить все обязательные реквизиты','Направить документ на рассмотрение руководителю']
},
3:{
  lore:(r)=>`${r.users.boss.name}, по итогам рассмотрения документа вам необходимо сформулировать чёткое задание исполнителю. Резолюция — это управленческий инструмент: расплывчатая формулировка означает неисполнение, а неисполнение — личную ответственность руководителя.`,
  objectives:['Найти документ через поиск','Перейти на вкладку «Резолюции»','Составить конкретную резолюцию с исполнителем и сроком','Утвердить резолюцию']
},
4:{
  lore:(r)=>`Исполнитель ${r.users.exec.name} получил задание и готов направить подготовленный ответ. Маршрут должен пройти строго: исполнение → подписание → рассылка. Малейшее отступление от маршрута — возврат документа на доработку.`,
  objectives:['Переключиться на роль исполнителя','Найти документ в папке «В работе»','Ознакомиться с резолюцией','Отправить документ по маршруту согласования']
},
5:{
  lore:(r)=>`Документ поступил к подписанту ${r.users.signer.name} для финального подписания. Электронная подпись — ваша персональная ответственность. Никогда не передавайте токен третьим лицам. Внимательно проверьте документ перед подписанием.`,
  objectives:['Переключиться на роль подписанта','Найти документ в папке «На согласование»','Ознакомиться с текстом и маршрутом','Подписать документ квалифицированной ЭП']
},
6:{
  lore:(r)=>`🚨 НЕШТАТНАЯ СИТУАЦИЯ: ${r.users.clerk.name} госпитализирован. Из МВД России пришёл срочный пакет документов. Вы, ${r.users.boss.name}, вынуждены лично пройти полный цикл — от регистрации до утверждения. Система фиксирует каждое ваше действие. Ловушки активированы. Время пошло.`,
  objectives:['Выполнить регистрацию входящего документа','Вынести и утвердить резолюцию','Принять документ к исполнению','Распознать все нештатные ситуации (ловушки)','Утвердить исполнение документа']
},
};

// ══════════════════════════════════════════════════════
// ПОКАЗ ЗАСТАВКИ СЦЕНАРИЯ
// ══════════════════════════════════════════════════════
function showSceneIntro(scId, region, onStart) {
  const sc  = SCENARIO_META.find(s => s.id === scId);
  const lor = SCENE_LORE[scId];
  if (!lor || !sc) { onStart(); return; }

  const roleNames = {boss:'Руководитель',clerk:'Делопроизводитель',exec:'Исполнитель',signer:'Подписант'};
  const avatars   = {boss:'👔',clerk:'📋',exec:'⚙️',signer:'✍️'};

  document.getElementById('si-eyebrow').textContent  = `Сценарий ${scId} из 6`;
  document.getElementById('si-title').textContent    = sc.title;
  document.getElementById('si-role').textContent     = `${avatars[sc.role]} ${roleNames[sc.role]}: ${region.users[sc.role].name}`;
  document.getElementById('si-time').textContent     = `⏱ ${sc.time}`;
  document.getElementById('si-steps').textContent    = `📋 ${sc.steps} шагов`;
  document.getElementById('si-lore').textContent     = lor.lore(region);

  const objEl = document.getElementById('si-objectives');
  objEl.innerHTML = lor.objectives.map((o,i)=>`
    <div class="obj-item">
      <div class="obj-num">${i+1}</div>
      <span>${o}</span>
    </div>`).join('');

  window._sceneIntroCallback = onStart;
  document.getElementById('scene-intro').classList.add('show');
}

function closeSceneIntro(skip) {
  document.getElementById('scene-intro').classList.remove('show');
  if (window._sceneIntroCallback) {
    window._sceneIntroCallback();
    window._sceneIntroCallback = null;
  }
}

// Патч startScenario — показывать заставку перед стартом
const _origStart = window.startScenario;
window.startScenario = function(id) {
  // Заглушить Engine.load во время UI-инициализации (_origStart вызывает loadScenarioEngine)
  const _savedLSE = window.loadScenarioEngine;
  window.loadScenarioEngine = function(){};    // временная заглушка
  _origStart(id);                              // только UI, таймер, экран
  window.loadScenarioEngine = _savedLSE;       // восстановить
  // Сбросить состояние трапа и движка
  if(typeof TrapEngine!=='undefined'){ TrapEngine.fired.clear(); clearInterval(TrapEngine._timer); }
  Engine.waiting = false; Engine.idx = 0;
  Nav.clear();
  // Закрыть все открытые оверлеи от предыдущего сценария
  document.querySelectorAll('.quest-alert').forEach(el=>el.remove());
  document.getElementById('quiz-overlay').classList.remove('show');
  document.getElementById('trap-overlay').classList.remove('show');
  // Показать заставку → потом загрузить движок (один раз)
  showSceneIntro(id, State.region, () => {
    Engine.load(id);
  });
};

// ══════════════════════════════════════════════════════
// ФОРМА РЕГИСТРАЦИИ ДОКУМЕНТА
// ══════════════════════════════════════════════════════
function openFormModal() {
  if (!State.region) return;
  const r = State.region;
  // Заполнить исполнителей
  const sel = document.getElementById('ff-exec');
  sel.innerHTML = '<option value="">— Не назначен —</option>' +
    Object.entries(r.users).map(([k,u]) =>
      `<option value="${k}">${u.name} (${u.rank})</option>`
    ).join('');
  // Предзаполнить из данных документа
  const d = r.docs[0];
  document.getElementById('ff-from').value    = d.from;
  document.getElementById('ff-subject').value = d.subject;
  document.getElementById('ff-extnum').value  = d.number;
  // Дата сегодня
  document.getElementById('ff-date').value = new Date().toISOString().split('T')[0];
  const dl = new Date(); dl.setDate(dl.getDate()+10);
  document.getElementById('ff-deadline').value = dl.toISOString().split('T')[0];

  document.getElementById('form-modal').classList.add('show');
  checkFormFill();
}

function closeFormModal() {
  document.getElementById('form-modal').classList.remove('show');
}

function checkFormFill() {
  const type    = document.getElementById('ff-type').value;
  const extnum  = document.getElementById('ff-extnum').value.trim();
  const from    = document.getElementById('ff-from').value.trim();
  const subject = document.getElementById('ff-subject').value.trim();
  const date    = document.getElementById('ff-date').value;
  const filled  = [type,extnum,from,subject,date].filter(Boolean).length;
  const total   = 5;
  const pct     = Math.round(filled/total*100);
  const btn     = document.getElementById('btn-form-submit');
  const info    = document.getElementById('form-fill-progress');

  btn.disabled  = filled < total;
  btn.style.opacity = filled < total ? '.5' : '1';

  // Подсветить заполненные поля
  ['ff-type','ff-extnum','ff-date','ff-from','ff-subject'].forEach(id => {
    const el = document.getElementById(id);
    if (el && el.value) el.classList.add('filled');
    else if (el) el.classList.remove('filled');
  });

  info.innerHTML = filled < total
    ? `Заполнено ${filled} из ${total} обязательных полей &nbsp;•&nbsp; <span style="color:#0058A3;font-weight:700;">${pct}%</span>`
    : '<span style="color:#1B7A3E;font-weight:700;">✓ Все обязательные поля заполнены — можно регистрировать</span>';
}

function submitForm() {
  if (!State.region) return;
  const r = State.region;
  const num = `${r.orgCode}/${Math.floor(1000+Math.random()*9000)}`;

  // Обновить данные документа
  r.docs[0].number  = document.getElementById('ff-extnum').value || num;
  r.docs[0].from    = document.getElementById('ff-from').value;
  r.docs[0].subject = document.getElementById('ff-subject').value;
  r.docs[0].urgency = document.getElementById('ff-urgency').value;

  closeFormModal();

  // Показать документ в списке (в папке "Утверждение исполнения" чтобы btn-to-folder работала)
  renderDocuments(r.docs, 'approval');
  showActionFlash('✅ Документ зарегистрирован. Присвоен №: ' + num);
  addScoreEvent('Документ зарегистрирован', +5);

  // Авто-открыть документ → карточка станет видимой → btn-to-folder доступна
  setTimeout(() => {
    selectDocument(0);
  }, 400);

  // Сказать Engine, что действие (btn-new-doc) выполнено — движок перейдёт к следующему шагу
  setTimeout(() => {
    Engine.hit('click', document.getElementById('btn-new-doc'), null);
  }, 100);
}

function showActionFlash(text) {
  const el = document.getElementById('action-flash');
  document.getElementById('action-flash-text').textContent = text;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 3000);
}

// Переопределяем обработчик создания документа
window.onNewDocClick = () => {
  // Если движок ждёт именно этого клика — открыть форму
  if (Engine.waiting && Engine._cur &&
     (Engine._cur.id === 's23' || Engine._cur.id === 's62')) {
    openFormModal();
    return;
  }
  Engine.hit('click', document.getElementById('btn-new-doc'), null);
};

// ══════════════════════════════════════════════════════
// ДОПОЛНИТЕЛЬНЫЕ КЛАВИШНЫЕ СОЧЕТАНИЯ
// ══════════════════════════════════════════════════════
document.addEventListener('keydown', e => {
  const sim = document.getElementById('screen-simulator').classList.contains('active');

  if (e.key === 'F2') { e.preventDefault(); document.getElementById('kbd-overlay').classList.toggle('show'); }
  if (e.key === 'F3' && sim) { e.preventDefault(); window.switchRTab('steps', document.querySelector('.rtab:nth-child(2)')); }
  if (e.key === 'F4' && sim) { e.preventDefault(); window.switchRTab('score', document.querySelector('.rtab:nth-child(4)')); }
  if (e.key === 'Tab' && sim && Engine.waiting && Engine._cur?.target) {
    e.preventDefault();
    Nav.activate(Engine._cur.target);
    // Мигнуть стрелкой
    const ar = document.getElementById('ptr-arrow');
    ar.style.color = '#C0392B';
    setTimeout(() => ar.style.color = '#FFB800', 700);
  }
  if ((e.ctrlKey||e.metaKey) && e.key === 'z' && sim && !Engine.waiting) {
    e.preventDefault();
    if (Engine.idx > 0) { Engine.idx--; Engine._run(); }
  }
  if (e.key === ' ' && sim) {
    e.preventDefault();
    if (Engine.waiting) {
      Nav.clear();
      Engine.waiting = false;
      showToast('⏸ Пауза. Нажмите Пробел для продолжения.', 'success');
    } else if (Engine._cur) {
      Engine._activate(Engine._cur);
    }
  }
});

