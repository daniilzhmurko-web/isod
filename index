function openCompose() {
  APP.composeOpen = true;
  APP.attachments = [];
  document.getElementById('m-compose').classList.remove('hide');
  ['c-to','c-subj','c-body','c-cc','c-bcc'].forEach(id => {const el=document.getElementById(id);if(el)el.value='';});
