/* Быстрый старт карточка */
.quick-card {
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%);
  border-radius: var(--r-lg);
  padding: 20px;
  color: #fff;
  margin-top: 16px;
}
.quick-card h4 { font-size: 13px; font-weight: 600; margin-bottom: 12px; color: var(--gold-light); }
.quick-item { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; font-size: 12px; }
.quick-item .q-key {
  font-family: var(--font-mono);
  background: rgba(255,255,255,.12);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 4px;
  padding: 2px 7px;
  font-size: 11px;
  white-space: nowrap;
}

/* ─── СЕКЦИИ ───────────────────────────────────── */
section {
  margin-bottom: 64px;
  scroll-margin-top: 80px;
}
.section-header {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 28px;
}
.section-num {
  width: 48px; height: 48px;
  background: var(--navy);
  color: #fff;
  border-radius: var(--r-md);
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 900;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(15,31,61,.25);
}
.section-header-text h2 {
  font-family: var(--font-display);
  font-size: 26px;
  font-weight: 700;
  color: var(--navy);
  line-height: 1.2;
}
.section-header-text .section-lead {
  font-size: 14px;
  color: var(--ink-soft);
  margin-top: 4px;
}

/* ─── КАРТОЧКИ ШАГОВ ───────────────────────────── */
.steps-list { display: flex; flex-direction: column; gap: 20px; }

.step-card {
  background: var(--warm-white);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: box-shadow .25s, transform .25s;
  position: relative;
}
.step-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.step-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 4px;
  background: var(--blue);
}
.step-card.step-critical::before { background: var(--accent); }
.step-card.step-info::before     { background: var(--gold); }
.step-card.step-success::before  { background: #27ae60; }

.step-header {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 20px;
  background: var(--step-bg);
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  user-select: none;
  transition: background .18s;
}
.step-header:hover { background: #ece9e2; }
.step-icon {
  width: 38px; height: 38px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
}
.step-icon-blue   { background: #dbeafe; }
.step-icon-red    { background: #fee2e2; }
.step-icon-gold   { background: #fef9c3; }
.step-icon-green  { background: #dcfce7; }
.step-icon-purple { background: #ede9fe; }

.step-meta { flex: 1; }
.step-title { font-weight: 700; font-size: 15px; color: var(--navy); }
.step-subtitle { font-size: 12px; color: var(--ink-soft); margin-top: 2px; }
.step-badge {
  font-size: 10px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 10px;
  text-transform: uppercase;
  letter-spacing: .5px;
}
.badge-crit   { background: #fee2e2; color: #dc2626; }
.badge-opt    { background: #dbeafe; color: #1d4ed8; }
.badge-info2  { background: #fef9c3; color: #92400e; }

.step-chevron {
  font-size: 13px;
  color: var(--ink-soft);
  transition: transform .25s;
}
.step-card.open .step-chevron { transform: rotate(180deg); }

.step-body {
  padding: 20px 20px 20px 24px;
  display: none;
}
.step-card.open .step-body { display: block; }

/* ─── ТЕЛО ШАГА ────────────────────────────────── */
.step-body p { font-size: 14px; margin-bottom: 12px; color: var(--ink-mid); }
.step-body p:last-child { margin-bottom: 0; }

.action-list { list-style: none; margin: 12px 0; }
.action-list li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 8px 0;
  border-bottom: 1px solid var(--border);
  font-size: 14px;
}
.action-list li:last-child { border-bottom: none; }
.action-num {
  width: 24px; height: 24px;
  background: var(--blue);
  color: #fff;
  border-radius: 50%;
  font-size: 11px;
  font-family: var(--font-mono);
  font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  margin-top: 1px;
}

.highlight-box {
  border-radius: var(--r-sm);
  padding: 12px 14px;
  font-size: 13px;
  margin: 12px 0;
  display: flex;
  gap: 10px;
  align-items: flex-start;
}
.hb-info    { background: #eff6ff; border-left: 3px solid var(--blue); color: #1e40af; }
.hb-warn    { background: #fffbeb; border-left: 3px solid var(--gold); color: #92400e; }
.hb-danger  { background: #fff5f5; border-left: 3px solid var(--accent); color: #9b1c1c; }
.hb-success { background: #f0fdf4; border-left: 3px solid #16a34a; color: #166534; }
.hb-icon { font-size: 16px; flex-shrink: 0; margin-top: 1px; }

code {
  font-family: var(--font-mono);
  background: var(--step-bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 1px 6px;
  font-size: 12px;
  color: var(--accent);
}

kbd {
  font-family: var(--font-mono);
  background: var(--navy);
  color: var(--gold-light);
  border-radius: 4px;
  padding: 2px 8px;
  font-size: 11px;
  font-weight: 600;
  white-space: nowrap;
}

.screen-mock {
  background: #f8f9fc;
  border: 1.5px solid var(--border);
  border-radius: var(--r-md);
  overflow: hidden;
  margin: 14px 0;
  font-size: 12px;
}
.sm-bar {
  background: var(--navy-mid);
  color: rgba(255,255,255,.8);
  padding: 7px 12px;
  font-family: var(--font-mono);
  font-size: 10px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.sm-bar-dot { width: 8px; height: 8px; border-radius: 50%; }
.sm-bar-dot-r { background: #ff5f57; }
.sm-bar-dot-y { background: #febc2e; }
.sm-bar-dot-g { background: #28c840; }
.sm-body { padding: 12px 14px; color: var(--ink-mid); }
.sm-field {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 7px;
}
.sm-label { color: var(--ink-soft); min-width: 90px; font-size: 11px; }
.sm-input {
  flex: 1;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 3px;
  padding: 4px 8px;
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--navy);
}
.sm-input.filled { background: #f0f6ff; border-color: var(--blue-light); color: var(--blue); }
.sm-btn {
  display: inline-block;
  background: var(--blue);
  color: #fff;
  border-radius: 3px;
  padding: 5px 12px;
  font-size: 11px;
  font-weight: 600;
  margin-top: 4px;
}
.sm-btn-red { background: var(--accent); }
.sm-btn-green { background: #16a34a; }

/* ─── СЦЕНАРИИ ─────────────────────────────────── */
.scenarios-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 14px;
  margin: 16px 0;
}
.scenario-card {
  background: var(--warm-white);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: 16px;
  transition: all .2s;
}
.scenario-card:hover { border-color: var(--blue-light); box-shadow: var(--shadow-sm); }
.sc-head { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.sc-icon { font-size: 24px; }
.sc-title { font-weight: 700; font-size: 13px; color: var(--navy); }
.sc-desc { font-size: 12px; color: var(--ink-soft); line-height: 1.5; }
.sc-action { margin-top: 8px; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 3px; display: inline-block; }
.sca-clean  { background: #dcfce7; color: #166534; }
.sca-conv   { background: #dbeafe; color: #1d4ed8; }
.sca-warn   { background: #fef9c3; color: #92400e; }
.sca-danger { background: #fee2e2; color: #dc2626; }

/* ─── ДОСТИЖЕНИЯ ───────────────────────────────── */
.achievements-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 12px;
  margin: 16px 0;
}
.ach-card {
  background: var(--warm-white);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: 14px;
  display: flex;
  gap: 10px;
  align-items: flex-start;
  transition: all .2s;
}
.ach-card:hover { border-color: var(--gold); box-shadow: 0 4px 12px rgba(200,164,21,.15); }
.ach-icon { font-size: 26px; flex-shrink: 0; }
.ach-name { font-size: 13px; font-weight: 700; color: var(--navy); }
.ach-desc { font-size: 11px; color: var(--ink-soft); margin-top: 2px; }

/* ─── ШКАЛА ОЦЕНОК ─────────────────────────────── */
.grade-bar {
  display: flex;
  border-radius: var(--r-md);
  overflow: hidden;
  height: 44px;
  margin: 16px 0;
  box-shadow: var(--shadow-sm);
}
.grade-seg {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: #fff;
  flex: 1;
  flex-direction: column;
  gap: 1px;
}
.grade-seg span { font-size: 10px; opacity: .8; font-weight: 400; }
.gs-a { background: #16a34a; }
.gs-b { background: #2563eb; }
.gs-c { background: #d97706; }
.gs-d { background: #dc2626; }

/* ─── СОВЕТЫ ───────────────────────────────────── */
.tips-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 14px;
  margin: 16px 0;
}
.tip-card {
  background: var(--warm-white);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: 16px;
}
.tip-card .tip-emoji { font-size: 28px; margin-bottom: 8px; display: block; }
.tip-card h4 { font-size: 13px; font-weight: 700; color: var(--navy); margin-bottom: 5px; }
.tip-card p { font-size: 12px; color: var(--ink-soft); line-height: 1.5; }

/* ─── ПРОГРЕСС-СХЕМА ───────────────────────────── */
.flow-wrap {
  display: flex;
  gap: 0;
  overflow-x: auto;
  padding: 20px 0;
  scrollbar-width: none;
  position: relative;
}
.flow-wrap::-webkit-scrollbar { display: none; }
.flow-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 100px;
  position: relative;
  z-index: 1;
}
.flow-step:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 28px;
  left: 68px;
  width: 64px;
  height: 2px;
  background: linear-gradient(90deg, var(--blue), var(--blue-light));
}
.flow-circle {
  width: 56px; height: 56px;
  background: var(--navy);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 22px;
  box-shadow: 0 4px 14px rgba(15,31,61,.25);
  margin-bottom: 10px;
  border: 3px solid var(--cream);
  transition: transform .2s;
}
.flow-step:hover .flow-circle { transform: scale(1.1); }
.flow-step.active .flow-circle { background: var(--blue); border-color: var(--blue-light); }
.flow-step.warn .flow-circle { background: var(--accent); }
.flow-label { font-size: 11px; font-weight: 600; color: var(--navy); text-align: center; line-height: 1.3; }
.flow-step-num { font-family: var(--font-mono); font-size: 10px; color: var(--ink-soft); margin-top: 3px; }

/* ─── FAQ ──────────────────────────────────────── */
.faq-list { display: flex; flex-direction: column; gap: 10px; }
.faq-item {
  background: var(--warm-white);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  overflow: hidden;
}
.faq-q {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 18px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  color: var(--navy);
  user-select: none;
  transition: background .15s;
}
.faq-q:hover { background: var(--step-bg); }
.faq-q::before { content: '❓'; font-size: 16px; }
.faq-q .faq-arr { margin-left: auto; font-size: 12px; color: var(--ink-soft); transition: transform .2s; }
.faq-item.open .faq-arr { transform: rotate(180deg); }
.faq-a { display: none; padding: 0 18px 14px 46px; font-size: 13px; color: var(--ink-mid); line-height: 1.6; }
.faq-item.open .faq-a { display: block; }

/* ─── FOOTER ───────────────────────────────────── */
footer {
  background: var(--navy);
  color: rgba(255,255,255,.6);
  padding: 40px;
  text-align: center;
  margin-top: 80px;
}
footer .footer-emblem { font-size: 40px; margin-bottom: 12px; display: block; }
footer p { font-size: 12px; line-height: 1.7; max-width: 480px; margin: 0 auto; }
footer strong { color: rgba(255,255,255,.9); }

/* ─── АНИМАЦИИ ─────────────────────────────────── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-up { animation: fadeUp .5s ease-out forwards; opacity: 0; }
.fade-up-d1 { animation-delay: .1s; }
.fade-up-d2 { animation-delay: .2s; }
.fade-up-d3 { animation-delay: .3s; }

/* Таблица горячих клавиш */
.shortcut-table { width: 100%; border-collapse: collapse; font-size: 13px; margin: 12px 0; }
.shortcut-table th { background: var(--step-bg); padding: 8px 12px; text-align: left; font-size: 11px; font-weight: 700; letter-spacing: .5px; color: var(--ink-soft); text-transform: uppercase; border-bottom: 2px solid var(--border); }
.shortcut-table td { padding: 8px 12px; border-bottom: 1px solid var(--border); }
.shortcut-table tr:last-child td { border-bottom: none; }
