const CM={
  active:[],completed:[],failed:[],curId:null,
  getNew(){
    const avail=CASE_TPLS.filter(t=>!this.active.find(c=>c.tplId===t.id)&&!this.completed.find(c=>c.tplId===t.id)&&t.diff<=S.user.diff+1);
    if(!avail.length)return null;
    let tpl;
    // Адаптивный выбор с учётом сложности
    if(S.user.diff>=3){tpl=rnd(avail.filter(t=>t.risk>65)||avail);}
    else{tpl=rnd(avail.slice(0,Math.min(8,avail.length)));}
    const c={id:Date.now(),tplId:tpl.id,tpl,status:'active',step:0,errors:0,score:0,start:Date.now()};
    this.active.push(c);
    S.riskIndex=Math.min(100,S.riskIndex+Math.floor(tpl.risk/10));
    updateRiskUI();addLog(`Кейс: ${tpl.title}`,'info');
    return c;
  },
  complete(id){
    const i=this.active.findIndex(c=>c.id===id);if(i<0)return;
    const c=this.active.splice(i,1)[0];
    c.status='completed';c.end=Date.now();
    c.final=Math.max(0,c.tpl.diff*100-c.errors*15);
    this.completed.push(c);
    S.score+=c.final;S.correctAct++;S.totalAct++;
    S.riskIndex=Math.max(0,S.riskIndex-Math.floor(c.tpl.risk/8));
    updateRiskUI();updateHeader();spop(`+${c.final}`,true);
    addLog(`✅ Кейс закрыт: ${c.tpl.title} +${c.final}`,'ok');
    notify('ok',`Кейс закрыт! +${c.final} очков`,c.tpl.title);
    checkAch();renderDash();renderCases();
  },
  completeStep(cid){
    const c=this.active.find(x=>x.id===cid);if(!c)return;
    c.step++;c.score+=Math.floor(c.tpl.diff*20);
    if(c.step>=c.tpl.steps.length)this.complete(cid);
    renderCases();renderDash();
  }
};

