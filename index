function renderAddressBook(type) {
  const q = document.getElementById('ab-search')?.value?.toLowerCase() || '';
  let contacts = DB.contacts;
  if (type === 'personal') contacts = contacts.slice(0,5);
  if (q) contacts = contacts.filter(c => c.name.toLowerCase().includes(q) || c.dept.toLowerCase().includes(q));
  
  const c = document.getElementById('ab-list');
  c.innerHTML = contacts.map(ct => `
    <div class="contact-item" onclick="selectContact(${ct.id})" style="${APP.abSelectedContacts.has(ct.id)?'background:var(--blue-xl)':''}">
      <div class="contact-av" style="background:${ct.color}">${ct.name.split(' ').map(w=>w[0]).join('').substring(0,2)}</div>
      <div style="flex:1">
        <div class="contact-name">${ct.name}</div>
        <div class="contact-email">${ct.email}</div>
        <div class="contact-dept">${ct.dept}${ct.rank?` · ${ct.rank}`:''}</div>
