/* СТАТ */
.sg{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:14px;margin-bottom:20px}
.sc{background:var(--bg-card);border-radius:var(--rl);padding:18px;box-shadow:var(--sh-sm);border:1px solid var(--bdrl);display:flex;gap:14px;align-items:flex-start;transition:transform var(--tr),box-shadow var(--tr)}
.sc:hover{transform:translateY(-2px);box-shadow:var(--sh-md)}
.si{width:46px;height:46px;border-radius:var(--rl);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.ib{background:rgba(21,101,192,.1);color:var(--primary)}.ig{background:rgba(46,125,50,.1);color:var(--success)}
.io{background:rgba(230,81,0,.1);color:var(--warning)}.ir{background:rgba(198,40,40,.1);color:var(--danger)}
.ip{background:rgba(106,27,154,.1);color:#6a1b9a}.it{background:rgba(0,105,92,.1);color:#00695c}
.iv{background:rgba(200,168,75,.15);color:#8a6d00}
.sv{font-size:30px;font-weight:800;color:var(--th);line-height:1}
.sl{font-size:11.5px;color:var(--tm);margin-top:3px}
.sn2{font-size:11px;font-weight:600;margin-top:5px;display:flex;align-items:center;gap:4px}
.nu{color:var(--success)}.nd{color:var(--danger)}.ni{color:var(--info)}

/* ТАБЛИЦЫ */
.tw{overflow-x:auto}
table{width:100%;border-collapse:collapse}
thead th{padding:9px 13px;font-size:10.5px;font-weight:700;color:var(--tm);text-transform:uppercase;letter-spacing:.6px;background:var(--bdrl);text-align:left;white-space:nowrap;border-bottom:1px solid var(--bdr)}
tbody td{padding:11px 13px;font-size:13px;border-bottom:1px solid var(--bdrl);vertical-align:middle}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover td{background:rgba(21,101,192,.025)}

/* БЕЙДЖИ */
.bdg{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:700;white-space:nowrap}
.bb{background:var(--primary-light);color:var(--primary)}.bg{background:var(--success-bg);color:var(--success)}
.bo{background:var(--warning-bg);color:var(--warning)}.br{background:var(--danger-bg);color:var(--danger)}
.bi{background:var(--info-bg);color:var(--info)}.bgy{background:var(--bdrl);color:var(--ts)}
.bv{background:rgba(200,168,75,.15);color:#8a6d00}

/* СТАТУС */
.sd{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:5px}
.sd.free{background:var(--success);animation:bl 2s infinite}.sd.busy{background:var(--warning)}
.sd.patrol{background:var(--primary)}.sd.off{background:var(--tm)}

/* ТОСТЫ */
#TB{position:fixed;top:72px;right:18px;display:flex;flex-direction:column;gap:9px;z-index:9000;pointer-events:none}
.tst{display:flex;align-items:flex-start;gap:11px;background:#fff;border-radius:var(--rl);box-shadow:var(--sh-lg);padding:13px 15px;min-width:290px;max-width:360px;border-left:4px solid var(--primary);pointer-events:all;animation:ti .3s ease;transition:opacity .3s ease,transform .3s ease}
.tst.ts{border-left-color:var(--success)}.tst.tw{border-left-color:var(--warning)}
.tst.td{border-left-color:var(--danger)}.tst.ti{border-left-color:var(--info)}
.tst.ts .ti2{color:var(--success)}.tst.tw .ti2{color:var(--warning)}
.tst.td .ti2{color:var(--danger)}.tst.ti .ti2{color:var(--info)}
.ti2{font-size:17px;flex-shrink:0;margin-top:1px}
.tb2{flex:1;min-width:0}.tt{font-size:12.5px;font-weight:700;color:var(--th)}
.tm2{font-size:11.5px;color:var(--ts);margin-top:2px;line-height:1.4}
.tx2{margin-left:auto;background:none;border:none;cursor:pointer;color:var(--tm);font-size:14px;flex-shrink:0}
.tx2:hover{color:var(--th)}
@keyframes ti{from{opacity:0;transform:translateX(100%)}to{opacity:1;transform:translateX(0)}}

/* МОДАЛ */
.mb{position:fixed;inset:0;z-index:8000;background:rgba(10,22,40,.6);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease}
.mb.open{opacity:1;pointer-events:all}
.md{background:#fff;border-radius:var(--rx);box-shadow:var(--sh-xl);width:90%;max-width:600px;max-height:90vh;display:flex;flex-direction:column;transform:scale(.96) translateY(8px);transition:transform .25s ease}
.mb.open .md{transform:scale(1) translateY(0)}
.md-lg{max-width:800px}
.mh{padding:18px 22px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;gap:11px}
.mt2{font-size:15px;font-weight:700;color:var(--th);flex:1}
.mb2{padding:22px;overflow-y:auto;flex:1}
.mf{padding:14px 22px;border-top:1px solid var(--bdr);display:flex;gap:8px;justify-content:flex-end}

/* СТРАНИЦА */
.ph{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:20px;gap:16px}
.pha{display:flex;gap:8px;align-items:center;flex-shrink:0}
.pt{font-size:20px;font-weight:800;color:var(--th)}.ps{font-size:12.5px;color:var(--tm);margin-top:3px}

/* DASH GRID */
.dg{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
.s2{grid-column:span 2}.s3{grid-column:span 3}

/* ЛЕНТА СОБЫТИЙ */
.ef{display:flex;flex-direction:column;gap:2px}
.ei{display:flex;gap:10px;align-items:flex-start;padding:8px 10px;border-radius:6px;transition:background var(--tr)}
.ei:hover{background:var(--bg-hv)}
.et{font-size:11px;color:var(--tm);white-space:nowrap;font-family:monospace;min-width:44px;margin-top:2px}
.ed{width:7px;height:7px;border-radius:50%;margin-top:5px;flex-shrink:0}
.ex{font-size:12.5px;color:var(--ts);line-height:1.45}.ex strong{color:var(--th)}

/* СМЕНА */
.shc{background:linear-gradient(135deg,var(--mvd-blue),var(--primary));border-radius:var(--rl);padding:18px;color:#fff;position:relative;overflow:hidden}
.shc::after{content:"";position:absolute;right:-20px;top:-20px;width:120px;height:120px;border-radius:50%;background:rgba(255,255,255,.06)}
.shl{font-size:10px;opacity:.6;text-transform:uppercase;letter-spacing:1px}
.shv{font-size:17px;font-weight:800;margin-top:4px}.shm{font-size:11px;opacity:.55;margin-top:2px}
.shr{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}
.shb{background:rgba(255,255,255,.12);border-radius:var(--r);padding:10px;text-align:center}
.shn{font-size:24px;font-weight:800}.shs{font-size:10.5px;opacity:.6;margin-top:2px}

/* XP */
.xb{background:var(--bdrl);border-radius:6px;height:7px;overflow:hidden;margin-top:6px}
.xf{height:100%;border-radius:6px;background:linear-gradient(90deg,var(--primary),var(--mvd-gold));transition:width .8s ease}

/* АЛЕРТ */
.al{padding:11px 15px;border-radius:var(--r);display:flex;align-items:center;gap:11px;margin-bottom:16px;font-size:13px}
.al i{flex-shrink:0}.al-b{flex:1}.al-ml{margin-left:auto}
.al-i{background:var(--info-bg);border:1px solid rgba(1,87,155,.2);color:var(--info)}
.al-s{background:var(--success-bg);border:1px solid rgba(46,125,50,.2);color:var(--success)}
.al-w{background:var(--warning-bg);border:1px solid rgba(239,108,0,.2);color:var(--warning)}
.al-d{background:var(--danger-bg);border:1px solid rgba(198,40,40,.2);color:var(--danger)}

/* ПУСТО / ЗАГЛУШКА */
.em{text-align:center;padding:40px 20px;color:var(--tm)}
.em i{font-size:40px;opacity:.25;margin-bottom:12px;display:block}.em p{font-size:13px}
.ms{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:280px;gap:12px;color:var(--tm)}
.ms i{font-size:52px;opacity:.2}.ms h3{font-size:15px;font-weight:700;color:var(--ts)}
.ms p{font-size:12.5px;max-width:300px;text-align:center;line-height:1.6}

/* ТОПЛИВО */
.fb{display:flex;align-items:center;gap:7px}
.ft{flex:1;height:5px;background:var(--bdrl);border-radius:3px;overflow:hidden;min-width:50px}
.ff{height:100%;border-radius:3px}

/* НАРЯДЫ */
.pm{display:flex;align-items:center;gap:10px;padding:9px 12px;border-bottom:1px solid var(--bdrl)}
.pm:last-child{border-bottom:none}
.pc{font-size:13px;font-weight:700;color:var(--th);min-width:76px}
.pi{flex:1;font-size:11.5px;color:var(--tm)}

/* МИССИИ */
.mc{background:#fff;border-radius:var(--rl);border:1.5px solid var(--bdrl);box-shadow:var(--sh-sm);margin-bottom:14px;overflow:hidden;transition:box-shadow var(--tr),border-color var(--tr)}
.mc:hover{box-shadow:var(--sh-md)}.mc.mca{border-color:var(--primary)}.mc.mcd{border-color:var(--success)}
.mch{display:flex;align-items:center;gap:14px;padding:16px 18px;border-bottom:1px solid var(--bdrl)}
.mce{width:48px;height:48px;border-radius:var(--rl);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}
.mci{flex:1}.mct{font-size:15px;font-weight:700;color:var(--th)}.mcs{font-size:11.5px;color:var(--tm);margin-top:2px}
.mca2{display:flex;gap:8px;align-items:center;flex-shrink:0}
.mcb{padding:15px 18px}.mcd2{font-size:13px;color:var(--ts);line-height:1.6;margin-bottom:12px}
.mctg{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:13px}
.mcf{display:flex;align-items:center;justify-content:space-between}
.mcm{font-size:11.5px;color:var(--tm);display:flex;gap:14px;align-items:center}

/* КУСП */
.kusp-form{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.kusp-form .span-full{grid-column:1/-1}
.kusp-num{font-size:22px;font-weight:800;color:var(--primary);letter-spacing:1px}
.kusp-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 12px;background:var(--primary-light);border-radius:20px;font-size:12px;font-weight:700;color:var(--primary)}

/* ДИСПЕТЧЕРИЗАЦИЯ */
.call-card{border-radius:var(--rl);padding:16px;border:2px solid var(--bdr);transition:all var(--tr);position:relative;overflow:hidden;cursor:pointer}
.call-card:hover{border-color:var(--primary);box-shadow:var(--sh-md)}
.call-card.incoming{border-color:var(--danger);animation:pulse-border 1.5s infinite}
.call-card.active{border-color:var(--success);background:var(--success-bg)}
@keyframes pulse-border{0%,100%{box-shadow:0 0 0 0 rgba(198,40,40,.3)}50%{box-shadow:0 0 0 6px rgba(198,40,40,0)}}
.call-timer{font-family:"Courier New",monospace;font-size:24px;font-weight:800;color:var(--primary)}
.call-timer.red{color:var(--danger);animation:bl 1s infinite}
.waveform{display:flex;align-items:center;gap:2px;height:30px}
.wv-bar{width:3px;background:var(--primary);border-radius:2px;animation:wave 1s ease-in-out infinite}
.wv-bar:nth-child(2n){animation-delay:.1s}.wv-bar:nth-child(3n){animation-delay:.2s}
@keyframes wave{0%,100%{height:4px}50%{height:24px}}
.call-queue{display:flex;flex-direction:column;gap:8px}
.cq-item{display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:var(--r);border:1.5px solid var(--bdr);background:#fff;transition:all var(--tr)}
.cq-item.cq-urgent{border-color:var(--danger);background:var(--danger-bg)}
.cq-item.cq-medium{border-color:var(--warning);background:var(--warning-bg)}
.cq-num{font-family:monospace;font-size:11px;color:var(--tm);min-width:44px}

/* АНАЛИТИКА */
.chart-wrap{position:relative;padding:16px}
.sql-editor{background:#1e2936;border-radius:var(--r);padding:14px;font-family:"Courier New",monospace;font-size:12.5px;color:#7ec8e3;line-height:1.7;border:1px solid #2d3f50}
.sql-kw{color:#c792ea}.sql-fn{color:#82aaff}.sql-str{color:#c3e88d}.sql-num{color:#f78c6c}
.kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}
.kpi{background:var(--bg-card);border-radius:var(--rl);padding:16px;box-shadow:var(--sh-sm);border:1px solid var(--bdrl);text-align:center}
.kpi-val{font-size:26px;font-weight:800}.kpi-lbl{font-size:11px;color:var(--tm);margin-top:3px}

/* ГРЛ */
.grl-form{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.grl-form .sf{grid-column:1/-1}
.detained-card{display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:var(--r);border:1px solid var(--bdr);margin-bottom:8px;background:#fff;transition:all var(--tr)}
.detained-card:hover{border-color:var(--primary);box-shadow:var(--sh-sm)}
.detained-av{width:36px;height:36px;border-radius:50%;background:var(--bdrl);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}

/* МОНО */
.mr{background:var(--bg-hv);border-radius:var(--r);padding:18px 20px;font-family:"Courier New",monospace;font-size:13px;line-height:1.9;color:var(--th);border:1px solid var(--bdr);white-space:pre-wrap}

/* КАРТА */
#ME{height:420px;border-radius:0 0 var(--rl) var(--rl);z-index:1;min-height:420px;background:#e8e8e8}

/* СТРОКА ПРОГРЕССА */
.prog-row{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.prog-lbl{font-size:12px;color:var(--ts);min-width:120px}
.prog-bar{flex:1;height:8px;background:var(--bdrl);border-radius:4px;overflow:hidden}
.prog-fill{height:100%;border-radius:4px;transition:width .6s ease}
.prog-val{font-size:12px;font-weight:700;color:var(--th);min-width:40px;text-align:right}

/* УТИЛИТЫ */
.df{display:flex}.ac{align-items:center}.jb{justify-content:space-between}
.g6{gap:6px}.g8{gap:8px}.g12{gap:12px}.g16{gap:16px}
.mb8{margin-bottom:8px}.mb12{margin-bottom:12px}.mb16{margin-bottom:16px}.mb20{margin-bottom:20px}
.mt8{margin-top:8px}.mt12{margin-top:12px}.mt16{margin-top:16px}
.fw7{font-weight:700}.fs12{font-size:12px}.fs13{font-size:13px}
.tc-m{color:var(--tm)}.tc-h{color:var(--th)}.tc-p{color:var(--primary)}
.w100{width:100%}.dn{display:none!important}
.row-2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}
.sep{height:1px;background:var(--bdrl);margin:16px 0}
.district-label{background:none!important;border:none!important;box-shadow:none!important;font-weight:800;font-size:13px;color:#0f172a;text-shadow:1px 1px 3px rgba(255,255,255,0.9)}
@media(max-width:900px){div[style*="display:flex;gap:16px"]{flex-direction:column}#ME{height:50vh!important;min-height:300px!important}}
@media(max-width:1100px){.dg{grid-template-columns:1fr 1fr}.s2,.s3{grid-column:span 2}}
@media(max-width:768px){.sg{grid-template-columns:1fr 1fr}.dg{grid-template-columns:1fr}.s2,.s3{grid-column:span 1}#CT{padding:14px}.h-sh,.h-un,.h-ur{display:none}.kusp-form,.grl-form,.row-2,.row-3{grid-template-columns:1fr}.kpi-row{grid-template-columns:1fr 1fr}}

/* ── ДОСТИЖЕНИЯ ── */
.ach-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px}
.ach-card{background:#fff;border-radius:var(--rl);border:2px solid var(--bdrl);padding:16px;text-align:center;transition:all var(--tr)}
.ach-card.unlocked{border-color:var(--mvd-gold);box-shadow:0 4px 16px rgba(200,168,75,.25)}
.ach-card.locked{opacity:.5;filter:grayscale(1)}
.ach-ico{font-size:36px;margin-bottom:8px;display:block}
.ach-name{font-size:12px;font-weight:700;color:var(--th);margin-bottom:4px}
.ach-desc{font-size:10.5px;color:var(--tm);line-height:1.4}
.ach-xp{display:inline-block;margin-top:6px;background:rgba(200,168,75,.15);color:#8a6d00;font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px}

/* ── НОТИФИКАЦИИ ── */
.notif-panel{position:fixed;top:68px;right:18px;width:340px;max-height:480px;background:#fff;border-radius:var(--rl);box-shadow:var(--sh-xl);border:1px solid var(--bdrl);z-index:7500;opacity:0;pointer-events:none;transition:all .25s ease;transform:translateY(-10px)}
.notif-panel.open{opacity:1;pointer-events:all;transform:translateY(0)}
.np-hd{padding:14px 16px;border-bottom:1px solid var(--bdrl);display:flex;align-items:center;gap:8px}
.np-title{font-size:13px;font-weight:700;flex:1;color:var(--th)}
.np-list{max-height:380px;overflow-y:auto}
.np-item{display:flex;gap:10px;padding:11px 16px;border-bottom:1px solid var(--bdrl);transition:background var(--tr);cursor:pointer}
.np-item:hover{background:var(--bg-hv)}
.np-item:last-child{border-bottom:none}
.np-ic{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}
.np-txt{flex:1}.np-nt{font-size:12.5px;font-weight:600;color:var(--th)}
.np-ns{font-size:11px;color:var(--tm);margin-top:2px}
.np-empty{padding:32px;text-align:center;color:var(--tm);font-size:13px}

/* ── РАДИОЧАТ ── */
.radio-wrap{display:flex;flex-direction:column;height:360px}
.radio-feed{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:6px;background:#0d1117;border-radius:var(--r) var(--r) 0 0}
.radio-msg{padding:7px 11px;border-radius:6px;font-size:12px;font-family:"Courier New",monospace;line-height:1.5}
.radio-msg.sys{background:rgba(21,101,192,.2);color:#7ec8e3}
.radio-msg.in{background:rgba(46,125,50,.2);color:#a8e6a3;align-self:flex-start}
.radio-msg.out{background:rgba(200,168,75,.2);color:#f0d080;align-self:flex-end}
.radio-msg.alert{background:rgba(198,40,40,.25);color:#ff9090}
.radio-footer{display:flex;gap:8px;padding:10px;background:#1a2332;border-radius:0 0 var(--r) var(--r)}
.radio-inp{flex:1;background:#0d1117;border:1px solid #2d3f50;border-radius:6px;color:#7ec8e3;padding:8px 12px;font-family:"Courier New",monospace;font-size:12px;outline:none}
.radio-inp:focus{border-color:var(--mvd-gold)}

/* ── СМЕНА ДЕЖУРСТВА ── */
.handover-form{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.handover-form .sf{grid-column:1/-1}

/* ── ЭКСТРЕННЫЙ РЕЖИМ ── */
.emergency-banner{background:var(--danger);color:#fff;padding:12px 20px;display:flex;align-items:center;gap:12px;font-weight:700;font-size:14px;animation:emer 1s ease infinite;position:fixed;top:0;left:0;right:0;z-index:7000}
@keyframes emer{0%,100%{opacity:1}50%{opacity:.8}}
.emergency-banner button{margin-left:auto;background:rgba(255,255,255,.2);border:none;color:#fff;padding:6px 14px;border-radius:6px;cursor:pointer;font-weight:700}

/* ── TIMELINE ── */
.tl{position:relative;padding-left:24px}
.tl::before{content:"";position:absolute;left:8px;top:0;bottom:0;width:2px;background:var(--bdrl)}
.tl-item{position:relative;margin-bottom:16px}
.tl-dot{position:absolute;left:-20px;width:12px;height:12px;border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 2px var(--primary);background:var(--primary);top:4px}
.tl-dot.success{box-shadow:0 0 0 2px var(--success);background:var(--success)}
.tl-dot.warning{box-shadow:0 0 0 2px var(--warning);background:var(--warning)}
.tl-dot.danger{box-shadow:0 0 0 2px var(--danger);background:var(--danger)}
.tl-time{font-size:10.5px;color:var(--tm);margin-bottom:2px;font-family:monospace}
.tl-text{font-size:13px;color:var(--tb);line-height:1.5}

/* ── КАРТА ИНЦИДЕНТОВ ── */
.inc-marker{background:var(--danger);color:#fff;padding:3px 7px;border-radius:4px;font-size:10px;font-weight:700;white-space:nowrap;box-shadow:0 2px 6px rgba(0,0,0,.3);animation:pulse-m 2s ease infinite}
@keyframes pulse-m{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}

/* ── PRINT ── */
@media print{
  #SB,#HDR,#MP,#TB,#MB,#emergBanner,.no-print{display:none!important}
  #APP{display:block;height:auto}
  .main{overflow:visible}
  #CT{overflow:visible;padding:0}
  .card{box-shadow:none;border:1px solid #ccc}
}

/* ── ПОИСК ── */
.search-bar{display:flex;align-items:center;gap:10px;padding:12px 16px;background:var(--bg-hv);border-radius:var(--rl);margin-bottom:16px;border:1.5px solid var(--bdrl)}
.search-bar input{flex:1;border:none;background:none;font-size:14px;color:var(--th);outline:none}
.search-bar input::placeholder{color:var(--tm)}
.search-results{background:#fff;border-radius:var(--rl);box-shadow:var(--sh-lg);border:1px solid var(--bdrl);overflow:hidden;margin-top:8px;max-height:320px;overflow-y:auto}
.sr-item{display:flex;align-items:center;gap:12px;padding:11px 16px;border-bottom:1px solid var(--bdrl);cursor:pointer;transition:background var(--tr)}
.sr-item:hover{background:var(--bg-hv)}.sr-item:last-child{border-bottom:none}
.sr-tag{font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--tm);min-width:60px}
.sr-nm{font-size:13px;font-weight:600;color:var(--th)}.sr-sub{font-size:11.5px;color:var(--tm)}

/* ── ИНЦИДЕНТ ПОДРОБНО ── */
.inc-header{background:linear-gradient(135deg,var(--danger),#8b0000);color:#fff;padding:20px;border-radius:var(--rl) var(--rl) 0 0}
.inc-status-flow{display:flex;align-items:center;gap:0;margin:16px 0;overflow-x:auto;padding-bottom:4px}
.isf-step{display:flex;flex-direction:column;align-items:center;min-width:90px}
.isf-dot{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;margin-bottom:4px}
.isf-lbl{font-size:9.5px;text-align:center;color:var(--tm);white-space:nowrap}
.isf-line{flex:1;height:2px;background:var(--bdrl);margin-top:-18px;min-width:20px}
.isf-step.done .isf-dot{background:var(--success);color:#fff}
.isf-step.current .isf-dot{background:var(--primary);color:#fff;box-shadow:0 0 0 4px var(--primary-light)}
.isf-step.pending .isf-dot{background:var(--bdrl);color:var(--tm)}

/* ── HEATMAP ── */
.heatmap-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
.hm-cell{height:32px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:rgba(255,255,255,.9);cursor:pointer;transition:transform var(--tr)}
.hm-cell:hover{transform:scale(1.05)}
.hm-days{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-bottom:4px}
.hm-day{font-size:9.5px;text-align:center;color:var(--tm);font-weight:600}

/* ── ВИДЖЕТ ВРЕМЕНИ РЕАГИРОВАНИЯ ── */
.rt-ring{position:relative;width:100px;height:100px;margin:0 auto}
.rt-ring svg{transform:rotate(-90deg)}
.rt-val{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column}
.rt-num{font-size:22px;font-weight:800;color:var(--primary);line-height:1}
.rt-unit{font-size:9px;color:var(--tm)}

/* ── МОБИЛЬНЫЙ ИНТЕРФЕЙС НАРЯДА ── */
.mobile-frame{width:320px;margin:0 auto;border-radius:28px;border:8px solid #1a1a2e;box-shadow:0 20px 60px rgba(0,0,0,.3);overflow:hidden;background:#fff}
.mobile-status-bar{background:#1a1a2e;color:#fff;padding:8px 16px;font-size:11px;display:flex;justify-content:space-between}
.mobile-header{background:linear-gradient(135deg,var(--primary),var(--mvd-mid));color:#fff;padding:16px;text-align:center}
.mobile-content{padding:16px;max-height:400px;overflow-y:auto}
.mob-card{background:var(--bg-hv);border-radius:var(--r);padding:12px;margin-bottom:10px;border-left:3px solid var(--primary)}
.mob-card.urgent{border-left-color:var(--danger);background:var(--danger-bg)}
.mob-btn{display:block;width:100%;padding:10px;border-radius:var(--r);border:none;font-weight:600;font-size:13px;margin-bottom:8px;cursor:pointer;text-align:center;transition:all var(--tr)}
.mob-btn.primary{background:var(--primary);color:#fff}
.mob-btn.success{background:var(--success);color:#fff}
.mob-btn.danger{background:var(--danger);color:#fff}

/* ── СТАТУС СИСТЕМА ── */
.sys-status-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}
.sys-mod{border-radius:var(--r);padding:14px;text-align:center;border:1.5px solid var(--bdrl)}
.sys-mod.ok{border-color:var(--success);background:var(--success-bg)}
.sys-mod.warn{border-color:var(--warning);background:var(--warning-bg)}
.sys-mod.err{border-color:var(--danger);background:var(--danger-bg)}
.sys-mod-ico{font-size:22px;margin-bottom:6px}
.sys-mod-nm{font-size:11.5px;font-weight:700}.sys-mod-st{font-size:10.5px;margin-top:3px}

/* ── ФИЛЬТРЫ ── */
.filter-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.filter-chip{padding:5px 12px;border-radius:20px;font-size:11.5px;font-weight:600;cursor:pointer;border:1.5px solid var(--bdrl);background:#fff;transition:all var(--tr)}
.filter-chip:hover{border-color:var(--primary);color:var(--primary)}
.filter-chip.active{background:var(--primary);color:#fff;border-color:var(--primary)}

/* ── СЧЁТЧИК АНИМАЦИЯ ── */
@keyframes countUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.count-anim{animation:countUp .5s ease}
</style>
</head>
<body>

