      <div class="sb-it" data-m="kusp" onclick="SYS.go('kusp')"><span class="sb-i"><i class="fas fa-book-open"></i></span><span class="sb-l">КУСП</span><span class="sb-bdg" id="bK" style="display:none">0</span></div>
      <div class="sb-it" data-m="disp" onclick="SYS.go('disp')"><span class="sb-i"><i class="fas fa-phone-volume"></i></span><span class="sb-l">Диспетчеризация 02</span><span class="sb-bdg" id="bD" style="display:none">0</span></div>
