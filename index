function genEvent() {
  const weights = [30,20,25,8,12,20];
  let r = Math.random() * weights.reduce((a,b)=>a+b,0), i = 0;
  for (; i < weights.length && (r -= weights[i]) > 0; i++);
  const type = EV_TYPES[i] || 'система';
  const msg = MSGS[type]();
  addEvent(type, msg);

  if (type === 'билет') {
    S.ticketsBought++;
    const cost = Math.random()*12000+3000;
    S.budget -= cost;
    const bi = Math.floor(Math.random()*(BRANCHES.length-1))+1;
    BRANCHES[bi].spent += cost;
    const ti = Math.floor(Math.random()*TRANSPORT.length);
    TRANSPORT[ti].tickets++; TRANSPORT[ti].sum += cost;
    document.getElementById('k-tix').textContent = S.ticketsBought;
  }
  if (type === 'заявка') {
    S.evpdIssued++;
    S.queueLen = Math.max(0, S.queueLen + (Math.random()>.5 ? 1 : -1));
    document.getElementById('k-evpd').textContent = S.evpdIssued;
    document.getElementById('k-que').textContent = S.queueLen;
  }
  updateKPIs();
}

function addEvent(type, msg) {
  const now = new Date();
  const ts = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;
  const ev = { type, msg, ts, id: S.evCount++ };
  S.events.unshift(ev);
  if (S.events.length > 200) S.events.pop();

  const body = document.getElementById('evbody');
  const el = document.createElement('div');
  el.className = `evE ev-${type}`;
  el.innerHTML = `<div class="evts">${ts}</div><b>${type.toUpperCase()}</b> — ${msg}`;
  body.insertBefore(el, body.firstChild);
  if (body.children.length > 60) body.removeChild(body.lastChild);
  document.getElementById('evCnt').textContent = S.evCount;

  // update mini-events on dashboard
  const re = document.getElementById('recEvs');
  const row = document.createElement('div');
  row.className = 'evmini';
  row.innerHTML = `<span class="evt">${ts}</span><span class="evtp ${type}">${type}</span><span style="flex:1;color:var(--tx2);font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${msg}</span>`;
  re.insertBefore(row, re.firstChild);
  if (re.children.length > 5) re.removeChild(re.lastChild);
}

