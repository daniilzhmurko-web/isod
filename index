.inst-step-mini.done { background: rgba(21,128,61,0.2); color: #6EE7B7; }
.inst-step-mini.current { background: rgba(37,99,235,0.25); color: #93C5FD; border: 1px solid rgba(37,99,235,0.3); }
.inst-step-mini.next { background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.3); }
.prog-bar { height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; margin-top: 10px; }
.prog-fill { height: 100%; background: var(--gold); border-radius: 2px; }

/* ── MISSION TABLE ───────────────────────────── */
.mission-table { width: 100%; border-collapse: collapse; margin: 24px 0; }
.mission-table thead th {
  background: var(--navy); color: rgba(255,255,255,0.8);
