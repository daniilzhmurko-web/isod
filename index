/* ── EXAM MODE ──────────────────────────────────────────────── */
let examState = {
  active: false,
  totalTime: 1200, // 20 минут
  remaining: 1200,
  timer: null
};

function toggleExamMode() {
  if (examState.active) {
    stopExamMode();
  } else {
    startExamMode();
  }
}

function startExamMode() {
  examState.active = true;
  examState.remaining = examState.totalTime;

  document.getElementById('examTimerBar').style.display = 'block';
  document.getElementById('examBanner').classList.add('visible');
  document.getElementById('btnExam').style.background = 'rgba(192,57,43,0.6)';
  document.getElementById('btnHint').disabled = true;
  document.getElementById('btnHint').style.opacity = '0.4';

  showToast('⚠ Экзаменационный режим активирован! Подсказки отключены.', 'warning');
  addLog('warn', 'Активирован экзаменационный режим');

  examState.timer = setInterval(() => {
    examState.remaining--;
    updateExamTimer();
    if (examState.remaining <= 0) {
      stopExamMode(true);
    }
    // Предупреждение за 5 минут
    if (examState.remaining === 300) {
      showToast('⏰ До конца экзамена осталось 5 минут!', 'warning');
    }
    if (examState.remaining === 60) {
      showToast('⏰ Осталась 1 минута!', 'error');
    }
  }, 1000);
}

function stopExamMode(timeUp = false) {
  examState.active = false;
  clearInterval(examState.timer);

  document.getElementById('examTimerBar').style.display = 'none';
  document.getElementById('examBanner').classList.remove('visible');
  document.getElementById('btnExam').style.background = 'rgba(255,255,255,0.1)';
  document.getElementById('btnHint').disabled = false;
  document.getElementById('btnHint').style.opacity = '1';

  if (timeUp) {
    showToast('⏰ Время экзамена истекло!', 'error');
    addLog('error', 'Время экзамена истекло');
    showFinalResults();
  } else {
    showToast('Экзаменационный режим деактивирован', 'info');
  }
}

function updateExamTimer() {
  const m = Math.floor(examState.remaining / 60);
  const s = examState.remaining % 60;
  document.getElementById('examTimerDigit').textContent =
    String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
  const pct = (examState.remaining / examState.totalTime) * 100;
  document.getElementById('examTimerFill').style.width = pct + '%';
  if (examState.remaining < 300) {
    document.getElementById('examTimerDigit').style.color = '#FCA5A5';
  }
}

