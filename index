function showToast(msg,type='info'){
  const icons={success:'fa-check-circle',error:'fa-exclamation-circle',info:'fa-info-circle',warning:'fa-exclamation-triangle'};
  const colors={success:'var(--success)',error:'var(--danger)',info:'var(--info)',warning:'var(--warning)'};
  const t=document.createElement('div');
  t.className=`toast ${type}`;
  t.innerHTML=`<i class="fas ${icons[type]}" style="color:${colors[type]};flex-shrink:0"></i><span>${msg}</span>`;
  const tc=document.getElementById('toastContainer');if(tc)tc.appendChild(t);
  setTimeout(()=>t.remove(),4000);
}

