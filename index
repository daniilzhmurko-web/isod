  log('Сохранён черновик', 'save_draft');
}

function toggleCC() {
  const row = document.getElementById('c-cc-row');
  row.style.display = row.style.display === 'none' ? '' : 'none';
}

function validateComposeTo() {
  checkStepValidation();
}

function addAttach() {
  const files = ['Отчёт.pdf','Инструкция.docx','Фото.jpg','Данные.xlsx','Документ.pdf'];
  const f = files[Math.floor(Math.random()*files.length)];
  APP.attachments.push(f);
  const al = document.getElementById('c-attach-list');
  al.style.display = 'flex';
  al.innerHTML = APP.attachments.map((a,i) =>
    `<div class="attach-chip">📎 ${a} <span class="attach-chip-del" onclick="removeAttach(${i})">✕</span></div>`
  ).join('');
  log(`Прикреплён файл: ${f}`, 'add_attach');
  checkStepValidation();
  notify('ok', 'Файл прикреплён', f);
  document.getElementById('compose-status').textContent = `📎 ${APP.attachments.length} файл(ов)`;
}

function removeAttach(idx) {
  APP.attachments.splice(idx, 1);
  const al = document.getElementById('c-attach-list');
  if (APP.attachments.length === 0) { al.style.display = 'none'; al.innerHTML = ''; }
  else al.innerHTML = APP.attachments.map((a,i) =>
    `<div class="attach-chip">📎 ${a} <span class="attach-chip-del" onclick="removeAttach(${i})">✕</span></div>`
  ).join('');
}

function checkSpam() {
  const body = document.getElementById('c-body').value;
  const subj = document.getElementById('c-subj').value;
  const spamWords = ['бесплатно','выиграли','клик здесь','100%','срочно','перейдите','заблокирован'];
  const found = spamWords.filter(w => (body+subj).toLowerCase().includes(w));
  const status = document.getElementById('compose-status');
  if (found.length) {
    status.innerHTML = `<span style="color:var(--red)">⚠️ Обнаружены спам-признаки: ${found.join(', ')}</span>`;
  } else {
    status.innerHTML = `<span style="color:var(--green)">✅ Проверка пройдена — спам не обнаружен</span>`;
  }
  log('Проверка на спам', 'check_spam', {found});
  checkStepValidation();
  notify('ok', 'Проверка завершена', found.length ? `Найдено: ${found.join(', ')}` : 'Письмо безопасно');
}

function sendEmail() {
  const to = document.getElementById('c-to').value.trim();
  const subj = document.getElementById('c-subj').value.trim();
  const body = document.getElementById('c-body').value.trim();
  
  if (!to) { notify('err','Укажите получателя',''); APP.acc.total++; return; }
  if (!subj) { notify('err','Укажите тему',''); return; }
  if (!body) { notify('err','Напишите текст письма',''); return; }

  const sent = {
    id: Date.now(), from: APP.user.login+'@mvd.ru', fromName: APP.user.name,
    subj, body, to, date: new Date().toLocaleString('ru-RU').slice(0,16),
    unread: false, important: false, folder: 'sent',
    attachments: [...APP.attachments], tags: APP.attachments.length?['attach']:[]
  };
  DB.emails.push(sent);
  
  const type = APP.attachments.length > 0 ? 'send_with_attach' : 'send_email';
  log(`Письмо отправлено: ${subj}`, type, {to, attachments:APP.attachments.length});
  APP.score += 50; APP.acc.total++; APP.acc.correct++;
  updateHeader(); checkStepValidation();
  closeCompose();
  notify('ok', 'Письмо отправлено!', `Кому: ${to}`);
}

