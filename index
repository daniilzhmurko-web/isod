  if(!S.wo.sg)return'<div style="padding:28px;text-align:center;color:var(--tm)">Сначала отправьте справку на подпись.</div>';
  const u=S.se.u,d=x.dept;
  return`<div style="flex:1;overflow-y:auto;display:flex;gap:12px;padding:14px">
    <div style="width:110px;flex-shrink:0">
      <div class="pdc"><i class="fas fa-file-pdf"></i><span>Справка</span></div>
      <div class="pdc"><i class="fas fa-file-pdf"></i><span>Документы</span></div>
    </div>
    <div style="flex:1">
      <div class="${S.wo.si?'ssb si':'ssb pe'}"><i class="fas fa-${S.wo.si?'check-circle':'clock'}"></i>${S.wo.si?'Справка подписана ЭЦП':'Ожидает подписания'}</div>
      <div class="sti2"><p><i class="fas fa-usb"></i> <strong>Токен:</strong> ${u?.tok||'—'}</p><p><i class="fas fa-certificate"></i> <strong>Сертификат до:</strong> ${u?.ce||'—'}</p><p><i class="fas fa-user"></i> <strong>Владелец:</strong> ${u?.nm||'—'}</p></div>
