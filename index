/* ── ПОИСК ПО РЕЕСТРУ (глобальный) ─────────────────────────── */
function globalSearch(query) {
  if (!query || query.length < 2) return [];
  const q = query.toLowerCase();
  const results = [];
  globalState.persons.forEach(p => {
    const full = `${p.lastName} ${p.firstName} ${p.middleName} ${p.passport}`.toLowerCase();
    if (full.includes(q)) results.push({ type:'person', label:`${p.lastName} ${p.firstName} ${p.middleName}`, id: p.id, icon:'fa-user' });
  });
  globalState.weapons.forEach(w => {
    if ((w.model + ' ' + w.serial).toLowerCase().includes(q)) results.push({ type:'weapon', label:`${w.model} (${w.serial})`, id: w.id, icon:'fa-gun' });
  });
  globalState.licenses.forEach(l => {
    if (l.number.toLowerCase().includes(q)) results.push({ type:'license', label:`Лицензия ${l.number}`, id: l.id, icon:'fa-id-card' });
  });
  return results;
}

