function initUI() {
  // Топбар
  document.getElementById('tb-uname').textContent = APP.user.name;
  document.getElementById('tb-urole').textContent = {operator:'Оператор',senior:'Старший инспектор',teacher:'Преподаватель',admin:'Администратор'}[APP.user.role] || APP.user.role;
  const av = APP.user.name.split(' ').map(w=>w[0]).join('').substring(0,2);
  document.getElementById('tb-av').textContent = av;
  const modes = {training:'ОБУЧЕНИЕ',exam:'ЭКЗАМЕН',teacher:'ПРЕПОДАВАТЕЛЬ'};
  const mbadge = document.getElementById('tb-mode');
  mbadge.textContent = modes[APP.user.mode] || 'ОБУЧЕНИЕ';
  mbadge.className = `tb-mode ${APP.user.mode}`;

  renderTBLevels();
  renderMailList('inbox');
  renderInstSteps();
  renderLevelProgress();
  renderInst();
  updateHeader();

  // Режим преподавателя
  if (APP.user.mode === 'teacher') {
    APP.teacherMode = true;
    document.getElementById('inst-skip-btn').style.display = '';
  }

  // Начать мониторинг действий
  setInterval(checkStepValidation, 2000);
  setInterval(AIAdapt.tick, 30000);
}

function renderTBLevels() {
  const c = document.getElementById('tb-levels');
  c.innerHTML = L.levels.map((lv,i) => `
    <div class="tlevel ${lv.done?'done':i===CQ.level?'cur':i>CQ.level&&!APP.teacherMode?'locked':''}" onclick="${APP.teacherMode?`jumpLevel(${i})`:''}">
      ${lv.icon}
      <div class="tlevel-tip">${lv.name}</div>
    </div>`).join('');
}

function jumpLevel(i) {
  if (!APP.teacherMode) return;
  CQ.level = i; CQ.step = 0; CQ.hintCount = 0;
  if (i >= 1) { go('inbox'); }
  renderTBLevels(); renderInst();
  notify('info', `Уровень ${i+1}`, L.levels[i].name);
}

function toggleTeacher() {
  APP.teacherMode = !APP.teacherMode;
  document.getElementById('inst-skip-btn').style.display = APP.teacherMode ? '' : 'none';
  notify(APP.teacherMode?'warn':'ok', APP.teacherMode?'Режим преподавателя ВКЛ':'Режим преподавателя ВЫКЛ', '');
  renderTBLevels();
}

function updateHeader() {
  document.getElementById('tb-score').textContent = APP.score;
  document.getElementById('tb-steps').textContent = APP.doneSteps;
  const acc = APP.acc.total > 0 ? Math.round(APP.acc.correct/APP.acc.total*100)+'%' : '—';
  document.getElementById('tb-acc').textContent = acc;
  document.getElementById('rp-score').textContent = APP.score;
  const maxPts = QUESTS.reduce((s,l)=>s+l.steps.reduce((ss,st)=>ss+st.pts,0),0);
  document.getElementById('rp-max').textContent = maxPts;
  document.getElementById('rp-pbar').style.width = Math.min(100,Math.round(APP.score/maxPts*100))+'%';
}

function renderLevelProgress() {
  const c = document.getElementById('level-progress');
  c.innerHTML = L.levels.map((lv,i) => {
    const q = QUESTS[i];
    const done = q ? q.steps.filter(s=>s.done).length : 0;
    const total = q ? q.steps.length : 0;
    const pct = total > 0 ? Math.round(done/total*100) : 0;
    return `<div style="margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;font-size:10px;margin-bottom:2px">
        <span style="font-family:var(--font);font-weight:700;color:var(--txt2)">${lv.icon} ${lv.name}</span>
        <span style="color:var(--txt3)">${done}/${total}</span>
      </div>
      <div class="pbar"><div class="pfill ${lv.done?'pfill-green':i===CQ.level?'pfill-blue':'pfill-gold'}" style="width:${pct}%"></div></div>
    </div>`;
  }).join('');
}

