const QM={active:[],completed:[],failed:[],
  getNew(){
    const avail=QT.filter(t=>!this.active.find(q=>q.tid===t.id)&&!this.completed.find(q=>q.tid===t.id)&&t.diff<=(S.user.diff+1)&&!t.isCrisis);
    if(!avail.length)return null;
    let sel;
    if(S.ai.weaknesses.length>0&&Math.random()<.6){
      const w=rnd(S.ai.weaknesses);
      const rel=avail.filter(t=>t.t===w);
      sel=rel.length>0?rnd(rel):rnd(avail);
    }else sel=rnd(avail);
    const q={id:Date.now(),tid:sel.id,tpl:sel,status:'active',step:0,stepsOK:[],start:Date.now(),score:0,errors:0};
    this.active.push(q);
    return q;
  },
  completeStep(qid,correct=true){
    const q=this.active.find(x=>x.id===qid);if(!q)return;
    if(correct){const sp=Math.floor(q.tpl.pts/q.tpl.steps.length);q.score+=sp;q.step++;log(`Шаг ${q.step}: ${q.tpl.steps[q.step-1]}`,'step_ok');}
    else{q.errors++;q.score=Math.max(0,q.score-15);log('Ошибка в шаге','step_err');}
    if(q.step>=q.tpl.steps.length)this.complete(qid);
  },
  complete(qid){
    const i=this.active.findIndex(x=>x.id===qid);if(i<0)return;
    const q=this.active.splice(i,1)[0];
    q.status='completed';q.end=Date.now();q.total=q.end-q.start;
    q.final=Math.max(0,q.score-q.errors*12);
    this.completed.push(q);
    S.score+=q.final;S.questsDone++;S.acc.total++;if(q.errors===0)S.acc.correct++;
    if(q.errors>2&&!S.ai.weaknesses.includes(q.tpl.t))S.ai.weaknesses.push(q.tpl.t);
    scorePopup(`+${q.final}`,true);
    updateHeader();renderDash();renderQList();
    log(`Квест завершён: ${q.tpl.name}`,'quest_done',{score:q.final,errors:q.errors});
    const msg=q.errors===0?`✅ Отлично! «${q.tpl.name}» без ошибок. +${q.final} баллов!`:`📝 «${q.tpl.name}» завершено с ${q.errors} ошибками. +${q.final} баллов.`;
    aMsg('exam',msg,q.errors===0?'ok':'warn');
    notify(q.errors===0?'ok':'w',`+${q.final} баллов`,q.tpl.name);
    MultiUser.broadcast({type:'quest_done',user:S.user,pts:q.final});
  },
  fail(qid,reason){
    const i=this.active.findIndex(x=>x.id===qid);if(i<0)return;
    const q=this.active.splice(i,1)[0];
