<script>
'use strict';
/* ═══════════════════════════════════════════════════
   СОДЧ МВД России — Учебный Симулятор v2
   Все модули: КУСП, Диспетчеризация 02, УСиС,
   Аналитика, ГРЛ, Журналы, Сводка, ЦОР, Миссии
