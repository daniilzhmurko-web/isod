const MultiUser={
  ch:null,users:[],
  init(){
    try{
      this.ch=new BroadcastChannel('fis_gibdd_v9');
      this.ch.onmessage=e=>this.handle(e.data);
      this.broadcast({type:'join',user:S.user,score:S.score});
      setInterval(()=>this.broadcast({type:'hb',user:S.user,score:S.score}),6000);
    }catch(e){}
  },
  broadcast(d){if(this.ch)try{this.ch.postMessage({...d,sid:S.sid});}catch(e){}},
  handle(d){
    if(d.sid===S.sid)return;
    if(d.type==='join'||d.type==='hb'){
      const ei=this.users.findIndex(u=>u.sid===d.sid);
      const u={...d.user,sid:d.sid,score:d.score,seen:Date.now()};
      if(ei>=0)this.users[ei]=u;else this.users.push(u);
      this.clean();this.updateUI();
      if(S.curPanel==='lb')renderLB();
    }
    if(d.type==='quest_done')notify('info',`${d.user.name} выполнил задание!`,`+${d.pts} баллов`);
  },
  clean(){const n=Date.now();this.users=this.users.filter(u=>n-u.seen<18000);},
  updateUI(){
    const cnt=this.users.length+1;
    document.getElementById('online-cnt').textContent=`${cnt} онлайн`;
  }
};

