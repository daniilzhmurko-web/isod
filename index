/* ── SUBSTEPS ────────────────────────────────── */
.substeps { display: flex; flex-direction: column; gap: 0; }
.substep {
  display: flex; gap: 16px; padding: 14px 0;
  border-bottom: 1px solid var(--border); position: relative;
}
.substep:last-child { border-bottom: none; }
.substep-dot {
  width: 28px; height: 28px; border-radius: 50%;
  background: var(--step-bg); border: 2px solid var(--border-dark);
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700; color: var(--navy-mid);
  flex-shrink: 0; margin-top: 2px; position: relative; z-index: 1;
}
.substep-dot::after {
  content: '';
  position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
  width: 2px; height: calc(100% + 14px);
  background: var(--border); z-index: 0;
}
.substep:last-child .substep-dot::after { display: none; }
.substep-content { flex: 1; }
.substep-action {
  font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 5px; line-height: 1.5;
}
.substep-action code {
  font-family: var(--font-mono); font-size: 12px;
  background: var(--step-bg); color: var(--navy-mid);
  padding: 2px 8px; border-radius: 4px; font-weight: 500;
}
.substep-detail { font-size: 13px; color: var(--muted); line-height: 1.6; }
.substep-detail strong { color: var(--ink-soft); }

/* ── CALLOUT BOXES ───────────────────────────── */
.callout {
  border-radius: 10px; padding: 16px 20px; margin: 20px 0;
  display: flex; gap: 14px; align-items: flex-start;
}
.callout-icon { font-size: 18px; flex-shrink: 0; margin-top: 1px; }
.callout-body {}
.callout-title { font-size: 13px; font-weight: 700; margin-bottom: 3px; }
.callout-text { font-size: 13px; line-height: 1.6; }
.callout.tip    { background: var(--tip-bg); border: 1px solid #FCD34D; }
.callout.tip .callout-title { color: #92400E; }
.callout.tip .callout-text  { color: #78350F; }
.callout.warn   { background: var(--warn-bg); border: 1px solid #FCA5A5; }
.callout.warn .callout-title { color: #991B1B; }
.callout.warn .callout-text  { color: #7F1D1D; }
.callout.ok     { background: var(--ok-bg); border: 1px solid #86EFAC; }
.callout.ok .callout-title   { color: #14532D; }
.callout.ok .callout-text    { color: #166534; }
.callout.info   { background: var(--step-bg); border: 1px solid #93C5FD; }
.callout.info .callout-title { color: #1E3A8A; }
.callout.info .callout-text  { color: #1E40AF; }

/* ── KEYBOARD SHORTCUTS ──────────────────────── */
.shortcut-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 10px; margin: 20px 0;
}
.shortcut-item {
  display: flex; align-items: center; gap: 12px;
  background: var(--white); border: 1px solid var(--border);
  border-radius: 8px; padding: 12px 14px;
}
.shortcut-item .keys { display: flex; gap: 4px; flex-shrink: 0; }
.kbd {
