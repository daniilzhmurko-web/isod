const SYS={
  s:null,sbCol:false,mpExp:false,map:null,charts:{},
  callTmr:null,callSec:0,evTmr:null,

  init(){
    setTimeout(()=>{
      this.s=this.load();
      const ls=document.getElementById('LS');
      ls.classList.add('out');setTimeout(()=>ls.style.display='none',650);
      if(this.s.user.nm){this.showApp();}
      else{document.getElementById('LGN').classList.add('show');setTimeout(()=>document.getElementById('iNm').focus(),500);}
    },1700);
  },

  load(){
    try{
      const r=localStorage.getItem('sodch_v2');
      if(r){
        const p=JSON.parse(r);
        const s=Object.assign({},JSON.parse(JSON.stringify(DEF)),p);
        if(!s.patrols)s.patrols=JSON.parse(JSON.stringify(INIT_P));
        if(!s.events) s.events=JSON.parse(JSON.stringify(INIT_EV));
        if(!s.kusp)   s.kusp=JSON.parse(JSON.stringify(INIT_KUSP));
        if(!s.bul)    s.bul=JSON.parse(JSON.stringify(INIT_BUL));
        return s;
      }
    }catch(e){}
    const s=JSON.parse(JSON.stringify(DEF));
    s.patrols=JSON.parse(JSON.stringify(INIT_P));
    s.events=JSON.parse(JSON.stringify(INIT_EV));
    s.kusp=JSON.parse(JSON.stringify(INIT_KUSP));
    s.bul=JSON.parse(JSON.stringify(INIT_BUL));
    return s;
  },
  save(){try{localStorage.setItem('sodch_v2',JSON.stringify(this.s));}catch(e){}},
  reset(){if(confirm('Сбросить весь прогресс?')){localStorage.removeItem('sodch_v2');location.reload();}},
  log(action){
    const n=new Date(),t=n.toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    this.s.audit.unshift({t,action,user:this.s.user.nm});
    if(this.s.audit.length>50)this.s.audit.pop();
  },

  login(){
    const nm=document.getElementById('iNm').value.trim();
    if(!nm){this.toast('w','Внимание','Введите ваше ФИО или позывной.');return;}
    this.s.user={nm,role:document.getElementById('iRl').value,unit:document.getElementById('iUn').value,av:nm.charAt(0).toUpperCase()};
    this.s.shift={num:1,start:new Date().toISOString(),od:nm};
    if(!this.s.patrols)this.s.patrols=JSON.parse(JSON.stringify(INIT_P));
    if(!this.s.events) this.s.events=JSON.parse(JSON.stringify(INIT_EV));
    if(!this.s.kusp)   this.s.kusp=JSON.parse(JSON.stringify(INIT_KUSP));
    if(!this.s.bul)    this.s.bul=JSON.parse(JSON.stringify(INIT_BUL));
    this.log('Вход в систему');
    this.save();
    document.getElementById('LGN').classList.remove('show');
    this.showApp();
  },
  logout(){if(confirm('Завершить сеанс? Прогресс сохранён.')){this.s.user={nm:'',role:'',unit:'',av:'?'};this.save();location.reload();}},

  showApp(){
    const u=this.s.user;
    ['sbAv','hAv'].forEach(id=>document.getElementById(id).textContent=u.av||'?');
    document.getElementById('sbNm').textContent=u.nm||'Пользователь';
    document.getElementById('sbRl').textContent=R[u.role]||u.role;
    document.getElementById('hNm').textContent=u.nm||'Пользователь';
    document.getElementById('hRk').textContent=this.rn(this.s.prog.xp);
    document.getElementById('hSh').textContent='№'+this.s.shift.num;
    document.getElementById('APP').classList.add('show');
    this.clock();this.renderMP();this.updBdg();
    this.go(this.s.mod||'dash');
    this.startEv();
    setTimeout(()=>this.toast('s','Добро пожаловать!','Роль: '+(R[u.role]||u.role)),700);
    // Генерировать входящие вызовы
    this.scheduleCall();
  },

  clock(){
    const tick=()=>{
      const n=new Date(),p=v=>String(v).padStart(2,'0');
      document.getElementById('hCl').textContent=p(n.getHours())+':'+p(n.getMinutes())+':'+p(n.getSeconds());
      const D=['Вс','Пн','Вт','Ср','Чт','Пт','Сб'],M=['янв','фев','мар','апр','май','июн','июл','авг','сен','окт','ноя','дек'];
      document.getElementById('hDt').textContent=D[n.getDay()]+' '+n.getDate()+' '+M[n.getMonth()]+' '+n.getFullYear();
    };tick();setInterval(tick,1000);
  },

  go(mod){
    document.querySelectorAll('.sb-it').forEach(el=>el.classList.toggle('act',el.dataset.m===mod));
    document.getElementById('hBc').textContent=MT[mod]||mod;
    this.s.mod=mod;this.save();
    if(this.map&&mod!=='usis'){try{this.map.remove();}catch(e){}this.map=null;}
    Object.keys(this.charts).forEach(k=>{try{this.charts[k].destroy();}catch(e){}});
    this.charts={};
    const c=document.getElementById('CT');
    switch(mod){
      case'dash': c.innerHTML=this.pgDash();break;
      case'miss': c.innerHTML=this.pgMiss();break;
      case'duty': c.innerHTML=this.pgDuty();break;
      case'kusp': c.innerHTML=this.pgKusp();break;
      case'disp': c.innerHTML=this.pgDisp();break;
      case'usis': c.innerHTML=this.pgUsis();setTimeout(()=>this.initMap(),300);break;
      case'patr': c.innerHTML=this.pgPatr();break;
      case'anal': c.innerHTML=this.pgAnal();setTimeout(()=>this.initCharts(),150);break;
      case'jour': c.innerHTML=this.pgJour();break;
      case'summ': c.innerHTML=this.pgSumm();break;
      case'cor':  c.innerHTML=this.pgCor();break;
      case'bul':  c.innerHTML=this.pgBul();break;
      case'asgo': c.innerHTML=this.pgAsgo();break;
      case'grl':  c.innerHTML=this.pgGrl();break;
      case'adm':  c.innerHTML=this.pgAdm();break;
      default:    c.innerHTML=this.pgSoon(mod);
    }
    this.valStep(mod);
  },

