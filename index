  color: var(--mvd-gold);
  padding: 5px 12px;
  border-radius: var(--radius-sm);
  font-size: 11px;
  cursor: pointer;
  transition: background var(--transition);
}
.btn-show-hint:hover { background: var(--mvd-gold-light); }

/* Прогресс шагов */
.steps-progress {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 12px 14px;
  margin-bottom: 14px;
}
.steps-progress__title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--mvd-gray-600); margin-bottom: 10px; }
.steps-dots {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.step-dot {
  width: 28px; height: 28px;
  border-radius: 50%;
  background: var(--mvd-gray-200);
  color: var(--mvd-gray-600);
  font-size: 11px;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  transition: all var(--transition);
}
.step-dot.done { background: var(--mvd-green); color: #fff; }
.step-dot.current { background: var(--mvd-blue); color: #fff; box-shadow: 0 0 0 3px rgba(0,88,163,0.25); }
.step-dot.locked { opacity: 0.4; }

/* Следующие шаги (список) */
.next-steps-list { display: flex; flex-direction: column; gap: 8px; }
.next-step-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 12px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  font-size: 12px;
  color: var(--mvd-gray-700);
  opacity: 0.5;
}
.next-step-item.upcoming { opacity: 1; border-color: var(--mvd-blue-light); background: var(--mvd-blue-light); }
.next-step-num {
  width: 20px; height: 20px;
  background: var(--mvd-gray-300);
  border-radius: 50%;
  font-size: 10px;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  margin-top: 1px;
}
.next-step-item.upcoming .next-step-num { background: var(--mvd-blue); color: #fff; }

/* ═══ СЭД ИНТЕРФЕЙС ВНУТРИ ЛЕВОГО ОКНА ═══ */
.sed-app { display: flex; flex-direction: column; height: 100%; overflow: hidden; }

/* СЭД-шапка */
.sed-header {
  background: var(--mvd-blue);
  color: #fff;
  height: 42px;
  display: flex;
  align-items: center;
  padding: 0;
  flex-shrink: 0;
}
.sed-header__left { display: flex; align-items: center; gap: 8px; padding: 0 12px; border-right: 1px solid rgba(255,255,255,0.2); height: 100%; }
.sed-header__icon { font-size: 16px; }
.sed-header__name { font-size: 12px; font-weight: 600; }
.sed-header__help {
  width: 30px; height: 30px;
  background: #E67E22;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 15px; font-weight: 700;
  margin: 0 8px;
  cursor: pointer;
}
.sed-toolbar { display: flex; gap: 2px; flex: 1; padding: 0 8px; }
.sed-tool { width: 30px; height: 30px; border-radius: var(--radius-sm); background: transparent; color: #fff; font-size: 14px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background var(--transition); }
.sed-tool:hover { background: rgba(255,255,255,0.15); }
.sed-header__right { padding: 0 12px; font-size: 12px; border-left: 1px solid rgba(255,255,255,0.2); white-space: nowrap; height: 100%; display: flex; align-items: center; gap: 8px; }
.operator-name { font-weight: 600; }

/* СЭД тело */
.sed-body { flex: 1; display: flex; overflow: hidden; }

/* Левая панель СЭД */
.sed-sidebar {
  width: 200px;
  flex-shrink: 0;
  background: var(--bg-sidebar);
  border-right: 1px solid var(--border);
  overflow-y: auto;
  padding: 12px 0;
}
.sed-user-block { padding: 12px; text-align: center; border-bottom: 1px solid var(--border); margin-bottom: 8px; }
.sed-avatar { width: 50px; height: 50px; background: var(--mvd-gold); border-radius: 50%; margin: 0 auto 8px; display: flex; align-items: center; justify-content: center; font-size: 22px; }
.sed-username { font-size: 12px; font-weight: 700; color: var(--mvd-blue); cursor: pointer; }
.sed-username:hover { text-decoration: underline; }
.sed-userrole { font-size: 11px; color: var(--mvd-gray-600); }

.sed-user-select { width: 100%; padding: 5px 8px; font-size: 11px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: #fff; margin-top: 6px; }

.folder-section-label {
  padding: 6px 12px;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--mvd-gray-600);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.folder-toggle { font-size: 10px; cursor: pointer; }

.folder-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px 8px 18px;
  font-size: 12px;
  color: var(--mvd-gray-800);
  cursor: pointer;
  transition: background var(--transition), color var(--transition);
  border-radius: 0;
}
.folder-item:hover { background: var(--mvd-blue-hover); color: var(--mvd-blue); }
.folder-item.active { background: var(--mvd-blue-light); color: var(--mvd-blue); font-weight: 600; border-right: 3px solid var(--mvd-blue); }
.folder-badge {
  background: var(--mvd-blue);
  color: #fff;
  border-radius: 100px;
  padding: 1px 7px;
  font-size: 10px;
  font-weight: 700;
  min-width: 20px;
  text-align: center;
}
.filter-item { display: flex; align-items: center; gap: 6px; padding: 5px 12px 5px 18px; font-size: 11px; color: var(--mvd-gray-600); }
.filter-check { color: var(--mvd-blue); font-size: 12px; }
.sed-refresh-btn { padding: 6px 12px; font-size: 11px; color: var(--mvd-blue); cursor: pointer; background: none; border: none; }

/* Центральная часть СЭД */
.sed-main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

.sed-list-header {
  padding: 10px 14px 0;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.sed-folder-title { font-size: 13px; font-weight: 600; color: var(--mvd-gray-800); margin-bottom: 10px; }
.sed-search-bar { display: flex; gap: 6px; align-items: center; margin-bottom: 8px; flex-wrap: wrap; }
.sed-search-input { flex: 1; min-width: 120px; padding: 5px 10px; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 12px; background: #fff; }
.sed-search-input:focus { outline: none; border-color: var(--mvd-blue); }
.sed-search-select { padding: 5px 8px; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 11px; background: #fff; color: var(--mvd-gray-800); }
.sed-icon-btn { width: 28px; height: 28px; background: var(--mvd-gray-100); border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 13px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background var(--transition); color: var(--mvd-gray-800); }
.sed-icon-btn:hover { background: var(--mvd-blue-light); color: var(--mvd-blue); }
.sed-icon-btn.primary { background: var(--mvd-blue); color: #fff; border-color: var(--mvd-blue); }

.sed-columns-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 5px 14px;
  font-size: 11px;
  color: var(--mvd-gray-600);
  font-weight: 600;
}
.sed-select-bar { display: flex; align-items: center; gap: 12px; padding: 5px 14px; font-size: 11px; color: var(--mvd-gray-600); border-top: 1px solid var(--border); }
.sed-select-bar a { color: var(--mvd-blue); }
.found-count { margin-left: auto; }

.sed-doc-list { flex: 1; overflow-y: auto; padding: 4px 0; }

/* Строка документа */
.doc-row {
  display: flex;
  align-items: flex-start;
  padding: 10px 14px;
  border-bottom: 1px solid var(--mvd-gray-100);
  cursor: pointer;
  transition: background var(--transition);
  gap: 10px;
}
.doc-row:hover { background: var(--mvd-blue-hover); }
.doc-row.selected { background: var(--mvd-blue-light); border-left: 3px solid var(--mvd-blue); }
.doc-row.highlighted { animation: rowPulse 1.5s ease-in-out infinite; }
@keyframes rowPulse {
  0%, 100% { background: var(--mvd-gold-light); }
  50% { background: #FFF9C4; }
}

.doc-check { font-size: 14px; color: var(--mvd-green); flex-shrink: 0; margin-top: 3px; }
.doc-info { flex: 1; min-width: 0; }
.doc-number { font-size: 12px; font-weight: 700; color: var(--mvd-gray-900); }
.doc-author { font-size: 11px; color: var(--mvd-gray-600); margin-top: 2px; }
.doc-subject { font-size: 12px; color: var(--mvd-gray-800); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.doc-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; flex-shrink: 0; }
.doc-badge { display: inline-block; padding: 2px 8px; border-radius: 100px; font-size: 10px; font-weight: 700; }
.doc-badge.new { background: var(--mvd-blue-light); color: var(--mvd-blue); }
.doc-badge.urgent { background: var(--mvd-red-light); color: var(--mvd-red); }
.doc-badge.dsp { background: #FFF3CD; color: #856404; }
.doc-icons { display: flex; gap: 4px; font-size: 12px; color: var(--mvd-gray-600); }
.doc-copy { font-size: 10px; color: var(--mvd-gray-600); }

/* Правая панель СЭД (карточка документа) */
.sed-card-panel {
  width: 300px;
  flex-shrink: 0;
  border-left: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  background: #fff;
  overflow: hidden;
}
.sed-card-panel.hidden { display: none; }

.card-header-row {
  padding: 10px 12px;
  border-bottom: 1px solid var(--border);
  background: var(--bg-sidebar);
  flex-shrink: 0;
}
.card-doc-num { font-size: 12px; font-weight: 700; color: var(--mvd-gray-900); }
.card-nav { padding: 8px 12px; display: flex; flex-wrap: wrap; gap: 6px; font-size: 11px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
.card-nav a { color: var(--mvd-blue); }
.card-nav a.active { font-weight: 700; text-decoration: none; }

.card-body { flex: 1; overflow-y: auto; padding: 12px; }

.card-section { margin-bottom: 16px; }
.card-section-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--mvd-gray-600); margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid var(--border); }

/* Маршрут */
.route-person { margin-bottom: 10px; }
.route-person-name { font-size: 12px; font-weight: 600; color: var(--mvd-gray-900); padding: 4px 0; }
.route-events { padding-left: 12px; border-left: 2px solid var(--border); margin-left: 6px; }
.route-event { display: flex; gap: 8px; align-items: flex-start; padding: 3px 0; }
.route-event-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--mvd-gray-300); flex-shrink: 0; margin-top: 4px; }
.route-event-dot.green { background: var(--mvd-green); }
.route-event-dot.orange { background: var(--mvd-gold); }
.route-event-date { font-size: 10px; color: var(--mvd-green); font-weight: 600; white-space: nowrap; }
.route-event-text { font-size: 11px; color: var(--mvd-gray-800); }

/* Резолюция */
.resolution-card {
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 10px 12px;
  margin-bottom: 8px;
  background: #FAFAFA;
}
.resolution-author { font-size: 12px; font-weight: 700; color: var(--mvd-blue); }
.resolution-text { font-size: 12px; color: var(--mvd-gray-800); margin-top: 4px; line-height: 1.5; }
.resolution-dates { font-size: 11px; color: var(--mvd-gray-600); margin-top: 6px; }
.resolution-status { font-size: 11px; font-weight: 700; color: var(--mvd-green); margin-top: 4px; }

/* Вложения */
.attachment-item {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 10px;
  background: var(--bg-sidebar);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  margin-bottom: 6px;
  font-size: 12px;
}
.attachment-icon {
  width: 32px; height: 32px;
  background: var(--mvd-red);
  color: #fff;
  border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
  font-size: 9px; font-weight: 700;
  flex-shrink: 0;
}
.attachment-icon.new-badge { position: relative; }
.attachment-icon.new-badge::after { content: 'NEW'; position: absolute; top: -4px; right: -4px; background: var(--mvd-blue); color: #fff; font-size: 7px; padding: 1px 3px; border-radius: 3px; }
.attachment-name { flex: 1; color: var(--mvd-gray-800); font-size: 11px; }
.attachment-actions { display: flex; gap: 4px; color: var(--mvd-gray-600); font-size: 13px; cursor: pointer; }
.attachment-actions span:hover { color: var(--mvd-blue); }

/* Кнопки действий карточки */
.card-footer {
  padding: 10px 12px;
  border-top: 1px solid var(--border);
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  background: var(--bg-sidebar);
  flex-shrink: 0;
}
.card-footer a { font-size: 12px; color: var(--mvd-blue); }
.btn-action { padding: 6px 14px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 600; transition: all var(--transition); border: 1px solid; }
.btn-action.primary { background: var(--mvd-blue); color: #fff; border-color: var(--mvd-blue); }
.btn-action.primary:hover { background: var(--mvd-blue-mid); }
.btn-action.secondary { background: #fff; color: var(--mvd-gray-800); border-color: var(--border); }
.btn-action.secondary:hover { border-color: var(--mvd-blue); color: var(--mvd-blue); }
.btn-action.danger { background: var(--mvd-red-light); color: var(--mvd-red); border-color: var(--mvd-red); }

/* ═══ SPOTLIGHT OVERLAY ═══ */
#spotlight-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 500;
}
#spotlight-svg { width: 100%; height: 100%; }

/* ═══ УВЕДОМЛЕНИЕ ОБ ОШИБКЕ ═══ */
.error-toast {
  position: fixed;
  bottom: 80px;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: var(--mvd-red);
  color: #fff;
  padding: 12px 24px;
  border-radius: var(--radius-md);
  font-size: 13px;
  font-weight: 600;
  box-shadow: var(--shadow-lg);
  z-index: 2000;
  opacity: 0;
  transition: all 0.3s ease;
  max-width: 400px;
  text-align: center;
}
.error-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

.success-toast {
  position: fixed;
  bottom: 80px;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: var(--mvd-green);
  color: #fff;
  padding: 12px 24px;
  border-radius: var(--radius-md);
  font-size: 13px;
  font-weight: 600;
  box-shadow: var(--shadow-lg);
  z-index: 2000;
  opacity: 0;
  transition: all 0.3s ease;
  max-width: 400px;
  text-align: center;
}
.success-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ═══ ТЕСТ-ВОПРОС МОДАЛЬ ═══ */
.quiz-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: none;
  align-items: center;
  justify-content: center;
}
.quiz-modal-overlay.show { display: flex; }
.quiz-modal {
  background: #fff;
  border-radius: var(--radius-lg);
  width: 520px;
  max-width: 95vw;
  box-shadow: var(--shadow-lg);
  overflow: hidden;
  animation: modalIn 0.25s ease;
}
@keyframes modalIn {
  from { transform: scale(0.92); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.quiz-modal__header {
  background: var(--mvd-blue);
  color: #fff;
  padding: 16px 20px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.quiz-modal__badge {
  background: rgba(255,255,255,0.2);
  border-radius: 100px;
  padding: 3px 12px;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}
.quiz-modal__title { font-size: 14px; font-weight: 600; }
.quiz-modal__body { padding: 20px; }
.quiz-question { font-size: 14px; color: var(--mvd-gray-900); font-weight: 600; margin-bottom: 16px; line-height: 1.55; }
.quiz-options { display: flex; flex-direction: column; gap: 8px; }
.quiz-option {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all var(--transition);
  font-size: 13px;
  color: var(--mvd-gray-800);
}
.quiz-option:hover { border-color: var(--mvd-blue); background: var(--mvd-blue-light); }
.quiz-option.correct { border-color: var(--mvd-green); background: var(--mvd-green-light); color: var(--mvd-green); }
.quiz-option.wrong { border-color: var(--mvd-red); background: var(--mvd-red-light); color: var(--mvd-red); animation: shake 0.4s ease; }
.quiz-option.disabled { pointer-events: none; }
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-6px); }
  75% { transform: translateX(6px); }
}
.quiz-option__letter {
  width: 24px; height: 24px;
  border-radius: 50%;
  background: var(--mvd-gray-200);
  font-weight: 700; font-size: 12px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.quiz-option.correct .quiz-option__letter { background: var(--mvd-green); color: #fff; }
.quiz-option.wrong .quiz-option__letter { background: var(--mvd-red); color: #fff; }

.quiz-feedback {
  margin-top: 14px;
  padding: 12px 14px;
  border-radius: var(--radius-md);
  font-size: 13px;
  display: none;
}
.quiz-feedback.correct { background: var(--mvd-green-light); color: var(--mvd-green); border: 1px solid var(--mvd-green); }
.quiz-feedback.wrong { background: var(--mvd-red-light); color: var(--mvd-red); border: 1px solid var(--mvd-red); }
.quiz-modal__footer { padding: 14px 20px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 8px; }
.btn-quiz-continue {
  background: var(--mvd-blue); color: #fff;
  padding: 9px 24px; border-radius: var(--radius-sm);
  font-size: 13px; font-weight: 600;
  display: none;
  transition: background var(--transition);
}
.btn-quiz-continue.show { display: inline-block; }
.btn-quiz-continue:hover { background: var(--mvd-blue-mid); }
.quiz-attempts { font-size: 12px; color: var(--mvd-gray-600); align-self: center; }

/* ═══ ЛОВУШКА МОДАЛЬ ═══ */
.trap-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  z-index: 1100;
  display: none;
  align-items: center;
  justify-content: center;
}
.trap-modal-overlay.show { display: flex; }
.trap-modal {
  background: #fff;
  border-radius: var(--radius-lg);
  width: 500px;
  max-width: 95vw;
  box-shadow: 0 20px 60px rgba(0,0,0,0.25);
  overflow: hidden;
  animation: modalIn 0.25s ease;
  border: 3px solid var(--mvd-red);
}
.trap-modal__header {
  background: var(--mvd-red);
  color: #fff;
  padding: 14px 20px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.trap-modal__icon { font-size: 24px; }
.trap-modal__title { font-size: 15px; font-weight: 700; }
.trap-countdown {
  margin-left: auto;
  background: rgba(255,255,255,0.2);
  border-radius: 100px;
  padding: 4px 14px;
  font-size: 14px;
  font-weight: 700;
}
.trap-modal__body { padding: 20px; }
.trap-scenario { font-size: 13px; color: var(--mvd-gray-800); line-height: 1.65; margin-bottom: 16px; }
.trap-choices { display: flex; flex-direction: column; gap: 8px; }
.trap-choice-btn {
  padding: 11px 16px;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  text-align: left;
  font-size: 13px;
  color: var(--mvd-gray-800);
  background: #fff;
  cursor: pointer;
  transition: all var(--transition);
  display: flex; align-items: center; gap: 10px;
}
.trap-choice-btn:hover { border-color: var(--mvd-blue); background: var(--mvd-blue-light); color: var(--mvd-blue); }
.trap-choice-btn.correct { border-color: var(--mvd-green); background: var(--mvd-green-light); color: var(--mvd-green); }
.trap-choice-btn.wrong { border-color: var(--mvd-red); background: var(--mvd-red-light); color: var(--mvd-red); }
.trap-choice-letter { width: 24px; height: 24px; border-radius: 50%; background: var(--mvd-gray-200); font-weight: 700; font-size: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

/* ═══ ЭКРАН ОЦЕНКИ ═══ */
#screen-result {
  background: var(--bg-main);
  overflow-y: auto;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px;
}
.result-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  max-width: 780px;
  width: 100%;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}
.result-header {
  background: var(--mvd-blue);
  color: #fff;
  padding: 28px 32px;
  display: flex;
  align-items: center;
  gap: 24px;
}
.result-grade-circle {
  width: 80px; height: 80px;
  border-radius: 50%;
  border: 3px solid rgba(255,255,255,0.5);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.result-grade-letter { font-size: 28px; font-weight: 900; }
.result-grade-score { font-size: 13px; opacity: 0.85; }
.result-header-info h2 { font-size: 20px; font-weight: 700; margin-bottom: 4px; }
.result-header-info p { font-size: 13px; opacity: 0.85; }
.result-body { padding: 28px 32px; }

.result-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
.result-stat {
  padding: 16px;
  background: var(--bg-sidebar);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}
.result-stat__label { font-size: 11px; color: var(--mvd-gray-600); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
.result-stat__value { font-size: 22px; font-weight: 700; color: var(--mvd-gray-900); }
.result-stat__sub { font-size: 11px; color: var(--mvd-gray-600); margin-top: 2px; }

.result-section-title { font-size: 14px; font-weight: 700; color: var(--mvd-gray-900); margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }

.result-scenarios-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; }
.result-scenarios-table th { padding: 8px 12px; text-align: left; background: var(--bg-sidebar); font-weight: 600; color: var(--mvd-gray-600); font-size: 11px; text-transform: uppercase; border-bottom: 1px solid var(--border); }
.result-scenarios-table td { padding: 10px 12px; border-bottom: 1px solid var(--mvd-gray-100); }
.result-scenarios-table tr:last-child td { border-bottom: none; }

.trap-result-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px; }
.trap-result-item { display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; border-radius: var(--radius-md); font-size: 12px; }
.trap-result-item.ok { background: var(--mvd-green-light); border: 1px solid var(--mvd-green); }
.trap-result-item.fail { background: var(--mvd-red-light); border: 1px solid var(--mvd-red); }
.trap-result-icon { font-size: 16px; flex-shrink: 0; }
.trap-result-name { font-weight: 700; color: var(--mvd-gray-900); }
.trap-result-desc { color: var(--mvd-gray-600); margin-top: 2px; }
.trap-result-points { margin-left: auto; font-weight: 700; white-space: nowrap; }
.trap-result-item.ok .trap-result-points { color: var(--mvd-green); }
.trap-result-item.fail .trap-result-points { color: var(--mvd-red); }

.recommendations-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
.rec-item { display: flex; gap: 10px; padding: 12px 14px; background: var(--mvd-blue-light); border: 1px solid rgba(0,88,163,0.15); border-radius: var(--radius-md); font-size: 13px; color: var(--mvd-gray-800); }

.result-footer { display: flex; gap: 12px; flex-wrap: wrap; padding-top: 16px; border-top: 1px solid var(--border); }
.btn-result { padding: 10px 20px; border-radius: var(--radius-sm); font-size: 13px; font-weight: 600; transition: all var(--transition); border: 1px solid; }
.btn-result.primary { background: var(--mvd-blue); color: #fff; border-color: var(--mvd-blue); }
.btn-result.primary:hover { background: var(--mvd-blue-mid); }
.btn-result.secondary { background: #fff; color: var(--mvd-gray-800); border-color: var(--border); }
.btn-result.secondary:hover { border-color: var(--mvd-blue); color: var(--mvd-blue); }

/* ═══ SPOTLIGHT HIGHLIGHT RING ═══ */
.spotlight-ring {
  position: absolute;
  border: 2.5px solid #FFB800;
  border-radius: var(--radius-sm);
  pointer-events: none;
  z-index: 501;
  animation: ringPulse 1.4s ease-in-out infinite;
  box-shadow: 0 0 0 2px rgba(255,184,0,0.3);
}
@keyframes ringPulse {
  0%, 100% { box-shadow: 0 0 0 2px rgba(255,184,0,0.3), 0 0 0 0 rgba(255,184,0,0.6); }
  50% { box-shadow: 0 0 0 4px rgba(255,184,0,0.15), 0 0 0 8px rgba(255,184,0,0.05); }
}

/* ═══ СТРЕЛКА-УКАЗАТЕЛЬ ═══ */
.pointer-arrow {
  position: fixed;
  pointer-events: none;
  z-index: 502;
  color: #FFB800;
  font-size: 24px;
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
  animation: arrowBounce 0.8s ease-in-out infinite;
}
@keyframes arrowBounce {
  0%, 100% { transform: translateY(0) rotate(-30deg); }
  50% { transform: translateY(-6px) rotate(-30deg); }
}

/* ═══ ПРЕДУПРЕЖДЕНИЕ ТРЕНАЖЁРА ═══ */
.trainer-warning {
  background: #FFF9C4;
  border: 1px solid #F9A825;
  color: #795548;
  font-size: 11px;
  padding: 4px 12px;
  text-align: center;
  flex-shrink: 0;
}
.trainer-warning strong { color: var(--mvd-red); }

/* ═══ СТАТУС-БАР ═══ */
.sim-statusbar {
  height: 26px;
  background: var(--bg-sidebar);
  border-top: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 14px;
  gap: 16px;
  font-size: 11px;
  color: var(--mvd-gray-600);
  flex-shrink: 0;
}
.statusbar-item { display: flex; align-items: center; gap: 4px; }
.statusbar-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--mvd-green); }
.statusbar-dot.orange { background: var(--mvd-gold); }

/* ═══ SHAKE ANIMATION ═══ */
@keyframes shakeEl { 0%,100%{transform:translateX(0)} 20%{transform:translateX(-8px)} 40%{transform:translateX(8px)} 60%{transform:translateX(-5px)} 80%{transform:translateX(5px)} }
.shake { animation: shakeEl 0.4s ease; }

/* ═══ FLASH SUCCESS ═══ */
@keyframes flashGreen { 0%{box-shadow:0 0 0 0 rgba(27,122,62,0.6)} 100%{box-shadow:0 0 0 16px rgba(27,122,62,0)} }
.flash-success { animation: flashGreen 0.6s ease forwards; border-color: var(--mvd-green) !important; }

/* ═══ SCROLLBAR STYLING ═══ */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--mvd-gray-400); }

/* ═══ RESPONSIVENESS ═══ */
@media (max-width: 900px) {
  .sim-right { width: 300px; }
  .sed-card-panel { width: 250px; }
}
</style>
</head>
