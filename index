@keyframes fadeIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }

/* ─── PAGE HEADER ────────────────────────────────── */
.page-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 24px; padding-bottom: 16px;
  border-bottom: 2px solid var(--border-light);
}
.page-title { display: flex; align-items: center; gap: 12px; }
.page-title-icon {
  width: 42px; height: 42px; border-radius: var(--radius);
  background: linear-gradient(135deg, #1a3a6b, #2a5298);
  display: flex; align-items: center; justify-content: center; color: #f0b429;
}
.page-title-text h2 { font-family: var(--font-serif); font-size: 20px; color: var(--text-primary); }
.page-title-text p { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
.page-actions { display: flex; gap: 8px; }

/* ─── CARDS ──────────────────────────────────────── */
.card {
  background: var(--bg-card); border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm); border: 1px solid var(--border-light);
  overflow: hidden;
}
.card-header {
  padding: 16px 20px; border-bottom: 1px solid var(--border-light);
  display: flex; align-items: center; justify-content: space-between;
}
.card-title { font-family: var(--font-serif); font-size: 15px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 8px; }
.card-body { padding: 20px; }

/* ─── STAT CARDS ─────────────────────────────────── */
.stats-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;
}
.stat-card {
  background: var(--bg-card); border-radius: var(--radius-lg);
  padding: 20px; border: 1px solid var(--border-light);
  box-shadow: var(--shadow-sm); position: relative; overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
}
.stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
.stat-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0;
  height: 3px;
}
.stat-card.blue::before { background: linear-gradient(90deg, #1a3a6b, #2a5298); }
.stat-card.gold::before { background: linear-gradient(90deg, #c8960c, #f0b429); }
.stat-card.green::before { background: linear-gradient(90deg, #1e8449, #27ae60); }
.stat-card.red::before { background: linear-gradient(90deg, #922b21, #c0392b); }
.stat-card.teal::before { background: linear-gradient(90deg, #1a6fa3, #2e86c1); }
.stat-icon {
  width: 44px; height: 44px; border-radius: var(--radius);
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; margin-bottom: 12px;
}
.stat-icon.blue { background: #ebf0ff; color: #1a3a6b; }
.stat-icon.gold { background: #fffaeb; color: #c8960c; }
.stat-icon.green { background: #eafaf1; color: #1e8449; }
.stat-icon.red { background: #fdf0f0; color: #c0392b; }
.stat-icon.teal { background: #ebf5ff; color: #1a6fa3; }
.stat-value { font-size: 28px; font-weight: 700; color: var(--text-primary); line-height: 1; margin-bottom: 4px; font-family: var(--font-mono); }
.stat-label { font-size: 12px; color: var(--text-muted); }
.stat-change { font-size: 11px; margin-top: 6px; display: flex; align-items: center; gap: 4px; }
.stat-change.up { color: var(--success); }
.stat-change.down { color: var(--danger); }

/* ─── DASHBOARD GRID ─────────────────────────────── */
.dashboard-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
.dashboard-grid .span2 { grid-column: span 2; }
.dashboard-grid .span3 { grid-column: span 3; }

/* ─── MISSION PANEL ──────────────────────────────── */
.mission-panel { margin-bottom: 24px; }
.mission-quest-header {
  background: linear-gradient(135deg, #1a3a6b 0%, #2a5298 100%);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 16px 20px; color: white;
  display: flex; align-items: center; justify-content: space-between;
}
.mq-left { display: flex; align-items: center; gap: 14px; }
.mq-number {
  width: 40px; height: 40px; background: var(--accent);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 16px; font-weight: 700; color: var(--primary-dark);
}
.mq-info h3 { font-family: var(--font-serif); font-size: 16px; }
.mq-info p { font-size: 11px; opacity: 0.75; margin-top: 2px; }
.mq-status {
  display: flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,0.1); border-radius: 20px; padding: 6px 14px;
  font-size: 12px; font-weight: 700;
}
.mq-status.active { background: rgba(46,204,113,0.2); color: #7defa0; }
.mq-status.completed { background: rgba(52,152,219,0.2); color: #87ceeb; }
.mission-objectives {
  background: white; border: 1px solid var(--border-light);
  border-top: none; border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  padding: 16px 20px;
}
.objective-list { list-style: none; }
.objective-item {
  display: flex; align-items: center; gap: 12px;
  padding: 8px 0; border-bottom: 1px solid var(--border-light);
  font-size: 13px; color: var(--text-secondary);
}
.objective-item:last-child { border-bottom: none; }
.obj-check {
  width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; transition: all 0.3s;
}
.obj-check.done { background: var(--success); border-color: var(--success); color: white; }
.obj-check.active { border-color: var(--primary); }

/* ─── TABLES ─────────────────────────────────────── */
.data-table { width: 100%; border-collapse: collapse; }
.data-table th {
  background: #f8f9fb; padding: 10px 14px; text-align: left;
  font-size: 11px; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.5px; color: var(--text-secondary);
  border-bottom: 2px solid var(--border); white-space: nowrap;
}
.data-table td {
  padding: 11px 14px; border-bottom: 1px solid var(--border-light);
  font-size: 13px; color: var(--text-primary);
}
.data-table tr:hover td { background: #f8f9fb; }
.data-table tr:last-child td { border-bottom: none; }

/* ─── BADGES ─────────────────────────────────────── */
.badge {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 2px 8px; border-radius: 20px; font-size: 11px; font-weight: 700;
}
.badge-blue { background: #ebf0ff; color: #1a3a6b; }
.badge-green { background: #eafaf1; color: #1e8449; }
.badge-gold { background: #fffaeb; color: #c8960c; }
.badge-red { background: #fdf0f0; color: #c0392b; }
.badge-gray { background: #f0f2f5; color: #718096; }
.badge-teal { background: #ebf5ff; color: #1a6fa3; }

/* ─── BUTTONS ────────────────────────────────────── */
.btn-sm { padding: 6px 14px; font-size: 12px; }
.btn-outline {
  background: white; border: 1px solid var(--border);
  color: var(--text-secondary);
}
.btn-outline:hover { background: var(--bg); border-color: var(--primary); color: var(--primary); }
.btn-success { background: var(--success); color: white; }
.btn-success:hover { background: #16703d; }
.btn-danger { background: var(--danger); color: white; }
.btn-danger:hover { background: #a93226; }
.btn-gold { background: var(--accent); color: white; }
.btn-gold:hover { background: #a67c0a; }
.btn-info { background: var(--info); color: white; }

/* ─── ALERTS ─────────────────────────────────────── */
.alert {
  padding: 12px 16px; border-radius: var(--radius); margin-bottom: 16px;
  display: flex; align-items: flex-start; gap: 10px; font-size: 13px;
}
.alert-info { background: #ebf5ff; border-left: 4px solid var(--info); color: #1a5276; }
.alert-success { background: #eafaf1; border-left: 4px solid var(--success); color: #1a5c31; }
.alert-warning { background: #fffaeb; border-left: 4px solid var(--warning); color: #7d5a00; }
.alert-danger { background: #fdf0f0; border-left: 4px solid var(--danger); color: #7b241c; }

/* ─── QUICK ACTIONS ──────────────────────────────── */
.quick-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.qa-item {
  background: white; border: 1px solid var(--border-light); border-radius: var(--radius);
  padding: 16px 14px; cursor: pointer; transition: all 0.2s;
  text-align: center; display: flex; flex-direction: column; align-items: center; gap: 8px;
}
.qa-item:hover { border-color: var(--primary-light); box-shadow: var(--shadow); transform: translateY(-1px); }
.qa-icon { width: 40px; height: 40px; border-radius: var(--radius); display: flex; align-items: center; justify-content: center; font-size: 16px; }
.qa-label { font-size: 12px; font-weight: 700; color: var(--text-secondary); line-height: 1.3; }

/* ─── NOTIFICATIONS LIST ─────────────────────────── */
.notif-item {
  display: flex; gap: 12px; padding: 12px 0;
  border-bottom: 1px solid var(--border-light);
}
.notif-item:last-child { border-bottom: none; }
.notif-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; }
.notif-content { flex: 1; }
.notif-title { font-size: 13px; font-weight: 700; color: var(--text-primary); margin-bottom: 2px; }
.notif-desc { font-size: 12px; color: var(--text-muted); }
.notif-time { font-size: 11px; color: var(--text-muted); white-space: nowrap; }

/* ─── MODAL ──────────────────────────────────────── */
.modal-overlay {
  display: none; position: fixed; inset: 0; z-index: 1000;
  background: rgba(15,32,68,0.55); backdrop-filter: blur(2px);
  align-items: center; justify-content: center;
}
.modal-overlay.open { display: flex; }
.modal {
  background: white; border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg); width: 90%; max-width: 560px;
  max-height: 90vh; overflow: hidden; display: flex; flex-direction: column;
  animation: slideUp 0.3s ease;
}
.modal-header {
  padding: 16px 20px; border-bottom: 1px solid var(--border-light);
  display: flex; align-items: center; justify-content: space-between;
  background: #f8f9fb;
}
.modal-title { font-family: var(--font-serif); font-size: 16px; font-weight: 700; }
.modal-close { width: 28px; height: 28px; border: none; background: none; cursor: pointer; border-radius: 50%; font-size: 16px; color: var(--text-muted); display: flex; align-items: center; justify-content: center; }
.modal-close:hover { background: var(--bg); color: var(--text-primary); }
.modal-body { padding: 20px; overflow-y: auto; flex: 1; }
.modal-footer {
  padding: 14px 20px; border-top: 1px solid var(--border-light);
  display: flex; gap: 8px; justify-content: flex-end; background: #f8f9fb;
}

/* ─── PROGRESS BAR ───────────────────────────────── */
.progress-bar { height: 6px; background: var(--border-light); border-radius: 3px; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 3px; transition: width 0.5s; }
.progress-fill.blue { background: linear-gradient(90deg, #1a3a6b, #2a5298); }
.progress-fill.gold { background: linear-gradient(90deg, #c8960c, #f0b429); }
.progress-fill.green { background: linear-gradient(90deg, #1e8449, #27ae60); }

/* ─── FORM STYLES ────────────────────────────────── */
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
.form-row.triple { grid-template-columns: 1fr 1fr 1fr; }
.form-row.single { grid-template-columns: 1fr; }
.form-label { display: block; font-size: 12px; font-weight: 700; color: var(--text-secondary); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.4px; }
.form-label .req { color: var(--danger); }
.form-select {
  width: 100%; padding: 9px 12px; border: 1px solid var(--border); border-radius: var(--radius);
  font-family: var(--font-main); font-size: 14px; color: var(--text-primary); background: white;
  cursor: pointer;
}
.form-select:focus { outline: none; border-color: var(--primary-light); box-shadow: 0 0 0 3px rgba(42,82,152,0.12); }
.field-error { font-size: 11px; color: var(--danger); margin-top: 4px; display: none; }
.form-control.error { border-color: var(--danger); }
.form-control.error + .field-error { display: block; }

/* ─── SEARCH BAR ─────────────────────────────────── */
.search-bar {
  display: flex; align-items: center; gap: 12px;
  background: white; border: 1px solid var(--border); border-radius: var(--radius);
  padding: 8px 14px; margin-bottom: 16px;
}
.search-bar input { flex: 1; border: none; outline: none; font-family: var(--font-main); font-size: 14px; }
.search-bar i { color: var(--text-muted); }

/* ─── TOAST ──────────────────────────────────────── */
#toastContainer {
  position: fixed; bottom: 24px; right: 24px; z-index: 9999;
  display: flex; flex-direction: column; gap: 8px;
}
.toast {
  background: white; border-radius: var(--radius); box-shadow: var(--shadow-lg);
  padding: 12px 16px; display: flex; align-items: center; gap: 10px;
  min-width: 280px; border-left: 4px solid;
  animation: toastIn 0.3s ease; font-size: 13px;
}
.toast.success { border-color: var(--success); }
.toast.error { border-color: var(--danger); }
.toast.info { border-color: var(--info); }
.toast.warning { border-color: var(--warning); }
@keyframes toastIn { from{transform:translateX(100px);opacity:0} to{transform:translateX(0);opacity:1} }

/* ─── TABS ───────────────────────────────────────── */
.tabs { display: flex; gap: 0; border-bottom: 2px solid var(--border-light); margin-bottom: 20px; }
.tab-btn {
  padding: 10px 18px; border: none; background: none; cursor: pointer;
  font-family: var(--font-main); font-size: 13px; font-weight: 700;
  color: var(--text-muted); border-bottom: 2px solid transparent;
  margin-bottom: -2px; transition: all 0.2s;
}
.tab-btn:hover { color: var(--primary); }
.tab-btn.active { color: var(--primary); border-bottom-color: var(--primary); }
.tab-pane { display: none; }
.tab-pane.active { display: block; }

/* ─── MISSION TRACKER (right panel) ─────────────── */
.mission-tracker-overlay {
  display: none; position: fixed; inset: 0; z-index: 500;
  background: rgba(0,0,0,0.3);
}
.mission-tracker {
  position: fixed; right: 0; top: var(--header-height); bottom: 0;
  width: 360px; background: white; box-shadow: -4px 0 20px rgba(0,0,0,0.12);
  z-index: 501; overflow-y: auto; padding: 0;
  transform: translateX(100%); transition: transform 0.3s ease;
}
.mission-tracker.open { transform: translateX(0); }
.mt-header {
  background: linear-gradient(135deg, #1a3a6b, #2a5298);
  padding: 16px 20px; color: white; position: sticky; top: 0; z-index: 1;
}
.mt-header h3 { font-family: var(--font-serif); font-size: 16px; margin-bottom: 4px; }
.mt-header p { font-size: 11px; opacity: 0.75; }
.mt-close {
  position: absolute; top: 12px; right: 12px;
  background: rgba(255,255,255,0.15); border: none; color: white;
  width: 28px; height: 28px; border-radius: 50%; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
}
.mt-score-bar { background: rgba(255,255,255,0.1); padding: 10px 20px; border-bottom: 1px solid var(--border-light); display: flex; gap: 20px; align-items: center; }
.mt-score-item { text-align: center; }
.mt-score-val { font-size: 20px; font-weight: 700; color: var(--primary); font-family: var(--font-mono); }
.mt-score-lbl { font-size: 10px; color: var(--text-muted); }
.mt-missions-list { padding: 12px; }
.mt-mission-item {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 12px; border-radius: var(--radius);
  margin-bottom: 4px; cursor: pointer; transition: background 0.2s;
  border: 1px solid transparent;
}
.mt-mission-item:hover { background: var(--bg); }
.mt-mission-item.current { background: #ebf0ff; border-color: #c5d5f5; }
.mt-mission-item.done { opacity: 0.7; }
.mt-num {
  width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700; color: var(--text-muted); flex-shrink: 0;
}
.mt-num.done { background: var(--success); border-color: var(--success); color: white; }
.mt-num.current { background: var(--primary); border-color: var(--primary); color: white; }
.mt-num.locked { background: #f0f2f5; }
.mt-mission-info { flex: 1; }
.mt-mission-name { font-size: 12px; font-weight: 700; color: var(--text-primary); }
.mt-mission-desc { font-size: 11px; color: var(--text-muted); margin-top: 1px; }
.mt-mission-score { font-size: 12px; font-weight: 700; color: var(--success); font-family: var(--font-mono); }

/* ─── INSTRUCTION BOX ────────────────────────────── */
.instruction-box {
  background: linear-gradient(135deg, #ebf0ff 0%, #f5f7ff 100%);
  border: 1px solid #c5d5f5; border-left: 4px solid var(--primary);
  border-radius: var(--radius); padding: 14px 16px; margin-bottom: 20px;
}
.instruction-box .ib-header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.instruction-box .ib-title { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--primary); }
.instruction-box p { font-size: 13px; color: var(--primary-dark); line-height: 1.6; }
.ib-steps { list-style: none; margin-top: 8px; }
.ib-steps li { display: flex; gap: 10px; font-size: 13px; color: var(--primary-dark); padding: 3px 0; }
.ib-step-num { width: 20px; height: 20px; background: var(--primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; flex-shrink: 0; }

/* ─── EMPLOYEE CARD ──────────────────────────────── */
.emp-card {
  background: white; border: 1px solid var(--border-light);
  border-radius: var(--radius-lg); padding: 20px;
  display: flex; gap: 16px; margin-bottom: 16px;
  transition: box-shadow 0.2s; cursor: pointer;
}
.emp-card:hover { box-shadow: var(--shadow); }
.emp-avatar {
  width: 56px; height: 56px; border-radius: var(--radius);
  background: linear-gradient(135deg, #1a3a6b, #2a5298);
  display: flex; align-items: center; justify-content: center;
  color: white; font-size: 20px; font-weight: 700; flex-shrink: 0;
}
.emp-main { flex: 1; }
.emp-name { font-family: var(--font-serif); font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 4px; }
.emp-details { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 6px; }
.emp-detail { font-size: 12px; color: var(--text-muted); display: flex; align-items: center; gap: 4px; }
.emp-actions { display: flex; flex-direction: column; gap: 6px; align-items: flex-end; }

/* ─── MISC ───────────────────────────────────────── */
.section-subtitle { font-size: 13px; color: var(--text-muted); margin-bottom: 16px; }
.text-muted { color: var(--text-muted); }
.text-success { color: var(--success); }
.text-danger { color: var(--danger); }
.text-primary { color: var(--primary); }
.fw-bold { font-weight: 700; }
.mb-16 { margin-bottom: 16px; }
.mb-8 { margin-bottom: 8px; }
.d-flex { display: flex; }
.gap-8 { gap: 8px; }
.gap-12 { gap: 12px; }
.align-center { align-items: center; }
.justify-between { justify-content: space-between; }
.flex-1 { flex: 1; }
.text-center { text-align: center; }
.mt-8 { margin-top: 8px; }
.mt-16 { margin-top: 16px; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }

/* ─── SCORE DISPLAY ──────────────────────────────── */
.score-display {
  position: fixed; top: var(--header-height); right: 0;
  background: white; border-left: 1px solid var(--border); border-bottom: 1px solid var(--border);
  border-radius: 0 0 0 var(--radius); padding: 6px 16px;
  display: flex; gap: 16px; align-items: center; z-index: 99; box-shadow: var(--shadow-sm);
}
.score-item { text-align: center; }
.score-val { font-size: 16px; font-weight: 700; color: var(--primary); font-family: var(--font-mono); }
.score-lbl { font-size: 10px; color: var(--text-muted); }

/* ─── ORG TREE ───────────────────────────────────── */
.org-tree { font-family: var(--font-main); }
.org-node {
  position: relative; padding: 8px 12px;
  background: white; border: 1px solid var(--border); border-radius: var(--radius);
  cursor: pointer; transition: all 0.2s; font-size: 12px; min-width: 160px;
  text-align: center;
}
.org-node:hover { border-color: var(--primary); box-shadow: var(--shadow-sm); }
.org-node.root { background: linear-gradient(135deg, #1a3a6b, #2a5298); color: white; border-color: transparent; }
.org-node.dept { background: #f0f4ff; border-color: #c5d5f5; color: var(--primary); }
.org-node-name { font-weight: 700; font-size: 11px; }
.org-node-count { font-size: 10px; opacity: 0.75; margin-top: 2px; }

/* ─── CHART BARS (CSS only) ──────────────────────── */
.bar-chart { display: flex; gap: 8px; align-items: flex-end; height: 80px; padding: 0 4px; }
.bar-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; }
.bar { width: 100%; border-radius: 4px 4px 0 0; transition: height 0.5s; }
.bar-label { font-size: 10px; color: var(--text-muted); white-space: nowrap; }
.bar-value { font-size: 10px; font-weight: 700; color: var(--text-secondary); }

/* ─── REPORT TABLE ───────────────────────────────── */
.report-header {
  background: var(--primary); color: white; padding: 16px 20px;
  border-radius: var(--radius) var(--radius) 0 0;
  display: flex; align-items: center; justify-content: space-between;
}
.report-subtitle { font-size: 11px; opacity: 0.75; }

/* Responsive */
@media (max-width: 1200px) {
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .dashboard-grid { grid-template-columns: 1fr 1fr; }
