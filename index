<script>
// ─── READING PROGRESS ────────────────────────────────────────
const readingBar = document.getElementById('readingBar');
window.addEventListener('scroll', () => {
  const scrollTop = window.scrollY;
  const docHeight = document.documentElement.scrollHeight - window.innerHeight;
  const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
  readingBar.style.width = pct + '%';

  // Back to top visibility
  const btt = document.getElementById('bttBtn');
  btt.classList.toggle('visible', scrollTop > 400);

  // Update active nav step
  updateActiveNav();
});

// ─── NAVIGATION ──────────────────────────────────────────────
function scrollTo(id) {
  const el = document.getElementById(id);
  if (!el) return;
  const offset = 60;
  const top = el.getBoundingClientRect().top + window.scrollY - offset;
  window.scrollTo({ top, behavior: 'smooth' });
}

function updateActiveNav() {
  const sections = ['intro','start','interface','missions','walkthrough','modules','roles','scoring','tips','faq'];
  const navSteps = document.querySelectorAll('.nav-step');
  let activeIdx = 0;
  sections.forEach((id, i) => {
    const el = document.getElementById(id);
    if (el) {
      const top = el.getBoundingClientRect().top;
      if (top <= 120) activeIdx = i;
    }
  });
  navSteps.forEach((s, i) => {
    s.classList.toggle('active', i === activeIdx);
    s.classList.toggle('done', i < activeIdx);
  });
}

// ─── FAQ TOGGLE ───────────────────────────────────────────────
function toggleFaq(btn) {
  const answer = btn.nextElementSibling;
  const isOpen = answer.classList.contains('open');
  // Close all
  document.querySelectorAll('.faq-a.open').forEach(a => {
    a.classList.remove('open');
    a.previousElementSibling.classList.remove('open');
  });
  if (!isOpen) {
    answer.classList.add('open');
    btn.classList.add('open');
  }
}

// ─── COPY CREDENTIAL ─────────────────────────────────────────
function copyText(text, el) {
  navigator.clipboard.writeText(text).then(() => {
    const orig = el.innerHTML;
    el.innerHTML = text + ' <i class="fas fa-check" style="color:#4ade80"></i>';
    setTimeout(() => { el.innerHTML = orig; }, 1500);
  }).catch(() => {
    // Fallback
    const ta = document.createElement('textarea');
    ta.value = text; document.body.appendChild(ta);
    ta.select(); document.execCommand('copy');
    document.body.removeChild(ta);
    const orig = el.innerHTML;
    el.innerHTML = text + ' <i class="fas fa-check" style="color:#4ade80"></i>';
    setTimeout(() => { el.innerHTML = orig; }, 1500);
  });
}

// ─── ANIMATE ON SCROLL ────────────────────────────────────────
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.style.opacity = '1';
      entry.target.style.transform = 'translateY(0)';
    }
  });
}, { threshold: 0.1 });

document.querySelectorAll('.mission-card, .tip-card, .role-card, .step-item').forEach(el => {
  el.style.opacity = '0';
  el.style.transform = 'translateY(16px)';
  el.style.transition = 'opacity .5s ease, transform .5s ease';
  observer.observe(el);
});
</script>
