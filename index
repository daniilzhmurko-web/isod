    <div class="cfs">Наказание</div>
    <div class="cfr"><div class="cfg"><label class="cfl">Вид</label><select class="cfi" style="width:200px">${PUN.map(p=>`<option ${cr.ptp===p?'selected':''}>${p}</option>`).join('')}</select></div><div class="cfg"><label class="cfl">Лет</label><input class="cfi" value="${cr.py||''}" style="width:48px"></div><div class="cfg"><label class="cfl">Мес.</label><input class="cfi" value="${cr.pm||''}" style="width:48px"></div></div>
