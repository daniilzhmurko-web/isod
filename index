function showModule(mod){
  appState.currentModule=mod;
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  const nav=document.getElementById('nav-'+mod);
  if(nav) nav.classList.add('active');
  logAction('Навигация','Открыт раздел: '+mod,mod.toUpperCase());
  appState.stats.totalActions++;
  if(!appState.openedModules.includes(mod)) appState.openedModules.push(mod);
  if(appState.openedModules.length>=5) unlockAchievement('explorer');
  document.getElementById('mainContent').innerHTML=getModuleHTML(mod);
}

function getModuleHTML(mod){
  switch(mod){
    case 'portal': return renderPortal();
    case 'resources': return renderResources();
    case 'news': return renderNews();
    case 'monitoring': return renderMonitoring();
    case 'isk': return renderIsk();
