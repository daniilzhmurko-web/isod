    const plate=genPlate();
    const vin=genVIN();
    const isW=wantedPlates.includes(plate)||(Math.random()<.07);
    const hasDup=i>5&&Math.random()<.04;
    const dupVIN=hasDup&&usedVINs.length>0?rnd(usedVINs):vin;
    if(!hasDup)usedVINs.push(vin);
    DB.vehicles.push({id:i+1,plate,vin:dupVIN,brand,model:rnd(mlist),year:ri(2000,2024),color:rnd(COLORS),type:Math.random()<.85?'Легковой':'Грузовой',owner:rnd(FNS),passport:genPass(),sts:genSTS(),regDate:rdDate(8),status:isW?'В розыске':Math.random()<.03?'Угнан':'Активен',anomaly:hasDup?'dup_vin':null});
