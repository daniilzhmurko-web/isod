    <td><span class="badge ${h.result==='Выполнено'?'b-green':'b-red'}">${h.result}</span></td>
  </tr>`).join('');
}

// TEACHER MODE
function teachInject(type){
  const fraud={id:DB.vehicles.length+1,plate:genPlate(),vin:DB.vehicles[ri(0,5)].vin,brand:rnd(BRANDS),model:'Unknown',year:2020,color:rnd(COLORS),type:'Легковой',owner:'Неизвестен',passport:genPass(),sts:genSTS(),regDate:today(),status:'Активен',anomaly:'dup_vin'};
