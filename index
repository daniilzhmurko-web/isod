<script>
/* ══════════════════════════════════════════════════════════
   ЭТАП 1 — ЯДРО: State Manager, утилиты
══════════════════════════════════════════════════════════ */
const S={
  user:{name:'',role:'analyst',mode:'training',diff:2},
  score:0,totalAct:0,correctAct:0,riskIndex:20,
  sessionStart:null,curPanel:'dash',
  curLevel:0,curStep:0,instCollapsed:false,teacherMode:false,
  examMode:false,hintCount:0,
  log:[],behaviors:{clicks:0,errors:0,speed:[],impulsive:0,logical:0},
  achievements:new Set(),explored:new Set(),
  adversaryActive:false,adversaryLevel:0,
};

const LEVELS=[
  {id:0,name:'Введение',icon:'🎓',desc:'Знакомство с СОЭБ',done:false},
  {id:1,name:'Регистрация',icon:'📄',desc:'Докладные записки',done:false},
  {id:2,name:'Исследования',icon:'🔬',desc:'Документальные исследования',done:false},
  {id:3,name:'Купюры',icon:'💵',desc:'Учёт фальшивых купюр',done:false},
  {id:4,name:'Объекты',icon:'🎯',desc:'Объекты заинтересованности',done:false},
  {id:5,name:'Запросы',icon:'📨',desc:'Межведомственные запросы',done:false},
  {id:6,name:'Граф',icon:'🌐',desc:'Анализ связей',done:false},
  {id:7,name:'AI-аналитика',icon:'🧠',desc:'Insights и дерево решений',done:false},
  {id:8,name:'Экзамен',icon:'🏆',desc:'Итоговый экзамен',done:false},
];

/* Утилиты */
const rnd=a=>a[Math.floor(Math.random()*a.length)];
const ri=(a,b)=>Math.floor(Math.random()*(b-a+1))+a;
const today=()=>new Date().toISOString().split('T')[0];
const fmtDate=s=>s?new Date(s).toLocaleDateString('ru-RU'):'—';
const fmtTime=()=>new Date().toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'});

function notify(type,title,body=''){
  const icons={ok:'✅',err:'❌',warn:'⚠️',info:'ℹ️',purple:'🧠'};
  const c=document.getElementById('notifs');
  const el=document.createElement('div');
  el.className=`notif ${type}`;
  el.innerHTML=`<span>${icons[type]||'📢'}</span><div><b>${title}</b>${body?`<br><span style="opacity:.7;font-size:11px">${body}</span>`:''}</div>`;
  c.appendChild(el);
  setTimeout(()=>{el.style.opacity='0';el.style.transition='.3s';setTimeout(()=>el.remove(),300);},4000);
}

function spop(text,pos=true){
  const c=document.getElementById('score-wrap');
  const el=document.createElement('div');
  el.className=`spop ${pos?'pos':'neg'}`;
  el.style.cssText=`left:${20+Math.random()*60}%;top:${20+Math.random()*60}%;`;
  el.textContent=text;c.appendChild(el);
  setTimeout(()=>el.remove(),1400);
}

function showAch(icon,name,desc=''){
  const c=document.getElementById('ach-wrap');
  const el=document.createElement('div');el.className='ach';
  el.innerHTML=`<div class="ach-ico">${icon}</div><div><div class="ach-lbl">Достижение</div><div class="ach-name">${name}</div>${desc?`<div style="font-size:10px;opacity:.6;margin-top:1px">${desc}</div>`:''}</div>`;
  c.appendChild(el);setTimeout(()=>el.remove(),4000);
}

function cm(id){document.getElementById(id).classList.add('hide');}
function openModal(id){document.getElementById(id).classList.remove('hide');}

function addLog(desc,type='info'){
  const e={id:S.log.length+1,time:fmtTime(),ts:Date.now(),desc,type,panel:S.curPanel};
  S.log.push(e);AC.record(e);
  const lp=document.getElementById('log-panel');
  if(lp){
    const el=document.createElement('div');el.className='lentry';
    el.innerHTML=`<span class="ltime">${e.time}</span><span class="ltext l-${type==='ok'?'ok':type==='err'?'err':type==='warn'?'warn':'info'}">${desc}</span>`;
    lp.insertBefore(el,lp.firstChild);
    if(lp.children.length>60)lp.removeChild(lp.lastChild);
  }
  // Data stream
  const ds=document.getElementById('data-stream');
  if(ds){
    const el=document.createElement('div');el.className='ds-line';
    el.innerHTML=`<span class="ds-t">${e.time}</span><span class="ds-type" style="color:${type==='ok'?'var(--green)':type==='err'?'var(--red)':type==='warn'?'var(--orange)':'var(--blue)'}">[${type.toUpperCase()}]</span><span class="ds-msg">${desc}</span>`;
    ds.insertBefore(el,ds.firstChild);
    if(ds.children.length>40)ds.removeChild(ds.lastChild);
  }
}

