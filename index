        <div class="score-item__value count-up">${State.hints}</div>
        <div class="score-item__sub">−${State.hints*2} баллов</div>
      </div>
      <div class="score-item ${State.trapsOk >= State.trapsFail ? 'green' : 'red'}">
        <div class="score-item__label">Ловушек разгадано</div>
        <div class="score-item__value count-up">${State.trapsOk} / ${State.trapsOk+State.trapsFail}</div>
