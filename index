let quizState = { cur:0, score:0, answered:false };

function openQuiz() {
  quizState = { cur:0, score:0, answered:false };
  renderQuizQ();
  document.getElementById('m-quiz').classList.remove('hide');
  appLog('Тест начат','quiz_start');
}

function renderQuizQ() {
  const q = QUIZ_QUESTIONS[quizState.cur];
  if (!q) { finishQuiz(); return; }
  quizState.answered = false;
  const prog = (quizState.cur / QUIZ_QUESTIONS.length * 100);
  document.getElementById('quiz-prog').style.width = prog+'%';
  document.getElementById('quiz-q-counter').textContent = `Вопрос ${quizState.cur+1} из ${QUIZ_QUESTIONS.length}`;
  document.getElementById('quiz-score-disp').textContent = `Баллы: ${quizState.score}`;
  document.getElementById('quiz-question').textContent = q.q;
  document.getElementById('quiz-options').innerHTML = q.opts.map((o,i)=>
    `<div class="quiz-opt" id="qopt-${i}" onclick="quizAnswer(${i})">${String.fromCharCode(65+i)}. ${o}</div>`
  ).join('');
  document.getElementById('quiz-feedback').style.display = 'none';
  document.getElementById('quiz-next-btn').disabled = true;
}

function quizAnswer(idx) {
  if (quizState.answered) return;
  quizState.answered = true;
  const q = QUIZ_QUESTIONS[quizState.cur];
  const correct = idx === q.ans;
  document.querySelectorAll('.quiz-opt').forEach((el,i)=>{
    if(i===q.ans) el.classList.add('correct');
    else if(i===idx&&!correct) el.classList.add('wrong');
  });
  if (correct) { quizState.score += 20; scorePopupAt(`+20 ⭐`, true); }
  else APP.examMistakes++;
  const fb = document.getElementById('quiz-feedback');
  fb.style.display='block';
  fb.innerHTML=`<div class="inst-hint-box"><div class="inst-hint-title">${correct?'✅ Верно!':'❌ Неверно'}</div><div>${q.exp}</div></div>`;
  document.getElementById('quiz-next-btn').disabled = false;
  appLog(`Ответ: ${correct?'верно':'неверно'}`, 'quiz_answer', {q:quizState.cur, correct});
}

function quizNext() {
  quizState.cur++;
  if (quizState.cur >= QUIZ_QUESTIONS.length) finishQuiz();
  else renderQuizQ();
}

function finishQuiz() {
  const pct = Math.round(quizState.score / (QUIZ_QUESTIONS.length*20) * 100);
  APP.score += quizState.score;
  updateHeader2();
  appLog('Тест завершён', 'quiz_done', {score:quizState.score, pct});
  document.getElementById('quiz-question').innerHTML = `<div style="text-align:center;padding:20px">
    <div style="font-size:52px;margin-bottom:12px">${pct>=80?'🏆':pct>=60?'🎯':'📚'}</div>
