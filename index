/* ═══════════════════════════════════════════════
   ЭТАП 1 — CSS ПЕРЕМЕННЫЕ И БАЗОВЫЕ СТИЛИ
═══════════════════════════════════════════════ */
:root{
  --bg:#f0f4f8;--bg2:#fff;--bg3:#f7f9fc;--bg4:#e8edf5;
  --nav:#1a3365;--nav2:#162040;--nav3:#0d2550;
  --blue:#1565c0;--blue2:#1976d2;--blue3:#42a5f5;--blue-l:#e3eeff;--blue-xl:#f0f5ff;
  --teal:#00838f;--teal-l:#e0f7fa;
  --red:#c62828;--red-l:#ffebee;
  --green:#2e7d32;--green-l:#e8f5e9;
  --orange:#e65100;--orange-l:#fff3e0;
  --gold:#f9a825;--purple:#6a1b9a;
  --txt:#1a2035;--txt2:#455a64;--txt3:#90a4ae;
  --border:#dde3ed;--border2:#c5cfe0;
  --shadow:0 2px 8px rgba(21,44,87,.1);--shadow2:0 4px 20px rgba(21,44,87,.15);--shadow3:0 8px 40px rgba(21,44,87,.2);
  --r:6px;--r2:10px;--r3:16px;
  --font:'Montserrat',sans-serif;--body:'PT Sans',sans-serif;--mono:'JetBrains Mono',monospace;
  --inst-h:220px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:var(--body);background:var(--bg);color:var(--txt);height:100vh;overflow:hidden;font-size:14px}
button{cursor:pointer;border:none;outline:none;font-family:var(--body)}
input,select,textarea{font-family:var(--body);outline:none}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}

/* АНИМАЦИИ */
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
@keyframes slideR{from{opacity:0;transform:translateX(16px)}to{opacity:1;transform:translateX(0)}}
@keyframes slideL{from{opacity:0;transform:translateX(-16px)}to{opacity:1;transform:translateX(0)}}
@keyframes slideU{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
@keyframes blink2{0%,100%{box-shadow:0 0 0 3px rgba(21,101,192,.4)}50%{box-shadow:0 0 0 6px rgba(21,101,192,.1)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes typewriter{from{width:0}to{width:100%}}
@keyframes glow{0%,100%{text-shadow:0 0 8px rgba(21,101,192,.4)}50%{text-shadow:0 0 20px rgba(21,101,192,.8)}}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
@keyframes popIn{0%{transform:scale(.8);opacity:0}100%{transform:scale(1);opacity:1}}
@keyframes slideDown{from{height:0;opacity:0}to{height:var(--inst-h);opacity:1}}
@keyframes notif{0%{transform:translateX(120%);opacity:0}10%{transform:translateX(0);opacity:1}85%{transform:translateX(0);opacity:1}100%{transform:translateX(120%);opacity:0}}

/* ════════════════════════════════════════════
   ЭКРАН ЗАГРУЗКИ
════════════════════════════════════════════ */
#splash{position:fixed;inset:0;background:linear-gradient(135deg,#0d1b3e 0%,#1a3365 50%,#0d47a1 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9999;transition:opacity .6s}
#splash.out{opacity:0;pointer-events:none}
.splash-emblem{font-size:72px;margin-bottom:24px;animation:popIn .6s ease}
.splash-title{font-family:var(--font);font-size:28px;font-weight:800;color:#fff;margin-bottom:8px;text-align:center}
.splash-sub{font-size:14px;color:rgba(255,255,255,.7);margin-bottom:40px;text-align:center}
.splash-bar{width:320px;height:4px;background:rgba(255,255,255,.2);border-radius:2px;overflow:hidden}
.splash-fill{height:100%;background:linear-gradient(90deg,#42a5f5,#1565c0);border-radius:2px;transition:width .1s}
.splash-status{font-family:var(--mono);font-size:11px;color:rgba(255,255,255,.5);margin-top:12px}

/* ════════════════════════════════════════════
   ЭКРАН АВТОРИЗАЦИИ (УРОВЕНЬ 1)
════════════════════════════════════════════ */
#screen-login{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;display:none}
.login-wrap{width:960px;display:flex;gap:0;border-radius:16px;overflow:hidden;box-shadow:var(--shadow3);animation:fadeIn .5s ease}
.login-left{width:380px;background:linear-gradient(160deg,var(--nav3),var(--nav),#1565c0);padding:48px 40px;display:flex;flex-direction:column;justify-content:space-between;flex-shrink:0}
.login-logo{display:flex;align-items:center;gap:14px;margin-bottom:32px}
.login-logo-icon{font-size:40px}
.login-logo-text{font-family:var(--font);font-weight:800;color:#fff;line-height:1.3;font-size:15px}
.login-logo-sub{font-size:10px;color:rgba(255,255,255,.6);text-transform:uppercase;letter-spacing:1px}
.login-info{color:rgba(255,255,255,.9);font-size:13px;line-height:1.7;border-top:1px solid rgba(255,255,255,.15);padding-top:24px}
.login-info-title{font-family:var(--font);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:rgba(255,255,255,.5);margin-bottom:10px}
.login-feature{display:flex;align-items:center;gap:9px;margin-bottom:8px;font-size:12px}
.login-feature-dot{width:6px;height:6px;background:#42a5f5;border-radius:50%;flex-shrink:0}
.login-right{flex:1;background:#fff;padding:48px}
.login-right-title{font-family:var(--font);font-size:22px;font-weight:800;color:var(--txt);margin-bottom:6px}
.login-right-sub{font-size:13px;color:var(--txt2);margin-bottom:32px}
.auth-section{margin-bottom:20px}
.auth-label{font-family:var(--font);font-size:10px;font-weight:700;color:var(--txt2);text-transform:uppercase;letter-spacing:.8px;display:block;margin-bottom:6px}
.auth-iface-btns{display:flex;gap:8px;margin-bottom:24px}
.iface-btn{flex:1;padding:11px;border:2px solid var(--border);border-radius:var(--r);cursor:pointer;text-align:center;transition:.2s;background:var(--bg3)}
.iface-btn:hover,.iface-btn.sel{border-color:var(--blue);background:var(--blue-xl)}
.iface-btn-name{font-family:var(--font);font-size:12px;font-weight:700;color:var(--txt);display:block}
.iface-btn-desc{font-size:10px;color:var(--txt2);margin-top:2px}
.auth-input{width:100%;padding:11px 14px;border:2px solid var(--border);border-radius:var(--r);font-size:14px;color:var(--txt);background:var(--bg3);transition:.2s;margin-bottom:12px}
.auth-input:focus{border-color:var(--blue);background:#fff;box-shadow:0 0 0 3px rgba(21,101,192,.1)}
.auth-input.err{border-color:var(--red);animation:shake .3s ease}
.auth-btns{display:flex;gap:10px;margin-top:20px}
.btn-login{flex:1;padding:13px;background:linear-gradient(135deg,var(--blue),#0d47a1);color:#fff;border-radius:var(--r);font-family:var(--font);font-size:13px;font-weight:700;transition:.2s;box-shadow:0 4px 14px rgba(21,101,192,.4)}
.btn-login:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(21,101,192,.5)}
.btn-login-ep{padding:13px 20px;border:2px solid var(--blue);color:var(--blue);border-radius:var(--r);font-family:var(--font);font-size:13px;font-weight:700;background:transparent;transition:.2s}
.btn-login-ep:hover{background:var(--blue-xl)}
.auth-note{margin-top:20px;padding:14px;background:var(--blue-xl);border-radius:var(--r);border-left:4px solid var(--blue);font-size:12px;color:var(--txt2)}
.auth-note strong{color:var(--blue)}
.auth-err{color:var(--red);font-size:12px;margin-top:6px;display:none}

/* ════════════════════════════════════════════
   ГЛАВНЫЙ ЭКРАН
════════════════════════════════════════════ */
#screen-main{position:fixed;inset:0;display:none;flex-direction:column}
#screen-main.on{display:flex}

/* TOPBAR */
.topbar{height:50px;background:var(--nav);display:flex;align-items:center;padding:0 16px;gap:14px;flex-shrink:0;box-shadow:0 2px 8px rgba(0,0,0,.25);z-index:200}
.tb-logo{display:flex;align-items:center;gap:9px;border-right:1px solid rgba(255,255,255,.15);padding-right:14px}
.tb-logo-icon{font-size:20px}
.tb-logo-text{font-family:var(--font);font-size:11px;font-weight:800;color:#fff;line-height:1.3}
.tb-logo-sub{font-size:8px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.8px}
/* Уровень прогресса */
.tb-levels{display:flex;align-items:center;gap:4px;margin-left:8px}
.tlevel{width:28px;height:28px;border-radius:50%;border:2px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-family:var(--font);font-size:10px;font-weight:700;color:rgba(255,255,255,.4);cursor:pointer;transition:.2s;position:relative}
.tlevel.done{background:var(--green);border-color:var(--green);color:#fff}
.tlevel.cur{background:var(--blue);border-color:var(--blue3);color:#fff;animation:blink2 2s infinite}
.tlevel.locked{cursor:not-allowed}
.tlevel-tip{position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);background:var(--txt);color:#fff;font-size:10px;padding:4px 8px;border-radius:4px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .2s;font-family:var(--body)}
.tlevel:hover .tlevel-tip{opacity:1}
.tb-sp{flex:1}
.tb-status{display:flex;align-items:center;gap:14px}
.tb-stat{display:flex;align-items:center;gap:5px;color:rgba(255,255,255,.8)}
.tb-stat-val{font-family:var(--font);font-size:12px;font-weight:700;color:#fff}
.tb-stat-lbl{font-size:10px;color:rgba(255,255,255,.5)}
.tb-mode{padding:3px 10px;border-radius:20px;font-family:var(--font);font-size:10px;font-weight:700;letter-spacing:.5px}
.tb-mode.training{background:rgba(46,125,50,.3);color:#81c784}
.tb-mode.exam{background:rgba(198,40,40,.3);color:#ef9a9a}
.tb-mode.teacher{background:rgba(249,168,37,.3);color:#ffcc02}
.tb-btn{padding:4px 11px;background:rgba(255,255,255,.1);color:#fff;border-radius:var(--r);font-size:11px;font-family:var(--font);font-weight:600;border:1px solid rgba(255,255,255,.15);transition:.2s}
.tb-btn:hover{background:rgba(255,255,255,.2)}
.tb-user{display:flex;align-items:center;gap:7px;padding:4px 9px;background:rgba(255,255,255,.1);border-radius:var(--r);border:1px solid rgba(255,255,255,.15)}
.tb-av{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,#42a5f5,#1565c0);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;font-family:var(--font)}
.tb-uname{font-family:var(--font);font-size:11px;font-weight:600;color:#fff}
.tb-urole{font-size:9px;color:rgba(255,255,255,.5)}

/* LAYOUT */
.main-layout{display:flex;flex:1;overflow:hidden}

/* МЕНЮ ПОЧТЫ (ЛЕВЫЙ) */
.mail-nav{width:200px;background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;overflow-y:auto}
.mn-compose{margin:12px 10px;padding:9px;background:var(--blue);color:#fff;border-radius:var(--r);font-family:var(--font);font-size:12px;font-weight:700;text-align:center;cursor:pointer;transition:.2s;display:flex;align-items:center;justify-content:center;gap:6px;box-shadow:0 2px 8px rgba(21,101,192,.3)}
.mn-compose:hover{background:var(--blue2);transform:translateY(-1px)}
.mn-compose.pulse{animation:blink2 1.5s infinite}
.mn-section{padding:8px 0}
.mn-title{font-family:var(--font);font-size:9px;font-weight:700;color:var(--txt3);text-transform:uppercase;letter-spacing:1.2px;padding:0 14px;margin-bottom:3px}
.mn-item{display:flex;align-items:center;gap:9px;padding:7px 14px;cursor:pointer;transition:.2s;border-left:3px solid transparent;position:relative}
.mn-item:hover{background:var(--bg3)}
.mn-item.on{background:var(--blue-xl);border-left-color:var(--blue)}
.mn-icon{font-size:15px;width:18px;text-align:center;flex-shrink:0}
.mn-label{font-family:var(--font);font-size:12px;font-weight:600;color:var(--txt2)}
.mn-item.on .mn-label{color:var(--blue)}
.mn-badge{margin-left:auto;background:var(--red);color:#fff;font-size:9px;font-weight:700;border-radius:10px;padding:2px 6px;font-family:var(--font)}
.mn-badge.b{background:var(--blue)}
.mn-quota{padding:10px 14px;margin-top:auto;border-top:1px solid var(--border)}
.mn-quota-lbl{font-size:10px;color:var(--txt3);margin-bottom:4px}
.mn-quota-bar{height:4px;background:var(--border);border-radius:2px;overflow:hidden}
.mn-quota-fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--teal));border-radius:2px}
.mn-quota-val{font-size:10px;color:var(--txt2);margin-top:3px}

/* ЦЕНТРАЛЬНАЯ ЗОНА */
.mail-center{flex:1;display:flex;flex-direction:column;overflow:hidden;border-right:1px solid var(--border)}

/* TOOLBAR ПОЧТЫ */
.mail-toolbar{height:44px;background:var(--bg2);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 14px;gap:9px;flex-shrink:0}
.mtb-btn{display:flex;align-items:center;gap:5px;padding:5px 11px;border:1.5px solid var(--border);border-radius:var(--r);font-size:12px;color:var(--txt2);background:var(--bg3);transition:.2s;cursor:pointer;font-family:var(--font);font-weight:600}
.mtb-btn:hover:not(:disabled){border-color:var(--blue);color:var(--blue);background:var(--blue-xl)}
.mtb-btn:disabled{opacity:.4;cursor:not-allowed}
.mtb-sep{width:1px;height:20px;background:var(--border);flex-shrink:0}
.mtb-sp{flex:1}
.mtb-search{display:flex;align-items:center;gap:7px;background:var(--bg3);border:1.5px solid var(--border);border-radius:20px;padding:5px 13px;max-width:280px;flex:1}
.mtb-search input{border:none;background:transparent;font-size:12px;color:var(--txt);flex:1}
.mtb-search-icon{color:var(--txt3);font-size:13px}
.mtb-select{display:flex;align-items:center;gap:5px;padding:4px 9px;border:1.5px solid var(--border);border-radius:var(--r);font-size:11px;background:var(--bg3);cursor:pointer}
.mtb-select select{border:none;background:transparent;font-size:11px;color:var(--txt2);cursor:pointer;font-family:var(--body)}

/* СПИСОК ПИСЕМ */
.mail-split{flex:1;display:flex;overflow:hidden}
.mail-list-pane{width:300px;border-right:1px solid var(--border);overflow-y:auto;flex-shrink:0;background:var(--bg2)}
.ml-filter{display:flex;padding:8px 10px;gap:5px;border-bottom:1px solid var(--border);background:var(--bg3)}
.ml-ftab{flex:1;padding:4px;text-align:center;font-family:var(--font);font-size:10px;font-weight:700;color:var(--txt3);border-radius:var(--r);cursor:pointer;transition:.2s}
.ml-ftab.on{background:#fff;color:var(--blue);box-shadow:0 1px 4px rgba(21,44,87,.1)}
.mail-item{padding:12px 14px;border-bottom:1px solid var(--border);cursor:pointer;transition:.2s;position:relative}
.mail-item:hover{background:var(--bg3)}
.mail-item.on{background:var(--blue-xl)}
.mail-item.unread{background:#fff}
.mail-item.unread .mi-from{font-weight:700;color:var(--txt)}
.mail-item.unread::before{content:'';position:absolute;left:4px;top:50%;transform:translateY(-50%);width:6px;height:6px;border-radius:50%;background:var(--blue)}
.mail-item.spam{background:#fff9c4}
.mi-row1{display:flex;justify-content:space-between;align-items:center;margin-bottom:3px}
.mi-from{font-family:var(--font);font-size:12px;font-weight:600;color:var(--txt2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px}
.mi-date{font-size:10px;color:var(--txt3);flex-shrink:0}
.mi-subj{font-size:12px;color:var(--txt);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:2px}
.mi-preview{font-size:11px;color:var(--txt3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mi-icons{display:flex;gap:4px;margin-top:4px}
.mi-tag{font-size:9px;padding:1px 5px;border-radius:3px;font-family:var(--font);font-weight:700}
.mi-tag.spam{background:#fff3e0;color:var(--orange)}
.mi-tag.attach{background:var(--blue-xl);color:var(--blue)}
.mi-tag.important{background:#fff9c4;color:#f57f17}

/* ПРОСМОТР ПИСЬМА */
.mail-view{flex:1;overflow-y:auto;padding:20px;background:var(--bg2)}
.mv-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:var(--txt3)}
.mv-empty-icon{font-size:56px;margin-bottom:16px;opacity:.4}
.mv-header{margin-bottom:18px}
.mv-subject{font-family:var(--font);font-size:18px;font-weight:800;color:var(--txt);margin-bottom:10px}
.mv-meta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:12px}
.mv-meta-item{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--txt2)}
.mv-meta-lbl{font-weight:700}
.mv-badges{display:flex;gap:6px;margin-bottom:14px}
.mv-actions{display:flex;gap:7px;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--border)}
.mv-btn{display:flex;align-items:center;gap:5px;padding:6px 13px;border:1.5px solid var(--border);border-radius:var(--r);font-size:12px;color:var(--txt2);background:var(--bg3);cursor:pointer;transition:.2s;font-family:var(--font);font-weight:600}
.mv-btn:hover{border-color:var(--blue);color:var(--blue);background:var(--blue-xl)}
.mv-body{font-size:13px;color:var(--txt);line-height:1.7;white-space:pre-wrap}
.mv-attach{margin-top:18px;padding-top:14px;border-top:1px solid var(--border)}
.mv-attach-title{font-family:var(--font);font-size:11px;font-weight:700;color:var(--txt2);text-transform:uppercase;letter-spacing:.7px;margin-bottom:9px}
.attach-file{display:inline-flex;align-items:center;gap:7px;padding:7px 12px;border:1.5px solid var(--border);border-radius:var(--r);font-size:12px;color:var(--txt);background:var(--bg3);cursor:pointer;margin-right:7px;margin-bottom:7px;transition:.2s}
.attach-file:hover{border-color:var(--blue);background:var(--blue-xl);color:var(--blue)}
.attach-icon{font-size:16px}

/* СПАМ ПРЕДУПРЕЖДЕНИЕ */
.spam-warning{background:#fff3cd;border:2px solid var(--gold);border-radius:var(--r);padding:12px 14px;margin-bottom:14px;display:flex;gap:10px;align-items:flex-start}

/* ════════════════════════════════════════════
   ПРАВАЯ ПАНЕЛЬ (КОНТЕКСТ)
════════════════════════════════════════════ */
.right-panel{width:260px;background:var(--bg2);border-left:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden}
.rp-tabs{display:flex;border-bottom:1px solid var(--border)}
.rp-tab{flex:1;padding:8px 3px;font-family:var(--font);font-size:10px;font-weight:700;color:var(--txt2);border-bottom:2px solid transparent;cursor:pointer;transition:.2s;text-align:center;background:transparent}
.rp-tab.on{color:var(--blue);border-bottom-color:var(--blue);background:var(--blue-xl)}
.rp-pane{display:none;flex-direction:column;height:100%;overflow:hidden}
.rp-pane.on{display:flex}
.rp-body{flex:1;overflow-y:auto;padding:12px}

/* SCORE / EXAMINER */
.score-box{text-align:center;padding:14px;background:linear-gradient(135deg,#fff8e1,#fffde7);border-radius:var(--r2);border:2px solid var(--gold);margin-bottom:12px}
.score-val{font-family:var(--font);font-size:36px;font-weight:800;color:var(--orange)}
.score-lbl{font-size:11px;color:var(--txt2)}
.pbar{height:5px;background:var(--border);border-radius:3px;overflow:hidden}
.pfill{height:100%;border-radius:3px;transition:width .4s ease}
.pfill-blue{background:linear-gradient(90deg,var(--blue),var(--teal))}
.pfill-green{background:linear-gradient(90deg,var(--green),#4caf50)}
.pfill-red{background:linear-gradient(90deg,var(--red),#ef5350)}
.pfill-gold{background:linear-gradient(90deg,var(--gold),#ffca28)}

/* ЛОГ-ПАНЕЛЬ */
.log-entry{padding:5px 0;border-bottom:1px solid var(--border);font-size:11px;display:flex;gap:7px}
.log-time{color:var(--txt3);font-family:var(--mono);font-size:10px;flex-shrink:0}
.log-text{color:var(--txt2)}
.log-ok{color:var(--green)}
.log-err{color:var(--red)}
.log-warn{color:var(--orange)}

/* ════════════════════════════════════════════
   ПАНЕЛЬ ИНСТРУКЦИЙ (Cisco Packet Tracer стиль)
════════════════════════════════════════════ */
#inst-panel{height:var(--inst-h);background:#fff;border-top:2px solid var(--blue);flex-shrink:0;display:flex;flex-direction:column;overflow:hidden;transition:height .3s ease}
#inst-panel.collapsed{height:36px}
.inst-header{height:36px;background:var(--blue);display:flex;align-items:center;padding:0 14px;gap:10px;flex-shrink:0;cursor:pointer;user-select:none}
.inst-title{font-family:var(--font);font-size:12px;font-weight:700;color:#fff;display:flex;align-items:center;gap:8px}
.inst-level-badge{background:rgba(255,255,255,.2);border-radius:20px;padding:2px 10px;font-size:10px;color:#fff;font-family:var(--font);font-weight:700}
.inst-sp{flex:1}
.inst-prog-wrap{display:flex;align-items:center;gap:9px}
.inst-prog-bar{width:160px;height:6px;background:rgba(255,255,255,.2);border-radius:3px;overflow:hidden}
.inst-prog-fill{height:100%;background:#fff;border-radius:3px;transition:width .4s ease}
.inst-prog-txt{font-family:var(--font);font-size:10px;color:rgba(255,255,255,.8)}
.inst-collapse-btn{width:22px;height:22px;background:rgba(255,255,255,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;transition:.2s}
.inst-collapse-btn:hover{background:rgba(255,255,255,.3)}
.inst-body{flex:1;display:flex;overflow:hidden;padding:12px 14px;gap:14px}
.inst-steps{width:200px;overflow-y:auto;flex-shrink:0}
