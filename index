function renderRPScore() {
  const maxPts = QUESTS.reduce((s,l)=>s+l.steps.reduce((ss,st)=>ss+st.pts,0),0);
  const pct = Math.min(100, Math.round(APP.score/maxPts*100));
  const doneSteps = QUESTS.reduce((s,l)=>s+l.steps.filter(st=>st.done).length,0);
  const totalSteps = QUESTS.reduce((s,l)=>s+l.steps.length,0);
  
  document.getElementById('rp-score').textContent = APP.score;
  document.getElementById('rp-max').textContent = maxPts;
  document.getElementById('rp-pbar').style.width = pct+'%';
  
  // Кольцо прогресса
  const ring = document.getElementById('rp-ring');
  if (ring) {
    const r=28,circ=2*Math.PI*r;
    const fill=ring.querySelector('.prog-ring-fill');
    const txt=ring.querySelector('.prog-ring-text');
    if(fill){fill.style.strokeDasharray=circ;fill.style.strokeDashoffset=circ*(1-pct/100);}
    if(txt) txt.textContent=pct+'%';
  }
}

