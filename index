  // ── ОПРЕДЕЛЕНИЕ БЛИЖАЙШЕГО НАРЯДА ──
  findNearest(incAddr){
    const free=this.s.patrols.filter(p=>p.sta==='free');
    if(!free.length)return null;
    // Определяем по совпадению района
    const addrLower=incAddr.toLowerCase();
    const districts={Центральный:['ленина','мира','центральная'],Северный:['гагарина','молодёжная'],Советский:['садовая','победы','школьный']};
    for(const [dist,kws] of Object.entries(districts)){
      if(kws.some(k=>addrLower.includes(k))){
        const match=free.find(p=>p.dst===dist);
        if(match)return match;
      }
    }
    return free[0];
  },

  dispatchNearest(kuspId){
    const k=this.s.kusp?this.s.kusp.find(x=>x.id===kuspId):null;
    if(!k){this.toast('w','Ошибка','Запись КУСП не найдена.');return;}
    const nearest=this.findNearest(k.addr);
    if(!nearest){this.toast('w','Нет нарядов','Все наряды заняты. Ожидайте освобождения.');return;}
    nearest.sta='busy';nearest.inc=kuspId;k.patrol=nearest.cs;k.status='inprogress';
    this.addEv(`<strong>Ближайший наряд ${nearest.cs}</strong> (${nearest.dst}) направлен на ${k.type} — ${k.addr}.`,'warning');
    this.addNotif('patrol','Наряд выслан автоматически',nearest.cs+' → '+k.addr,'Ближайший','ig');
    this.log('Автодиспетчер: '+nearest.cs+' → '+kuspId);
    this.save();this.updBdg();
    this.toast('s','Ближайший наряд выслан!',nearest.cs+' ('+nearest.dst+') направлен на '+k.addr);
    setTimeout(()=>{nearest.sta='free';nearest.inc=null;k.status='resolved';this.addEv(`<strong>Наряд ${nearest.cs}</strong> завершил отработку ${k.type}.`,'success');this.save();this.updBdg();},90000);
    if(this.s.mod==='kusp')this.go('kusp');
  },

