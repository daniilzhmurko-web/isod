<script>
/* === CORE ENGINE === */
function setDiff(d,el){S.diff=d;document.querySelectorAll('.diff-o').forEach(e=>e.classList.remove('sel'));el.classList.add('sel');document.getElementById('diffLbl').textContent=['','Стажёр','Оператор','Эксперт','Мастер'][d]||'Стажёр';}
function doLogin(){const b=document.getElementById('lbtn');b.innerHTML='<i class="fas fa-spinner fa-spin" style="margin-right:6px;"></i>АУТЕНТИФИКАЦИЯ...';b.disabled=true;setTimeout(()=>{const l=document.getElementById('ls');l.style.opacity='0';l.style.transition='opacity .35s';setTimeout(()=>{l.style.display='none';document.getElementById('rs').classList.add('a');},350);},1100);}
function selectRole(role){
  S.role=role;S.ss=Date.now();
  const um={operator:{n:'Оператор',l:'operator01',av:'О',cls:'op',ic:'fas fa-keyboard'},expert:{n:'Эксперт-криминалист',l:'expert01',av:'Э',cls:'ex',ic:'fas fa-dna'},admin:{n:'Администратор',l:'admin01',av:'А',cls:'ad',ic:'fas fa-user-shield'},analyst:{n:'Аналитик-эксперт',l:'analyst01',av:'А',cls:'an',ic:'fas fa-chart-pie'}};
  S.user=um[role];
  const saved=localStorage.getItem('kx2_'+role);if(saved){const d=JSON.parse(saved);S.xp=d.xp||0;S.bg=d.bg||[];}
  S.mc=ALL_MISSIONS;
  document.getElementById('rs').classList.remove('a');
  document.getElementById('app').classList.add('a');
  initApp();
}
function initApp(){
  renderTB();renderNav();renderBadges();startTimer();navTo('db');loadMission(0);
  audit('Вход в систему','AUTH','OK');
  ntf('Добро пожаловать!','Система КСЕНОН-2 готова. Начните с первого задания в панели ниже.','ok');
  setTimeout(startRandEvents,15000);
}
function renderTB(){
  const m=S.user;
  const b=document.getElementById('rbdg');
  b.className='tc '+m.cls;b.innerHTML=`<i class="${m.ic}" style="font-size:9px;"></i><span id="rlbl">${m.n}</span>`;
  document.getElementById('av').textContent=m.av;
  document.getElementById('un').textContent=m.n;
  document.getElementById('diffBdg').innerHTML=`<i class="fas fa-signal" style="font-size:9px;"></i>${['','Стажёр','Оператор','Эксперт','Мастер'][S.diff]||'Стажёр'}`;
  updateXP();
}
function getRank(x){return RANKS.find(r=>x>=r.mn&&x<=r.mx)||RANKS[0];}
function updateXP(){
  const r=getRank(S.xp);
  ['xpd','xpp'].forEach(id=>{const e=document.getElementById(id);if(e)e.textContent=S.xp+' XP';});
  ['rkd','ur','rkp'].forEach(id=>{const e=document.getElementById(id);if(e)e.textContent=r.n;});
  document.getElementById('ur').textContent=r.n;
  const pct=r.mx===Infinity?99:Math.round((S.xp-r.mn)/(r.mx-r.mn)*100);
  ['xbf','tbxf','lpXpF'].forEach(id=>{const e=document.getElementById(id);if(e)e.style.width=pct+'%';});
  const lpn=document.getElementById('lpRank');if(lpn)lpn.textContent=r.n;
  const lpv=document.getElementById('lpXpV');if(lpv)lpv.textContent=S.xp+' XP';
  const lps=document.getElementById('lpXpS');if(lps)lps.textContent=S.xp+' / '+(r.mx===Infinity?'∞':r.mx)+' XP до следующего уровня';
  BS.xp=S.xp;checkBadges();
}
function addXP(n,x,y){
  const prev=getRank(S.xp),newX=S.xp+n;S.xp=newX;
  if(x&&y){const f=document.createElement('div');f.className='xp-float';f.textContent='+'+n+' XP';f.style.cssText=`left:${x}px;top:${y}px;`;document.body.appendChild(f);setTimeout(()=>f.remove(),1200);}
  const newR=getRank(newX);
  if(newR.n!==prev.n){showLvlUp(newR);}
  updateXP();saveProgress();BS.xp=S.xp;
}
function showLvlUp(r){
  document.getElementById('lvlS').textContent=r.ic||'⭐';
  document.getElementById('lvlR').textContent=r.n;
  document.getElementById('lvlX').textContent=S.xp+' XP';
  document.getElementById('lvlOv').classList.add('a');
}
function closeLvl(){document.getElementById('lvlOv').classList.remove('a');}
function checkBadges(){
  BADGES_DEF.forEach(b=>{
    if(!S.bg.includes(b.id)&&b.c(BS)){
      S.bg.push(b.id);renderBadges();
      showBadge(b);
      document.getElementById('bdgcnt').textContent=S.bg.length;
    }
  });
}
function showBadge(b){
  const ov=document.getElementById('bdgOv');
  const el=document.createElement('div');el.className='bdg-pop';
  el.innerHTML=`<div class="bdg-ic">${b.ic}</div><div><div class="bdg-t">Новый значок!</div><div class="bdg-n">${b.nm}</div><div style="font-size:10px;color:rgba(232,240,254,.5);">${b.desc}</div></div>`;
  ov.appendChild(el);setTimeout(()=>el.remove(),4000);
}
function renderBadges(){
  const g=document.getElementById('bgrd');if(!g)return;
  g.innerHTML=BADGES_DEF.map(b=>`<div class="bgi ${S.bg.includes(b.id)?'ul':'lk'}" title="${b.nm}: ${b.desc}"><div class="bgi-ic">${b.ic}</div><div class="bgi-nm">${b.nm}</div></div>`).join('');
}
function renderNav(){
  const cfg=NAV_CFG[S.role]||NAV_CFG.operator;let h='';
  cfg.forEach(sec=>{
    h+=`<div class="ns"><div class="nst">${sec.s}</div>`;
    sec.i.forEach(it=>{
      const bg=it.bg?`<span class="nbg" style="background:${it.bc||'#2563eb'}">${it.bg}</span>`:'';
      h+=`<div class="ni" id="nav_${it.id}" onclick="navTo('${it.id}')"><i class="${it.ic}"></i>${it.lb}${bg}</div>`;
    });
    h+=`</div>`;
  });
  document.getElementById('nm').innerHTML=h;
}
function navTo(pg){
  S.pg=pg;
  document.querySelectorAll('.ni').forEach(e=>e.classList.remove('a'));
  const n=document.getElementById('nav_'+pg);if(n)n.classList.add('a');
  vMS('nav_'+pg);renderPage(pg);
}
function vMS(k,pts){
  const m=S.mc[S.mi];if(!m)return;
  const st=m.steps.find(s=>s.k===k);if(!st||st.dn)return;
  st.dn=true;
  const el=document.getElementById('ste_'+k);
  if(el){el.className='ipch dn';el.querySelector('i').className='fas fa-check-circle';}
  if(m.steps.every(s=>s.dn))completeMission(m,pts);
  else renderMissionPanel(m);
}
function completeMission(m,pts){
  const xpGain=(m.xp||50)*Math.max(1,S.diff);
  addXP(xpGain);
  S.total++;BS.done++;
  document.getElementById('dc').textContent=S.total;
  const acc=Math.round((1-S.errors/Math.max(1,S.total))*100);
  document.getElementById('acc').textContent=acc+'%';
  if(S.errors===0)BS.perfect++;
  ntf('🎉 Задание выполнено!',`«${m.t}» — получено ${xpGain} XP`,'ok');
  audit('Задание '+m.id+' выполнено','ОБУЧЕНИЕ','OK');
  saveProgress();checkBadges();
}
function mNext(){
  if(S.mi<S.mc.length-1){S.mi++;loadMission(S.mi);}
  else ntf('🏆 Все задания выполнены!','Откройте раздел «Сертификат» для получения диплома.','ok');
}
function mPrev(){if(S.mi>0){S.mi--;loadMission(S.mi);}}
function loadMission(i){
  S.mi=i;const m=S.mc[i];if(!m)return;
  m.steps.forEach(s=>s.dn=false);
  document.getElementById('mcat').textContent=m.cat;
  renderMissionPanel(m);
}
function renderMissionPanel(m){
  const tot=S.mc.length,idx=S.mi;
  const pct=Math.round(idx/tot*100);
  document.getElementById('ippf').style.width=pct+'%';
  document.getElementById('ipct').textContent=(idx+1)+'/'+tot;
  document.getElementById('isnum').textContent=idx+1;
  document.getElementById('ittl').textContent=m.t;
  document.getElementById('idsc').textContent=m.desc;
  document.getElementById('iht').textContent=m.hint;
  document.getElementById('ichl').innerHTML=m.steps.map((s,i)=>{
    const first=m.steps.findIndex(x=>!x.dn);
    return `<div class="ipch ${s.dn?'dn':i===first?'ac':''}" id="ste_${s.k}">
      <i class="fas ${s.dn?'fa-check-circle':'fa-circle-dot'}" style="color:${s.dn?'var(--ok)':'var(--t2)'}"></i>${s.tx}</div>`;
  }).join('');
  document.getElementById('ias').innerHTML=S.mc.map((mm,i)=>`
    <div class="ipad ${i<idx?'dn':i===idx?'ac':''}" onclick="loadMission(${i})">
      <div class="d"></div><span>${i+1}. ${mm.t}</span>
    </div>`).join('');
  document.getElementById('ibpv').disabled=idx===0;
  const allDone=m.steps.every(s=>s.dn),isLast=idx===tot-1;
  const nb=document.getElementById('ibnx');
  nb.textContent=allDone?(isLast?'🏆 Завершить':'Следующее ▶'):'Пропустить →';
  nb.className='ipbtn '+(allDone?(isLast?'fn':'nx'):'nx');
}
function tglInstr(){S.ic=!S.ic;document.getElementById('ip').classList.toggle('cl',S.ic);}
function saveProgress(){
  if(!S.role)return;
  localStorage.setItem('kx2_'+S.role,JSON.stringify({xp:S.xp,bg:S.bg}));
}
function startTimer(){
  S.stmr=setInterval(()=>{
    const e=Math.floor((Date.now()-S.ss)/1000);
    const h=String(Math.floor(e/3600)).padStart(2,'0'),mn=String(Math.floor((e%3600)/60)).padStart(2,'0'),sec=String(e%60).padStart(2,'0');
    document.getElementById('stmr').textContent=h+':'+mn+':'+sec;
  },1000);
}
function audit(a,m,r){
  const t=new Date().toTimeString().split(' ')[0];
  S.au.push({t,u:S.user?S.user.l:'sys',a,m,r});
  const el=document.getElementById('aul');
  if(el){el.innerHTML=S.au.slice(-8).reverse().map(e=>`<div style="padding:3px 6px;background:var(--bg);border-radius:4px;font-size:10px;border-left:2px solid ${e.r==='OK'?'var(--ok)':'var(--er)'}"><span style="font-family:'Courier New',monospace;font-size:9px;">${e.t}</span> ${e.a}</div>`).join('');}
}
function ntf(title,msg,type='in'){
  const icons={in:'fas fa-info-circle',ok:'fas fa-check-circle',er:'fas fa-times-circle',wn:'fas fa-exclamation-triangle'};
  const el=document.createElement('div');el.className='nti '+type;
  el.innerHTML=`<i class="ntic ${icons[type]}"></i><div><div class="ntit">${title}</div><div class="ntim">${msg}</div></div>`;
  document.getElementById('nt').appendChild(el);
  setTimeout(()=>{el.style.opacity='0';el.style.transition='opacity .3s';setTimeout(()=>el.remove(),300);},3500);
}
function doLogout(){
  if(S.stmr)clearInterval(S.stmr);S.role=null;
  document.getElementById('app').classList.remove('a');
  const ls=document.getElementById('ls');ls.style.display='flex';ls.style.opacity='1';
  document.getElementById('lbtn').innerHTML='<i class="fas fa-shield-halved" style="margin-right:6px;"></i>ВОЙТИ В СИСТЕМУ';
  document.getElementById('lbtn').disabled=false;
}
function showRandEvent(){
  const evts=[
    {type:'crit',title:'⚠️ Инцидент безопасности',msg:'Обнаружена попытка несанкционированного доступа к API. IP: 10.0.0.42',actions:[{lb:'Заблокировать',fn:()=>{BS.secInc++;checkBadges();vMS('au_crit');ntf('IP заблокирован','Адрес 10.0.0.42 добавлен в список запрещённых','ok');}}]},
    {type:'warn',title:'📡 Узел недоступен',msg:'ГУ МВД Екатеринбург не отвечает уже 8 часов. Очередь: 7 запросов.',actions:[{lb:'Зафиксировать инцидент',fn:()=>{vMS('nd_inc');vMS('nd_find');ntf('Инцидент зафиксирован','Отправлено уведомление ответственному администратору','ok');}}]},
    {type:'ok',title:'🔍 Потенциальное совпадение',msg:'Система обнаружила возможное совпадение профилей по делу УД-2024-0047.',actions:[{lb:'Просмотреть',fn:()=>{navTo(S.role==='expert'?'cmp':'search');ntf('Открыт модуль поиска','Перейдите к сравнению профилей','in');}}]},
    {type:'in',title:'📥 Новый срочный запрос',msg:'Поступил запрос HIGH-приоритета из ГУ МВД Казань.',actions:[{lb:'Перейти к очереди',fn:()=>{navTo('queue');}}]},
    {type:'warn',title:'💾 Ошибка резервного копирования',msg:'Плановый бэкап BK-004 завершился с ошибкой. Требуется внеплановое копирование.',actions:[{lb:'Запустить бэкап',fn:()=>{navTo('bk');ntf('Переход к резервному копированию','Выполните внеплановый бэкап','in');}}]},
  ];
  const ev=evts[Math.floor(Math.random()*evts.length)];
  const p=document.getElementById('evtP');
  const el=document.createElement('div');el.className='evt '+ev.type;
  el.innerHTML=`<div class="evt-h"><div class="evt-t">${ev.title}</div></div><div class="evt-m">${ev.msg}</div><div class="evt-a">${ev.actions.map((a,i)=>`<button class="evbtn p" onclick="evtAct(${i},this.closest('.evt'))">${a.lb}</button>`).join('')}<button class="evbtn s" onclick="this.closest('.evt').remove()">Игнорировать</button></div>`;
  el._actions=ev.actions;p.appendChild(el);
  setTimeout(()=>{if(el.parentNode)el.remove();},12000);
}
window._evtActions=[];
function evtAct(i,el){const a=el._actions;if(a&&a[i])a[i].fn();el.remove();}
function startRandEvents(){setInterval(()=>{if(Math.random()<0.3)showRandEvent();},25000);}
</script>
<script>
