/* ===================== ГАМИФИКАЦИЯ ===================== */
.ranks-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 14px;
  margin-bottom: 20px;
}
.rank-card {
  background: var(--panel);
  border-radius: 12px;
  padding: 20px 16px;
  text-align: center;
  box-shadow: var(--shadow);
  border: 2px solid var(--border);
  transition: all .2s;
}
.rank-card:hover { border-color: var(--blue); transform: translateY(-2px); }
.rank-emoji { font-size: 40px; margin-bottom: 10px; }
.rank-name { font-size: 14px; font-weight: 800; color: var(--text); margin-bottom: 4px; }
.rank-xp { font-size: 12px; color: var(--muted); }

/* ===================== ГОРЯЧИЕ КЛАВИШИ / СОВЕТЫ ===================== */
.tips-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
.tip-card {
  background: var(--panel);
  border-radius: 11px;
  padding: 18px;
  box-shadow: var(--shadow);
  border-left: 4px solid var(--blue);
  transition: transform .2s;
}
.tip-card:hover { transform: translateX(3px); }
.tip-card.green { border-left-color: var(--green); }
.tip-card.orange { border-left-color: var(--orange); }
.tip-card.purple { border-left-color: var(--purple); }
.tip-title {
  font-size: 14px;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 7px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.tip-text { font-size: 13px; color: var(--text2); line-height: 1.6; }

/* ===================== FOOTER ===================== */
.site-footer {
  background: #1A1A2E;
  color: rgba(255,255,255,.6);
  padding: 32px 40px;
  text-align: center;
  font-size: 13px;
}
.site-footer strong { color: rgba(255,255,255,.9); }
.footer-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: rgba(255,255,255,.08);
  border-radius: 20px;
  padding: 5px 16px;
  font-size: 11px;
  margin-top: 10px;
}

/* ===================== ПРОГРЕСС СКРОЛЛА ===================== */
#scroll-bar {
  position: fixed;
  top: 0; left: 0;
  height: 3px;
  background: linear-gradient(90deg,#003F8A,#7EE8A2);
  z-index: 9999;
  transition: width .1s;
  width: 0%;
}

/* ===================== КНОПКА НАВЕРХ ===================== */
#to-top {
  position: fixed;
  bottom: 32px; right: 28px;
  width: 44px; height: 44px;
  background: var(--blue);
  color: #fff;
  border: none;
  border-radius: 50%;
  cursor: pointer;
  font-size: 16px;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 16px rgba(0,63,138,.3);
  transition: all .2s;
  opacity: 0;
  pointer-events: none;
  z-index: 1000;
}
#to-top.show { opacity: 1; pointer-events: auto; }
#to-top:hover { background: var(--blue2); transform: translateY(-2px); }

/* ===================== АНИМАЦИИ ===================== */
.fade-up {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity .5s ease, transform .5s ease;
}
.fade-up.visible { opacity: 1; transform: none; }

/* ===================== RESPONSIVE ===================== */
@media (max-width: 900px) {
  .layout { grid-template-columns: 1fr; }
  .toc { position: static; }
  .roles-grid, .tips-grid, .ranks-grid, .zone-legend { grid-template-columns: 1fr; }
  .header-title { font-size: 30px; }
  .stats-grid { grid-template-columns: repeat(2,1fr); }
}

