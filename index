.ec{padding:13px;background:#fff;border-radius:var(--r);border:1px solid rgba(245,158,11,.3);display:flex;flex-direction:column;align-items:center;text-align:center}
.ec-ico{font-size:24px;margin-bottom:5px}
.ec-name{font-family:var(--font);font-size:13px;font-weight:800;color:var(--txt);margin-bottom:3px}
.ec-val{font-size:12px;color:var(--txt2);line-height:1.4}

/* RANKS */
.ranks{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:14px 0}
.rank{padding:16px 12px;border-radius:var(--r2);border:2px solid var(--border);text-align:center;transition:.2s;background:var(--bg2)}
.rank:hover{transform:translateY(-2px);box-shadow:var(--sh2)}
.r1{border-color:var(--gold);background:#fffde7}
.r2{border-color:var(--blue);background:var(--blue-xl)}
.r3{border-color:var(--green);background:var(--green-l)}
.r4{border-color:var(--red);background:var(--red-l)}
.rank-ico{font-size:28px;margin-bottom:6px}
.rank-pct{font-family:var(--font);font-size:15px;font-weight:900}
.rank-name{font-family:var(--font);font-size:11px;font-weight:700;color:var(--txt);margin-top:3px}

/* ACHIEVEMENTS */
.ach-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.ach-item{padding:12px;border-radius:var(--r);border:1.5px solid var(--border);background:var(--bg3);display:flex;gap:9px;align-items:flex-start;transition:.2s}
.ach-item:hover{border-color:var(--blue);background:var(--blue-xl)}
.ach-ico{font-size:22px;flex-shrink:0}
.ach-name{font-family:var(--font);font-size:12px;font-weight:700;color:var(--txt);margin-bottom:2px}
.ach-desc{font-size:11px;color:var(--txt2);line-height:1.4}

/* FAQ */
.faq{border-bottom:1px solid var(--border);padding:18px 0}
.faq:first-child{border-top:1px solid var(--border)}
.faq-q{font-family:var(--font);font-size:15px;font-weight:700;color:var(--txt);cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:12px}
.faq-q:hover{color:var(--blue)}
.faq-ico{font-size:14px;color:var(--txt3);flex-shrink:0;transition:transform .3s}
.faq-q.open .faq-ico{transform:rotate(45deg);color:var(--blue)}
.faq-a{display:none;padding-top:13px;font-size:13px;color:var(--txt2);line-height:1.7}
.faq-a.open{display:block;animation:up .22s ease}

/* STICKY NAV */
.snav{position:fixed;left:18px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:7px;z-index:100}
.sndot{width:10px;height:10px;border-radius:50%;background:rgba(21,51,101,.2);cursor:pointer;transition:.25s;position:relative}
.sndot:hover,.sndot.act{background:var(--blue);transform:scale(1.5)}
.sn-tip{position:absolute;left:calc(100%+9px);top:50%;transform:translateY(-50%);background:var(--txt);color:#fff;font-size:10px;padding:4px 9px;border-radius:4px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .2s;font-family:var(--body)}
.sndot:hover .sn-tip{opacity:1}

/* SCROLL TOP */
#go-top{position:fixed;bottom:26px;right:26px;width:44px;height:44px;background:var(--blue);color:#fff;border:none;border-radius:50%;font-size:18px;cursor:pointer;box-shadow:var(--sh2);transition:.25s;opacity:0;pointer-events:none;z-index:100}
#go-top.show{opacity:1;pointer-events:all}
#go-top:hover{background:var(--blue2);transform:translateY(-3px)}

/* FOOTER */
.footer{background:var(--nav);color:rgba(255,255,255,.55);text-align:center;padding:52px 24px;margin-top:80px;font-size:13px}
.footer-logo{font-family:var(--font);font-size:20px;font-weight:900;color:#fff;margin-bottom:5px}
.footer-ver{background:rgba(255,255,255,.1);border-radius:20px;padding:3px 14px;font-family:var(--font);font-size:10px;font-weight:700;display:inline-block;margin-bottom:14px;color:rgba(255,255,255,.65)}

/* RESPONSIVE */
@media(max-width:820px){
  .hero-title{font-size:30px}
