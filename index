    else h+=`<div style="margin-top:8px;display:flex;align-items:center;gap:8px"><input type="checkbox" id="cb_mc" onchange="if(this.checked)document.getElementById('mc_e').style.display='block';else document.getElementById('mc_e').style.display='none'"><label for="cb_mc" class="cfl">Ещё судимость</label></div><div id="mc_e" style="display:none;margin-top:8px;padding:10px;background:#f0f4fb;border:1px solid var(--bl);border-radius:4px"><input class="cfi" placeholder="Дата осуждения" style="margin-bottom:5px;width:100%"><input class="cfi" placeholder="Суд" style="width:100%"></div>`;
    return h;}
  if(bid==='p'){const pr=data||{};return hdr+`<div class="cfs">Привлечение</div><div class="cfr"><div class="cfg"><label class="cfl">Дата</label><input class="cfi" value="${pr.d||''}" placeholder="ДД.ММ.ГГГГ" style="width:100px"></div><div class="cfg"><label class="cfl">Орган</label><input class="cfi" value="${pr.og||''}" style="width:200px"></div></div><div class="cfr" style="margin-top:5px;align-items:center"><span class="cfl">УК ст.</span><select class="cfi" style="width:65px">${UKA.map(u=>`<option value="${u.c}" ${pr.ar&&pr.ar.c===u.c?'selected':''}>${u.c}</option>`).join('')}</select><span class="cfl">ч.</span><select class="cfi" style="width:48px">${[1,2,3,4].map(n=>`<option ${pr.pa===n?'selected':''}>${n}</option>`).join('')}</select></div><div style="margin-top:7px;display:flex;align-items:center;gap:8px"><input type="checkbox" checked id="cb_pd"><label for="cb_pd" class="cfl">Решение</label></div><div style="margin-top:5px"><input class="cfi" value="${pr.dc||''}" placeholder="Решение" style="width:100%;margin-bottom:5px"><div class="cfr"><div class="cfg"><label class="cfl">Дата решения</label><input class="cfi" value="${pr.dd||''}" style="width:100px"></div><div class="cfg"><label class="cfl">Орган</label><input class="cfi" value="${pr.og||''}" style="width:180px"></div></div><div class="cfr" style="margin-top:5px;align-items:center"><span class="cfl">УПК ст.</span><select class="cfi" style="min-width:220px">${UPKA.map(u=>`<option value="${u.c}" ${pr.uk&&pr.uk.c===u.c?'selected':''}>${u.c} — ${u.n}</option>`).join('')}</select></div></div><div class="cfg" style="margin-top:6px"><label class="cfl">Данные из картотеки</label><textarea class="ka"></textarea></div><div style="margin-top:7px;display:flex;align-items:center;gap:8px"><input type="checkbox"><label class="cfl">Ещё привлечение</label></div>`;}
  if(bid==='r'){const wt=data||{};return hdr+(wt.lv==='f'?'<div class="fw">🚨 ФЕДЕРАЛЬНЫЙ РОЗЫСК — немедленно информируйте руководство!</div>':'')+`<div class="cfs">Розыск</div><div class="cfr"><div class="cfg"><label class="cfl">Дата объявления</label><input class="cfi" value="${wt.d||''}" placeholder="ДД.ММ.ГГГГ" style="width:100px"></div><div class="cfg"><label class="cfl">Орган</label><input class="cfi" value="${wt.og||''}" style="width:200px"></div></div><div class="cfr" style="margin-top:5px;align-items:center"><span class="cfl">УК ст.</span><select class="cfi" style="min-width:200px">${UKA.map(u=>`<option value="${u.c}" ${wt.ar&&wt.ar.c===u.c?'selected':''}>${u.c} — ${u.n}</option>`).join('')}</select></div><div class="cfg" style="margin-top:7px"><label class="cfl">Данные из ФР-оповещения / Основание</label><textarea class="ka">${wt.ba||''}</textarea></div>`;}
  if(bid==='o'){const om=data||{};return hdr+`<div class="cfs">Отказ в возбуждении</div><div class="cfr"><div class="cfg"><label class="cfl">Дата</label><input class="cfi" value="${om.d||''}" placeholder="ДД.ММ.ГГГГ" style="width:100px"></div><div class="cfg"><label class="cfl">Орган</label><input class="cfi" value="${om.og||''}" style="width:200px"></div></div><div class="cfr" style="margin-top:5px;align-items:center"><span class="cfl">УК ст.</span><select class="cfi" style="width:65px">${UKA.map(u=>`<option value="${u.c}" ${om.ar&&om.ar.c===u.c?'selected':''}>${u.c}</option>`).join('')}</select></div><div class="cfs">Причина</div><div><input class="cfi" value="${om.ba||''}" placeholder="Основание отказа" style="width:100%;margin-bottom:5px"><div class="cfr" style="align-items:center"><span class="cfl">УПК ст.</span><select class="cfi" style="min-width:220px">${UPKA.map(u=>`<option value="${u.c}" ${om.uk&&om.uk.c===u.c?'selected':''}>${u.c} — ${u.n}</option>`).join('')}</select></div></div><div class="cfg" style="margin-top:7px"><label class="cfl">Данные из картотеки</label><textarea class="ka"></textarea></div><div style="margin-top:7px;display:flex;align-items:center;gap:8px"><input type="checkbox"><label class="cfl">Ещё отказной материал</label></div>`;}
  return'';}

function subChk(){
  const x=S.wo.req;const hAny=Object.values(S.wo.cr).some(Boolean);
  if(x&&(x.crs.length>0||x.pros||x.wnt||x.ref)&&!hAny){notif('Внимание','По данному сценарию есть данные. Установите галочку в нужном блоке.','warning');return;}
  S.wo.cs=true;if(x)x.rq.st='in_progress';
  log('Проверка: данные отправлены',S.wo.req?.a.fn,'success');notif('Данные отправлены','Результаты приняты. Переходите к формированию справки.','success');
  updBadges();updQ();chkAchs();renderJTab('check');
}
function subNod(){S.wo.cs=true;if(S.wo.req)S.wo.req.rq.st='in_progress';log('Проверка: Нет сведений',S.wo.req?.a.fn,'info');notif('Нет сведений','Отправлено. Переходите к формированию справки.','success');updBadges();updQ();chkAchs();renderJTab('check');}

