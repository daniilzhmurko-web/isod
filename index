// ПРОГРЕСС
// ════════════════════════════════════
function saveProgress() {
  localStorage.setItem('sed_progress', JSON.stringify({
    completedScenarios: State.completedScenarios,
    progress: State.progress
  }));
}
function loadProgress() {
  try {
    const saved = JSON.parse(localStorage.getItem('sed_progress') || '{}');
    State.completedScenarios = saved.completedScenarios || [];
    State.progress = saved.progress || {};
  } catch(e) { State.completedScenarios = []; State.progress = {}; }
}
function resetProgress() {
  if (confirm('Сбросить весь прогресс?')) {
    localStorage.removeItem('sed_progress');
    State.completedScenarios = [];
    State.progress = {};
    buildMenu();
  }
}

