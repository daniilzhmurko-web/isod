    </div>`).join('');
}

function selCTask(i){S.crisisTasks.forEach((t,j)=>t.sel=j===i);renderCrisisTasks();}
function doCrisisTask(){
  const t=S.crisisTasks.find(x=>x.sel&&!x.done);
  if(!t){notify('w','Выберите задание!','');return;}
  t.done=true;t.sel=false;renderCrisisTasks();
  scorePopup('+100',true);S.score+=100;updateHeader();
  notify('ok','Задача выполнена!',t.name);
  log(`Кризисная задача: ${t.name}`,'crisis_task');
  if(S.crisisTasks.every(x=>x.done))endCrisis();
}
function endCrisis(){
  clearInterval(S.crisisTimer);S.crisisActive=false;
  document.getElementById('crisispanel').style.display='none';
  document.getElementById('ctimer').style.display='none';
  const done=S.crisisTasks.filter(t=>t.done).length;
  const total=S.crisisTasks.length;
  const bonus=done*100;S.score+=bonus;updateHeader();
  aMsg('sys',done===total?`✅ КРИЗИС РАЗРЕШЁН! Все ${total} задачи выполнены. Бонус: +${bonus}!`:`⏰ Время вышло. Выполнено ${done}/${total}. Частичный бонус: +${bonus}.`,done===total?'ok':'warn');
  notify(done>total/2?'ok':'w',`Кризис завершён: ${done}/${total}`,`Бонус: +${bonus}`);
  log('Кризис завершён','crisis_end',{done,total,bonus});
  S.crisisTasks=[];
}

