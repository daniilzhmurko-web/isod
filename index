    addLog('success', 'Проверка по базам завершена. Противопоказаний не выявлено.');
    addAISystemMsg('Проверка по базам завершена. Нарушений не выявлено.');
    navigate('app-detail');
    showToast('Проверка завершена. Противопоказаний не выявлено.', 'success');
  }, 1800);
