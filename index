/* ══════════════════════════════════════════
   KEYBOARD SHORTCUTS TABLE
══════════════════════════════════════════ */
.shortcut-table { width: 100%; border-collapse: collapse; margin: 16px 0; }
.shortcut-table th { text-align: left; padding: 10px 14px; background: var(--bg); border-bottom: 2px solid var(--border); font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--text-muted); font-weight: 700; }
.shortcut-table td { padding: 10px 14px; border-bottom: 1px solid var(--border); font-size: 13px; color: var(--text-2); }
.shortcut-table tr:hover td { background: var(--sky); }
.shortcut-table tr:last-child td { border-bottom: none; }

/* ══════════════════════════════════════════
   NUMBERED LIST
══════════════════════════════════════════ */
.num-list { counter-reset: num; list-style: none; margin: 14px 0; }
.num-list li {
  counter-increment: num;
  padding: 10px 14px 10px 48px;
  position: relative;
  font-size: 14px; color: var(--text-2);
  line-height: 1.6;
  border-radius: var(--r);
  margin-bottom: 6px;
  background: white;
  border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
}
.num-list li::before {
  content: counter(num);
  position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
  width: 24px; height: 24px; border-radius: 50%;
  background: var(--navy); color: white;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 800;
  font-family: 'JetBrains Mono', monospace;
}
.num-list li strong { color: var(--navy); }

/* ══════════════════════════════════════════
   HIGHLIGHT CHIP
══════════════════════════════════════════ */
.chip { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 6px; font-size: 12px; font-weight: 600; }
.chip-blue { background: var(--sky); color: var(--blue); }
.chip-gold { background: var(--gold-light); color: #92400e; }
.chip-green { background: var(--green-light); color: var(--green); }
.chip-red { background: var(--red-light); color: var(--red); }

/* ══════════════════════════════════════════
   SCREEN MOCKUP
══════════════════════════════════════════ */
.screen-mockup {
  background: white; border: 1.5px solid var(--border);
  border-radius: var(--r-lg); overflow: hidden;
  margin: 20px 0; box-shadow: var(--shadow);
}
.screen-titlebar {
  background: #0f2d5c; height: 36px;
  display: flex; align-items: center; padding: 0 14px; gap: 7px;
}
.screen-dot { width: 10px; height: 10px; border-radius: 50%; }
.screen-body { padding: 16px; background: #f8fafd; min-height: 80px; }
.screen-nav-bar { background: white; height: 38px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 0; padding: 0 12px; }
.screen-nav-item { padding: 0 12px; height: 38px; display: flex; align-items: center; font-size: 11px; font-weight: 600; color: #9ca3af; cursor: default; }
.screen-nav-item.active { color: #1a4a8a; border-bottom: 2px solid #1a4a8a; }

/* ══════════════════════════════════════════
   TIPS SIDEBAR BOX
══════════════════════════════════════════ */
.tip-block {
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  border: 1px solid #bfdbfe;
  border-radius: var(--r-lg);
  padding: 20px;
  margin: 24px 0;
  position: relative;
  overflow: hidden;
}
.tip-block::before { content: '💡'; position: absolute; right: 16px; top: 12px; font-size: 40px; opacity: .15; }
.tip-block-title { font-size: 14px; font-weight: 700; color: var(--blue); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
.tip-block ul { padding-left: 18px; }
.tip-block li { font-size: 13.5px; color: #1e40af; margin-bottom: 6px; line-height: 1.6; }

/* ══════════════════════════════════════════
   STAT ROW
══════════════════════════════════════════ */
.stat-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 20px 0; }
.stat-box { background: white; border: 1px solid var(--border); border-radius: var(--r-lg); padding: 18px 14px; text-align: center; box-shadow: var(--shadow-sm); }
.stat-val { font-family: 'Playfair Display', serif; font-size: 30px; font-weight: 700; color: var(--navy); line-height: 1; margin-bottom: 6px; }
.stat-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--text-light); }

/* ══════════════════════════════════════════
   FOOTER
══════════════════════════════════════════ */
.site-footer {
  margin-left: var(--sidebar-w);
  background: var(--navy);
  color: rgba(255,255,255,.6);
  padding: 32px 48px;
  font-size: 13px;
  display: flex; align-items: center; justify-content: space-between;
}
.site-footer strong { color: white; }
.site-footer a { color: rgba(255,255,255,.7); text-decoration: none; }
.site-footer a:hover { color: white; }

/* ══════════════════════════════════════════
   ANIMATIONS
══════════════════════════════════════════ */
@keyframes fadeUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
.fade-up { animation: fadeUp .5s ease both; }
.fade-up:nth-child(1){animation-delay:.05s}
.fade-up:nth-child(2){animation-delay:.1s}
.fade-up:nth-child(3){animation-delay:.15s}
.fade-up:nth-child(4){animation-delay:.2s}
.fade-up:nth-child(5){animation-delay:.25s}
.fade-up:nth-child(6){animation-delay:.3s}

/* ══════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════ */
@media(max-width:900px){
  .sidebar{display:none}
  .main-content{margin-left:0;padding:20px}
  .module-grid{grid-template-columns:1fr}
  .stat-row{grid-template-columns:1fr 1fr}
