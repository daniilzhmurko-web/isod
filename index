function navigate(sectionId, el) {
  // убрать active у всех секций и nav-items
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  
  const sec = document.getElementById('sec-' + sectionId);
  if (sec) sec.classList.add('active');
  if (el) el.classList.add('active');
  
  STATE.currentSection = sectionId;
  
  const names = {
    dashboard:'Дашборд', topology:'Топология сети', events:'Консоль событий',
    access:'СУДИС — Доступ', antivirus:'Антивирус (KSC)', vuln:'MaxPatrol',
    ids:'ViPNet IDS', crypto:'КриптоПро / ViPNet', siem:'ArcSight SIEM',
    incident:'Реагирование на инциденты'
  };
  document.getElementById('headerSection').textContent = names[sectionId] || sectionId;
  
  checkStepValidation();
}

/* ╔══════════════════════════════════════════════════════════════
   СИСТЕМА ВКЛАДОК
══════════════════════════════════════════════════════════════╗ */
function switchTab(btn, panelId) {
  const parent = btn.closest('.panel-body') || btn.closest('section');
  parent.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  parent.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  const panel = document.getElementById(panelId);
  if (panel) panel.classList.add('active');
}

/* ╔══════════════════════════════════════════════════════════════
   ТАСКБАР — УПРАВЛЕНИЕ ЗАДАНИЯМИ
══════════════════════════════════════════════════════════════╗ */
function renderStep() {
  const step = STEPS[STATE.step];
  if (!step) return;
  
  document.getElementById('taskMissionLabel').textContent = step.mission;
  document.getElementById('taskStepCounter').textContent = `Шаг ${STATE.step + 1} из ${STATE.totalSteps}`;
  document.getElementById('taskTitle').textContent = step.title;
  document.getElementById('taskDesc').textContent = step.desc;
  document.getElementById('taskHint').innerHTML = step.hint;
  
  const pct = ((STATE.step) / STATE.totalSteps) * 100;
  document.getElementById('taskProgress').style.width = pct + '%';
  document.getElementById('taskScore').textContent = `Очки: ${STATE.score}`;
  document.getElementById('spStep').textContent = STATE.step;
  document.getElementById('spScore').textContent = STATE.score;
  document.getElementById('sidebarProgressBar').style.width = pct + '%';
  
  updateTaskStatus('pending');
  document.getElementById('btnNext').disabled = true;
  document.getElementById('btnPrev').disabled = STATE.step === 0;
  
  checkStepValidation();
}

function updateTaskStatus(status) {
  const el = document.getElementById('taskStatus');
  el.className = 'task-status ' + status;
  el.textContent = status === 'done' ? '✅ Выполнено' : status === 'failed' ? '❌ Ошибка' : '⏳ Не выполнено';
}

function checkStepValidation() {
  const step = STEPS[STATE.step];
  if (!step) return;
  const ok = step.validate();
  if (ok) {
    updateTaskStatus('done');
    document.getElementById('btnNext').disabled = false;
    if (!STATE.completedSteps.has(STATE.step)) {
      STATE.completedSteps.add(STATE.step);
      STATE.score += 100;
      document.getElementById('taskScore').textContent = `Очки: ${STATE.score}`;
      document.getElementById('spScore').textContent = STATE.score;
    }
  }
}

function nextStep() {
  if (STATE.step < STATE.totalSteps - 1) {
    STATE.step++;
    renderStep();
  } else {
    showFinalScreen();
  }
}
function prevStep() {
  if (STATE.step > 0) { STATE.step--; renderStep(); }
}

function toggleTaskbar() {
  const tb = document.getElementById('taskbar');
  tb.classList.toggle('collapsed');
  document.getElementById('taskbarToggleBtn').textContent = tb.classList.contains('collapsed') ? '▲' : '▼';
}

