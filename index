.sbl{padding:7px 15px 3px;font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.28)}
.ni{display:flex;align-items:center;gap:9px;padding:8px 15px;color:var(--ts);cursor:pointer;transition:all .15s;font-size:12.5px;border-left:3px solid transparent}
.ni:hover{background:var(--sb2);color:#fff;border-left-color:rgba(255,255,255,.2)}
