// Текущий статус квеста
let CQ = { level:0, step:0, hintCount:0, validated:false };

function getCurStep() {
  const lv = QUESTS[CQ.level];
  if (!lv) return null;
  return lv.steps[CQ.step] || null;
}

function checkStepValidation() {
  const step = getCurStep();
  if (!step || step.done) return;
  try {
    if (step.validate()) {
      if (!step.done) {
        step.done = true;
        APP.score += step.pts;
        APP.doneSteps++;
        APP.totalSteps++;
        APP.acc.total++;
        APP.acc.correct++;
        showInstStatus('ok', `✅ Шаг выполнен! +${step.pts} баллов`);
        log(`${step.title}`, 'step_done', {pts:step.pts});
        notify('ok', `+${step.pts} баллов`, step.title);
        updateHeader();
        setTimeout(() => {
          document.getElementById('inst-next-btn').disabled = false;
          renderInstSteps();
        }, 600);
      }
    }
  } catch(e) {}
}

function instNext() {
  const step = getCurStep();
  if (step && !step.done) {
    // Попробуем провалидировать ещё раз
    if (!step.validate()) {
      APP.acc.total++;
      CQ.hintCount++;
      showInstStatus('err', '❌ Шаг ещё не выполнен. Следуйте инструкции.');
      showHint(step, CQ.hintCount);
      return;
    }
  }
  
  const lv = QUESTS[CQ.level];
  if (CQ.step < lv.steps.length - 1) {
    CQ.step++;
    CQ.hintCount = 0;
    renderInst();
  } else {
    // Завершить уровень
    completeLevel();
  }
}

function instPrev() {
  if (CQ.step > 0) { CQ.step--; CQ.hintCount = 0; renderInst(); }
  else if (CQ.level > 0) { CQ.level--; CQ.step = QUESTS[CQ.level].steps.length-1; renderInst(); }
}

function instSkip() {
  const step = getCurStep();
  if (step && !step.done) { step.done = true; APP.doneSteps++; }
  instNext();
}

function completeLevel() {
  QUESTS[CQ.level].done = true;
  L.levels[CQ.level].done = true;
  notify('ok', `Уровень ${CQ.level+1} пройден!`, L.levels[CQ.level].name);
  log(`Уровень завершён: ${L.levels[CQ.level].name}`, 'level_done');
  
  if (CQ.level < QUESTS.length - 1) {
    CQ.level++;
    CQ.step = 0;
    CQ.hintCount = 0;
    L.cur = CQ.level;
    renderInst();
    renderTBLevels();
    
    // Если первый шаг входа — но мы уже на уровне 1 и выше
    if (CQ.level === 1) {
      go('inbox');
    }
  } else {
    showInstStatus('ok', '🏆 ВСЕ УРОВНИ ПРОЙДЕНЫ! Симулятор завершён.');
  }
  updateHeader();
  renderLevelProgress();
}

function showHint(step, cnt) {
  const hints = [
    step.hint,
    `Подсказка 2: ${step.desc}`,
    `Решение: ${step.hint} — нажмите или введите нужные данные для продолжения.`
  ];
  const hint = hints[Math.min(cnt-1, hints.length-1)];
  const ha = document.getElementById('inst-hint-area');
  ha.innerHTML = `<div class="inst-hint-box"><div class="inst-hint-title">💡 Подсказка ${cnt}</div><div>${hint}</div></div>`;
}

function showInstStatus(type, msg) {
  const el = document.getElementById('inst-status');
  el.style.display = 'flex';
  el.className = `inst-status ${type}`;
  el.innerHTML = `<span>${type==='ok'?'✅':type==='err'?'❌':'⏳'}</span> ${msg}`;
}

function renderInst() {
  const lv = QUESTS[CQ.level];
  if (!lv) return;
  const step = lv.steps[CQ.step];
  if (!step) return;

  document.getElementById('inst-level-badge').textContent = `Уровень ${CQ.level+1}: ${L.levels[CQ.level].name}`;
  document.getElementById('inst-task-title').textContent = `${L.levels[CQ.level].icon} Шаг ${CQ.step+1}: ${step.title}`;
  document.getElementById('inst-task-desc').textContent = step.desc;
  document.getElementById('inst-hint-area').innerHTML = APP.user.mode==='training'
    ? `<div class="inst-hint-box"><div class="inst-hint-title">💡 Подсказка</div><div>${step.hint}</div></div>` : '';
  document.getElementById('inst-status').style.display = 'none';

  // Прогресс
  const totalSteps = lv.steps.length;
  const prog = Math.round(CQ.step/totalSteps*100);
  document.getElementById('inst-prog-fill').style.width = prog+'%';
  document.getElementById('inst-prog-txt').textContent = `${CQ.step}/${totalSteps}`;

  // Кнопка далее
  document.getElementById('inst-next-btn').disabled = !step.done && APP.user.mode!=='teacher';
  
  // Кнопка пропуска (только для преподавателя)
  const skipBtn = document.getElementById('inst-skip-btn');
  skipBtn.style.display = (APP.user.mode === 'teacher' || APP.teacherMode) ? '' : 'none';
  
  renderInstSteps();
  checkStepValidation();
}

function renderInstSteps() {
  const lv = QUESTS[CQ.level];
  if (!lv) return;
  const c = document.getElementById('inst-steps');
  c.innerHTML = lv.steps.map((s,i) => `
    <div class="istep ${s.done?'done':i===CQ.step?'cur':''}" onclick="CQ.step=${i};CQ.hintCount=0;renderInst()">
      <div class="istep-num">${s.done?'✓':i+1}</div>
      <div class="istep-txt">${s.title}</div>
    </div>`).join('');
}

