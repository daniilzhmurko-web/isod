// ─── ИНИЦИАЛИЗАЦИЯ ДЕРЕВА И ПОИСКА ───
function initDirectory() {
  const tree = document.getElementById('orgTree');
  let isFirst = true;
  for (let key in orgDb) {
    const node = document.createElement('div');
    node.className = 'org-node' + (isFirst ? ' selected' : '');
    node.onclick = () => selectOrg(node, key);
    node.innerHTML = `
      <div class="org-node-inner">
        <div>
          <div class="org-node-name">${orgDb[key].name}</div>
          <div class="org-node-count">${orgDb[key].staff.length} сотрудников</div>
        </div>
        <div class="org-node-badge">➤</div>
      </div>
    `;
    tree.appendChild(node);
    if(isFirst) { selectOrg(node, key); isFirst = false; }
  }
}

function createCard(s) {
  return `
    <div class="staff-card" onclick="showToast('Профиль: ${s.n}')">
      <div class="staff-photo">👨‍💼</div>
      <div class="staff-info">
        <div class="name">${s.n}</div>
        <div class="post">${s.p}</div>
        <div class="contact">📞 Тел.: ${s.t} &nbsp;·&nbsp; 📍 Каб.: ${s.c}</div>
      </div>
    </div>
  `;
}

function selectOrg(el, key) {
  document.querySelectorAll('.org-node').forEach(n => n.classList.remove('selected'));
  if(el) el.classList.add('selected');
  document.getElementById('staffPanelTitle').textContent = orgDb[key].name + ' — Сотрудники';
  const list = document.getElementById('staffList');
  list.innerHTML = '';
  orgDb[key].staff.forEach(s => { list.innerHTML += createCard(s); });
}

function searchStaff() {
  const q = document.getElementById('staffSearch').value.toLowerCase();
  if(!q) return;
  document.querySelectorAll('.org-node').forEach(n => n.classList.remove('selected'));
  document.getElementById('staffPanelTitle').textContent = 'Результаты поиска: ' + q;
  const list = document.getElementById('staffList');
  list.innerHTML = '';
  let count = 0;
  for (let key in orgDb) {
    orgDb[key].staff.forEach(s => {
      if(s.n.toLowerCase().includes(q) || s.p.toLowerCase().includes(q) || orgDb[key].name.toLowerCase().includes(q)) {
        list.innerHTML += createCard(s);
        count++;
      }
