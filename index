/* ══════════════════════════════════════════════════════════
   ЭТАП 6 — ГРАФ СВЯЗЕЙ (Canvas)
══════════════════════════════════════════════════════════ */
let GS={drag:null,ox:0,oy:0,sel:null};

function initGraph(){
  const c=document.getElementById('graph-canvas');if(!c)return;
  const w=c.parentElement.clientWidth-33;
  c.width=w;c.height=420;
  c.addEventListener('mousedown',gmDown);
  c.addEventListener('mousemove',gmMove);
  c.addEventListener('mouseup',()=>GS.drag=null);
  c.addEventListener('click',gClick);
  drawGraph();
}

function drawGraph(){
  const c=document.getElementById('graph-canvas');if(!c)return;
  const ctx=c.getContext('2d');const w=c.width,h=c.height;
  ctx.clearRect(0,0,w,h);
  ctx.fillStyle='#f7f9fc';ctx.fillRect(0,0,w,h);
  // Grid
  ctx.strokeStyle='rgba(0,0,0,.04)';ctx.lineWidth=1;
  for(let x=0;x<w;x+=40){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke();}
  for(let y=0;y<h;y+=40){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();}
  // Рёбра
  DB.graphEdges.forEach(e=>{
    const f=DB.graphNodes.find(n=>n.id===e.from);const t=DB.graphNodes.find(n=>n.id===e.to);if(!f||!t)return;
    ctx.beginPath();ctx.moveTo(f.x,f.y);ctx.lineTo(t.x,t.y);
    ctx.strokeStyle=`rgba(100,120,160,${0.15+e.w*0.08})`;ctx.lineWidth=e.w;ctx.stroke();
    // Arrow
    const angle=Math.atan2(t.y-f.y,t.x-f.x);const al=t.r+5;
    const ax=t.x-Math.cos(angle)*al,ay=t.y-Math.sin(angle)*al;
    ctx.beginPath();ctx.moveTo(ax,ay);
    ctx.lineTo(ax-8*Math.cos(angle-0.4),ay-8*Math.sin(angle-0.4));
    ctx.lineTo(ax-8*Math.cos(angle+0.4),ay-8*Math.sin(angle+0.4));
    ctx.closePath();ctx.fillStyle='rgba(100,120,160,.3)';ctx.fill();
    const mx=(f.x+t.x)/2,my=(f.y+t.y)/2;
    ctx.fillStyle='#9ca3af';ctx.font='9px PT Sans';ctx.textAlign='center';
    ctx.fillText(e.label,mx,my-4);
  });
  // Узлы
  DB.graphNodes.forEach(n=>{
    const isSel=GS.sel?.id===n.id;
    if(n.risk>60){
      ctx.beginPath();ctx.arc(n.x,n.y,n.r+5,0,Math.PI*2);
      ctx.strokeStyle=n.risk>80?'rgba(224,36,36,.4)':'rgba(217,119,6,.35)';
      ctx.lineWidth=2;ctx.setLineDash([4,3]);ctx.stroke();ctx.setLineDash([]);
    }
    ctx.save();ctx.shadowColor='rgba(0,0,0,.15)';ctx.shadowBlur=8;
    ctx.beginPath();ctx.arc(n.x,n.y,n.r,0,Math.PI*2);
    ctx.fillStyle=n.color;ctx.fill();
    if(isSel){ctx.strokeStyle='#fff';ctx.lineWidth=3;ctx.stroke();}
    ctx.restore();
    ctx.fillStyle='#fff';ctx.font=`bold 9px PT Sans`;ctx.textAlign='center';
    const words=n.label.split(' ');
    words.forEach((w,i)=>ctx.fillText(w,n.x,n.y+(i-(words.length-1)/2)*11+1));
    ctx.fillStyle=n.risk>70?'#e02424':n.risk>40?'#d97706':'#057a55';
    ctx.font='bold 9px PT Sans';ctx.textAlign='center';
    ctx.fillText(`R:${n.risk}`,n.x,n.y+n.r+12);
  });
}

function gmDown(e){const r=e.target.getBoundingClientRect();const x=e.clientX-r.left,y=e.clientY-r.top;const n=DB.graphNodes.find(n=>Math.hypot(n.x-x,n.y-y)<=n.r+4);if(n){GS.drag=n;GS.ox=x-n.x;GS.oy=y-n.y;}}
function gmMove(e){if(!GS.drag)return;const r=e.target.getBoundingClientRect();GS.drag.x=e.clientX-r.left-GS.ox;GS.drag.y=e.clientY-r.top-GS.oy;drawGraph();}
function gClick(e){const r=e.target.getBoundingClientRect();const x=e.clientX-r.left,y=e.clientY-r.top;const n=DB.graphNodes.find(n=>Math.hypot(n.x-x,n.y-y)<=n.r+4);if(n){GS.sel=n;showNodeInfo(n);drawGraph();}}
function showNodeInfo(n){
  const c=document.getElementById('graph-info');if(!c)return;
  const rels=DB.graphEdges.filter(e=>e.from===n.id||e.to===n.id);
  c.innerHTML=`<div class="ai-ins ${n.risk>70?'danger':n.risk>40?'warn':'info'}">
    <div class="ai-ins-hd"><div class="ai-ins-tt">${n.type==='org'?'🏢':'👤'} ${n.label}</div><div class="ai-conf">Риск: ${n.risk}</div></div>
    <div class="ai-ins-tx">Тип: ${n.type==='org'?'Организация':'Физ. лицо'} · Связей: ${rels.length}<br>${rels.map(e=>{const o=DB.graphNodes.find(nd=>nd.id===(e.from===n.id?e.to:e.from));return`→ ${o?.label||'?'} (${e.label})`;}).join('<br>')}</div>
  </div>`;
}
function addNode(){const name=prompt('Введите имя объекта:');if(!name)return;const risk=ri(20,90);DB.graphNodes.push({id:Date.now(),label:name,type:rnd(['person','org']),x:ri(80,700),y:ri(60,380),risk,color:risk>70?'#e02424':risk>40?'#d97706':'#057a55',r:17+Math.floor(risk/20)});drawGraph();S.log.push({ts:Date.now(),type:'graph_add',desc:`Узел: ${name}`});checkStep();addLog(`Узел графа: ${name}`,'ok');notify('ok','Объект добавлен',name);}
function addEdge(){
  const ids=DB.graphNodes.map(n=>`${n.id}: ${n.label}`).join('\n');
  const from=parseInt(prompt(`ID «ОТ»:\n${ids}`));const to=parseInt(prompt(`ID «К»:\n${ids}`));const label=prompt('Тип связи:')||'Связан';
  if(from&&to&&from!==to){DB.graphEdges.push({from,to,label,w:ri(1,3)});drawGraph();S.log.push({ts:Date.now(),type:'graph_add',desc:'Ребро'});checkStep();addLog('Связь добавлена в граф','ok');}
}
function analyzeGraph(){
  addLog('AI-анализ графа','info');S.log.push({ts:Date.now(),type:'graph_analyze',desc:'Анализ'});checkStep();
  const hi=DB.graphNodes.filter(n=>n.risk>70);
  const c=document.getElementById('graph-info');
  setTimeout(()=>{
    if(c)c.innerHTML=`
      <div class="ai-ins danger"><div class="ai-ins-hd"><div class="ai-ins-tt">🔴 Критические узлы</div><div class="ai-conf">${hi.length} объектов</div></div><div class="ai-ins-tx">${hi.map(n=>n.label).join(', ')} — немедленная проверка.</div></div>
      <div class="ai-ins warn"><div class="ai-ins-hd"><div class="ai-ins-tt">⚠️ Кластер угроз</div><div class="ai-conf">87%</div></div><div class="ai-ins-tx">Обнаружена кластерная структура. ${ri(2,5)} объектов координируют действия — признаки ОПГ.</div><div class="ai-ins-hy">Гипотеза: организованная группа (${DB.graphNodes.length} субъектов)</div></div>
      <div class="ai-ins discover"><div class="ai-ins-hd"><div class="ai-ins-tt">🧠 Скрытые связи</div><div class="ai-conf">74%</div></div><div class="ai-ins-tx">Выявлено ${ri(2,5)} неявных связей. Вероятный офшорный канал вывода средств.</div></div>`;
    addMsg('analyst',`Анализ графа завершён. ${hi.length} критических объектов, ${ri(2,5)} скрытых связей. Рекомендую проверку кластера через СУДИС.`,'analyst');
    S.score+=40;updateHeader();spop('+40',true);
  },1500);
  notify('info','AI анализирует граф...','');
}
function resetGraph(){initGraph();notify('info','Граф сброшен','');}

