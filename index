function addEvent(type, sev, msg) {
  const now = new Date();
  const ts = now.toTimeString().slice(0,8);
  const sources = {'LOGIN_SUCCESS':'AUTH-SRV','LOGIN_FAILED':'AUTH-SRV','MALWARE':'KSC-01',
                   'IDS_ALERT':'VIPNET-IDS','PRIVILEGE':'SUDIS','CRYPTO':'VIPNET',
                   'CERT_ERROR':'PKI-CA','POLICY':'KSC-01','info':'SYSTEM'};
  const src = sources[type] || 'SYSTEM';
  STATE.eventLog.push({ time:ts, type, src, msg, sev });
  
  const con = document.getElementById('event-console');
  if (con) {
    con.innerHTML += `<div class="ec-line">
      <span class="ec-ts">${ts}</span>
      <span class="ec-src">${src}</span>
      <span class="ec-type ${type}">${type}</span>
      <span class="ec-msg">${msg}</span>
    </div>`;
    con.scrollTop = con.scrollHeight;
  }
  
  // Обновить бейджи
  const bc = document.getElementById('badgeEvents');
  if (bc) bc.textContent = STATE.eventLog.length;
  
  // Обновить ленту дашборда
  const feed = document.getElementById('dashEventFeed');
  if (feed) {
    const last5 = STATE.eventLog.slice(-5).reverse();
    feed.innerHTML = last5.map(e => `
      <div class="event-item sev-${e.sev}">
        <div class="ei-time">${e.time}</div>
        <div class="ei-type ${e.type}">${e.type}</div>
        <div class="ei-msg">${e.msg}</div>
      </div>`).join('');
  }
}

function filterEvents() {
  const filter = document.getElementById('eventFilter').value;
  const con = document.getElementById('event-console');
  if (!con) return;
  const filtered = filter ? STATE.eventLog.filter(e => e.type.includes(filter)) : STATE.eventLog;
  con.innerHTML = filtered.map(e => `
    <div class="ec-line">
      <span class="ec-ts">${e.time}</span>
      <span class="ec-src">${e.src}</span>
      <span class="ec-type ${e.type}">${e.type}</span>
      <span class="ec-msg">${e.msg}</span>
    </div>`).join('');
}

function clearEventConsole() {
  const con = document.getElementById('event-console');
  if (con) con.innerHTML = '';
}

