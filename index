.task-status {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 4px 10px; border-radius: 20px;
  font-size: 12px; font-weight: 700;
}
.task-status.pending  { background: var(--warning-light); color: var(--warning); }
.task-status.done     { background: var(--success-light); color: var(--success); }
.task-status.failed   { background: var(--danger-light);  color: var(--danger);  }

.taskbar-nav {
  display: flex; flex-direction: column; gap: 6px;
  justify-content: center; flex-shrink: 0;
}
.taskbar-nav .btn { min-width: 110px; justify-content: center; }

/* ═══════════════════════════════════════════════
