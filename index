/* ── AUTO-TESTS (Автотесты движка) ─────────────────────────── */
function runAutoTests() {
  const results = [];
  let pass = 0, fail = 0;

  function test(name, fn) {
    try { const r = fn(); results.push(`✅ PASS: ${name}`); pass++; }
    catch(e) { results.push(`❌ FAIL: ${name} — ${e.message}`); fail++; }
  }

  test('STATE: persons array exists',  () => { if (!Array.isArray(globalState.persons)) throw new Error('not array'); });
  test('STATE: weapons array exists',  () => { if (!Array.isArray(globalState.weapons)) throw new Error('not array'); });
  test('QUEST: missions loaded',        () => { if (MISSIONS.length < 6) throw new Error('< 6 missions'); });
  test('QUEST: each mission has steps', () => { MISSIONS.forEach((m,i) => { if (!m.steps?.length) throw new Error(`mission ${i} empty`); }); });
  test('SCORE: getAccuracy returns 100 on fresh state', () => {
    const prev = { ta: globalState.totalActions, ca: globalState.correctActions };
    globalState.totalActions = 0; globalState.correctActions = 0;
    const r = getAccuracy();
    globalState.totalActions = prev.ta; globalState.correctActions = prev.ca;
    if (r !== 100) throw new Error('expected 100');
  });
  test('ROLES: all 3 roles defined', () => { ['operator','inspector','admin'].forEach(r => { if (!ROLES[r]) throw new Error('missing ' + r); }); });
  test('QUIZ: questions array has 8+', () => { if (QUIZ_QUESTIONS.length < 8) throw new Error('< 8 q'); });
  test('DUPLICATE: weapon serial check', () => {
    const prev = globalState.weapons.length;
    const dup = globalState.weapons[0]?.serial;
    if (dup && globalState.weapons.filter(w => w.serial === dup).length > 1) throw new Error('duplicates allowed!');
  });
  test('LOG: addLog creates entry', () => {
    const before = globalState.logs.length;
    addLog('info', '__autotest__');
    if (globalState.logs.length !== before + 1) throw new Error('log entry not added');
    globalState.logs.shift();
  });
  test('BUILDER: builderState.cases array', () => { if (!Array.isArray(builderState.cases)) throw new Error('not array'); });

  console.groupCollapsed('%c🧪 СЦУО AutoTest Results', 'color:#1B3A6B;font-weight:bold;font-size:14px');
  results.forEach(r => console.log(r));
  console.log(`\n📊 Итог: ${pass} passed, ${fail} failed из ${results.length} тестов`);
  console.groupEnd();

  return { pass, fail, total: results.length };
}

// Запуск автотестов после инициализации
setTimeout(() => {
  const r = runAutoTests();
  if (r.fail > 0) {
    console.warn(`⚠ СЦУО: ${r.fail} автотест(ов) не пройдено`);
  } else {
    console.log('%c✅ Все автотесты пройдены!', 'color:#27AE60;font-weight:bold');
  }
