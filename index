.toc-sep{width:1px;height:20px;background:var(--bdr);flex-shrink:0;margin:0 4px}

/* ── КОНТЕНТ ── */
.main{max-width:1100px;margin:0 auto;padding:40px 32px 80px}
.section{margin-bottom:64px;scroll-margin-top:70px}
.sec-badge{display:inline-flex;align-items:center;gap:8px;background:var(--primary);color:#fff;font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;padding:4px 14px;border-radius:20px;margin-bottom:16px}
.sec-title{font-size:clamp(22px,3vw,32px);font-weight:900;color:var(--text);margin-bottom:8px;line-height:1.2}
.sec-sub{font-size:14px;color:var(--sec);margin-bottom:28px;max-width:700px}

/* ── КАРТОЧКИ ── */
.card{background:var(--card);border-radius:16px;border:1px solid var(--bdr);box-shadow:var(--sh);overflow:hidden;margin-bottom:20px}
.card-h{padding:20px 24px;border-bottom:1px solid var(--bdrl);display:flex;align-items:center;gap:14px}
.card-ico{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.card-t{font-size:16px;font-weight:800;color:var(--text)}
.card-s{font-size:12px;color:var(--muted);margin-top:2px}
.card-b{padding:24px}

/* ── ШАГИ ── */
.steps{display:flex;flex-direction:column;gap:0}
.step{display:flex;gap:20px;padding:20px 0;border-bottom:1px solid var(--bdrl);position:relative}
.step:last-child{border-bottom:none}
.step-num{
  width:40px;height:40px;min-width:40px;
  background:var(--primary);color:#fff;
  border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-size:16px;font-weight:900;flex-shrink:0;
  box-shadow:0 4px 12px rgba(21,101,192,.35);
  font-family:"JetBrains Mono",monospace;
}
.step-content{flex:1;padding-top:6px}
.step-title{font-size:15px;font-weight:800;color:var(--text);margin-bottom:6px}
.step-desc{font-size:13.5px;color:var(--sec);line-height:1.7}
.step-tip{margin-top:10px;padding:10px 14px;background:#e3f0ff;border-left:3px solid var(--primary);border-radius:0 8px 8px 0;font-size:12.5px;color:var(--info);display:flex;gap:8px;align-items:flex-start}
.step-warn{margin-top:10px;padding:10px 14px;background:#fff3e0;border-left:3px solid var(--warning);border-radius:0 8px 8px 0;font-size:12.5px;color:var(--warning);display:flex;gap:8px}
.step-success{margin-top:10px;padding:10px 14px;background:#e8f5e9;border-left:3px solid var(--success);border-radius:0 8px 8px 0;font-size:12.5px;color:var(--success);display:flex;gap:8px}

/* ── МОДУЛЬНАЯ СЕТКА ── */
.mod-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
.mod-card{background:var(--card);border-radius:14px;border:1.5px solid var(--bdrl);padding:20px;transition:all .2s;cursor:default}
.mod-card:hover{border-color:var(--primary);box-shadow:var(--sh);transform:translateY(-2px)}
.mod-ico{font-size:28px;margin-bottom:12px}
.mod-name{font-size:14px;font-weight:800;color:var(--text);margin-bottom:6px}
.mod-path{display:inline-flex;align-items:center;gap:5px;background:var(--bdrl);color:var(--sec);font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;margin-bottom:8px;font-family:"JetBrains Mono",monospace}
.mod-desc{font-size:12.5px;color:var(--sec);line-height:1.6}
.mod-hot{margin-top:8px;font-size:11px;color:var(--muted)}

/* ── ГОРЯЧИЕ КЛАВИШИ ── */
.hotkeys{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px}
.hk{display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--card);border-radius:10px;border:1px solid var(--bdrl)}
kbd{background:var(--navy);color:var(--gold);font-family:"JetBrains Mono",monospace;font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:6px;border-bottom:2px solid rgba(0,0,0,.3);white-space:nowrap}
.hk-desc{font-size:13px;color:var(--sec);font-weight:500}

/* ── WORKFLOW ── */
.flow{display:flex;flex-wrap:wrap;gap:0;align-items:center;margin:20px 0}
.flow-step{background:var(--card);border:2px solid var(--primary);border-radius:12px;padding:14px 18px;text-align:center;min-width:120px;flex:1}
.flow-step-n{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--primary);margin-bottom:4px}
.flow-step-t{font-size:13px;font-weight:800;color:var(--text)}
.flow-step-s{font-size:11px;color:var(--muted);margin-top:3px}
.flow-arrow{font-size:22px;color:var(--primary);padding:0 6px;flex-shrink:0}

/* ── ДОСТИЖЕНИЯ ПРЕВЬЮ ── */
.ach-preview{display:flex;flex-wrap:wrap;gap:10px}
.ach-chip{display:flex;align-items:center;gap:8px;background:var(--card);border:1.5px solid var(--bdrl);border-radius:30px;padding:6px 14px;font-size:12.5px;font-weight:600;color:var(--sec);transition:all .2s}
.ach-chip:hover{border-color:var(--gold);color:#8a6d00;background:rgba(200,168,75,.08)}
.ach-chip span{font-size:16px}

/* ── BADGE ── */
.bdg{display:inline-flex;align-items:center;gap:4px;padding:2px 10px;border-radius:20px;font-size:11.5px;font-weight:700}
.bdg-b{background:#e3f0ff;color:var(--primary)}
.bdg-g{background:#e8f5e9;color:var(--success)}
.bdg-o{background:#fff3e0;color:var(--warning)}
.bdg-r{background:#ffebee;color:var(--danger)}
.bdg-v{background:rgba(200,168,75,.12);color:#8a6d00}

/* ── ТАБЛИЦА ── */
.tbl{width:100%;border-collapse:collapse;font-size:13px}
.tbl thead th{background:var(--navy);color:#fff;padding:10px 16px;text-align:left;font-size:11px;font-weight:700;letter-spacing:.8px;text-transform:uppercase}
.tbl thead th:first-child{border-radius:8px 0 0 0}
.tbl thead th:last-child{border-radius:0 8px 0 0}
.tbl tbody td{padding:11px 16px;border-bottom:1px solid var(--bdrl);vertical-align:middle}
.tbl tbody tr:hover td{background:var(--bdrl)}
.tbl tbody tr:last-child td{border-bottom:none}

/* ── АЛЕРТЫ ── */
.al{padding:14px 18px;border-radius:10px;display:flex;align-items:flex-start;gap:12px;font-size:13.5px;margin-bottom:16px}
.al i{margin-top:2px;flex-shrink:0}
.al-info{background:#e3f0ff;border:1px solid rgba(1,87,155,.15);color:var(--info)}
.al-warn{background:#fff3e0;border:1px solid rgba(239,108,0,.15);color:var(--warning)}
.al-success{background:#e8f5e9;border:1px solid rgba(46,125,50,.15);color:var(--success)}
.al-danger{background:#ffebee;border:1px solid rgba(198,40,40,.15);color:var(--danger)}

/* ── МИССИИ СХЕМА ── */
.mission-map{background:var(--navy);border-radius:16px;padding:24px;color:#fff}
.mm-row{display:flex;gap:12px;align-items:stretch;margin-bottom:16px;flex-wrap:wrap}
.mm-box{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:14px;flex:1;min-width:160px}
.mm-num{font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:6px;font-family:"JetBrains Mono",monospace}
.mm-title{font-size:13.5px;font-weight:800;margin-bottom:4px}
.mm-desc{font-size:11.5px;opacity:.6;line-height:1.5}
.mm-xp{display:inline-block;margin-top:8px;background:rgba(200,168,75,.2);color:var(--gold);font-size:10.5px;font-weight:700;padding:2px 10px;border-radius:20px}
.mm-arrow{display:flex;align-items:center;justify-content:center;font-size:22px;opacity:.4;padding:0 4px;align-self:center}

/* ── РАНГИ ── */
.ranks{display:flex;flex-direction:column;gap:8px}
.rank-row{display:flex;align-items:center;gap:12px;padding:10px 16px;background:var(--card);border-radius:10px;border:1.5px solid var(--bdrl)}
.rank-ico{font-size:22px;width:36px;text-align:center}
.rank-name{font-size:13.5px;font-weight:700;flex:1}
.rank-xp{font-family:"JetBrains Mono",monospace;font-size:12px;color:var(--muted)}

/* ── ФИКСИРОВАННЫЙ НАЗАД-ВВЕРХ ── */
.back-top{position:fixed;bottom:28px;right:28px;width:44px;height:44px;background:var(--primary);color:#fff;border:none;border-radius:50%;font-size:18px;cursor:pointer;box-shadow:var(--sh);transition:all .2s;display:flex;align-items:center;justify-content:center;z-index:50}
.back-top:hover{transform:translateY(-3px);box-shadow:var(--sh-lg)}

/* ── ФУТЕР ── */
.footer{background:var(--navy);color:rgba(255,255,255,.5);text-align:center;padding:32px;font-size:12.5px}
.footer strong{color:var(--gold)}

/* ── АНИМАЦИИ ── */
@keyframes fadeInUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.hero-inner>*{animation:fadeInUp .6s ease both}
.hero-inner>*:nth-child(1){animation-delay:.1s}
.hero-inner>*:nth-child(2){animation-delay:.2s}
.hero-inner>*:nth-child(3){animation-delay:.3s}
.hero-inner>*:nth-child(4){animation-delay:.4s}

/* ── ПРИНТ ── */
@media print{.toc-sticky,.back-top{display:none}.hero{print-color-adjust:exact}}
@media(max-width:768px){.hero-inner{padding:40px 20px 28px}.main{padding:28px 20px 60px}.mod-grid{grid-template-columns:1fr}.flow{flex-direction:column}.flow-arrow{transform:rotate(90deg)}.hotkeys{grid-template-columns:1fr}}
</style>
