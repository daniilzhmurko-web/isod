// ГЛОБАЛЬНОЕ ХРАНИЛИЩЕ ГРАФИКОВ
// ═══════════════════════════════════════════════════════
const _charts = {};

function destroyChart(id) {
  if (_charts[id]) {
    _charts[id].destroy();
    delete _charts[id];
  }
}

function destroyAllCharts() {
  Object.keys(_charts).forEach(function(id) {
    _charts[id].destroy();
    delete _charts[id];
  });
}

// ═══════════════════════════════════════════════════════
// АВТОРИЗАЦИЯ
// ═══════════════════════════════════════════════════════
const ROLES = {
  admin:{name:'Иванов И.И.',label:'Администратор',cls:'role-admin'},
  operator:{name:'Петров А.С.',label:'Оператор',cls:'role-operator'},
  user:{name:'Сидорова Е.В.',label:'Пользователь',cls:'role-user'}
};

function doLogin() {
  const role = document.getElementById('login-role').value;
  State.currentRole = role;
  State.currentUser = ROLES[role];
  State.sessionStart = Date.now();
  document.getElementById('login-screen').style.display = 'none';
  document.getElementById('app').classList.add('visible');
  document.getElementById('hdr-username').textContent = State.currentUser.name;
  const badge = document.getElementById('hdr-role-badge');
  badge.textContent = State.currentUser.label;
  badge.className = 'header-role-badge ' + State.currentUser.cls;
  applyRoleUI();
  addAudit('Вход в систему', 'Пользователь ' + State.currentUser.name + ' авторизован как «' + State.currentUser.label + '»');
  State.flags.loggedIn = true;
  openModule('dashboard');
  startSessionTimer();
  questSetStep(0);
  showNotif('✅ Добро пожаловать в СОШП! Квест-система активирована.','success');
}

function doLogout() {
  addAudit('Выход','Пользователь '+State.currentUser.name+' завершил сессию');
  destroyAllCharts();
  document.getElementById('app').classList.remove('visible');
  document.getElementById('login-screen').style.display='flex';
}

function applyRoleUI() {
  const adminSec = document.getElementById('admin-nav-section');
  const tbAdmin = document.getElementById('tb-admin');
  const show = State.currentRole==='admin';
  if(adminSec) adminSec.style.display = show?'':'none';
  if(tbAdmin) tbAdmin.style.display = show?'':'none';
}

let _sessionInterval;
function startSessionTimer() {
  _sessionInterval = setInterval(function(){
    const s=Math.floor((Date.now()-State.sessionStart)/1000);
    document.getElementById('session-time').textContent=String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
  },1000);
}

function canEdit(){return State.currentRole==='admin'||State.currentRole==='operator';}

