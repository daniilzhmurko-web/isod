.toc-logo {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  color: var(--blue);
  white-space: nowrap;
  padding: 14px 16px 14px 0;
  border-right: 1px solid var(--border);
  margin-right: 8px;
}
.toc-link {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 14px 10px;
  font-size: 12px;
  font-weight: 500;
  color: var(--ink-soft);
  text-decoration: none;
  white-space: nowrap;
  border-bottom: 2px solid transparent;
  transition: all .2s;
}
.toc-link:hover { color: var(--blue); border-bottom-color: var(--blue); }
.toc-link.active { color: var(--blue); border-bottom-color: var(--blue); font-weight: 600; }
.toc-link .tl-num {
  width: 18px; height: 18px;
  background: var(--blue);
  color: #fff;
  border-radius: 50%;
  font-size: 10px;
