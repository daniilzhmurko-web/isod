// Раскрытие/закрытие шагов
function toggleStep(header) {
  const card = header.closest('.step-card');
  card.classList.toggle('open');
}

// FAQ
function toggleFaq(q) {
  const item = q.closest('.faq-item');
  item.classList.toggle('open');
}

// Активная ссылка в навигации
const sections = document.querySelectorAll('section[id]');
const tocLinks = document.querySelectorAll('.toc-link');

const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      tocLinks.forEach(l => l.classList.remove('active'));
      const link = document.querySelector(`.toc-link[href="#${entry.target.id}"]`);
      if (link) link.classList.add('active');
    }
  });
}, { rootMargin: '-20% 0px -70% 0px' });

sections.forEach(s => observer.observe(s));

// Открыть первый шаг каждой секции автоматически
document.querySelectorAll('.steps-list').forEach(list => {
  const first = list.querySelector('.step-card:first-child');
  if (first && !first.classList.contains('open')) {
    first.classList.add('open');
  }
});

// Плавное появление при скролле
const fadeEls = document.querySelectorAll('.step-card, .scenario-card, .ach-card, .tip-card');
const fadeObs = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.style.opacity = '1';
      e.target.style.transform = 'translateY(0)';
    }
  });
}, { threshold: 0.1 });

fadeEls.forEach(el => {
  el.style.opacity = '0';
  el.style.transform = 'translateY(12px)';
  el.style.transition = 'opacity .4s ease, transform .4s ease';
  fadeObs.observe(el);
});
</script>
