// ScenarioEngine
// ════════════════════════════════════
const Engine={
  all:null,steps:null,idx:0,scId:0,waiting:false,_cur:null,

  load(id){
    Nav.init();
    this.scId=id;this.all=buildScenarios(State.region);
    this.steps=this.all[id];
    if(!this.steps){console.error('No scenario',id);return;}
    this.idx=0;this.waiting=false;this._run();
  },

  _run(){
    if(this.idx>=this.steps.length){this._complete();return;}
    const s=this.steps[this.idx];
    if(s.quiz&&!s._qd){s._qd=true;showQuiz(s.quiz,()=>this._activate(s));}
    else this._activate(s);
  },

  _activate(s){
    // Проверить pending user change из буфера
    if (s.action === 'change' && window._pendingUserChange) {
      const pval = window._pendingUserChange;
      window._pendingUserChange = null;
      this.waiting = true;
      this._cur = s;
      // Обновить UI подсказок
      document.getElementById('instr-step-num').textContent=`Шаг ${this.idx+1} из ${this.steps.length}`;
      document.getElementById('instr-title').textContent=s.title;
      document.getElementById('instr-text').textContent=s.text;
      document.getElementById('sim-step-counter').textContent=`Шаг ${this.idx+1} из ${this.steps.length}`;
      // Применить буферизованный change сразу
      setTimeout(() => this.hit('change', document.getElementById('sed-user-dropdown'), pval), 50);
      return;
    }
    document.getElementById('instr-step-num').textContent=`Шаг ${this.idx+1} из ${this.steps.length}`;
    document.getElementById('instr-title').textContent=s.title;
    document.getElementById('instr-text').textContent=s.text;
    document.getElementById('instr-hint').textContent='💡 '+s.hint;
    document.getElementById('instr-hint').style.display='none';
    document.getElementById('btn-show-hint').style.display='inline-block';
    document.getElementById('sim-step-counter').textContent=`Шаг ${this.idx+1} из ${this.steps.length}`;
    document.getElementById('theory-title').textContent=s.title;
    document.getElementById('theory-text').textContent=s.theory||'';
    document.getElementById('theory-norm').textContent=s.norm||'';
    this._dots();this._next();
    Nav.activate(s.target);
    this.waiting=true;this._cur=s;
  },

  hit(type,el,val){
    if(!this.waiting||!this._cur)return;
    const s=this._cur;
    if(s.action!==type)return;
    if(type==='change'&&s.targetValue&&val!==s.targetValue){
      // Мягкое предупреждение при неверном выборе пользователя — не блокировать
      const r = State.region;
      const correctUser = r && r.users[s.targetValue];
      const correctName = correctUser ? correctUser.name : s.targetValue;
      showToast('⚠️ Выберите: ' + correctName + ' (не текущего пользователя!)');
      State.errors++;
      addScoreEvent('Неверный выбор пользователя', -1);
      return;  // Ждём правильного выбора
    }
    if(type==='click'){
      const t=s.target?document.querySelector(s.target):null;
      if(t){
        // Принять клик если: e.target = кнопка, ИЛИ e.target внутри кнопки,
        // ИЛИ координаты клика попали в rect кнопки (защита от stacking context)
        const rect=t.getBoundingClientRect();
        const lastClick=Engine._lastClick||{clientX:-999,clientY:-999};
        const inRect=(lastClick.clientX>=rect.left&&lastClick.clientX<=rect.right&&
                      lastClick.clientY>=rect.top&&lastClick.clientY<=rect.bottom);
        if(el!==t&&!t.contains(el)&&!inRect){Nav.wrong();return;}
      }
    }
    this._ok();
  },

  _ok(){
    this.waiting=false;Nav.clear();
    showToast('✅ Верно! Переходим к следующему шагу.','success');
    addScoreEvent('Шаг выполнен',+3);
    const prevStep = this._cur;
    this.idx++;
    // Для шага показа dropdown — запустить следующий шаг быстро (200ms вместо 900)
    const isUserStep = prevStep && prevStep.target === '#sed-username';
    setTimeout(()=>this._run(), isUserStep ? 150 : 900);
  },

  _dots(){
    const el=document.getElementById('steps-dots'),n=this.steps.length;
