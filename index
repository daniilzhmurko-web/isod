  },

  _next(){
    const el=document.getElementById('next-steps-list');
    el.innerHTML=this.steps.slice(this.idx,this.idx+4).map((s,i)=>`<div class="next-step-item ${i===0?'upcoming':''}"><div class="next-step-num">${this.idx+i+1}</div><span>${s.title}</span></div>`).join('');
  },

  _complete(){
    clearInterval(State.timerInterval);
    if(!State.completedScenarios.includes(this.scId))State.completedScenarios.push(this.scId);
    const stars=State.errors<=2&&State.hints===0?3:State.errors<=5?2:1;
    State.progress['sc'+this.scId]={stars,errors:State.errors,hints:State.hints,time:State.elapsedSeconds};
