// ════════════════════════════════════
// УТИЛИТЫ
// ════════════════════════════════════
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function showToast(msg, type = 'error') {
  const el = document.getElementById(type === 'success' ? 'success-toast' : 'error-toast');
  el.textContent = msg;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 3000);
}

function switchRTab(name, el) {
  document.querySelectorAll('.rtab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.rpanel').forEach(p => p.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('rpanel-' + name).classList.add('active');
}

function switchCardTab(tab, e) {
  e.preventDefault();
  ['info','res','control'].forEach(t => {
    document.getElementById('card-tab-'+t).style.display = t === tab ? 'block' : 'none';
    document.getElementById('card-link-'+t).classList.toggle('active', t === tab);
  });
}

function toggleUserDropdown() {
  const dd = document.getElementById('sed-user-dropdown');
  // Если Engine ждёт смены пользователя — всегда показать
  const forceShow = Engine.waiting && Engine._cur &&
    (Engine._cur.action === 'click' && Engine._cur.target === '#sed-username');
  if (forceShow) {
    dd.style.display = 'block';
  } else {
    dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
  }
}

function switchUser(val) {
  if (!val || !State.region) return;
  const u = State.region.users[val];
  if (!u) return;
  document.getElementById('sed-username').textContent = u.name;
  document.getElementById('sed-userrole').textContent = u.rank;
  document.getElementById('sed-avatar').textContent = u.avatar;
  document.getElementById('sed-operator').textContent = u.name;
  document.getElementById('sim-operator-name').textContent = u.name;
  document.getElementById('sed-user-dropdown').style.display = 'none';
  // Триггер для движка теперь в отдельном event listener с буферизацией (sed-user-dropdown listener)
}

