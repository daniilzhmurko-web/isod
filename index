    const curLvInfo = document.getElementById('cur-level-info');
    if (!curLvInfo) return;
    
    let tip = '';
    if (CQ.level === 0) tip = '🔐 Вы на этапе авторизации. Введите логин и пароль для входа.';
    else if (CQ.level === 1) tip = '🗂️ Изучите интерфейс. Попробуйте открыть разные папки.';
    else if (CQ.level === 2) tip = '📥 Работа с входящими. Открывайте, читайте, удаляйте письма.';
    else if (CQ.level === 3) tip = '✏️ Напишите деловое письмо. Используйте корректный адрес.';
    else if (CQ.level === 4) tip = '📎 Добавьте вложение через адресную книгу.';
    else if (CQ.level === 5) tip = '🛡️ Научитесь распознавать спам и фишинг.';
    else if (CQ.level === 6) tip = '⚙️ Создайте правило автоматической обработки.';
    else if (CQ.level === 7) tip = '🗓️ Используйте календарь и задачи для планирования.';
    else tip = '🏆 Финальный экзамен. Примените все навыки!';
    
    if (acc < 0.5 && APP.acc.total > 5) tip += '\n\n💡 Совет: читайте инструкции внимательнее.';
    if (acc > 0.9 && APP.acc.total > 5) tip += '\n\n⚡ Отличная работа! Продолжайте в том же темпе.';
    
    curLvInfo.textContent = tip;
  }
};

