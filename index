// ═══════════════════ AUTH ═══════════════════════════════

function doLogin(){
  const loginEl=document.getElementById('loginInput');
  const passEl=document.getElementById('passInput');
  const roleEl=document.getElementById('roleSelect');
  const errEl=document.getElementById('authError');
  if(!loginEl||!passEl||!roleEl)return;

  const login=loginEl.value.trim();
  const pass=passEl.value.trim();
  const role=roleEl.value;

  if(login!=='kadry_officer_01'||pass!=='Mvd@2025'){
    STATE._loginFails++;
    errEl.classList.add('show');
    if(STATE._loginFails>=3){
      errEl.innerHTML='<i class="fas fa-lock"></i>&nbsp;Учётная запись заблокирована (3 неудачных попытки).';
    }
    return;
  }

  errEl.classList.remove('show');
  STATE.user={login,role};
  STATE.startTime=Date.now();
  completeMission(1);

  const roleNames={
    officer:'Сотрудник кадрового подразделения',
    admin:'Администратор СОКД',
    nsi:'Администратор НСИ',
    chief:'Руководитель'
  };
  const el1=document.getElementById('userName');
  const el2=document.getElementById('userRole');
  if(el1)el1.textContent='Козлов О.В.';
  if(el2)el2.textContent=roleNames[role]||role;

  document.getElementById('authScreen').style.display='none';
  document.getElementById('appScreen').style.display='block';

  initData();
  renderAll();
  updateUI();
  startClock();
  setCurrentDate();
  showToast('Добро пожаловать в СОКД ИСОД МВД России!','success');
  setTimeout(()=>showToast('Миссия 2 — перейдите в «Реестр сотрудников»','info'),1800);
}

function doLogout(){
  if(confirm('Выйти из системы?')){
    document.getElementById('authScreen').style.display='flex';
    document.getElementById('appScreen').style.display='none';
  }
}

function togglePass(){
  const p=document.getElementById('passInput');
  const i=document.getElementById('passToggle');
  p.type=p.type==='password'?'text':'password';
  if(i)i.className=p.type==='password'?'fas fa-eye input-group-icon':'fas fa-eye-slash input-group-icon';
}

// ═══════════════════ CLOCK ══════════════════════════════

function startClock(){
  setInterval(()=>{
    const n=new Date();
    const h=n.getHours().toString().padStart(2,'0');
    const m=n.getMinutes().toString().padStart(2,'0');
    const s=n.getSeconds().toString().padStart(2,'0');
    const el=document.getElementById('headerClock');
    if(el)el.textContent=`${h}:${m}:${s}`;
    if(STATE.startTime){
      const el2=Math.floor((Date.now()-STATE.startTime)/1000);
      const em=Math.floor(el2/60).toString().padStart(2,'0');
      const es=(el2%60).toString().padStart(2,'0');
      ['smpTime','mtTime2'].forEach(id=>{const e=document.getElementById(id);if(e)e.textContent=`${em}:${es}`;});
    }
  },1000);
}

function setCurrentDate(){
  const d=new Date();
  const el=document.getElementById('currentDateDisplay');
  if(el)el.textContent=d.toLocaleDateString('ru-RU',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
  const today=dateInput(d);
  ['eld_service_date','idc_issue_date','ord_date','repFrom','repTo'].forEach(id=>{
    const e=document.getElementById(id);if(e)e.value=today;
  });
  const ce=new Date(d);ce.setFullYear(ce.getFullYear()+5);
  const e1=document.getElementById('eld_contract_end');if(e1)e1.value=dateInput(ce);
  const e2=document.getElementById('idc_expiry');if(e2)e2.value=dateInput(ce);
}

// ═══════════════════ MISSIONS ═══════════════════════════

function completeMission(mNum){
  if(STATE.missions[mNum-1])return;
  STATE.missions[mNum-1]=true;
  STATE.missionsDone=STATE.missions.filter(Boolean).length;
  const pts=MISSIONS[mNum-1].points;
  STATE.score+=pts;
  updateUI();
  renderMissionTracker();
  updateInstructionPanel();
  updateExamUI();
  showToast(`✓ Миссия ${mNum} выполнена! +${pts} очков`,'success');
  if(mNum===1){
    const al=document.getElementById('mission1Alert');
    if(al){al.style.display='flex';setTimeout(()=>al.style.display='none',5000);}
  }
}

function updateUI(){
  const done=STATE.missionsDone;
  const pct=Math.round((done/16)*100);
  ['headerScore','mtScore'].forEach(id=>{const e=document.getElementById(id);if(e)e.textContent=STATE.score;});
  const hm=document.getElementById('headerMission');if(hm)hm.textContent=`${done}/16`;
  ['smpDone','smpScore'].forEach((id,i)=>{
    const e=document.getElementById(id);if(e)e.textContent=i===0?done:STATE.score;
  });
  const mp=document.getElementById('mtPercent');if(mp)mp.textContent=pct+'%';
  const bar=document.getElementById('smpBar');if(bar)bar.style.width=pct+'%';
  const nextM=STATE.missions.findIndex(m=>!m);
  if(nextM>=0&&nextM<16){
    const hmb=document.getElementById('headerMissionBadge');
    if(hmb)hmb.textContent=`Миссия ${nextM+1}: ${MISSIONS[nextM].title}`;
  }
}

