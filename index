<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ВИСП — Ведомственный информационно-справочный портал МВД России</title>
<link href="https://fonts.googleapis.com/css2?family=PT+Sans:ital,wght@0,400;0,700;1,400&family=PT+Serif:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --blue-dark: #1a3a6b;
    --blue-mid: #1e5799;
    --blue-light: #2980b9;
    --blue-pale: #d6e8f5;
    --gold: #c9a227;
    --gold-light: #f0c040;
    --text: #1c2b3a;
    --text-light: #5a6a7a;
    --white: #ffffff;
    --bg: #f0f4f8;
    --border: #c8d8e8;
    --red: #c0392b;
    --green: #27ae60;
    --orange: #e67e22;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'PT Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  header {
    background: linear-gradient(135deg, var(--blue-dark) 0%, var(--blue-mid) 60%, var(--blue-light) 100%);
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    box-shadow: 0 3px 12px rgba(0,0,0,.35);
    position: sticky;
    top: 0;
    z-index: 200;
  }

  .header-left { display: flex; align-items: center; gap: 16px; }
  
  .emblem { 
    width: 44px; 
    height: 44px; 
    flex-shrink: 0; 
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4));
  }
  
  .portal-title { line-height: 1.2; }
  .portal-title .main { font-size: 15px; font-weight: 700; color: var(--white); letter-spacing: .3px; text-transform: uppercase; }
  .portal-title .sub { font-size: 10px; color: rgba(255,255,255,.65); text-transform: uppercase; letter-spacing: 1.2px; }

  .header-right { display: flex; align-items: center; gap: 18px; }
  .user-badge { display: flex; align-items: center; gap: 8px; color: var(--white); font-size: 13px; cursor: pointer; padding: 6px 10px; border-radius: 6px; transition: background .2s; }
  .user-badge:hover { background: rgba(255,255,255,.12); }
  .user-avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--gold); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; color: var(--blue-dark); }
  .btn-logout { background: none; border: 1px solid rgba(255,255,255,.4); color: var(--white); padding: 5px 10px; border-radius: 5px; cursor: pointer; font-size: 12px; transition: background .2s; }
  .btn-logout:hover { background: rgba(255,255,255,.15); }

  nav { background: var(--white); border-bottom: 2px solid var(--blue-pale); display: flex; align-items: stretch; padding: 0 24px; box-shadow: 0 2px 6px rgba(0,0,0,.08); }
  .nav-item { display: flex; align-items: center; gap: 8px; padding: 0 20px; height: 50px; cursor: pointer; font-size: 13px; font-weight: 700; color: var(--text-light); border-bottom: 3px solid transparent; transition: all .2s; white-space: nowrap; user-select: none; }
  .nav-item:hover { color: var(--blue-mid); background: var(--blue-pale); }
  .nav-item.active { color: var(--blue-mid); border-bottom-color: var(--gold); background: linear-gradient(to bottom, transparent, var(--blue-pale)); }
  .nav-icon { font-size: 16px; }

  .nav-search { margin-left: auto; display: flex; align-items: center; gap: 8px; padding: 0 12px; }
  .nav-search input { border: 1px solid var(--border); border-radius: 20px; padding: 6px 14px; font-size: 12px; width: 180px; font-family: inherit; outline: none; transition: border-color .2s, width .3s; }
  .nav-search input:focus { border-color: var(--blue-light); width: 220px; }
  .btn-search { background: var(--blue-mid); color: white; border: none; padding: 6px 14px; border-radius: 20px; cursor: pointer; font-size: 12px; font-family: inherit; transition: background .2s; }
  .btn-search:hover { background: var(--blue-dark); }

  main { flex: 1; padding: 28px 32px; max-width: 1400px; margin: 0 auto; width: 100%; }
  .section { display: none; animation: fadeIn .25s ease; }
  .section.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  .breadcrumb { font-size: 12px; color: var(--text-light); margin-bottom: 20px; display: flex; gap: 6px; align-items: center; }
  .breadcrumb a { color: var(--blue-light); cursor: pointer; text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb .sep { color: var(--border); }

  .page-title { font-family: 'PT Serif', serif; font-size: 20px; font-weight: 700; color: var(--blue-dark); letter-spacing: .3px; margin-bottom: 24px; padding-bottom: 12px; border-bottom: 2px solid var(--gold); display: inline-block; }

  .org-layout { display: grid; grid-template-columns: 360px 1fr; gap: 24px; align-items: start; }
  
  .org-tree { background: var(--white); border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,.07); max-height: 75vh; overflow-y: auto; }
  .org-tree-header { background: linear-gradient(90deg, var(--blue-dark), var(--blue-mid)); color: white; padding: 12px 16px; display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 700; position: sticky; top: 0; z-index: 10; }
  .org-node { border-bottom: 1px solid var(--blue-pale); cursor: pointer; transition: background .15s; }
  .org-node:hover { background: var(--blue-pale); }
  .org-node.selected { background: var(--blue-pale); border-left: 3px solid var(--gold); }
  .org-node-inner { padding: 10px 16px; display: flex; align-items: center; justify-content: space-between; }
  .org-node-name { font-size: 13px; font-weight: 600; color: var(--blue-mid); }
  .org-node-count { font-size: 11px; color: var(--text-light); }
  .org-node-badge { background: var(--blue-mid); color: white; width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; flex-shrink: 0; }

  .staff-panel { background: var(--white); border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,.07); padding: 20px; max-height: 75vh; overflow-y: auto; position: relative;}
  .staff-panel-title { font-size: 14px; font-weight: 700; color: var(--blue-dark); margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid var(--border); position: sticky; top: -20px; background: #fff; z-index: 10; padding-top: 20px; }
  .staff-card { display: flex; gap: 14px; padding: 12px; border-radius: 6px; border: 1px solid var(--border); margin-bottom: 10px; transition: border-color .2s, box-shadow .2s; cursor: pointer; }
  .staff-card:hover { border-color: var(--blue-light); box-shadow: 0 2px 10px rgba(30,87,153,.12); }
  .staff-photo { width: 52px; height: 52px; border-radius: 6px; background: var(--blue-pale); display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; overflow: hidden; }
  .staff-info .name { font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 2px; }
  .staff-info .post { font-size: 12px; color: var(--text-light); margin-bottom: 4px; }
  .staff-info .contact { font-size: 12px; color: var(--blue-light); }

  .search-bar { background: var(--white); border-radius: 8px; padding: 16px; box-shadow: 0 2px 8px rgba(0,0,0,.07); margin-bottom: 20px; display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; }
  .search-bar input { border: 1px solid var(--border); border-radius: 5px; padding: 8px 12px; font-size: 13px; font-family: inherit; outline: none; flex: 1; min-width: 120px; transition: border-color .2s; }
  .search-bar input:focus { border-color: var(--blue-light); }
  .btn-primary { background: linear-gradient(135deg, var(--blue-mid), var(--blue-dark)); color: white; border: none; padding: 8px 20px; border-radius: 5px; cursor: pointer; font-size: 13px; font-family: inherit; font-weight: 700; transition: opacity .2s, transform .1s; white-space: nowrap; }
  .btn-primary:hover { opacity: .9; }
  .btn-primary:active { transform: scale(.97); }
  .btn-secondary { background: var(--white); color: var(--blue-mid); border: 1px solid var(--blue-mid); padding: 8px 18px; border-radius: 5px; cursor: pointer; font-size: 13px; font-family: inherit; font-weight: 600; transition: background .2s; }
  .btn-secondary:hover { background: var(--blue-pale); }

  .news-layout { display: grid; grid-template-columns: 1fr 260px; gap: 24px; }
  .tabs { display: flex; gap: 0; margin-bottom: 20px; border-bottom: 2px solid var(--border); }
  .tab { padding: 10px 20px; cursor: pointer; font-size: 13px; font-weight: 600; color: var(--text-light); border-bottom: 2px solid transparent; margin-bottom: -2px; transition: color .2s, border-color .2s; }
  .tab:hover { color: var(--blue-mid); }
  .tab.active { color: var(--blue-mid); border-bottom-color: var(--gold); }
  .news-card { background: var(--white); border-radius: 8px; padding: 16px; margin-bottom: 12px; box-shadow: 0 2px 6px rgba(0,0,0,.06); display: flex; gap: 14px; cursor: pointer; transition: box-shadow .2s; border-left: 4px solid transparent; }
  .news-card:hover { box-shadow: 0 4px 14px rgba(0,0,0,.1); border-left-color: var(--blue-light); }
  .news-thumb { width: 90px; height: 66px; border-radius: 5px; background: var(--blue-pale); flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 28px; overflow: hidden; }
  .news-title { font-size: 13px; font-weight: 700; color: var(--blue-mid); margin-bottom: 6px; }
  .news-excerpt { font-size: 12px; color: var(--text-light); line-height: 1.5; }
  .news-date { font-size: 11px; color: var(--text-light); margin-top: 8px; }
  .news-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
  .tag { background: var(--blue-pale); color: var(--blue-mid); font-size: 10px; padding: 2px 8px; border-radius: 10px; font-weight: 600; }
  .mini-calendar { background: var(--white); border-radius: 8px; padding: 16px; box-shadow: 0 2px 6px rgba(0,0,0,.06); }
  .cal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; font-size: 13px; font-weight: 700; color: var(--blue-dark); }
  .cal-nav { background: none; border: none; cursor: pointer; color: var(--blue-mid); font-size: 16px; padding: 2px 6px; border-radius: 4px; }
  .cal-nav:hover { background: var(--blue-pale); }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
  .cal-day-name { text-align: center; font-size: 10px; font-weight: 700; color: var(--text-light); padding: 4px 0; }
  .cal-day { text-align: center; font-size: 12px; padding: 5px 2px; border-radius: 4px; cursor: pointer; transition: background .15s; color: var(--text); }
  .cal-day:hover { background: var(--blue-pale); }
  .cal-day.today { background: var(--blue-mid); color: white; font-weight: 700; border-radius: 50%; }
  .cal-day.has-event { position: relative; font-weight: 700; color: var(--blue-mid); }
  .cal-day.has-event::after { content: ''; position: absolute; bottom: 1px; left: 50%; transform: translateX(-50%); width: 4px; height: 4px; background: var(--gold); border-radius: 50%; }
  .cal-day.other-month { color: var(--border); }

  .services-intro { background: var(--white); border-radius: 8px; padding: 16px 20px; margin-bottom: 20px; box-shadow: 0 2px 6px rgba(0,0,0,.06); font-size: 13px; color: var(--text-light); border-left: 4px solid var(--gold); }
  .services-section-title { font-size: 12px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; margin: 20px 0 12px; padding-bottom: 6px; border-bottom: 1px solid var(--border); }
  .services-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; margin-bottom: 24px; }
  .service-card { background: var(--white); border-radius: 10px; padding: 20px 16px; box-shadow: 0 2px 8px rgba(0,0,0,.07); cursor: pointer; transition: box-shadow .2s, transform .2s, border-color .2s; border: 1.5px solid var(--border); position: relative; display: flex; flex-direction: column; gap: 10px; }
  .service-card:hover { box-shadow: 0 6px 20px rgba(30,87,153,.15); transform: translateY(-2px); border-color: var(--blue-light); }
  .service-card-icon { width: 46px; height: 46px; border-radius: 10px; background: var(--blue-pale); display: flex; align-items: center; justify-content: center; font-size: 22px; }
  .service-card-name { font-size: 15px; font-weight: 700; color: var(--blue-dark); }
  .service-card-desc { font-size: 12px; color: var(--text-light); line-height: 1.5; flex: 1; }
  .service-card-status { display: flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; }
  .status-dot.ok { background: var(--green); }
  .status-dot.warn { background: var(--orange); }
  .status-dot.err { background: var(--red); }
  .service-card-actions { display: flex; gap: 8px; flex-wrap: nowrap; margin-top: 5px; }
  .btn-sm { padding: 6px 12px; font-size: 11px; border-radius: 4px; cursor: pointer; font-family: inherit; font-weight: 700; text-transform: uppercase; transition: all .15s; border: none; white-space: nowrap; }
  .btn-sm.primary { background: var(--blue-mid); color: white; border: none; }
  .btn-sm.primary:hover { background: var(--blue-dark); }
  .btn-sm.outline { background: var(--bg); color: var(--blue-mid); border: 1px solid var(--border); }
  .btn-sm.outline:hover { background: var(--blue-pale); border-color: var(--blue-light);}
  .btn-sm.instr { 
  background: var(--green); 
  color: white; 
  border: 1px solid var(--green); 
}
.btn-sm.instr:hover { 
  background: #219a52; 
  border-color: #219a52;
}

  .warning-banner { background: #fff8e1; border: 1px solid #ffe082; border-radius: 6px; padding: 10px 14px; font-size: 12px; color: #7a5800; margin-bottom: 16px; display: flex; gap: 8px; align-items: flex-start; }

  .qa-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 24px; }
  .qa-category { background: var(--white); border-radius: 8px; padding: 16px; box-shadow: 0 2px 6px rgba(0,0,0,.06); border-top: 3px solid var(--blue-mid); }
  .qa-cat-header { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .qa-cat-icon { width: 36px; height: 36px; border-radius: 8px; background: var(--blue-pale); display: flex; align-items: center; justify-content: center; font-size: 16px; }
  .qa-cat-name { font-size: 13px; font-weight: 700; color: var(--blue-dark); }
  .qa-item { font-size: 12px; color: var(--blue-light); cursor: pointer; padding: 4px 0; border-bottom: 1px dashed var(--border); transition: color .15s; }
  .qa-item:last-child { border-bottom: none; }
  .qa-item:hover { color: var(--blue-dark); }
  .qa-more { font-size: 11px; color: var(--blue-mid); cursor: pointer; margin-top: 8px; font-weight: 600; }

  .modal-overlay { position: fixed; inset: 0; background: rgba(10,25,50,.6); backdrop-filter: blur(4px); z-index: 1000; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity .25s; }
  .modal-overlay.open { opacity: 1; pointer-events: all; }
  .modal { background: var(--white); border-radius: 12px; width: 90%; max-width: 900px; max-height: 88vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,.35); transform: scale(.95) translateY(20px); transition: transform .25s; overflow: hidden; }
  .modal-overlay.open .modal { transform: scale(1) translateY(0); }
  .modal-header { background: linear-gradient(135deg, var(--blue-dark), var(--blue-mid)); padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
  .modal-title { color: white; font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 10px; }
  .modal-close { background: rgba(255,255,255,.2); border: none; color: white; width: 30px; height: 30px; border-radius: 50%; cursor: pointer; font-size: 16px; display: flex; align-items: center; justify-content: center; transition: background .2s; }
  .modal-close:hover { background: rgba(255,255,255,.35); }
  .modal-tabs { display: flex; background: var(--bg); border-bottom: 1px solid var(--border); flex-shrink: 0; }
  .modal-tab { padding: 10px 20px; cursor: pointer; font-size: 13px; font-weight: 600; color: var(--text-light); border-bottom: 2px solid transparent; margin-bottom: -1px; transition: color .2s; }
  .modal-tab:hover { color: var(--blue-mid); }
  .modal-tab.active { color: var(--blue-mid); border-bottom-color: var(--gold); background: white; }
  .modal-body { flex: 1; overflow-y: auto; padding: 20px; }

  .simulator-zone { border: 2px dashed var(--border); border-radius: 8px; min-height: 380px; position: relative; overflow: hidden; transition: border-color .2s; }
  .simulator-zone:hover { border-color: var(--blue-light); }
  .simulator-zone iframe { width: 100%; height: 100%; min-height: 380px; border: none; border-radius: 6px; }
  .sim-placeholder { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 24px; text-align: center; }
  .sim-placeholder-icon { font-size: 52px; opacity: .35; }
  .sim-placeholder-text { font-size: 14px; color: var(--text-light); max-width: 360px; line-height: 1.6; }
  .sim-input-area { margin-top: 16px; display: flex; flex-direction: column; gap: 10px; }
  .sim-input-area label { font-size: 12px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: .8px; }
  .sim-input-area textarea { border: 1px solid var(--border); border-radius: 6px; padding: 10px; font-size: 12px; font-family: 'Courier New', monospace; resize: vertical; min-height: 90px; outline: none; transition: border-color .2s; background: #f8fbff; }
  .sim-input-area textarea:focus { border-color: var(--blue-light); }
  .sim-input-area input[type=url] { border: 1px solid var(--border); border-radius: 6px; padding: 9px 12px; font-size: 13px; font-family: inherit; outline: none; transition: border-color .2s; }
  .sim-input-area input[type=url]:focus { border-color: var(--blue-light); }
  .sim-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .sim-divider { text-align: center; color: var(--text-light); font-size: 12px; font-weight: 600; position: relative; margin: 10px 0; }
  .sim-divider::before, .sim-divider::after { content: ''; position: absolute; top: 50%; width: 42%; height: 1px; background: var(--border); }
  .sim-divider::before { left: 0; }
  .sim-divider::after { right: 0; }

  #ph-overlay { display: none; position: fixed; inset: 0; background: rgba(10, 25, 50, 0.85); backdrop-filter: blur(5px); z-index: 9999; align-items: center; justify-content: center; padding: 20px; }
  #ph-overlay.on { display: flex; }
  .ph-box { background: var(--white); border-radius: 12px; width: 100%; max-width: 540px; padding: 36px; text-align: center; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.4); }
  .ph-close-btn { position: absolute; top: 12px; right: 12px; width: 30px; height: 30px; background: var(--bg); border: 1px solid var(--border); border-radius: 6px; color: var(--text-light); font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .2s; }
  .ph-close-btn:hover { background: #ffebee; color: var(--red); border-color: #ffcdd2; }
  .ph-ico { font-size: 48px; opacity: 0.8; margin-bottom: 14px; }
  .ph-ttl { font-size: 16px; font-weight: 700; color: var(--blue-dark); text-transform: uppercase; margin-bottom: 10px; }
  .ph-msg { font-size: 13px; color: var(--text-light); line-height: 1.6; margin-bottom: 18px; }
  .ph-code { display: block; margin: 10px auto; padding: 10px 14px; background: var(--bg); border: 1px dashed var(--blue-light); border-radius: 6px; color: var(--blue-dark); font-family: monospace; font-size: 13px; font-weight: 700; text-align: center; }

  .profile-layout { display: grid; grid-template-columns: 240px 1fr; gap: 24px; }
  .profile-sidebar { background: var(--white); border-radius: 8px; padding: 20px; box-shadow: 0 2px 6px rgba(0,0,0,.06); align-self: start; }
  .profile-avatar-big { width: 90px; height: 90px; border-radius: 50%; background: linear-gradient(135deg, var(--blue-pale), var(--blue-mid)); margin: 0 auto 14px; display: flex; align-items: center; justify-content: center; font-size: 36px; border: 3px solid var(--gold); }
  .profile-name { text-align: center; font-size: 14px; font-weight: 700; color: var(--blue-dark); margin-bottom: 4px; }
  .profile-dept { text-align: center; font-size: 11px; color: var(--text-light); margin-bottom: 16px; }
  .profile-menu-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 6px; cursor: pointer; font-size: 13px; color: var(--text-light); transition: background .15s, color .15s; }
  .profile-menu-item:hover { background: var(--blue-pale); color: var(--blue-mid); }
  .profile-menu-item.active { background: var(--blue-pale); color: var(--blue-mid); font-weight: 700; }
  .profile-content { background: var(--white); border-radius: 8px; padding: 24px; box-shadow: 0 2px 6px rgba(0,0,0,.06); }
  .field-row { margin-bottom: 16px; }
  .field-label { font-size: 11px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: .8px; margin-bottom: 4px; }
  .field-value { font-size: 14px; color: var(--text); }
  .field-value a { color: var(--blue-light); }

  footer { background: var(--blue-dark); color: rgba(255,255,255,.5); font-size: 11px; padding: 12px 32px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; }
  footer a { color: rgba(255,255,255,.6); text-decoration: none; }
  footer a:hover { color: white; }
  .notif-badge { background: var(--red); color: white; font-size: 9px; font-weight: 700; padding: 1px 5px; border-radius: 8px; position: relative; top: -1px; }

  @media (max-width: 900px) {
    .org-layout, .news-layout, .profile-layout { grid-template-columns: 1fr; }
    .qa-grid { grid-template-columns: 1fr 1fr; }
    main { padding: 16px; }
    .service-card-actions { flex-wrap: wrap; }
    .btn-sm { padding: 6px 10px; font-size: 10px; }
  }
  @media (max-width: 600px) {
    .qa-grid { grid-template-columns: 1fr; }
    .nav-item span.nav-label { display: none; }
  }

