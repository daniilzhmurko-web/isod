  el.setAttribute('data-tooltip', labels[i] || '');
});

// 2. Переключение вкладок правой панели — обновлять теорию
const origSwitchRTab = window.switchRTab;
window.switchRTab = function(name, el) {
  origSwitchRTab(name, el);
  if (name === 'theory' && Engine._cur) {
    document.getElementById('theory-title').textContent = Engine._cur.title || 'Теория';
    document.getElementById('theory-text').textContent  = Engine._cur.theory || '';
    document.getElementById('theory-norm').textContent  = Engine._cur.norm  || '';
  }
};

// 3. Кнопка «?» в СЭД — показывает справку
document.getElementById('sed-help-btn').addEventListener('click', () => {
  if (Engine.waiting && Engine._cur?.target === '#sed-help-btn') return; // обработает Engine
  showToast('💡 Нажмите на выделенный элемент для продолжения!', 'success');
});

// 4. Обновлять live-статистику каждые 5с
setInterval(() => {
  if (document.getElementById('screen-simulator').classList.contains('active')) {
    document.getElementById('stat-correct').textContent = Engine.idx || 0;
    document.getElementById('stat-errors').textContent = State.errors || 0;
    document.getElementById('stat-hints').textContent  = State.hints  || 0;
    document.getElementById('stat-traps').textContent  = State.trapsFail || 0;
    document.getElementById('stat-traps-ok').textContent = State.trapsOk || 0;
    document.getElementById('live-score').textContent  = Math.max(0, State.score);
  }
}, 5000);

// 5. Resize — обновить spotlight при изменении размера окна
window.addEventListener('resize', () => {
  if (Engine.waiting && Engine._cur?.target) {
    Nav.activate(Engine._cur.target);
  }
});

// 6. Клавиша Escape — показать подсказку
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && Engine.waiting) {
    showHint();
  }
  if (e.key === 'F1') {
    e.preventDefault();
    window.switchRTab('theory', document.querySelector('.rtab:nth-child(3)'));
  }
});

// 7. «+» кнопка симуляция создания документа
window.onNewDocClick = () => {
  Engine.hit('click', document.getElementById('btn-new-doc'), null);
  // Показать симуляцию формы
  if (Engine._cur?.id === 's23' || Engine._cur?.id === 's62') {
    setTimeout(() => {
      showToast('📋 Форма регистрации входящего документа открыта. Заполните реквизиты.', 'success');
    }, 400);
  }
};

// 8. Обновить папку processed при утверждении
const origApprove = window.onApproveClick;
window.onApproveClick = () => {
  origApprove && origApprove();
  // Визуально переместить документ
  setTimeout(() => {
    const badge = document.getElementById('badge-approval');
    if (badge) {
      const cur = parseInt(badge.textContent) || 1;
      if (cur > 0) badge.textContent = cur - 1;
      if (cur - 1 === 0) badge.style.display = 'none';
    }
    const procBadge = document.getElementById('badge-processed');
    if (procBadge) {
      procBadge.style.display = 'inline-block';
      procBadge.textContent = (parseInt(procBadge.textContent) || 0) + 1;
    }
  }, 1200);
};

// 9. Кнопка «Ознакомлен» — краткая анимация
window.onAcknowledgedClick = () => {
  Engine.hit('click', document.getElementById('btn-acknowledged'), null);
  const btn = document.getElementById('btn-acknowledged');
  if (btn) {
    btn.textContent = '✓ Ознакомлен';
    btn.style.background = '#E8F5EE';
    btn.style.color = '#1B7A3E';
    btn.style.borderColor = '#1B7A3E';
  }
};

// 10. Статус-бар — обновлять сценарий
setInterval(() => {
  if (Engine.scId) {
    const sc = SCENARIO_META?.find(s => s.id === Engine.scId);
    if (sc) document.getElementById('statusbar-scenario').textContent = `Сц.${Engine.scId}: ${sc.title}`;
  }
}, 2000);


