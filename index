// StepNavigator
// ════════════════════════════════════
const Nav={
  init(){this.svm=document.getElementById('svm');this.sr=document.getElementById('sring');this.ar=document.getElementById('ptr-arrow');this.lk=document.getElementById('ui-lock');},
  activate(sel){
    let el=sel?document.querySelector(sel):null;
    if(!el){this.clear();return;}
    // Если элемент скрыт — найти ближайший видимый предок
    let targetEl = el;
    if(el.offsetParent===null && el.id==='sed-user-dropdown'){
      targetEl = document.querySelector('.sed-user-block') || el.parentElement || el;
    }
    const r=targetEl.getBoundingClientRect(),pad=8;
    const W=window.innerWidth,H=window.innerHeight;
    this.svm.style.display='block';
    this.svm.innerHTML=`<defs><mask id="smask"><rect width="${W}" height="${H}" fill="white"/><rect x="${r.left-pad}" y="${r.top-pad}" width="${r.width+pad*2}" height="${r.height+pad*2}" rx="6" fill="black"/></mask></defs><rect width="${W}" height="${H}" fill="rgba(0,30,80,0.46)" mask="url(#smask)"/>`;
    this.sr.style.cssText=`display:block;left:${r.left-pad}px;top:${r.top-pad}px;width:${r.width+pad*2}px;height:${r.height+pad*2}px;`;
    const ax=r.left+r.width/2,ay=Math.max(r.top-48,60);
    this.ar.style.cssText=`display:block;left:${ax}px;top:${ay}px;`;
    this.lk.style.display='block';
    // z-index не работает из-за stacking context (.sim-left overflow:hidden)
    // Вместо этого — блокировка через document capture listener
    this._lt=el;
    this._ltRect = el.getBoundingClientRect(); // запомнить rect для проверки кликов
  },
  clear(){
    ['svm','sr','ar','lk'].forEach(k=>{if(this[k])this[k].style.display='none';});
    if(this._lt){this._lt=null;}
    this._ltRect=null;
  },
  wrong(){
    this.sr.style.borderColor='#C0392B';
    showToast('Нажмите на выделенный элемент!');
    setTimeout(()=>{this.sr.style.borderColor='#FFB800';},600);
    State.errors++;addScoreEvent('Неверный клик',-1);
  }
};

