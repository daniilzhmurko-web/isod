  setTimeout(()=>document.getElementById('c-to')?.focus(),100);
}

function closeCompose() {
  APP.composeOpen = false;
  document.getElementById('m-compose').classList.add('hide');
}

function saveDraft() {
  const draft = {
    id: Date.now(), from: APP.user.login+'@mvd.ru', fromName: APP.user.name,
    subj: document.getElementById('c-subj').value || '(Без темы)',
    body: document.getElementById('c-body').value,
    to: document.getElementById('c-to').value,
    date: new Date().toLocaleDateString('ru-RU'), unread: false,
    important: false, folder: 'drafts', attachments: [...APP.attachments], tags: []
  };
  DB.emails.push(draft);
  document.getElementById('mn-draft-badge').style.display = '';
  document.getElementById('mn-draft-badge').textContent = DB.emails.filter(m=>m.folder==='drafts').length;
  closeCompose();
