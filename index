function renderDocuments(docs, folder) {
  State.currentFolder = folder;
  const list = document.getElementById('doc-list');
  const titles = {
    approval: 'Утверждение исполнения', inwork: 'В работе',
    agreement: 'На согласование', control: 'На контроле',
    processed: 'Обработанные', registered: 'Зарегистрированные'
  };
  document.getElementById('sed-folder-title').textContent = `Документы:: ${titles[folder] || folder}`;

  // Выделить активную папку
  document.querySelectorAll('.folder-item').forEach(fi => fi.classList.remove('active'));
  const fEl = document.getElementById('folder-' + folder);
  if (fEl) fEl.classList.add('active');

  if (!docs || docs.length === 0) {
    list.innerHTML = '<div style="padding:24px;text-align:center;color:#6C757D;font-size:13px;">Документов не найдено</div>';
    document.getElementById('found-count').textContent = 'Найдено: 0';
    return;
  }
  document.getElementById('found-count').textContent = `Найдено: ${docs.length}`;
  list.innerHTML = docs.map((d, i) => `
    <div class="doc-row" id="doc-row-${i}" onclick="selectDocument(${i});if(Engine&&Engine.waiting&&Engine._cur&&(Engine._cur.target==='#doc-row-0'||Engine._cur.target==='#doc-row-${i}'||Engine._cur.target==='.doc-row'||Engine._cur.target==='.document-row'))Engine.hit('click',document.getElementById('doc-row-${i}'),null);">
      <div class="doc-check">✓</div>
      <div class="doc-info">
        <div class="doc-number">${d.number} от ${d.date}</div>
        <div class="doc-author">${d.from}</div>
        <div class="doc-subject">${d.subject}</div>
      </div>
      <div class="doc-right">
        <span class="doc-badge ${d.urgency === 'Срочно' ? 'urgent' : 'new'}">${d.urgency === 'Срочно' ? 'Срочно' : 'Новый'}</span>
        ${d.grift === 'Секретно' || d.grift === 'Для служебного пользования' ? `<span class="doc-badge dsp">${d.grift}</span>` : ''}
        <div class="doc-copy">1 📋</div>
      </div>
    </div>
  `).join('');
}

// Хранилище документов по папкам
if(!State.folderDocs) State.folderDocs = {};

function selectFolder(folder) {
  if (!State.region) return;
  let docs = [];
  if (folder === 'approval') {
    docs = State.region.docs;
  } else if (folder === 'processed') {
    docs = State.folderDocs['processed'] || [];
  } else if (folder === 'inwork') {
    docs = State.folderDocs['inwork'] || State.region.docs.slice(0,1);
  } else if (folder === 'agreement') {
    docs = State.folderDocs['agreement'] || State.region.docs.slice(0,1);
  } else if (folder === 'registered') {
    docs = State.folderDocs['registered'] || [];
  } else {
    docs = [];
  }
  renderDocuments(docs, folder);
  document.getElementById('doc-card').classList.add('hidden');
  State.selectedDoc = null;
  if (typeof onFolderClick === 'function') onFolderClick(folder);
}

function selectDocument(index) {
  if (!State.region) return;
  // Прямой вызов Engine для шагов 'click on doc-row'
  if (Engine && Engine.waiting && Engine._cur &&
      Engine._cur.action === 'click' &&
      (Engine._cur.target === '#doc-row-0' || Engine._cur.target === '.doc-row' ||
       Engine._cur.target === '#document-row-0' || Engine._cur.target === '.document-row')) {
    setTimeout(() => Engine.hit('click', document.getElementById('doc-row-'+index), null), 50);
  }
  const doc = State.region.docs[index];
  if (!doc) return;
  State.selectedDoc = doc;

  document.querySelectorAll('.doc-row').forEach((r,i) => r.classList.toggle('selected', i === index));
  document.getElementById('doc-card').classList.remove('hidden');

  // Заполнить карточку
  document.getElementById('card-doc-num').textContent = `${doc.number} от ${doc.date} < >`;
  document.getElementById('card-type').textContent = doc.type;
  document.getElementById('card-regnum').textContent = doc.number;
  document.getElementById('card-date').textContent = doc.date;
  document.getElementById('card-from').textContent = doc.from;
  document.getElementById('card-subject').textContent = doc.subject;
  document.getElementById('card-grift').textContent = doc.grift || 'Несекретно';
  document.getElementById('card-urgency').textContent = doc.urgency || 'Обычный';

  const r = State.region;
  document.getElementById('res-author').textContent = r.users.boss.name;
  document.getElementById('res-text').textContent = 'Подготовить проект и доложить до ' + getDeadlineDate();
  document.getElementById('res-dates').textContent = getResDate() + '   ' + r.users.exec.name;

  // Маршрут
  document.getElementById('route-executors').innerHTML = `
    <div class="route-event"><div class="route-event-dot green"></div><span class="route-event-date">${doc.date} 09:20</span><span class="route-event-text"> На редактировании</span></div>
    <div class="route-event"><div class="route-event-dot green"></div><span class="route-event-date">${doc.date} 09:22</span><span class="route-event-text"> Отправлен по маршруту</span></div>
  `;
  document.getElementById('route-signers').innerHTML = `
    <div class="route-event"><div class="route-event-dot green"></div><span class="route-event-date">${doc.date} 09:25</span><span class="route-event-text"> На подписании</span></div>
    <div class="route-event"><div class="route-event-dot green"></div><span class="route-event-date">${doc.date} 09:25</span><span class="route-event-text"> Подписано</span></div>
  `;
  document.getElementById('route-addressees').innerHTML = `
    <div class="route-event"><div class="route-event-dot orange"></div><span class="route-event-text" style="color:#C8860A;font-weight:600;"> К отправке</span></div>
  `;

  switchCardTab('info', { preventDefault: ()=>{} });
  if (typeof onDocumentClick === 'function') onDocumentClick(index, doc);
}

function getDeadlineDate() {
  const d = new Date(); d.setDate(d.getDate() + 10);
  return d.toLocaleDateString('ru-RU');
}
function getResDate() {
  const d = new Date(); d.setDate(d.getDate() - 30);
  return d.toLocaleDateString('ru-RU');
}

