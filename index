}
.diagram-dot { width: 10px; height: 10px; border-radius: 50%; }
.diagram-dot.r { background: #EF4444; }
.diagram-dot.y { background: #F59E0B; }
.diagram-dot.g { background: #10B981; }
.diagram-title { color: rgba(255,255,255,0.5); font-size: 12px; margin-left: 8px; font-family: var(--font-mono); }
.diagram-body {
