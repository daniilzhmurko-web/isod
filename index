.notif-t{font-weight:700;margin-bottom:2px;font-size:12px}

/* ── ANIMATIONS ── */
@keyframes fuUp{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}
@keyframes fuR{from{opacity:0;transform:translateX(7px)}to{opacity:1;transform:translateX(0)}}
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--br2);border-radius:10px}
