}


// ════════════════════════════════════
// Wire-up: перехват кликов
// ════════════════════════════════════
document.addEventListener('click',function(e){
  Engine._lastClick={clientX:e.clientX,clientY:e.clientY};
  if(!Engine.waiting)return;
  const step=Engine._cur;
  if(!step)return;
  // Проверяем попал ли клик в зону целевого элемента
  const target=step.target?document.querySelector(step.target):null;
  if(target){
    const rect=target.getBoundingClientRect();
    const inTarget=(e.clientX>=rect.left&&e.clientX<=rect.right&&
                    e.clientY>=rect.top&&e.clientY<=rect.bottom);
    if(!inTarget){
      // Клик вне цели — предотвратить действие и показать ошибку
      e.preventDefault();e.stopPropagation();
      Nav.wrong();
      return;
    }
    // Клик в цели — передать в Engine
    if(step.action==='click') Engine.hit('click',e.target,null);
  }
},true);
document.addEventListener('change',function(e){
  if(!Engine.waiting)return;
  Engine.hit('change',e.target,e.target.value);
},true);
document.addEventListener('input',function(e){
  if(!Engine.waiting||Engine._cur?.action!=='input')return;
  clearTimeout(Engine._it);Engine._it=setTimeout(()=>Engine._ok(),1400);
});

