.mp-bm{display:flex;align-items:center;gap:10px;flex-shrink:0}
.mp-bs{font-size:11px;color:rgba(255,255,255,.5)}
.mp-pr{width:90px;height:5px;background:rgba(255,255,255,.15);border-radius:3px;overflow:hidden}
.mp-pf{height:100%;border-radius:3px;background:var(--mvd-gold);transition:width .6s ease}
.mp-bx{font-size:11px;font-weight:700;color:var(--mvd-gold)}
.mp-tg{color:rgba(255,255,255,.4);font-size:12px;transition:transform var(--tr)}
