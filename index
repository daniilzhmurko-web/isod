function addXP(amount,msg){
  appState.xp+=amount;appState.stats.totalActions++;
  const pct=Math.min(100,(appState.xp/appState.xpToNextLevel)*100);
  const bar=document.getElementById('xpBar');const disp=document.getElementById('xpDisplay');
  if(bar) bar.style.width=pct+'%';if(disp) disp.textContent=appState.xp+' XP';
  if(appState.xp>=appState.xpToNextLevel){
    appState.level++;appState.xp-=appState.xpToNextLevel;appState.xpToNextLevel=Math.round(appState.xpToNextLevel*1.5);
    const lvl=document.getElementById('levelDisplay');if(lvl) lvl.textContent='Ур.'+appState.level;
    showLevelUp();
  }
  if(msg) showToast('⭐ +'+amount+' XP',msg,'xp');
}

function showLevelUp(){
  const p=document.createElement('div');
  p.className='xp-popup';
  p.innerHTML=`<div style="font-size:52px;font-weight:900">⬆️</div><div style="font-size:16px;opacity:.9;margin-top:6px">УРОВЕНЬ ${appState.level}!</div>`;
  document.body.appendChild(p);
  setTimeout(()=>{p.style.opacity='0';p.style.transition='opacity .3s';setTimeout(()=>p.remove(),300);},2200);
}

function unlockAchievement(id){
  if(!appState.achievements.includes(id)){
    appState.achievements.push(id);
    const a=achievementsList.find(x=>x.id===id);
    if(a) showToast(a.icon+' Достижение разблокировано!',a.name+' — '+a.desc,'xp');
    const nc=document.getElementById('notifCount');
    if(nc){appState.notifications.push(a?.name||id);nc.textContent=appState.notifications.length;nc.classList.remove('hidden');}
  }
}

function logAction(type,detail,module){
  const t=new Date().toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
  appState.logs.push({time:t,action:type,detail,module});
  if(appState.logs.length>200) appState.logs.shift();
}

function showToast(title,body,type='info'){
  const icons={success:'✅',warn:'⚠️',danger:'❌',info:'ℹ️',xp:'⭐'};
  const c=document.getElementById('toastContainer');
  const t=document.createElement('div');
  t.className='toast '+type;
  t.innerHTML=`<div style="font-size:18px;flex-shrink:0">${icons[type]||'ℹ️'}</div><div><div class="toast-title">${title}</div><div class="toast-body">${body}</div></div>`;
  c.appendChild(t);
  setTimeout(()=>{t.style.opacity='0';t.style.transform='translateX(20px)';t.style.transition='all .3s';setTimeout(()=>t.remove(),300);},3500);
}

function openModal(title,body,buttons=[]){
  document.getElementById('modalTitle').textContent=title;
  document.getElementById('modalBody').innerHTML=body;
  document.getElementById('modalFooter').innerHTML=buttons.map((b,i)=>`<button class="btn ${b.cls}" id="mb${i}">${b.label}</button>`).join('');
  document.getElementById('modalOverlay').classList.remove('hidden');
  buttons.forEach((b,i)=>{const el=document.getElementById('mb'+i);if(el) el.onclick=b.action;});
}

