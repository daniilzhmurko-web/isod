function instrReply(q){
  const ql=q.toLowerCase();
  if(ql.includes('тс')||ql.includes('автомобил')||ql.includes('vin')||ql.includes('номер'))return rnd(INSTR.vehicles);
  if(ql.includes('права')||ql.includes('удостовер')||ql.includes('ву'))return rnd(INSTR.licenses);
  if(ql.includes('штраф')||ql.includes('нарушен')||ql.includes('коап'))return rnd(INSTR.violations);
  if(ql.includes('мошен')||ql.includes('фрод')||ql.includes('поддел'))return rnd(INSTR.fraud);
  return rnd(INSTR.def);
}

