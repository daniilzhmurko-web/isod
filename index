}
.role-login span { color: var(--muted); }

/* ── SCORE SYSTEM ────────────────────────────── */
.score-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 24px 0; }
.score-tile {
  background: var(--white); border: 1px solid var(--border);
  border-radius: 10px; padding: 18px; text-align: center;
}
.score-tile .val {
  font-family: var(--font-mono); font-size: 28px; font-weight: 700;
  margin-bottom: 4px;
}
.score-tile .label { font-size: 11px; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
.score-tile.plus .val  { color: #15803D; }
.score-tile.minus .val { color: var(--crimson); }
.score-tile.info .val  { color: var(--navy-mid); }
.score-tile.gold .val  { color: var(--gold); }

/* ── FAQ ─────────────────────────────────────── */
.faq-item { border: 1px solid var(--border); border-radius: 10px; margin-bottom: 10px; overflow: hidden; }
.faq-q {
  padding: 16px 20px; font-weight: 600; font-size: 14px; color: var(--navy);
  cursor: pointer; display: flex; align-items: center; justify-content: space-between;
  background: var(--white); transition: background 0.15s;
}
.faq-q:hover { background: var(--step-bg); }
.faq-q .faq-icon { font-size: 16px; color: var(--muted); transition: transform 0.2s; }
.faq-item.open .faq-q .faq-icon { transform: rotate(45deg); }
.faq-a {
  display: none; padding: 0 20px 16px; font-size: 13px;
  color: var(--ink-soft); line-height: 1.7; border-top: 1px solid var(--border);
  padding-top: 14px;
}
.faq-item.open .faq-a { display: block; }

/* ── GLOSSARY ────────────────────────────────── */
.glossary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 20px 0; }
.gloss-item {
  background: var(--white); border: 1px solid var(--border);
  border-radius: 8px; padding: 14px 16px;
}
.gloss-term {
  font-family: var(--font-mono); font-size: 13px; font-weight: 500;
  color: var(--navy-mid); margin-bottom: 4px;
}
.gloss-def { font-size: 12px; color: var(--muted); line-height: 1.5; }

/* ── BACK TO TOP ─────────────────────────────── */
#backTop {
  position: fixed; bottom: 28px; right: 28px;
  width: 44px; height: 44px; border-radius: 50%;
  background: var(--navy); color: #fff; border: none;
  cursor: pointer; font-size: 16px; display: flex; align-items: center;
  justify-content: center; box-shadow: 0 4px 16px rgba(15,37,69,0.3);
  opacity: 0; transition: opacity 0.3s, transform 0.2s; pointer-events: none;
  z-index: 100;
}
#backTop.visible { opacity: 1; pointer-events: auto; }
#backTop:hover { transform: translateY(-3px); }

/* ── PROGRESS READING BAR ────────────────────── */
#readProgress {
  position: fixed; top: 0; left: 0; height: 3px;
  background: linear-gradient(90deg, var(--crimson), var(--gold));
  width: 0%; z-index: 200; transition: width 0.1s;
}

/* ── PRINT BUTTON ────────────────────────────── */
.print-btn {
  position: fixed; bottom: 28px; left: 28px;
  display: flex; align-items: center; gap: 8px;
  background: var(--white); border: 1px solid var(--border);
  border-radius: 24px; padding: 10px 18px; cursor: pointer;
  font-size: 12px; font-weight: 600; color: var(--ink-soft);
  box-shadow: 0 2px 12px rgba(0,0,0,0.08); z-index: 100;
  transition: all 0.2s;
}
.print-btn:hover { background: var(--navy); color: #fff; border-color: var(--navy); }

/* ── HEADER SECTION DIVIDER ──────────────────── */
.divider {
  display: flex; align-items: center; gap: 16px; margin: 40px 0 28px;
}
.divider-line { flex: 1; height: 1px; background: var(--border); }
.divider-text {
  font-size: 11px; font-weight: 700; color: var(--muted);
  text-transform: uppercase; letter-spacing: 1.5px; white-space: nowrap;
}

/* ── ANIMATIONS ──────────────────────────────── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}
.section { animation: fadeUp 0.5s ease both; }

/* ── RESPONSIVE ──────────────────────────────── */
@media (max-width: 1024px) {
  .sidebar { display: none; }
  .section { padding: 48px 32px; }
  .roles-grid { grid-template-columns: 1fr; }
  .score-grid { grid-template-columns: repeat(2, 1fr); }
  .diagram-body { grid-template-columns: 1fr; }
  .glossary-grid { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .section { padding: 36px 20px; }
  .step-body { padding: 20px 20px; }
  .shortcut-grid { grid-template-columns: 1fr 1fr; }
}

@media print {
  .sidebar, #backTop, .print-btn, #readProgress { display: none !important; }
  .step-body { display: block !important; }
  .section { padding: 40px 0; }
  .step-card { box-shadow: none; border: 1px solid #ddd; }
}
