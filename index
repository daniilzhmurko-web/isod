    <div class="cfr" style="margin-top:6px"><div class="cfg"><label class="cfl">Дата освобождения</label><input class="cfi" value="${cr.rl?.d||''}" style="width:100px"></div><div class="cfg"><label class="cfl">Основание</label><input class="cfi" value="${cr.rl?.b||''}" style="width:200px"></div></div>
    <div class="cfg" style="margin-top:7px"><label class="cfl">Основание снятия судимости ${cr.ex?'<span style="color:#16a34a;font-weight:700">(ПОГАШЕНА)</span>':''}</label><textarea class="ka" style="height:45px">${cr.eb||''}</textarea></div>
    <div class="cfg" style="margin-top:6px"><label class="cfl">Данные из картотеки</label><textarea class="ka"></textarea></div>`;
