    case'services':renderServices();break;
    case'lb':renderLB();break;
    case'dash':renderDash();break;
    case'quests':renderQList();break;
    case'profile':updateProfile();break;
  }
  if(S.user.role==='teacher'){document.getElementById('teacher-v').style.display=panel==='vehicles'?'block':'none';}
}

