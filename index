})();

// 3. Пульс кнопки «?» при ожидании клика на неё
const _origActivate = Engine._activate.bind(Engine);
Engine._activate = function(step) {
  // Если цель — dropdown пользователя: показать и сбросить на первый НЕ-целевой вариант
  if (step.target === '#sed-user-dropdown') {
    const dd = document.getElementById('sed-user-dropdown');
    if (dd) {
      dd.style.display = 'block';
      // Если уже выбран целевой — сбросить на другой, чтобы change event сработал
      if (step.targetValue && dd.value === step.targetValue) {
        // Найти первый вариант, отличный от целевого
        const firstOther = Array.from(dd.options).find(o => o.value && o.value !== step.targetValue);
        if (firstOther) {
          dd.value = firstOther.value;
          // Обновить отображение без вызова Engine (только UI)
          const r = State.region;
          if (r && r.users[firstOther.value]) {
            const u = r.users[firstOther.value];
            document.getElementById('sed-username').textContent = u.name;
            document.getElementById('sed-userrole').textContent = u.rank;
            document.getElementById('sed-avatar').textContent = u.avatar;
          }
        }
      }
    }
  }
  // Если цель — кнопки в карточке документа, убедиться что карточка открыта
  const cardTargets = ['#btn-approve','#btn-to-folder','#btn-add-resolution',
                       '#btn-acknowledged','#card-link-res','#card-link-control','#card-link-info'];
  if (step.target && cardTargets.includes(step.target)) {
    const card = document.getElementById('doc-card');
    if (card && card.classList.contains('hidden')) {
      // Открыть первый документ в текущей папке
      const firstRow = document.querySelector('#doc-list .doc-row');
      if (firstRow) {
        selectDocument(0);
      } else if (State.region) {
        // Нет документов → отрисовать и открыть
        renderDocuments(State.region.docs, State.currentFolder || 'approval');
        setTimeout(() => selectDocument(0), 100);
      }
    }
  }
  _origActivate(step);
  // Добавить pulse-класс кнопке «?» если она — цель
  const helpBtn = document.getElementById('sed-help-btn');
  if (helpBtn) {
    if (step.target === '#sed-help-btn') {
      helpBtn.classList.add('help-pulse');
    } else {
      helpBtn.classList.remove('help-pulse');
    }
  }
  // Подсветить кнопку-цель в карточке если нужно
  document.querySelectorAll('.btn-action.target-glow').forEach(b => b.classList.remove('target-glow'));
  if (step.target && ['#btn-approve','#btn-to-folder','#btn-add-resolution','#btn-acknowledged'].includes(step.target)) {
    const el = document.querySelector(step.target);
    if (el) el.classList.add('target-glow');
  }
};

// 4. Сброс glow после успешного шага + авто-показ dropdown
const _origOk5 = Engine._ok.bind(Engine);
Engine._ok = function() {
  const justDone = Engine._cur;
  // Если только что кликнули по имени пользователя — показать dropdown для следующего шага
  if (justDone && justDone.target === '#sed-username') {
    setTimeout(() => {
      const dd = document.getElementById('sed-user-dropdown');
      if (dd) dd.style.display = 'block';
    }, 300);
  }
  document.querySelectorAll('.btn-action.target-glow').forEach(b => b.classList.remove('target-glow'));
  document.getElementById('sed-help-btn')?.classList.remove('help-pulse');
  _origOk5();
};

