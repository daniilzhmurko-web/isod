/* ХЛЕБНЫЕ КРОШКИ */
.breadcrumb{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted);margin-bottom:16px;flex-wrap:wrap}
.breadcrumb-item{cursor:pointer;transition:color .15s}
.breadcrumb-item:hover{color:var(--primary)}
.breadcrumb-item.active{color:var(--text);font-weight:600;cursor:default}
.breadcrumb-sep{color:var(--border)}

/* ВИСП */
#vispScreen{position:fixed;inset:0;z-index:500;background:white;display:flex;flex-direction:column}
.visp-header{background:var(--primary);height:52px;display:flex;align-items:center;padding:0 20px;gap:12px;color:white}
.visp-nav{background:#f0f4f8;border-bottom:1px solid var(--border);display:flex;gap:0;padding:0 20px;height:44px;align-items:center}
.visp-nav-item{padding:0 18px;height:44px;display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;font-weight:600;color:var(--text-muted);border-bottom:2.5px solid transparent;transition:all .15s}
.visp-nav-item:hover,.visp-nav-item.active{color:var(--primary);border-bottom-color:var(--primary)}
.visp-body{flex:1;overflow-y:auto;padding:24px;background:#f8fafd}
.visp-services-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:16px;background:white;border-radius:var(--radius-lg);border:1px solid var(--border)}
.visp-service-item{padding:14px;background:var(--bg);border-radius:var(--radius);border:1px solid var(--border);cursor:pointer;transition:all .15s}
.visp-service-item:hover{background:var(--primary-pale);border-color:var(--primary)}
.visp-service-item.highlight{border-color:var(--accent);background:#fffde7;animation:glow 1.5s ease-in-out infinite alternate}
@keyframes glow{from{box-shadow:0 0 6px rgba(200,162,0,.3)}to{box-shadow:0 0 16px rgba(200,162,0,.6)}}
.visp-service-name{font-size:12px;font-weight:700;color:var(--primary);margin-bottom:4px}
.visp-service-desc{font-size:11px;color:var(--text-muted)}
.visp-news-item{padding:14px 16px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .15s}
.visp-news-item:hover{background:var(--primary-pale)}
.visp-news-title{font-size:13px;font-weight:600;color:var(--primary);margin-bottom:4px}
.visp-news-meta{font-size:11px;color:var(--text-muted)}

/* МОНИТОРИНГ */
.monitoring-layout{display:grid;grid-template-columns:220px 1fr;gap:16px}
.monitoring-sidebar{background:white;border-radius:var(--radius-lg);border:1px solid var(--border);padding:14px;height:fit-content}
.sidebar-nav-item{padding:7px 10px;border-radius:var(--radius);cursor:pointer;font-size:13px;color:var(--text-muted);transition:all .15s;margin-bottom:2px}
.sidebar-nav-item:hover,.sidebar-nav-item.active{background:var(--primary-pale);color:var(--primary);font-weight:600}
.sidebar-nav-title{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);font-weight:700;margin:12px 0 4px;display:flex;align-items:center;gap:6px;cursor:pointer}
.search-results{background:white;border-radius:var(--radius-lg);border:1px solid var(--border);overflow:hidden}
.search-results-header{padding:14px 16px;border-bottom:1px solid var(--border);background:var(--bg);display:flex;justify-content:space-between;align-items:center}
.search-result-item{padding:14px 16px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .15s}
.search-result-item:hover{background:var(--primary-pale)}
.search-result-num{font-size:12px;font-weight:700;color:var(--primary);margin-bottom:4px}
.search-result-title{font-size:13px;color:var(--text);line-height:1.4}
.highlight-text{background:#fff176;padding:1px 2px;border-radius:2px}

/* ИСК */
.isk-tab{padding:12px 16px;cursor:pointer;font-size:13px;font-weight:600;color:var(--text-muted);border-bottom:2.5px solid transparent;transition:all .15s;display:flex;align-items:center;gap:6px}
.isk-tab:hover{color:var(--primary)}.isk-tab.active{color:var(--primary);border-bottom-color:var(--primary)}
.isk-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.timeline-item{display:flex;gap:14px;margin-bottom:14px}
.timeline-dot{width:10px;height:10px;border-radius:50%;background:var(--primary);margin-top:3px;flex-shrink:0}

/* КОНСТРУКТОР НПА */
.npa-editor{display:grid;grid-template-columns:260px 1fr;gap:16px}
.npa-templates{background:white;border-radius:var(--radius-lg);border:1px solid var(--border);overflow:hidden;height:fit-content}
.npa-template-item{padding:12px 16px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .15s}
.npa-template-item:hover,.npa-template-item.selected{background:var(--primary-pale);border-left:3px solid var(--primary)}
.npa-template-name{font-size:13px;font-weight:600;color:var(--text);margin-bottom:3px}
.npa-template-type{font-size:11px;color:var(--text-muted)}
.npa-doc-preview{background:white;border-radius:var(--radius-lg);border:1px solid var(--border);padding:32px;min-height:500px}
.npa-doc-section{margin-bottom:16px;padding:14px;background:var(--bg);border-radius:var(--radius);border:1px dashed var(--border);cursor:pointer;transition:all .15s}
.npa-doc-section:hover{border-color:var(--primary);background:var(--primary-pale)}
.npa-doc-section.filled{background:white;border-style:solid;border-color:var(--success)}
.npa-doc-section label{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);font-weight:700;display:block;margin-bottom:6px}
.npa-check-result{padding:14px;border-radius:var(--radius);margin-top:12px}
.npa-check-result.ok{background:#e0f5ea;border:1px solid #6bcf9a}
.npa-check-result.error{background:#fde8e8;border:1px solid #f59a9a}
.npa-check-item{display:flex;align-items:flex-start;gap:8px;font-size:13px;margin-bottom:6px}

/* ПРАВОВАЯ ЭКСПЕРТИЗА */
.expertise-layout{display:grid;grid-template-columns:1fr 320px;gap:16px}
.doc-editor-wrap{background:white;border-radius:var(--radius-lg);border:1px solid var(--border);overflow:hidden}
.doc-toolbar{padding:10px 14px;border-bottom:1px solid var(--border);background:var(--bg);display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.doc-toolbar-btn{padding:5px 10px;background:white;border:1px solid var(--border);border-radius:var(--radius);font-size:12px;cursor:pointer;transition:all .15s;font-weight:600}
.doc-toolbar-btn:hover,.doc-toolbar-btn.active{background:var(--primary);color:white;border-color:var(--primary)}
.doc-content-area{padding:24px;min-height:400px;font-size:13px;line-height:1.8}
.doc-paragraph{margin-bottom:12px;border-radius:4px;padding:4px 8px;transition:background .15s;cursor:pointer}
.doc-paragraph:hover{background:#f0f4ff}
.doc-paragraph.error{background:#fff0f0;border-left:3px solid var(--danger)}
.doc-paragraph.warn{background:#fffde7;border-left:3px solid var(--accent)}
.doc-paragraph.ok{background:#f0fff4;border-left:3px solid var(--success)}
.rule-item{padding:10px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px}
.rule-checkbox{width:16px;height:16px;accent-color:var(--primary);cursor:pointer}
.rule-name{font-size:12px;flex:1}
.rule-count{font-size:11px;font-weight:700;color:white;background:var(--danger);width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center}
.rule-count.ok{background:var(--success)}

/* АНТИКОР */
.anticor-layout{display:grid;grid-template-columns:1fr 300px;gap:16px}
.corruption-flag{background:#fff8e6;border:1px solid #ffd96a;border-radius:var(--radius);padding:12px;margin-bottom:10px;cursor:pointer;transition:all .15s}
.corruption-flag:hover{transform:translateX(3px)}
.corruption-flag.high{border-color:#f44336;background:#fff0f0}
.corruption-flag.medium{border-color:#ff9800;background:#fff8e6}
.corruption-flag.low{border-color:#4caf50;background:#f0fff4}
.corruption-flag-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.corruption-type{font-size:12px;font-weight:700;color:var(--text)}
.corruption-fragment{font-size:12px;color:var(--text);background:rgba(0,0,0,.04);padding:6px 8px;border-radius:4px;font-family:monospace;margin-bottom:6px}
.risk-meter{height:6px;background:var(--bg);border-radius:3px;overflow:hidden;margin-top:4px}
.risk-fill{height:100%;border-radius:3px;transition:width .5s ease}

/* НПА-З */
.npaz-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.npaz-doc{background:white;border-radius:var(--radius-lg);border:1px solid var(--border);padding:16px;cursor:pointer;transition:all .15s;position:relative}
.npaz-doc:hover{box-shadow:var(--shadow-md)}
.npaz-access-required{position:absolute;inset:0;background:rgba(255,255,255,.92);border-radius:var(--radius-lg);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px}

/* ДОСТИЖЕНИЯ */
.achievements-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.achievement-card{background:white;border-radius:var(--radius-lg);padding:14px;border:1px solid var(--border);text-align:center}
.achievement-card.unlocked{border-color:var(--accent);background:linear-gradient(135deg,#fffde7,#fff8dc)}
.achievement-card.locked{opacity:.5;filter:grayscale(1)}

/* МОДАЛЬНЫЕ ОКНА */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:8000;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(3px)}
.modal{background:white;border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);max-width:580px;width:90%;max-height:88vh;display:flex;flex-direction:column;animation:modalIn .2s ease}
@keyframes modalIn{from{opacity:0;transform:scale(.95)}to{opacity:1;transform:scale(1)}}
.modal-header{padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.modal-title{font-size:16px;font-weight:800;color:var(--text)}
.modal-close{width:28px;height:28px;border:none;background:var(--bg);border-radius:50%;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;color:var(--text-muted);transition:all .15s}
.modal-close:hover{background:var(--danger);color:white}
.modal-body{padding:22px;overflow-y:auto;flex:1}
.modal-footer{padding:16px 22px;border-top:1px solid var(--border);display:flex;gap:10px;justify-content:flex-end;flex-shrink:0}

/* ЖУРНАЛ */
.ops-log-item{padding:10px 14px;border-bottom:1px solid var(--border);display:flex;gap:12px;align-items:flex-start;font-size:12px}
.ops-log-time{color:var(--text-muted);white-space:nowrap;font-family:monospace}
.ops-log-action{flex:1;color:var(--text)}
.ops-log-module{padding:2px 8px;background:var(--primary-pale);color:var(--primary);border-radius:10px;font-size:10px;font-weight:700;white-space:nowrap}

/* XP ПОПАП */
.xp-popup{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:9500;background:linear-gradient(135deg,var(--primary),var(--primary-light));color:white;padding:28px 40px;border-radius:var(--radius-lg);text-align:center;box-shadow:var(--shadow-lg);animation:xpAnim .4s cubic-bezier(.175,.885,.32,1.275)}
@keyframes xpAnim{from{opacity:0;transform:translate(-50%,-50%) scale(.5)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}

/* ИНСТРУКЦИИ (CISCO-СТИЛЬ) */
#instructionsPanel{position:fixed;bottom:0;left:0;right:0;z-index:2000;background:white;border-top:2px solid var(--primary);box-shadow:0 -4px 20px rgba(0,0,0,.12);transition:transform .3s ease}
#instructionsPanel.collapsed{transform:translateY(calc(100% - 36px))}
.instructions-toggle{height:36px;background:var(--primary);color:white;display:flex;align-items:center;padding:0 16px;gap:8px;cursor:pointer;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em}
.toggle-icon{margin-left:auto;transition:transform .3s}
#instructionsPanel.collapsed .toggle-icon{transform:rotate(180deg)}
.instructions-content{padding:14px 20px;display:flex;gap:20px}
.instructions-step-info{flex:1}
.instructions-step-title{font-size:14px;font-weight:700;color:var(--primary);margin-bottom:6px}
.instructions-step-text{font-size:13px;color:var(--text);line-height:1.5}
.instructions-hint{background:#fff8e6;border:1px solid #ffe082;border-radius:var(--radius);padding:10px 14px;font-size:12px;color:#7a5800;min-width:200px;max-width:280px}
.instructions-hint strong{display:block;margin-bottom:4px}
.instructions-nav{display:flex;flex-direction:column;gap:8px;align-items:flex-end;min-width:200px}
.instructions-progress{display:flex;gap:4px;margin-bottom:4px;flex-wrap:wrap;max-width:180px}
.step-dot{width:10px;height:10px;border-radius:50%;background:var(--border);transition:background .3s}
.step-dot.done{background:var(--success)}
.step-dot.current{background:var(--primary)}

/* СПИННЕР */
.spinner{width:36px;height:36px;border:3px solid var(--border);border-top-color:var(--primary);border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ПОДСВЕТКА */
.highlight-pulse{animation:hPulse 1.5s ease-in-out infinite;position:relative;z-index:10}
@keyframes hPulse{0%,100%{box-shadow:0 0 0 0 rgba(26,74,138,.4)}50%{box-shadow:0 0 0 8px rgba(26,74,138,0)}}

/* СТАТЫ */
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}
.stat-card{background:white;border-radius:var(--radius-lg);padding:16px;border:1px solid var(--border);box-shadow:var(--shadow)}
.stat-card-value{font-size:28px;font-weight:800;color:var(--primary);margin-bottom:4px}
.stat-card-label{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);font-weight:700}

/* МОДУЛИ СЕТКА */
.modules-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px}
.module-card{background:white;border-radius:var(--radius-lg);padding:20px;border:1.5px solid var(--border);box-shadow:var(--shadow);cursor:pointer;transition:all .2s;position:relative;overflow:hidden}
.module-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--primary)}
.module-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-md);border-color:var(--primary)}
.module-card.completed::before{background:var(--success)}

/* ФОРУМ */
.portal-news-heading{font-size:13px;font-weight:600;color:var(--primary);margin-bottom:6px}
.portal-news-date{font-size:11px;color:var(--text-muted);margin-bottom:4px}
.portal-news-preview{font-size:12px;color:var(--text-muted);line-height:1.4}
.quick-link-item{padding:11px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;cursor:pointer;font-size:13px;color:var(--primary);transition:background .15px}
.quick-link-item:hover{background:var(--primary-pale)}
.quick-link-item:last-child{border-bottom:none}

/* ЗАВЕРШЕНИЕ */
@keyframes bounce{from{transform:translateY(0)}to{transform:translateY(-12px)}}
.completion-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;max-width:600px;margin:0 auto 28px}
.completion-stat{background:white;border-radius:var(--radius-lg);padding:18px;border:1px solid var(--border)}
.completion-stat-val{font-size:28px;font-weight:800;color:var(--primary)}
.completion-stat-label{font-size:12px;color:var(--text-muted)}

@media(max-width:1100px){.modules-grid{grid-template-columns:repeat(2,1fr)}.stat-grid{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>

<!-- ЭКРАН ЗАГРУЗКИ -->
<div id="loadingScreen">
  <div style="font-size:80px;margin-bottom:20px;animation:pulse 2s infinite">🦅</div>
