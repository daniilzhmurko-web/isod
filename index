// TrapEngine
// ══════════════════════════════════════════════════════
const TrapEngine = {
  traps: [],
  fired: new Set(),
  _resolve: null,
  _timer: null,
  COUNTDOWN: 35,

  init(region) {
    this.traps = buildTraps(region);
    this.fired.clear();
  },

  // Проверить, нужно ли показать ловушку после stepIdx в сценарии scId
  check(scId, stepIdx) {
    if (!State.region) return false;
    const eligible = this.traps.filter(t =>
      t.forScenario.includes(scId) &&
      t.when === stepIdx &&
      !this.fired.has(t.id) &&
      Math.random() < (scId >= 3 ? 0.75 : 0.45) // выше шанс в поздних сценариях
    );
    if (!eligible.length) return false;
    const trap = eligible[Math.floor(Math.random() * eligible.length)];
    this.fired.add(trap.id);
    setTimeout(() => this._show(trap), 600);
    return true;
  },

  _show(trap) {
    // Баннер
    const banner = document.getElementById('trap-banner');
    document.getElementById('trap-banner-text').textContent = trap.title;
    banner.classList.add('show');
    setTimeout(() => banner.classList.remove('show'), 2500);

    // Пауза движка
    Engine.waiting = false;
    Nav.clear();

    // Построить окно
    const el = document.createElement('div');
    el.className = 'quest-alert';
    el.id = 'trap-alert-' + trap.id;

    const choicesHTML = trap.choices.map((c, i) => `
      <button class="trap-opt" data-idx="${i}" onclick="TrapEngine._answer(this,${c.correct},${c.points},'${c.feedback.replace(/'/g,"&#39;")}','${(trap.norm||'').replace(/'/g,"&#39;")}')">
        <span class="trap-opt__letter">${c.letter}</span>
        <span>${c.text}</span>
      </button>`).join('');

    el.innerHTML = `
      <div class="quest-alert__header">
        <span class="quest-alert__icon">${trap.icon}</span>
        <span class="quest-alert__title">${trap.title}</span>
        <span class="quest-alert__timer" id="trap-timer-${trap.id}">${this.COUNTDOWN}</span>
      </div>
      <div class="quest-alert__body">
        <div class="quest-alert__scenario">${trap.scenario}</div>
        <div style="font-size:12px;font-weight:700;color:#6C757D;margin-bottom:8px;text-transform:uppercase;letter-spacing:.04em;">❓ ${trap.question}</div>
        <div class="quest-alert__choices">${choicesHTML}</div>
        <div class="trap-feedback" id="trap-fb-${trap.id}"></div>
      </div>`;

    document.body.appendChild(el);
    requestAnimationFrame(() => el.classList.add('show'));

    // Таймер обратного отсчёта
    let sec = this.COUNTDOWN;
    this._timer = setInterval(() => {
      sec--;
      const t = document.getElementById('trap-timer-' + trap.id);
      if (t) t.textContent = sec;
      if (sec <= 0) {
        clearInterval(this._timer);
        this._timeout(trap, el);
      }
    }, 1000);

    this._currentEl = el;
    this._currentTrap = trap;
  },

  _answer(btn, correct, points, feedback, norm) {
    clearInterval(this._timer);
    const trap = this._currentTrap;
    const el = this._currentEl;

    // Заблокировать кнопки
    el.querySelectorAll('.trap-opt').forEach(b => b.classList.add('disabled'));
    btn.classList.add(correct ? 'correct' : 'wrong');

    // Обратная связь
    const fb = document.getElementById('trap-fb-' + trap.id);
    fb.className = 'trap-feedback ' + (correct ? 'ok' : 'fail');
    fb.innerHTML = feedback + (norm ? `<span class="norm-link">📌 ${norm}</span>` : '');
    fb.style.display = 'block';

    // Очки
    if (correct) {
      State.trapsOk++;
      addScoreEvent('🎯 Ловушка: верный ответ', points);
      showToast(`✅ Ловушка разгадана! +${points} баллов`, 'success');
    } else {
      State.trapsFail++;
      addScoreEvent('⚠️ Ловушка: неверный ответ', points);
      showToast(`❌ Ловушка сработала! ${points} баллов`, 'error');
    }

    // Закрыть через 3.5с и возобновить движок
    setTimeout(() => this._close(el), 3500);
  },

  _timeout(trap, el) {
    State.trapsFail++;
    addScoreEvent('⏰ Ловушка: время вышло', -6);
    showToast('⏰ Время вышло! Ловушка не обработана. -6 баллов', 'error');
    const fb = document.getElementById('trap-fb-' + trap.id);
    fb.className = 'trap-feedback fail';
    fb.textContent = 'Время истекло! Ловушка не обработана. Правильный ответ: ' + trap.choices.find(c=>c.correct)?.text;
    fb.style.display = 'block';
    setTimeout(() => this._close(el), 2500);
  },

  _close(el) {
    el.classList.remove('show');
    setTimeout(() => { el.remove(); }, 400);
    // Возобновить движок: запустить следующий шаг
    setTimeout(() => {
      Engine.waiting = false;
      Engine._run();
    }, 500);
  }
};

// ══════════════════════════════════════════════════════
// Патч ScenarioEngine: добавляем проверку ловушек
// (переопределяем _ok чтобы перед следующим шагом
//  TrapEngine мог вклиниться)
// ══════════════════════════════════════════════════════
const _origOk = Engine._ok.bind(Engine);
Engine._ok = function() {
  this.waiting = false;
  Nav.clear();
  showToast('✅ Верно! Переходим к следующему шагу.', 'success');
  addScoreEvent('Шаг выполнен', +3);
  const prevIdx = this.idx;
  this.idx++;
  // Проверить ловушку
  const trapFired = TrapEngine.check(this.scId, prevIdx + 1);
  if (!trapFired) {
    setTimeout(() => this._run(), 900);
  }
  // Если ловушка сработала — _run() вызовется из TrapEngine._close
};

// ══════════════════════════════════════════════════════
// Патч loadScenarioEngine: инициализировать TrapEngine
// ══════════════════════════════════════════════════════
const _origLoad = loadScenarioEngine;
window.loadScenarioEngine = function(id) {
  TrapEngine.init(State.region);
  _origLoad(id);
};

