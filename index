function renderDocTimeline() {
  const panel = document.getElementById('card-tab-control');
  if (!panel || !State.region) return;
  const r = State.region;
  const today = new Date().toLocaleDateString('ru-RU');

  const tl = [
    {label:'Регистрация входящего',    role:r.users.clerk.name,  date:today,    status:'done'},
    {label:'На рассмотрение',          role:r.users.boss.name,   date:today,    status:'done'},
    {label:'Редактирование (исполн.)', role:r.users.exec.name,   date:today,    status:'done'},
    {label:'Подписание',               role:r.users.signer.name, date:today,    status:'done'},
    {label:'Утверждение исполнения',   role:r.users.boss.name,   date:'',       status:'active'},
    {label:'Архивирование',            role:'Архив',             date:'',       status:'wait'},
  ];

  const existing = panel.querySelector('.doc-timeline');
  if (existing) existing.remove();

  const div = document.createElement('div');
  div.className = 'doc-timeline';
  div.innerHTML = tl.map((item,i) => `
    <div class="doc-tl-item">
      <div>
        <div class="doc-tl-dot ${item.status}"></div>
        ${i < tl.length-1 ? '<div class="doc-tl-line"></div>' : ''}
