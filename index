      <div style="padding:12px;background:#F8F9FA;border-radius:8px;"><div style="font-size:18px;font-weight:800;color:#343A40;">${m}м ${s}с</div><div style="font-size:11px;color:#6C757D;">время</div></div>
      <div style="padding:12px;background:#F8F9FA;border-radius:8px;"><div style="font-size:20px;font-weight:800;color:${State.errors?'#C0392B':'#1B7A3E'};">${State.errors}</div><div style="font-size:11px;color:#6C757D;">ошибок</div></div>
    </div>
    ${isLast
      ?`<button onclick="document.getElementById('${ovId}').remove();showFinalResult();" style="background:#0058A3;color:#fff;padding:12px 32px;border-radius:6px;font-size:14px;font-weight:700;border:none;cursor:pointer;width:100%;">🏆 Итоговые результаты</button>`
      :`<div style="display:flex;gap:10px;">
          <button onclick="document.getElementById('${ovId}').remove();showScreen('screen-menu');buildMenu();" style="flex:1;background:#F8F9FA;color:#343A40;padding:12px;border-radius:6px;font-size:13px;font-weight:600;border:1px solid #DEE2E6;cursor:pointer;">В меню</button>
