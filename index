const AIW={
  injInterval:null,
  init(){
    const ms=S.user.diff>=3?25000:55000;
    this.injInterval=setInterval(()=>{if(!S.crisisActive)this.inject();},ms);
    setInterval(()=>this.adapt(),120000);
    if(S.user.diff>=2)setTimeout(()=>{aMsg('sys','👁️ Система мониторинга активирована. Ваши действия записываются.','sys');this.renderStatus();},6000);
  },
  inject(){
    const r=Math.random();
    if(r<.3){
      const fv={id:DB.vehicles.length+1,plate:genPlate(),vin:DB.vehicles[ri(0,8)].vin,brand:rnd(BRANDS),model:'Unknown',year:2021,color:rnd(COLORS),type:'Легковой',owner:'Неизвестен',passport:genPass(),sts:genSTS(),regDate:today(),status:'Активен',anomaly:'dup_vin'};
      DB.vehicles.push(fv);
      aMsg('sys',`⚡ AI: В базе появился подозрительный ТС [${fv.plate}]. Проверьте VIN!`,'sys');
      notify('w','Аномалия в базе!',`ТС ${fv.plate} требует проверки`);
    }else if(r<.6){
      const vi=DB.violations.find(v=>v.status==='Новый');
      if(vi){vi.status='Просрочен';aMsg('sys',`🔴 AI: Штраф ${vi.decree} стал просроченным!`,'sys');}
    }else{
      const v=rnd(DB.vehicles);
      if(!DB.wanted.find(w=>w.plate===v.plate&&w.active)){
        DB.wanted.push({plate:v.plate,vin:v.vin,reason:'Угон (GPS-сигнал)',date:today(),active:true});
        aMsg('sys',`🚨 AI: ТС [${v.plate}] объявлено в розыск!`,'sys');
        notify('d','Новый розыск!',v.plate);
      }
    }
    S.ai.anomalies++;this.renderStatus();
    document.getElementById('st-w').textContent=DB.wanted.filter(w=>w.active).length;
  },
  adapt(){
    const rate=S.acc.total>0?S.acc.correct/S.acc.total:0;
    const cnt=QM.completed.length;
    if(rate>.88&&cnt>3){S.ai.diff=Math.min(4,S.ai.diff+.5);aMsg('sys','📈 AI: Отличная работа! Повышаю сложность...','sys');}
    else if(rate<.5&&cnt>2){S.ai.diff=Math.max(1,S.ai.diff-.3);aMsg('sys','📉 AI: Задания немного упрощены.','sys');}
    S.ai.adapt++;this.renderStatus();
    if(S.ai.anomalies>3){S.ai.threat='СРЕДНИЙ';document.getElementById('threat-lv').textContent=S.ai.threat;}
    if(S.ai.anomalies>7){S.ai.threat='ВЫСОКИЙ';const tl=document.getElementById('threat-lv');tl.textContent=S.ai.threat;tl.style.color='#ef5350';}
  },
  renderStatus(){
    const c=document.getElementById('aiw-status');if(!c)return;
    c.innerHTML=`<div style="font-size:11px;color:var(--txt)">
      <div style="display:flex;justify-content:space-between;margin-bottom:3px"><span>Уровень ИИ:</span><b>${S.ai.diff.toFixed(1)}</b></div>
      <div style="display:flex;justify-content:space-between;margin-bottom:3px"><span>Инъекций:</span><b>${S.ai.anomalies}</b></div>
