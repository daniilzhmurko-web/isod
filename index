      {id:'s3',t:'Протестировать АСГО',d:'Выполните тест связи всех секторов системы оповещения.',m:'asgo',h:'Раздел «АСГО» → кнопка «Тест связи» для каждого сектора.'},
      {id:'s4',t:'Проверить журналы',d:'Откройте журналы личного состава и транспорта.',m:'jour',h:'Раздел «Журналы».'},
      {id:'s5',t:'Передать сводку в ЦОР',d:'Откройте ЦОР и отправьте консолидированную сводку на федеральный уровень.',m:'summ',h:'Раздел «Оперативная сводка» → «Отправить в ЦОР».'}
    ]}
  ];},

  startM(id){this.s.mission=id;this.s.mStep=0;this.save();this.renderMP();this.mpExp=true;this.applyMP();const m=this.getMiss().find(x=>x.id===id);this.log('Начата миссия: '+m.title);this.toast('s','Миссия начата!',m.title);this.go('dash');},
  replayM(id){this.s.prog.done=this.s.prog.done.filter(x=>x!==id);this.startM(id);},

  renderMP(){
    if(!this.s.mission){document.getElementById('mpT').textContent='Выберите учебную миссию';document.getElementById('mpS').textContent='—';document.getElementById('mpF').style.width='0%';document.getElementById('mpX').textContent='+0 XP';document.getElementById('mpSL').innerHTML='';document.getElementById('mpCT').innerHTML='<div class="mp-em"><i class="fas fa-graduation-cap"></i><span>Перейдите в «Учебные миссии» и выберите задание</span></div>';return;}
    const m=this.getMiss().find(x=>x.id===this.s.mission);if(!m)return;
    document.getElementById('mpT').textContent=m.title;document.getElementById('mpX').textContent='+'+m.xp+' XP';
    const c=this.s.mStep,tot=m.steps.length;
    document.getElementById('mpS').textContent=Math.min(c,tot)+'/'+tot;
    document.getElementById('mpF').style.width=(Math.min(c,tot)/tot*100)+'%';
    document.getElementById('mpSL').innerHTML=m.steps.map((s,i)=>{let cl=i<c?'sn-d':i===c?'sn-c':'sn-p',nm=i<c?'✓':(i+1);return`<div class="mp-si ${i===c?'cs':''}" onclick="SYS.showSt(${i})"><div class="mp-snum ${cl}">${nm}</div><div class="mp-sl2">${s.t}</div></div>`;}).join('');
    this.showSt(c<tot?c:tot-1);
  },
  showSt(i){const m=this.getMiss().find(x=>x.id===this.s.mission);if(!m)return;const s=m.steps[i];if(!s)return;const c=this.s.mStep;document.getElementById('mpCT').innerHTML=`<div class="mp-ct-t"><span class="bdg ${i<c?'bg':i===c?'bb':'bgy'}">${i<c?'✓':(i+1)}</span>${s.t}</div><div class="mp-ct-d">${s.d}</div>${s.h?`<div class="mp-hn"><i class="fas fa-lightbulb" style="flex-shrink:0;margin-top:1px"></i><span><strong>Подсказка:</strong> ${s.h}</span></div>`:''}`; },

  valStep(mod){
    if(!this.s.mission)return;const m=this.getMiss().find(x=>x.id===this.s.mission);if(!m)return;
    const s=m.steps[this.s.mStep];if(!s||s.m!==mod)return;
    this.s.mStep++;
    if(this.s.mStep>=m.steps.length){this.complM(m);}
    else{this.toast('s','✓ Шаг выполнен!','Следующий: '+m.steps[this.s.mStep].t);this.save();this.renderMP();}
  },
  complM(m){
    if(!this.s.prog.done.includes(m.id)){this.s.prog.done.push(m.id);this.s.prog.xp+=m.xp;}
    this.s.mission=null;this.s.mStep=0;this.log('Завершена миссия: '+m.title);this.save();this.renderMP();this.updBdg();
    document.getElementById('hRk').textContent=this.rn(this.s.prog.xp);this.mpExp=false;this.applyMP();
    this.showM('🏆 Миссия завершена!',`<div style="text-align:center;padding:12px 0"><div style="font-size:52px;margin-bottom:14px">🏆</div><div style="font-size:17px;font-weight:800;margin-bottom:6px">${m.title}</div><div style="color:var(--ts);font-size:13px;margin-bottom:16px">Все задания выполнены успешно!</div><div style="font-size:28px;font-weight:800;color:#8a6d00">+${m.xp} XP</div><div style="font-size:12px;color:var(--tm);margin-top:4px">Ваш ранг: ${this.rn(this.s.prog.xp)}</div><div style="margin-top:16px"><div class="xb" style="max-width:200px;margin:0 auto"><div class="xf" style="width:${this.xpP(this.s.prog.xp)}%"></div></div></div></div>`,'fas fa-trophy',[{l:'К миссиям',a:"SYS.go('miss')",cl:'btn-p'}]);
  },
  tgMP(){this.mpExp=!this.mpExp;this.applyMP();},
  applyMP(){document.getElementById('MP').classList.toggle('exp',this.mpExp);},

  // ═══ ВСПОМОГАТЕЛЬНЫЕ ═══
  rn(xp){let r=RANKS[0];for(const k of RANKS){if(xp>=k.x)r=k;}return r.n;},
  xpP(xp){for(let i=0;i<RANKS.length-1;i++){if(xp>=RANKS[i].x&&xp<RANKS[i+1].x){return Math.round((xp-RANKS[i].x)/(RANKS[i+1].x-RANKS[i].x)*100);}}return 100;},
  pb(st){return{free:'bg',busy:'bo',patrol:'bb',off:'bgy'}[st]||'bgy';},
  ps(st){return{free:'Свободен',busy:'На выезде',patrol:'Патрулирует',off:'Не в строю'}[st]||st;},
  ec(tp){return{info:'#1565c0',success:'#2e7d32',warning:'#e65100',danger:'#c62828'}[tp]||'#64748b';},
  prBdg(p){return{low:'bgy',medium:'bb',high:'bo',critical:'br'}[p]||'bgy';},
  prNm(p){return{low:'Низкий',medium:'Средний',high:'Высокий',critical:'Критический'}[p]||p;},
  stBdg(st){return{pending:'bo',inprogress:'bb',resolved:'bg',closed:'bgy'}[st]||'bgy';},
  stNm(st){return{pending:'Ожидает',inprogress:'В работе',resolved:'Завершён',closed:'Закрыт'}[st]||st;},

  updBdg(){
    const k=this.s.kusp||[],grl=this.s.grl;
    const bK=document.getElementById('bK'),bM=document.getElementById('bM'),bP=document.getElementById('bP'),bD=document.getElementById('bD');
    const pend=k.filter(x=>x.status==='pending').length;
    if(bK){bK.textContent=pend;bK.style.display=pend?'flex':'none';}
    if(bM)bM.textContent=3-this.s.prog.done.length;
    if(bP)bP.textContent=this.s.patrols.filter(p=>p.sta!=='off').length;
    if(bD){const q=this.s.callQueue.length;bD.textContent=q;bD.style.display=q?'flex':'none';}
  },

  addEv(tx,tp='info'){
    const n=new Date(),t=String(n.getHours()).padStart(2,'0')+':'+String(n.getMinutes()).padStart(2,'0');
    this.s.events.push({t,tx,tp});if(this.s.events.length>60)this.s.events.shift();this.save();
    if(this.s.mod==='dash'){const f=document.getElementById('evFeed');if(f)f.insertAdjacentHTML('afterbegin',`<div class="ei"><span class="et">${t}</span><span class="ed" style="background:${this.ec(tp)}"></span><span class="ex">${tx}</span></div>`);}
  },
  startEv(){
    const pool=[{tx:'<strong>Патруль Ромб-2</strong>: патрулирование района без происшествий.',tp:'info'},{tx:'<strong>Наряд Сокол-1</strong> завершил отработку, возвращается на маршрут.',tp:'success'},{tx:'<strong>АСГО:</strong> плановая проверка связи пройдена.',tp:'info'},{tx:'<strong>Наряд Кедр-1</strong> проверяет документы подозрительного лица.',tp:'warning'},{tx:'<strong>Сводка:</strong> за последний час особых происшествий не выявлено.',tp:'info'}];
    setInterval(()=>{const e=pool[Math.floor(Math.random()*pool.length)];this.addEv(e.tx,e.tp);},55000);
  },

  showNotifs(){this.toast('i','Уведомления','Всего событий за смену: '+this.s.events.length+'. Все уведомления в ленте событий.');},

  toast(tp,title,msg){
    const ico={s:'fa-circle-check',w:'fa-triangle-exclamation',d:'fa-circle-xmark',i:'fa-circle-info'};
    const id='t'+Date.now();
    document.getElementById('TB').insertAdjacentHTML('beforeend',`<div class="tst t${tp}" id="${id}"><i class="fas ${ico[tp]||ico.i} ti2"></i><div class="tb2"><div class="tt">${title}</div><div class="tm2">${msg}</div></div><button class="tx2" onclick="this.parentElement.remove()"><i class="fas fa-xmark"></i></button></div>`);
    setTimeout(()=>{const el=document.getElementById(id);if(el){el.style.opacity='0';el.style.transform='translateX(100%)';setTimeout(()=>el.remove(),300);}},5000);
  },

  showM(title,body,ico='fas fa-info-circle',btns=[]){
    document.getElementById('mT').textContent=title;document.getElementById('mB').innerHTML=body;document.getElementById('mIco').className=ico+' fa-fw';
    document.getElementById('mF').innerHTML=btns.map(b=>`<button class="btn btn-sm ${b.cl||'btn-sec'}" onclick="${b.a};SYS.cM()">${b.l}</button>`).join('')+'<button class="btn btn-sm btn-sec" onclick="SYS.cM()">Закрыть</button>';
    document.getElementById('MB').classList.add('open');
  },
  cM(){document.getElementById('MB').classList.remove('open');document.getElementById('MDL').className='md';},

  prof(){
