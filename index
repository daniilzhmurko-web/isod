function getQuest(){
  const q=QM.getNew();
  if(!q){notify('info','Нет доступных заданий','Увеличьте сложность или попробуйте позже');return;}
  S.activeQ=q;
  document.getElementById('wmtext').textContent=q.tpl.name;
  renderQList();renderDash();updateHeader();
  if(S.user.mode!=='exam'){
    showTyping('instr',()=>aMsg('instr',`📋 Новое задание: «${q.tpl.name}»\n\nПодсказка: ${q.tpl.hints[0]||''}\n\nПервый шаг: ${q.tpl.steps[0]}`,'ag'));
  }
  aMsg('exam',`📝 Задание: «${q.tpl.name}»\nСложность: ${'⭐'.repeat(q.tpl.diff)}\nМакс.: ${q.tpl.pts} баллов`,'ag');
  log(`Квест получен: ${q.tpl.name}`,'quest_get');
  notify('info','Новое задание!',q.tpl.name);
  // Если у квеста есть нужная панель — перейти
  if(q.tpl.panel&&q.tpl.panel!=='dash')setTimeout(()=>{go(q.tpl.panel);if(q.tpl.tab){const tabMap={vehicles:vTab,licenses:lTab,violations:pvTab};const fn=tabMap[q.tpl.panel];if(fn)fn(q.tpl.tab);}},600);
}

function filterQ(f){S.questFilter=f;renderQList();}
function renderQList(){
  const c=document.getElementById('qlist');
  const f=S.questFilter;
  let qs=[];
  if(f==='all'||f==='active')qs.push(...QM.active);
  if(f==='all'||f==='completed')qs.push(...QM.completed);
  if(f==='all'||f==='failed')qs.push(...QM.failed);
  if(!qs.length){c.innerHTML=`<div class="empty"><div class="eico">📋</div><div class="etxt">Нет заданий</div><button class="btn btn-p btn-sm" style="margin-top:11px" onclick="getQuest()">+ Получить задание</button></div>`;return;}
  c.innerHTML=qs.map(q=>{
    const sb=q.status==='active'?`<span class="badge b-blue">Активно</span>`:q.status==='completed'?`<span class="badge b-green">✅ +${q.final}</span>`:`<span class="badge b-red">❌ Провалено</span>`;
    return`<div class="qcard ${q.status==='active'?'aq':q.status}" onclick="openQD('${q.id}')" style="margin-bottom:9px">
      <div class="qicon">${q.tpl.icon}</div>
      <div style="flex:1">
        <div style="display:flex;justify-content:space-between;align-items:flex-start"><div class="qname">${q.tpl.name}</div>${sb}</div>
        <div class="qdesc">${q.tpl.desc}</div>
        <div class="qmeta"><span class="badge ${'b-'+(q.tpl.diff>=3?'red':q.tpl.diff===2?'orange':'green')}">${'⭐'.repeat(q.tpl.diff)}</span><span class="badge b-gray">${q.tpl.pts} макс.</span>${q.status==='active'?`<span class="badge b-blue">Шаг ${q.step+1}/${q.tpl.steps.length}</span>`:''}</div>
        ${q.status==='active'?`<div class="pbar" style="margin-top:6px"><div class="pfill blue" style="width:${q.step/q.tpl.steps.length*100}%"></div></div>`:''}
      </div>
    </div>`;
  }).join('');
}

let currentQuestId=null;
function openQD(qid){
  const q=[...QM.active,...QM.completed,...QM.failed].find(x=>String(x.id)===String(qid));
  if(!q)return;
  currentQuestId=q.id;
  document.getElementById('qd-title').textContent=`${q.tpl.icon} ${q.tpl.name}`;
  document.getElementById('qd-body').innerHTML=`
    <div class="alrt ${q.tpl.isFraud?'ai-warn':q.tpl.isWanted?'ai-danger':'ai-info'}" style="margin-bottom:14px"><span>${q.tpl.icon}</span><div class="alrt-text">${q.tpl.desc}</div></div>
    <div style="font-family:var(--font);font-size:11px;font-weight:700;color:var(--txt2);text-transform:uppercase;letter-spacing:.7px;margin-bottom:9px">Шаги выполнения:</div>
    ${q.tpl.steps.map((s,i)=>`<div class="step ${i<q.step?'done':i===q.step&&q.status==='active'?'cur':''}">
      <div class="snum">${i<q.step?'✓':i+1}</div>
      <div><div class="stitle">${s}</div>${q.tpl.hints&&q.tpl.hints[i]?`<div class="sdesc">${q.tpl.hints[i]}</div>`:''}</div>
    </div>`).join('')}
    ${q.status!=='active'?`<div class="alrt ${q.status==='completed'?'ai-ok':'ai-danger'}" style="margin-top:11px">
      <span>${q.status==='completed'?'✅':'❌'}</span>
      <div><div class="alrt-title">${q.status==='completed'?`Выполнено! +${q.final} баллов (ошибок: ${q.errors})`:`Провалено: ${q.failReason||''}`}</div></div>
    </div>`:''}
  `;
  const btn=document.getElementById('qd-action');
  btn.style.display=q.status==='active'?'':'none';
  openModal('m-quest');
}

function startActiveQuest(){
  cm('m-quest');
  const q=QM.active.find(x=>x.id===currentQuestId);
  if(!q)return;
  if(q.tpl.panel)go(q.tpl.panel);
  if(q.tpl.tab){const m={vehicles:vTab,licenses:lTab,violations:pvTab};const fn=m[q.tpl.panel];if(fn)setTimeout(()=>fn(q.tpl.tab),300);}
  aMsg('instr',`🎯 Выполняйте: ${q.tpl.steps[q.step]}${q.tpl.hints[q.step]?'\n💡 '+q.tpl.hints[q.step]:''}`, 'ag');
}

function advanceActiveQuest(correct=true){
  if(QM.active.length>0){
    const q=QM.active[0];
    QM.completeStep(q.id,correct);
  }
}

