function addFreeMode() {
  const header = document.getElementById('header');
  if (!header || document.getElementById('freeModeBtn')) return;

  const modeToggle = document.createElement('div');
  modeToggle.style.cssText = 'display:flex;align-items:center;gap:8px;background:var(--bg-main);border:1px solid var(--border);border-radius:6px;padding:4px 8px';
  modeToggle.innerHTML = `
    <span style="font-size:11px;font-weight:700;color:var(--text-muted)">РЕЖИМ:</span>
    <button id="freeModeBtn" onclick="setMode('guided')" class="btn btn-xs btn-primary">📋 Обучение</button>
    <button id="freeModeBtn2" onclick="setMode('free')" class="btn btn-xs btn-secondary">🔓 Свободный</button>`;
  header.insertBefore(modeToggle, header.querySelector('.header-spacer'));
}

let currentMode = 'guided';
function setMode(mode) {
  currentMode = mode;
  const taskbar = document.getElementById('taskbar');
  if (mode === 'free') {
    taskbar.classList.add('collapsed');
    document.getElementById('freeModeBtn').className = 'btn btn-xs btn-secondary';
    document.getElementById('freeModeBtn2').className = 'btn btn-xs btn-primary';
    showToast('Свободный режим','Исследуйте все подсистемы без ограничений','info');
  } else {
    taskbar.classList.remove('collapsed');
    document.getElementById('freeModeBtn').className = 'btn btn-xs btn-primary';
    document.getElementById('freeModeBtn2').className = 'btn btn-xs btn-secondary';
    showToast('Режим обучения','Следуйте заданиям в нижней панели','info');
  }
}

