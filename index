let gCanvas, gCtx, gW, gH, gAnimFrame;
let gParticles = [];
let gActiveEdge = null;

function initGraph() {
  gCanvas = document.getElementById('gc');
  gCtx = gCanvas.getContext('2d');
  resizeGraph();
  window.addEventListener('resize', resizeGraph);
  gCanvas.addEventListener('click', graphClick);
  gCanvas.addEventListener('mousemove', graphHover);
  spawnGParticles();
  requestAnimationFrame(drawGraph);
}

function resizeGraph() {
  const p = document.getElementById('graphP');
  gW = gCanvas.width = p.clientWidth;
  gH = gCanvas.height = p.clientHeight;
}

function nPos(n) { return { x: n.x * gW, y: n.y * gH }; }

function spawnGParticles() {
  setInterval(() => {
    if (!S.running || S.activeTab !== 'graph') return;
    const edges = GRAPH_EDGES.filter(e => S.gFilter === 'all' || e.type === S.gFilter);
    if (!edges.length) return;
    const e = edges[Math.floor(Math.random() * edges.length)];
    const fn = GRAPH_NODES.find(n => n.id === e.from);
    const tn = GRAPH_NODES.find(n => n.id === e.to);
    if (!fn || !tn) return;
    const fp = nPos(fn), tp = nPos(tn);
    gParticles.push({ x: fp.x, y: fp.y, tx: tp.x, ty: tp.y, t: 0, edge: e,
      color: e.type === 'finance' ? '#10B981' : e.type === 'tickets' ? '#F59E0B' : '#3B82F6' });
  }, 400 / S.speed);
}

function drawGraph() {
  if (!gCtx) { requestAnimationFrame(drawGraph); return; }
  gCtx.clearRect(0, 0, gW, gH);

  // background grid
  gCtx.strokeStyle = 'rgba(180,200,220,.18)';
  gCtx.lineWidth = .5;
  for (let x = 0; x < gW; x += 50) { gCtx.beginPath(); gCtx.moveTo(x, 0); gCtx.lineTo(x, gH); gCtx.stroke(); }
  for (let y = 0; y < gH; y += 50) { gCtx.beginPath(); gCtx.moveTo(0, y); gCtx.lineTo(gW, y); gCtx.stroke(); }

  // edges
  GRAPH_EDGES.forEach(e => {
    if (S.gFilter !== 'all' && e.type !== S.gFilter) return;
    const fn = GRAPH_NODES.find(n => n.id === e.from);
    const tn = GRAPH_NODES.find(n => n.id === e.to);
    if (!fn || !tn) return;
    const fp = nPos(fn), tp = nPos(tn);
    gCtx.beginPath();
    gCtx.moveTo(fp.x, fp.y); gCtx.lineTo(tp.x, tp.y);
    gCtx.strokeStyle = e.type === 'finance' ? 'rgba(16,185,129,.25)' :
                       e.type === 'tickets'  ? 'rgba(245,158,11,.25)' :
                                               'rgba(59,130,246,.25)';
    gCtx.lineWidth = e.w;
    gCtx.setLineDash([5, 4]);
    gCtx.stroke();
    gCtx.setLineDash([]);
  });

  // particles
  gParticles = gParticles.filter(p => { p.t += .012 * S.speed; return p.t < 1; });
  gParticles.forEach(p => {
    const cx = p.x + (p.tx - p.x) * p.t;
    const cy = p.y + (p.ty - p.y) * p.t;
    gCtx.beginPath();
    gCtx.arc(cx, cy, 4, 0, Math.PI * 2);
    gCtx.fillStyle = p.color;
    gCtx.shadowBlur = 10; gCtx.shadowColor = p.color;
    gCtx.fill();
    gCtx.shadowBlur = 0;
  });

  // nodes
  GRAPH_NODES.forEach(n => {
    if (S.gFilter !== 'all') {
      const hasEdge = GRAPH_EDGES.some(e => (e.from === n.id || e.to === n.id) && e.type === S.gFilter);
      if (!hasEdge) { gCtx.globalAlpha = .25; }
    }
    const p = nPos(n);
    const isSel = S.selectedNode && S.selectedNode.id === n.id;
    // shadow
    gCtx.shadowBlur = isSel ? 20 : 8;
    gCtx.shadowColor = n.color;
    gCtx.beginPath();
    gCtx.arc(p.x, p.y, n.r + (isSel ? 3 : 0), 0, Math.PI * 2);
    gCtx.fillStyle = n.color;
    gCtx.fill();
    gCtx.shadowBlur = 0;
    // ring
    gCtx.strokeStyle = 'rgba(255,255,255,.45)';
    gCtx.lineWidth = isSel ? 3 : 1.5;
    gCtx.stroke();
    // label
    gCtx.fillStyle = '#FFFFFF';
    gCtx.font = `bold ${Math.max(8, n.r * .5)}px PT Sans`;
    gCtx.textAlign = 'center'; gCtx.textBaseline = 'middle';
    const lines = n.label.split(' ');
    if (lines.length === 1) {
      gCtx.fillText(n.label, p.x, p.y);
    } else {
      gCtx.fillText(lines[0], p.x, p.y - 5);
      gCtx.fillText(lines.slice(1).join(' '), p.x, p.y + 7);
    }
    gCtx.globalAlpha = 1;
  });

  requestAnimationFrame(drawGraph);
}

function graphClick(ev) {
  const rect = gCanvas.getBoundingClientRect();
  const mx = ev.clientX - rect.left, my = ev.clientY - rect.top;
  let hit = null;
  GRAPH_NODES.forEach(n => {
    const p = nPos(n);
    if (Math.hypot(mx - p.x, my - p.y) < n.r + 8) hit = n;
  });
  S.selectedNode = hit;
  const ni = document.getElementById('ninfo');
  if (hit) {
    ni.classList.add('vis');
    document.getElementById('ni-t').textContent = hit.label;
    const branch = BRANCHES.find(b => b.id === hit.id);
    let html = '';
    const typeMap = {gcsp:'Главный центр',branch:'Филиал',fin:'Фин. подразделение',emp:'Сотрудник',transport:'Транс. организация'};
    html += `<div class="nst"><span class="nsl2">Тип</span><span class="nsv">${typeMap[hit.type]||hit.type}</span></div>`;
    if (branch) {
      html += `<div class="nst"><span class="nsl2">Лимит</span><span class="nsv">${(branch.limit/1e6).toFixed(1)}М ₽</span></div>`;
      html += `<div class="nst"><span class="nsl2">Израсходовано</span><span class="nsv">${(branch.spent/1e6).toFixed(2)}М ₽</span></div>`;
      const pct = Math.round(branch.spent / branch.limit * 100);
      html += `<div class="nst"><span class="nsl2">Использовано</span><span class="nsv">${pct}%</span></div>`;
    }
    const edgesOut = GRAPH_EDGES.filter(e => e.from === hit.id).length;
    const edgesIn  = GRAPH_EDGES.filter(e => e.to === hit.id).length;
    html += `<div class="nst"><span class="nsl2">Исходящих связей</span><span class="nsv">${edgesOut}</span></div>`;
    html += `<div class="nst"><span class="nsl2">Входящих связей</span><span class="nsv">${edgesIn}</span></div>`;
    document.getElementById('ni-s').innerHTML = html;
  } else {
    ni.classList.remove('vis');
  }
}
function graphHover(ev) {
  const rect = gCanvas.getBoundingClientRect();
  const mx = ev.clientX - rect.left, my = ev.clientY - rect.top;
  let hit = false;
  GRAPH_NODES.forEach(n => {
    const p = nPos(n);
    if (Math.hypot(mx - p.x, my - p.y) < n.r + 8) hit = true;
  });
  gCanvas.style.cursor = hit ? 'pointer' : 'default';
}

function gFilt(f) {
  S.gFilter = f;
  ['all','finance','tickets','requests'].forEach(x => {
