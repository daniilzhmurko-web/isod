document.addEventListener('keydown', e => {
  if (!globalState.currentUser) return;
  // Ctrl+F — поиск
  if (e.ctrlKey && e.key === 'f') { e.preventDefault(); document.getElementById('globalSearch')?.focus(); }
  // Ctrl+H — главная
  if (e.ctrlKey && e.key === 'h') { e.preventDefault(); navigate('dashboard'); }
  // Ctrl+E — экзамен
  if (e.ctrlKey && e.key === 'e') { e.preventDefault(); toggleExamMode(); }
  // Ctrl+Enter — следующий шаг
  if (e.ctrlKey && e.key === 'Enter') { e.preventDefault(); nextMission(); }
  // Escape — закрыть AI
  if (e.key === 'Escape') document.getElementById('aiPanel').classList.remove('open');
});

