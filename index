const rnd=a=>a[Math.floor(Math.random()*a.length)];
const ri=(a,b)=>Math.floor(Math.random()*(b-a+1))+a;
const rdDate=(y=5)=>{const d=new Date();d.setFullYear(d.getFullYear()-Math.random()*y);d.setDate(d.getDate()-ri(0,365));return d.toISOString().split('T')[0]};
const today=()=>new Date().toISOString().split('T')[0];
const addDays=(s,d)=>{const dt=new Date(s);dt.setDate(dt.getDate()+d);return dt.toISOString().split('T')[0]};
const daysDiff=(a,b)=>Math.round((new Date(b)-new Date(a))/86400000);
const fmtDate=s=>{if(!s)return'—';return new Date(s).toLocaleDateString('ru-RU')};
const fmtMoney=n=>n.toLocaleString('ru-RU')+'₽';

function genPlate(){const L=()=>LETTERS[ri(0,LETTERS.length-1)];return`${L()}${ri(100,999)}${L()}${L()}${rnd(REGS)}`}
function genVIN(){const c='ABCDEFGHJKLMNPRSTUVWXYZ0123456789';let v='';for(let i=0;i<17;i++)v+=c[ri(0,c.length-1)];return v}
function genSTS(){return`${ri(10,99)}${String.fromCharCode(65+ri(0,25))}${String.fromCharCode(65+ri(0,25))} ${ri(100000,999999)}`}
function genPass(){return`${ri(10,99)}${ri(10,99)} ${ri(100000,999999)}`}
function genDecree(){return`18810${ri(10000000,99999999)}`}
function genLicNum(){const s=['77АА','77АВ','78АА','50АА'];return`${rnd(s)} ${ri(100000,999999)}`}

