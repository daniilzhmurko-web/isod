.nic{width:16px;text-align:center;font-size:12px;color:rgba(255,255,255,.45);flex-shrink:0}
.ni.on .nic,.ni:hover .nic{color:rgba(255,255,255,.85)}
.nl{flex:1}.nb{font-size:9px;font-weight:700;padding:1px 5px;border-radius:10px;color:#fff;background:var(--rd)}
.nb.i{background:var(--bl)}.nb.w{background:var(--am)}.nb.g{background:var(--gn)}
.sbft{margin-top:auto;border-top:1px solid rgba(255,255,255,.07);padding:10px}
.sbss{background:rgba(255,255,255,.04);border-radius:6px;padding:7px 10px;font-size:10px;font-family:var(--fm);color:rgba(255,255,255,.35);line-height:1.9}
/* CONTENT */
.ca{flex:1;display:flex;flex-direction:column;overflow:hidden}
.cm{flex:1;overflow-y:auto;padding:16px 20px}
.cm::-webkit-scrollbar{width:5px}.cm::-webkit-scrollbar-thumb{background:var(--b2);border-radius:3px}
/* CONSOLE */
.con{height:var(--ch);background:#0D1B2A;border-top:2px solid #1E3A5F;display:flex;flex-direction:column;flex-shrink:0;transition:height .2s}
.con.cls{height:32px}
.cnhd{display:flex;align-items:center;justify-content:space-between;padding:5px 11px;border-bottom:1px solid rgba(255,255,255,.05);flex-shrink:0;cursor:pointer;user-select:none}
.cntl{font-family:var(--fm);font-size:11px;font-weight:600;color:rgba(255,255,255,.5);letter-spacing:.05em;text-transform:uppercase}
.cdts{display:flex;gap:5px}.cdts span{width:8px;height:8px;border-radius:50%}
.d1{background:#FF5F57}.d2{background:#FEBC2E}.d3{background:#28C840}
.cnbd{flex:1;overflow-y:auto;padding:7px 11px;font-family:var(--fm);font-size:11px}
.cnbd::-webkit-scrollbar{width:3px}.cnbd::-webkit-scrollbar-thumb{background:rgba(255,255,255,.08);border-radius:2px}
.le{display:flex;gap:7px;align-items:flex-start;padding:2px 0;border-bottom:1px solid rgba(255,255,255,.03);line-height:1.5}
.lt{color:rgba(255,255,255,.22);flex-shrink:0;font-size:10px;padding-top:1px}
.ll{flex-shrink:0;font-size:10px;font-weight:700;padding:0 4px;border-radius:2px}
.ll.INFO{color:#60A5FA;background:rgba(96,165,250,.1)}.ll.OK{color:#34D399;background:rgba(52,211,153,.1)}
.ll.WARN{color:#FBBF24;background:rgba(251,191,36,.1)}.ll.ERROR{color:#F87171;background:rgba(248,113,113,.1)}
.ll.SEC{color:#C084FC;background:rgba(192,132,252,.1)}
.lm{color:rgba(255,255,255,.6);font-size:11px}
/* CARDS */
.card{background:#fff;border:1px solid var(--b1);border-radius:8px;box-shadow:var(--s1)}
.chd{padding:12px 15px;border-bottom:1px solid var(--b1);display:flex;align-items:center;justify-content:space-between}
.ct{font-size:13px;font-weight:700;color:var(--t1);display:flex;align-items:center;gap:7px}.ct i{color:var(--bl)}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.sc{background:#fff;border:1px solid var(--b1);border-radius:8px;padding:14px;display:flex;align-items:flex-start;gap:12px;box-shadow:var(--s1);transition:box-shadow .2s}
.sc:hover{box-shadow:var(--s2)}
.si{width:40px;height:40px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}
.si.bl{background:var(--bl3);color:var(--bl)}.si.gn{background:var(--gn2);color:var(--gn)}
.si.rd{background:var(--rd2);color:var(--rd)}.si.am{background:var(--am2);color:var(--am)}
.si.pu{background:var(--pu2);color:var(--pu)}.si.cy{background:var(--cy2);color:var(--cy)}
.sv{font-size:22px;font-weight:700;color:var(--t1);line-height:1}.slb{font-size:11px;color:var(--t3);margin-top:3px}
.sdl{font-size:11px;margin-top:3px;font-family:var(--fm)}.sdl.up{color:var(--gn)}.sdl.dn{color:var(--rd)}
/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:6px;font-family:var(--f);font-size:13px;font-weight:500;cursor:pointer;transition:all .15s;border:1px solid transparent}
.bp{background:var(--bl);color:#fff;border-color:var(--bl)}.bp:hover{background:#1E40AF}
.bs{background:#fff;color:var(--t2);border-color:var(--b2)}.bs:hover{background:var(--bg3);color:var(--t1)}
.bd{background:var(--rd);color:#fff}.bd:hover{background:#B91C1C}
.bk{background:var(--gn);color:#fff}.bk:hover{background:#15803D}
.bw{background:var(--am);color:#fff}.bw:hover{background:#B45309}
.bpu{background:var(--pu);color:#fff}.bpu:hover{background:#6D28D9}
.bsm{padding:5px 10px;font-size:12px}.bxs{padding:3px 7px;font-size:11px;border-radius:4px}
.btn:disabled{opacity:.5;cursor:not-allowed}
/* TABLE */
.dt{width:100%;border-collapse:collapse}
.dt th{background:var(--bg3);color:var(--t2);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;padding:9px 11px;text-align:left;border-bottom:1px solid var(--b1);white-space:nowrap}
.dt td{padding:9px 11px;border-bottom:1px solid var(--b1);font-size:12px;color:var(--t1);vertical-align:middle}
.dt tr:last-child td{border-bottom:none}.dt tbody tr{transition:background .1s;cursor:pointer}.dt tbody tr:hover{background:var(--bl3)}
/* BADGES */
.bst{display:inline-flex;align-items:center;gap:3px;padding:2px 8px;border-radius:20px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em}
.bst-rd{background:var(--rd2);color:#991B1B}.bst-gn{background:var(--gn2);color:#166534}
.bst-am{background:var(--am2);color:#92400E}.bst-bl{background:var(--bl3);color:#1E3A8A}
.bst-pu{background:var(--pu2);color:#5B21B6}.bst-cy{background:var(--cy2);color:#164E63}
.bst-gr{background:var(--bg3);color:var(--t3)}
/* NOTICES */
.n-R{background:#FEE2E2;color:#991B1B;border:1px solid #FECACA;padding:2px 9px;border-radius:4px;font-size:11px;font-weight:700;font-family:var(--fm)}
.n-Y{background:#FEF9C3;color:#713F12;border:1px solid #FDE68A;padding:2px 9px;border-radius:4px;font-size:11px;font-weight:700;font-family:var(--fm)}
.n-G{background:#DCFCE7;color:#166534;border:1px solid #BBF7D0;padding:2px 9px;border-radius:4px;font-size:11px;font-weight:700;font-family:var(--fm)}
.n-B{background:#DBEAFE;color:#1E3A8A;border:1px solid #BFDBFE;padding:2px 9px;border-radius:4px;font-size:11px;font-weight:700;font-family:var(--fm)}
.n-K{background:#1C1917;color:#F5F5F4;padding:2px 9px;border-radius:4px;font-size:11px;font-weight:700;font-family:var(--fm)}
.n-O{background:#FED7AA;color:#7C2D12;border:1px solid #FDBA74;padding:2px 9px;border-radius:4px;font-size:11px;font-weight:700;font-family:var(--fm)}
/* SEARCH FORM */
.sf{background:#fff;border:1px solid var(--b1);border-radius:8px;padding:14px;margin-bottom:14px;box-shadow:var(--s1)}
.sft{font-size:12px;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:11px;display:flex;align-items:center;gap:6px}
.sr{display:flex;gap:9px;flex-wrap:wrap;align-items:flex-end}
.sfld{flex:1;min-width:110px}
.sfld label{display:block;font-size:11px;font-weight:600;color:var(--t2);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px}
.sfld input,.sfld select,.sfld textarea{width:100%;padding:7px 10px;border:1.5px solid var(--b2);border-radius:5px;font-family:var(--f);font-size:13px;color:var(--t1);background:#fff;outline:none;transition:border-color .2s,box-shadow .2s}
.sfld input:focus,.sfld select:focus,.sfld textarea:focus{border-color:var(--bl);box-shadow:0 0 0 3px var(--bl3)}
.sdiv{height:1px;background:var(--b1);margin:10px 0}
.proc{background:var(--bl3);border:1px solid #BFDBFE;border-radius:6px;padding:9px 13px;font-size:12px;color:var(--bl);display:flex;align-items:center;gap:8px;margin-bottom:11px}
.pbar{flex:1;height:3px;background:rgba(0,0,0,.08);border-radius:2px;overflow:hidden}
.pfill{height:100%;background:var(--bl);border-radius:2px;animation:pfil 1.6s ease-in-out}
/* NOTIFICATIONS */
#na{position:fixed;top:62px;right:14px;z-index:9000;display:flex;flex-direction:column;gap:7px;width:310px;pointer-events:none}
.notif{background:#fff;border:1px solid var(--b1);border-radius:8px;padding:11px 13px;box-shadow:var(--s3);display:flex;gap:9px;align-items:flex-start;pointer-events:all;animation:nIn .3s ease;transition:opacity .3s,transform .3s}
.notif.out{opacity:0;transform:translateX(20px)}
.nic2{width:30px;height:30px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0}
.nic2.info{background:var(--bl3);color:var(--bl)}.nic2.ok{background:var(--gn2);color:var(--gn)}
.nic2.warn{background:var(--am2);color:var(--am)}.nic2.error{background:var(--rd2);color:var(--rd)}
.ntl{font-size:12px;font-weight:700;color:var(--t1);margin-bottom:2px}
.nm{font-size:11px;color:var(--t2);line-height:1.4}
.nX{color:var(--t3);cursor:pointer;font-size:12px;flex-shrink:0}.nX:hover{color:var(--t1)}
/* DASHBOARD */
.dash-hero{background:linear-gradient(135deg,#1A2B4A,#2E5090);border-radius:10px;padding:18px 22px;margin-bottom:16px;color:#fff;display:flex;align-items:center;justify-content:space-between}
.dhl h2{font-size:17px;font-weight:700;margin-bottom:3px}.dhl p{font-size:12px;color:rgba(255,255,255,.6)}
.dhr{display:flex;gap:18px;text-align:center}
.dsn{font-size:22px;font-weight:700;color:#FFD700}.dsl{font-size:10px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.06em}
/* PAGE */
.ph{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:16px}
.ptl{font-size:19px;font-weight:700;color:var(--t1)}.psb{font-size:12px;color:var(--t3);margin-top:3px;font-family:var(--fm)}
.tabs{display:flex;border-bottom:1px solid var(--b1);margin-bottom:11px}
.tab{padding:7px 13px;font-size:12px;font-weight:600;color:var(--t3);cursor:pointer;border-bottom:2px solid transparent;transition:all .15s;white-space:nowrap}
.tab:hover{color:var(--t1)}.tab.on{color:var(--bl);border-bottom-color:var(--bl)}
.tp{display:none}.tp.on{display:block}
.dl{display:grid;grid-template-columns:auto 1fr;gap:3px 14px}
.dl dt{font-size:11px;color:var(--t3);font-weight:600;text-transform:uppercase;letter-spacing:.04em;padding:4px 0;white-space:nowrap}
.dl dd{font-size:12px;color:var(--t1);padding:4px 0;font-family:var(--fm)}
.tl{display:flex;flex-direction:column}
.tli{display:flex;gap:11px;padding-bottom:12px;position:relative}
.tli::before{content:"";position:absolute;left:10px;top:21px;bottom:0;width:1px;background:var(--b1)}
.tli:last-child::before{display:none}
.tld{width:21px;height:21px;border-radius:50%;background:#fff;border:2px solid var(--b2);display:flex;align-items:center;justify-content:center;font-size:9px;flex-shrink:0;z-index:1}
.tld.ok{border-color:var(--gn);color:var(--gn);background:var(--gn2)}
.tld.warn{border-color:var(--am);color:var(--am);background:var(--am2)}
.tld.err{border-color:var(--rd);color:var(--rd);background:var(--rd2)}
.tlc{flex:1;padding-top:1px}.tlt{font-size:12px;color:var(--t1)}.tls{font-size:11px;color:var(--t3);margin-top:1px}.tld2{font-size:10px;color:var(--t3);font-family:var(--fm);margin-bottom:1px}
/* SECURITY */
.slv{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.slv-s{background:var(--pu2);color:#5B21B6}.slv-d{background:var(--am2);color:#92400E}.slv-o{background:var(--gn2);color:#166534}
.sig{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:5px;font-size:11px;font-family:var(--fm);font-weight:600}
.sig.ok{background:var(--gn2);color:#166534;border:1px solid #BBF7D0}
.sig.bad{background:var(--rd2);color:#991B1B;border:1px solid #FECACA}
.sig.pen{background:var(--am2);color:#92400E;border:1px solid #FDE68A}
/* MODAL */
.mov{position:fixed;inset:0;background:rgba(0,0,0,.42);z-index:8000;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .2s}
.mov.open{opacity:1;pointer-events:all}
.mbox{background:#fff;border-radius:10px;box-shadow:var(--sM);width:700px;max-width:95vw;max-height:88vh;display:flex;flex-direction:column;transform:scale(.95);transition:transform .2s}
.mov.open .mbox{transform:scale(1)}
.mhd{padding:14px 18px;border-bottom:1px solid var(--b1);display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.mtl{font-size:15px;font-weight:700;color:var(--t1);display:flex;align-items:center;gap:7px}
.mX{width:26px;height:26px;border-radius:50%;border:1px solid var(--b1);background:none;color:var(--t3);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:13px;transition:all .15s}
.mX:hover{background:var(--rd2);color:var(--rd);border-color:var(--rd)}
.mbdy{padding:18px;overflow-y:auto;flex:1}.mft{padding:13px 18px;border-top:1px solid var(--b1);display:flex;justify-content:flex-end;gap:7px;flex-shrink:0}
/* QUEST */
#qp{position:fixed;bottom:0;right:0;width:345px;background:#fff;border:1px solid var(--b1);border-bottom:none;border-right:none;border-radius:8px 0 0 0;box-shadow:var(--s3);z-index:500;transition:transform .3s;max-height:65vh;display:flex;flex-direction:column}
#qp.min{transform:translateY(calc(100% - 40px))}
.qhd{padding:9px 13px;background:linear-gradient(135deg,#1A2B4A,#2E5090);border-radius:8px 0 0 0;display:flex;align-items:center;justify-content:space-between;cursor:pointer;flex-shrink:0}
.qtt{font-size:12px;font-weight:700;color:#fff;text-transform:uppercase;letter-spacing:.04em}
.qctr{display:flex;gap:3px}
.qcb{width:21px;height:21px;border-radius:4px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.1);color:rgba(255,255,255,.8);font-size:10px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s}
.qcb:hover{background:rgba(255,255,255,.2);color:#fff}
.qpb{height:4px;background:rgba(0,0,0,.08);flex-shrink:0}.qpf{height:100%;background:linear-gradient(90deg,#60A5FA,#34D399);transition:width .5s}
.qbd{flex:1;overflow-y:auto;padding:12px}
.qmn{font-size:13px;font-weight:700;color:var(--t1);margin-bottom:5px;display:flex;align-items:center;gap:6px}
.qmi{width:22px;height:22px;background:var(--bl3);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--bl)}
.qst{font-size:12px;color:var(--t2);line-height:1.6;margin-bottom:10px}
.qob{display:flex;align-items:flex-start;gap:7px;font-size:12px;color:var(--t2);padding:5px 8px;border-radius:5px;background:var(--bg3);border:1px solid var(--b1);margin-bottom:5px}
.qob .ock{width:15px;height:15px;border-radius:50%;border:2px solid var(--b2);display:flex;align-items:center;justify-content:center;font-size:8px;flex-shrink:0;margin-top:1px}
.qob.dn{background:var(--gn2);border-color:#BBF7D0;color:#166534}
.qob.dn .ock{border-color:var(--gn);background:var(--gn);color:#fff}
.qht{background:var(--am2);border:1px solid #FDE68A;border-radius:6px;padding:7px 10px;font-size:11px;color:#92400E;display:none;gap:6px;align-items:flex-start;margin-bottom:9px}
.qht.show{display:flex}
.qft{padding:9px 13px;border-top:1px solid var(--b1);display:flex;gap:5px;justify-content:space-between;flex-shrink:0}
/* MISC */
.psec{display:none}.psec.on{display:block}
.spn{width:30px;height:30px;border:3px solid var(--b1);border-top-color:var(--bl);border-radius:50%;animation:spin .8s linear infinite}
.lov{display:flex;align-items:center;justify-content:center;padding:38px;flex-direction:column;gap:11px}
.emp{text-align:center;padding:36px 18px;color:var(--t3)}.emp i{font-size:32px;margin-bottom:10px;opacity:.35;display:block}.emp p{font-size:13px}
.info-box{background:var(--bl3);border:1px solid #BFDBFE;border-radius:6px;padding:10px 13px;font-size:12px;color:var(--bl);margin-bottom:12px;display:flex;align-items:flex-start;gap:8px;line-height:1.5}
.warn-box{background:var(--am2);border:1px solid #FDE68A;border-radius:6px;padding:10px 13px;font-size:12px;color:#92400E;margin-bottom:12px;display:flex;align-items:flex-start;gap:8px;line-height:1.5}
.err-box{background:var(--rd2);border:1px solid #FECACA;border-radius:6px;padding:10px 13px;font-size:12px;color:#991B1B;margin-bottom:12px;display:flex;align-items:flex-start;gap:8px;line-height:1.5}
.ok-box{background:var(--gn2);border:1px solid #BBF7D0;border-radius:6px;padding:10px 13px;font-size:12px;color:#166534;margin-bottom:12px;display:flex;align-items:flex-start;gap:8px;line-height:1.5}
.achip{display:inline-flex;align-items:center;gap:4px;background:var(--bg3);border:1px solid var(--b1);border-radius:4px;padding:2px 8px;font-size:11px;font-family:var(--fm);margin:2px}
/* STAGE 4: REQUESTS */
.pri-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:12px;font-size:10px;font-weight:700;font-family:var(--fm)}
.pri-H{background:#FEE2E2;color:#991B1B;border:1px solid #FECACA}
.pri-M{background:#FEF3C7;color:#92400E;border:1px solid #FDE68A}
.pri-L{background:#DCFCE7;color:#166534;border:1px solid #BBF7D0}
.req-card{background:#fff;border:1px solid var(--b1);border-radius:8px;padding:12px;margin-bottom:9px;box-shadow:var(--s1);cursor:pointer;border-left:4px solid var(--b2);transition:all .15s}
.req-card:hover{box-shadow:var(--s2);border-left-color:var(--bl)}
.req-card.high{border-left-color:var(--rd)}.req-card.medium{border-left-color:var(--am)}.req-card.low{border-left-color:var(--gn)}
.req-card.urgent{animation:urgpulse 2s infinite}
@keyframes urgpulse{0%,100%{background:#fff}50%{background:#FFF5F5}}
.req-hd{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:7px}
.req-id{font-family:var(--fm);font-size:11px;color:var(--t3);margin-bottom:2px}
.req-title{font-size:13px;font-weight:700;color:var(--t1)}
.req-meta{display:flex;gap:8px;flex-wrap:wrap;font-size:11px;color:var(--t2);margin-top:5px}
.dl-ok{background:var(--gn2);color:#166534;padding:1px 7px;border-radius:10px;font-size:10px;font-weight:700;font-family:var(--fm)}
.dl-warn{background:var(--am2);color:#92400E;padding:1px 7px;border-radius:10px;font-size:10px;font-weight:700;font-family:var(--fm)}
.dl-over{background:var(--rd2);color:#991B1B;padding:1px 7px;border-radius:10px;font-size:10px;font-weight:700;font-family:var(--fm);animation:blink 1.5s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.5}}
.filter-bar{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:13px;align-items:center}
.filter-chip{display:inline-flex;align-items:center;gap:4px;padding:5px 11px;border-radius:20px;font-size:12px;font-weight:500;cursor:pointer;border:1.5px solid var(--b2);background:#fff;color:var(--t2);transition:all .15s}
.filter-chip:hover{border-color:var(--bl);color:var(--bl)}.filter-chip.on{background:var(--bl);border-color:var(--bl);color:#fff}
/* QUEUE */
